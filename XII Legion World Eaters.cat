      <selectionEntryGroups>
        <selectionEntryGroup id="4ccef9c0-e7ad-4d84-ae83-61d87ae819a7" name="Fleet Role" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="a01550ab-9eb0-4760-a93a-b7798eafe6e7" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="39e82527-15b1-46b2-bfce-25be338a22cd" name="Designate as Flagship" hidden="false" collective="false" import="true" type="upgrade"><profiles><profile id="87aabaa5-16b8-473a-af1e-64232fc084db" name="Flagship" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship is the fleet's Flagship. Exactly one Flagship is required in a standard fleet.</characteristic></characteristics></profile><profile id="10ea7046-ee5f-4d60-84a0-57b9110ecac8" name="Commander Embarkation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander here. The Commander is embarked on this Flagship.</characteristic></characteristics></profile></profiles><categoryLinks><categoryLink id="380a7ddd-6d9d-4b0b-8405-0c0c25f188f2" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" /></categoryLinks><selectionEntryGroups><selectionEntryGroup id="91c32910-47ce-48c7-98ae-3c7e3ef7e166" name="Fleet Commander" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="297aacc6-ee27-4b98-906a-b646f9ea0c13" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="98fde837-7275-4a0c-ae71-775