          <constraints>
            <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="61140043-6106-57f5-8b99-027fc630ca82" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry id="aab683e1-a36d-58c1-8bd3-28e611ce1d00" name="Veteran Crew - Line Ship" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="745964f3-86d0-5760-8fdf-d5f8122940de" percentValue="false" includeChildSelections="false" includeChildForces="false" />
              </constraints>
            <profiles>
