    <profiles>
        <profile id="8b35bcc8-6110-4e88-9d7b-2449a66d798b" name="Lotara Sarrin" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Flagship may re-roll ram distance/effects; Ursus Claws force Break Away on 6+.</characteristic>
          </characteristics>
        </profile>
      <profile id="a671d93f-db6e-410f-9e2a-b24f1bf1a195" name="Primarch Retinue" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This character is embarked as the Primarch's additional named retinue. They do not add Fleet Orders, Command range or Leadership; only effects unrelated to the order economy apply.</characteristic></characteristics></profile></profiles>
