            <characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">—</characteristic>
            <characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">—</characteristic>
            <characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">—</characteristic>
            <characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">12″</characteristic>
            <characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Rams inflict D3+1 hits and retain Armourbane; target may not Evade; Locked enemy breaks away only on 6; tearing free suffers 3 HP</characteristic>
          </characteristics>
        </profile>
        <profile id="8ecc2593-902a-53c9-8dd9-3e22a6a529bf" name="Drop Pod Launchers ×4" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
