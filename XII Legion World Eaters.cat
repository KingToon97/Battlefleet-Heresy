    <selectionEntry id="a9698f94-9562-563b-a87e-53086b15ca76" name="Fleet Construction Rules" hidden="false" collective="false" import="true" type="upgrade">
      <profiles>
        <profile id="517ca2e4-30de-5f14-bb1e-3828dd9989a0" name="Fleet Construction Rules" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Capital Ships: minimum 1. Maximum by fleet size: 1 at 1,000; 2 at 1,500; 3 at 2,000; 4 at 2,500; 5 at 3,000. Minimum Line Ships: 4/5/6/7/8 respectively. No single ship may exceed 50% of fleet points including upgrades. Gloriana 2,000+; Abyss/Phalanx 3,000+. Escorts/Frigates squadrons 3–6; Assault Barges up to 4. This v0.2 catalogue displays these rules but automatic variable-points bracket validation is still in development.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    <categoryLinks>
        <categoryLink id="f30fafc6-53e4-57a9-b920-6b5a7bf9263b" name="Upgrade" hidden="false" targetId="7610de76-9ef1-58ab-9c7b-f97ede66e61d" primary="true" />
      </categoryLinks>
      </selectionEntry>
    <selectionEntry id="870ae829-3e1a-5c75-aa26-1ab1991c2ecd" name="XII Legion - Violence Incarnate" hidden="false" collective="false" import="true" type="upgrade">
      <rules><rule id="8af34776-a9d5-552c-9a6a-c1b6e7282420" name="XII Legion - Violence Incarnate" hidden="false"><description>One ship per turn gains +3 on its Ram roll.</description></rule></rules><categoryLinks>
        <categoryLink id="246ee527-16e6-5992-ab96-e1121b7679ea" name="Upgrade" hidden="false" targetId="7610de76-9ef1-58ab-9c7b-f97ede66e61d" primary="true" />
      </categoryLinks>
      </selectionEntry>
    <selectionEntry id="cdebbbe9-b972-4e95-8f4c-a3a50c2f1a1f" name="Battle Carrier" hidden="false" collective="false" import="true" type="unit">
      <profiles>
        <profile id="67a37117-7ecc-4007-82bd-5b1c27638874" name="Battle Carrier" hidden="false" typeId="806f9ff1-fd51-5ddb-b005-ce73a5d09d65" typeName="Ship">
          <characteristics>
            <characteristic name="BS" typeId="d130e705-611e-5a0a-bd7d-ea8e848fdb2e">3</characteristic>
            <characteristic name="Prow" typeId="84a55377-edbc-5825-a2bf-70c6155018f2">14</characteristic>
            <characteristic name="Broadside" typeId="5f595433-7397-5c4b-9d4a-8f35d83a2b29">13</characteristic>
            <characteristic name="Stern" typeId="cd9ec76e-f959-5560-8845-9ab242f16e71">12</characteristic>
            <characteristic name="HP" typeId="ef713781-2034-5fb4-83d1-e49d1d683694">13</characteristic>
            <characteristic name="VS" typeId="84309751-688d-50ef-8940-d8d042261a56">8</characteristic>
            <characteristic name="Speed" typeId="25d0e01e-8e74-55b3-8a2a-17773c881625">6″</characteristic>
            <characteristic name="Turn" typeId="899e9c58-70ef-5da5-8495-5bf6a8b7f8f0">45°</characteristic>
            <characteristic name="Crew" typeId="2f6312dd-493e-53c6-96e2-d901afca0e81">8</characteristic>
          </characteristics>
        </profile>
        <profile id="02f2b36b-a9c4-4172-ae5a-51591d430d73" name="Hangar Bays (6)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">6 physical Hangar Bay mounts; each bay costs 10 pts and carries one aircraft squadron.</characteristic>
          </characteristics>
        </profile>
        <profile id="585cab5e-9c4e-415a-bd23-a4ba8a4e1115" name="Bulwark of the Line" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Enemy Damage Table rolls against this ship suffer −1.</characteristic>
          </characteristics>
        </profile>
        <profile id="9ddb4516-9c0f-4eda-bc52-352044f38c94" name="Hangar Loadout Validation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Maximum 8 aircraft squadrons.</characteristic>
          </characteristics>
        </profile>
        <profile id="b3986dd5-2a86-47ba-bd05-cfc817ace5b7" name="Boarding Forces Validation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding forces are bought against the ship’s Crew. Terminator/Dreadnought class limits are enforced; remember a Contemptor occupies 2 Crew slots.</characteristic>
          </characteristics>
        </profile>
        <profile id="4c38db8b-ae3e-4949-82b6-06693e0fc07a" name="Hardpoint Construction" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Bare chassis. Every mounted weapon is purchased separately. No upgrade-spend ceiling. Legal choices are controlled by hull class, hardpoint type and facing; each hardpoint must contain exactly one weapon.</characteristic>
          </characteristics>
        </profile>
      <profile id="940a5505-c24e-436d-88c2-24ec278cdeae" name="Mount Capacity" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Port Heavy: 1 · Starboard Heavy: 1 · Prow Ordnance: 6 · Dorsal: 4 · Defence: 10 · Hangar: 6</characteristic></characteristics></profile><profile id="fe962c12-6d57-42e8-846f-52f9898e515b" name="Hardpoint Configuration" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ships begin with no weapons or Defence Batteries selected. Hangar Bay slots represent built-in hull capacity and cost 0 pts. Each physical hardpoint may take at most one legal component. There is no separate upgrade-spend cap; the hull's mount layout is the limit.</characteristic></characteristics></profile><profile id="71a8b72a-5ac1-48ca-8555-c33f2cc93fdb" name="Carrier Flagship Priority" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">A Battle Carrier must be the fleet's Flagship unless a Gloriana is present. New Recruit enforces this through the Fleet Role selection.</characteristic></characteristics></profile><profile id="430ed752-a79d-4dca-8e86-07b4eea86c19" name="Roster Builder Summary" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Crew 8 · Port Heavy 1 · Starboard Heavy 1 · Prow Ordnance 6 · Dorsal 4 · Defence 10 · Hangars 6. Ships start unequipped. Fill only the weapon and Defence hardpoints you want to purchase; each may contain at most one component. Hangar Bay slots cost 0 pts. Aircraft are purchased separately up to Hangar capacity.</characteristic></characteristics></profile></profiles>
      <categoryLinks>
        <categoryLink id="0f1a0b4d-db37-4aac-ab61-1260ff7fcd7d" name="Capital Ship" hidden="false" targetId="bd422ebf-10b3-5085-89cc-263568c40fe0" primary="true" />
      </categoryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup id="fb7d864e-6e88-4090-b7c8-1f791397f8a7" name="Fleet Role" hidden="false" collective="false" import="true"><modifiers><modifier type="set" field="74761eec-ce7b-427c-8f29-cb71b5f04429" value="0.0"><conditions><condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="6e49ea9d-e24f-5916-8418-787496f3214a" type="atLeast" /></conditions></modifier></modifiers><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="8fa3c073-ce52-476d-b132-f30534c5ec09" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="74761eec-ce7b-427c-8f29-cb71b5f04429" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="bbbdb18d-a618-4a63-a137-e4954b14589c" name="Designate as Flagship" hidden="false" collective="false" import="true" type="upgrade"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="6e49ea9d-e24f-5916-8418-787496f3214a" type="atLeast" /></conditions></modifier></modifiers><profiles><profile id="5789981c-c14b-4a01-8da7-fd475b53be75" name="Flagship" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Mandatory when the fleet contains no Gloriana. If a Gloriana is selected, this option is automatically hidden and the requirement is removed.</characteristic></characteristics></profile><profile id="d8ced6b7-6a0c-4d2b-a7ff-30a79126f49c" name="Commander Embarkation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander here. The Commander is embarked on this Flagship.</characteristic></characteristics></profile></profiles><categoryLinks><categoryLink id="3f170b2c-ec4a-4815-834d-ec350bc6d49e" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" /></categoryLinks><selectionEntryGroups><selectionEntryGroup id="b75e71b7-81b1-44ca-b51c-e1b6b27c2a13" name="Fleet Commander" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="5280a2ca-ec82-4894-917c-a804bd81a6dd" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="1370f1c7-46f4-4d86-85b0-15fa4db42f31" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="11946645-9811-435a-b1d1-7e5b192e0a02" name="Fleet Captain" hidden="false" collective="false" import="true" type="upgrade">
