          <selectionEntries>
            <selectionEntry id="0a2bbe72-9941-40d9-b719-d2c4304d2701" name="Heavy Macrobattery (Port)" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="8ad45323-3303-4407-881f-bba112dfd773" percentValue="false" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <profiles>
                <profile id="378d32d3-acd4-4cd6-8960-957cc5e8dd29" name="Heavy Macrobattery" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
                  <characteristics>
                    <characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Port</characteristic>
                    <characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">9</characteristic>
