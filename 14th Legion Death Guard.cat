 <sharedRules>
  <rule id="6e7baaa5-00fb-517a-8d21-9e034827bae8" name="14th Legion - The Remorseless" hidden="false">
   <description>Once per battle round, each friendly ship reduces the Hull Points lost from one enemy attack by 1, to a minimum of 1.</description>
  </rule>
