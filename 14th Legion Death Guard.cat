      <selectionEntry id="54d48825-6d39-5265-a92c-de365079d620" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="451a6ef0-a10e-597a-bf46-5d7e9eb50701" shared="false" includeChildSelections="false" />
