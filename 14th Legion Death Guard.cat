      </selectionEntry>
      <selectionEntry id="7cb3c85b-6eca-59e4-aaa2-78970f479f4d" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="3c9a856c-79d2-51bb-8504-93a050d3067b" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="499490ac-0f1b-5076-bd66-42f327ffef8c" name="Plasma Drive Overhaul" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic>
         </characteristics>
