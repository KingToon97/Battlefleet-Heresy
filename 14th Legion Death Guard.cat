      <selectionEntry id="18692956-b05d-51c6-af2c-242a3c5a6d6c" name="Deathshroud" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="88cb693c-787c-509f-a053-ccca15f82da8" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="ca182931-bcb5-5ada-8483-7bf77f0da1ee" name="Deathshroud" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">One Crew point; +2 to its boarding die. Maximum 1 per ship, and it does not count against the Terminator limit. Enemy Crew killed by this unit are not replaced by any rule, and the enemy ship loses 1 further Crew at the end of the boarding action.</characteristic>
         </characteristics>
