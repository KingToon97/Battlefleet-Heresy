     <selectionEntries>
      <selectionEntry id="3527b8df-7a12-5613-8eab-8af13f25fdce" name="Adamantium Belt Armour" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="c9d0739f-8e59-5aeb-a73b-b00b3948d829" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="102ed8d2-d237-54f5-bafa-a79ba65289fd" name="Adamantium Belt Armour" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="105.0" />
