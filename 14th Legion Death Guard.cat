      </selectionEntry>
      <selectionEntry id="ea51e790-4244-5d50-a1ef-c9c8d9695c28" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="8e455b72-0e2d-5635-b635-0ef04abb33fd" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="72aa4fc1-7b5a-5918-a39c-ac8aeffd1651" name="Plasma Drive Overhaul" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic>
         </characteristics>
        </profile>
       </profiles>
