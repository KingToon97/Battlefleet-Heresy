     </characteristics>
    </profile>
    <profile id="582706cd-af1f-543a-affd-f27ac2a9cd22" name="Astartes Crew" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Every Crew point aboard counts as Legiones Astartes (+1), free; eligible for Astartes boarding upgrades.</characteristic>
     </characteristics>
    </profile>
    <profile id="31d91157-c7f4-5c8e-b57b-f3885e3aa4d9" name="Assault Ramp" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">In a Hull Assault may commit up to full current Crew, always keeping 1 aboard.</characteristic>
     </characteristics>
    </profile>
    <profile id="9437cb3d-4ad3-5501-904d-d5c90dc565be" name="Drop Pod Launcher ×4" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
     <characteristics>
      <characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Prow</characteristic>
      <characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">—</characteristic>
      <characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">—</characteristic>
      <characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1 pod/rail</characteristic>
      <characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">18″</characteristic>
      <characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">One pod per rail. Reload (2)</characteristic>
     </characteristics>
    </profile>
    <profile id="dd523ddf-1335-58db-bdde-5ad35a099a49" name="Lance Turret ×3" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
     <characteristics>
      <characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Dorsal</characteristic>
      <characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">10</characteristic>
      <characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">1</characteristic>
      <characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1 each</characteristic>
      <characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">46″</characteristic>
      <characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Reload (1); Devastating (2)</characteristic>
     </characteristics>
    </profile>
    <profile id="1530e051-7dff-52d4-855d-ee92fcdb829e" name="Macro-Cannon Battery ×2" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
     <characteristics>
      <characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Port</characteristic>
      <characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">8</characteristic>
      <characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">3</characteristic>
      <characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">4 each</characteristic>
      <characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">30″</characteristic>
      <characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">—</characteristic>
     </characteristics>
    </profile>
    <profile id="d1383525-c14f-5b6f-b3d2-1793b1241751" name="Macro-Cannon Battery ×2" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
     <characteristics>
      <characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Starboard</characteristic>
      <characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">8</characteristic>
      <characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">3</characteristic>
      <characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">4 each</characteristic>
      <characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">30″</characteristic>
      <characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">—</characteristic>
     </characteristics>
    </profile>
    <profile id="5d5fcaab-4ed5-5c0d-b5d7-64cd3c04898f" name="Defence Battery ×6" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
     <characteristics>
      <characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">All-round</characteristic>
      <characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">6</characteristic>
      <characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">5</characteristic>
      <characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3 each</characteristic>
      <characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">12″</characteristic>
      <characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Skyfire; Interceptor. Aircraft to 12″; ships within 6″</characteristic>
     </characteristics>
    </profile>
    <profile id="84ad3d18-93be-5abb-b016-98752de06fed" name="Pattern" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Every hold given over to the landing: pods forward, bays amidships.</characteristic>
     </characteristics>
    </profile>
    <profile id="1c5af575-b104-5c66-a917-772018f9bed8" name="Launch Bays (4)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship carries 4 Launch Bays, sited on her broadsides. Each holds one aircraft squadron, bought separately. See Launch Bays &amp; Aircraft.</characteristic>
     </characteristics>
    </profile>
    <profile id="705ab3ba-4319-59f2-9b9a-7542bb2ddc70" name="Relentless Assault" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ship Type: Battle Barge. This ship's Drop Pod Launchers are not One Shot. They may be used again under their normal Reload rules.</characteristic>
     </characteristics>
    </profile>
   </profiles>
