    <profile id="558227f3-8582-5ef9-85ea-21940904b1f3" name="Pattern" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">A Lunar's broadside married to a Mars's lance batteries — a compromise that outlived the designs it borrowed from.</characteristic>
     </characteristics>
    </profile>
    <profile id="fd3a514b-c781-5ea8-b222-79a8127372ba" name="Battleline Momentum" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
