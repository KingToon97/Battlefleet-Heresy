     <selectionEntries>
      <selectionEntry id="ac699abc-5eb6-5cb2-8a07-12a53e0eef22" name="Adamantium Belt Armour" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="38af6a29-a160-58b5-8733-ae8b2b688666" shared="false" includeChildSelections="false" />
