    <profile id="49d06324-e5f4-59f7-83f8-9186558dbcf0" name="Heavy Macro-Cannon Battery ×4" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
     <characteristics>
