     <selectionEntries>
      <selectionEntry id="8d70cf5d-d90b-5510-bc56-ac299d2ca6b9" name="Adamantium Belt Armour" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="5ae6776d-6bf1-5f1f-92b4-39d7c519e575" shared="false" includeChildSelections="false" />
