      </selectionEntry>
      <selectionEntry id="b1fb1b47-cb14-543d-adb3-4fac823c163f" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="f7d0ec30-1b79-5b10-b8d5-bb6f06157b3b" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="8dc20fe0-ebf7-54cf-88aa-9d75c199bf7d" name="Plasma Drive Overhaul" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="65.0" />
