         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Character. Destroyer Hive: At the end of a boarding action this ship initiated and won, roll a D6: on a 4+ the enemy suffers 1 additional Crew casualty.</characteristic>
         </characteristics>
        </profile>
