      <profile id="e5fbeb24-7df5-5a45-8915-c8fe54488c1b" name="Torpedo Tube" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
       <characteristics>
        <characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Prow</characteristic>
        <characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">9</characteristic>
        <characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">2</characteristic>
        <characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1</characteristic>
        <characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">60″</characteristic>
        <characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">One torpedo per tube. Bypasses Void Shields; Armourbane; Reload (2)</characteristic>
       </characteristics>
      </profile>
      <profile id="5629a569-95e9-5e2d-83cb-6d0374dfc647" name="Macro-Cannon Battery" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
       <characteristics>
        <characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Port</characteristic>
        <characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">8</characteristic>
        <characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">3</characteristic>
        <characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">4</characteristic>
        <characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">30″</characteristic>
        <characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">—</characteristic>
       </characteristics>
      </profile>
      <profile id="568c6ca8-44bf-5b64-a727-0991f9431244" name="Macro-Cannon Battery" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
       <characteristics>
        <characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Starboard</characteristic>
        <characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">8</characteristic>
        <characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">3</characteristic>
        <characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">4</characteristic>
        <characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">30″</characteristic>
        <characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">—</characteristic>
       </characteristics>
      </profile>
      <profile id="5cf8b81e-ebbd-55f6-9753-aa1e45333f49" name="Melta Mine Layer" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
       <characteristics>
        <characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Stern</characteristic>
        <characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">9</characteristic>
        <characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">2</characteristic>
        <characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1</characteristic>
        <characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">3″ blast</characteristic>
        <characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Armourbane. Carries 2 mines; Reload (2). Laid on a 32mm base instead of shooting. Triggers when any part of a non-Frigate ship passes over it: every ship within 3″ — including the ship that triggered it — suffers one hit resolved against its Armour. Aircraft pass over mines safely. Remove the mine once the attack is resolved.</characteristic>
       </characteristics>
      </profile>
      <profile id="d3f28e9a-e51d-5088-bb49-0265f71515f3" name="Defence Battery ×2" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
       <characteristics>
        <characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">All-round</characteristic>
        <characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">6</characteristic>
        <characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">5</characteristic>
        <characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3 each</characteristic>
        <characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">12″</characteristic>
        <characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Skyfire; Interceptor. Aircraft to 12″; ships within 6″</characteristic>
       </characteristics>
      </profile>
      <profile id="a3dd9a76-0119-5df1-92b3-4f5ee0345507" name="Pattern" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
       <characteristics>
        <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Stripped for the torpedo run, screening guns cut to the bone.</characteristic>
       </characteristics>
      </profile>
      <profile id="29c18c2d-0085-5a57-8f7a-f2a947872b2f" name="Screen" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
       <characteristics>
        <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ship Type: Frigate. Enemy ships suffer −1 BS when targeting a friendly Capital Ship within 3″ of one or more friendly Frigates. Screen protects only Capital Ships, never the Frigate itself, and multiple instances never stack — the maximum is −1 BS.</characteristic>
       </characteristics>
      </profile>
     </profiles>
