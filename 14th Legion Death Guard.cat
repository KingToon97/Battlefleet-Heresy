         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This character is embarked as the Primarch's additional named retinue. They do not add Fleet Orders or any command ability; only effects unrelated to the order economy apply.</characteristic>
         </characteristics>
        </profile>
       </profiles>
