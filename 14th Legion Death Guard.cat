     <selectionEntries>
      <selectionEntry id="67926709-43f7-577f-9ad0-f649fa7acd07" name="Adamantium Belt Armour" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="0ab06d30-9fd9-5c29-bf12-c75f518188ab" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="ece6a584-ba68-5e18-9dd9-04fb4ee064fc" name="Adamantium Belt Armour" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="85.0" />
       </costs>
      </selectionEntry>
      <selectionEntry id="2178594b-ee35-5b61-b9d8-4c3fd0de2e4a" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="57a33ab0-1e49-50ab-8e94-7f7dd8717a45" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="d556c007-0c1f-51a1-aa0d-f8fecb97da1e" name="Plasma Drive Overhaul" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="50.0" />
