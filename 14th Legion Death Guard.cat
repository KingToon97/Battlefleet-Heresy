     <selectionEntries>
      <selectionEntry id="62dea316-d036-509b-8a04-699ccc17af40" name="Adamantium Belt Armour" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="5f5094e7-1a42-5ab3-bb25-9e16a8c6c426" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="e1a2fd1c-9fae-5413-8e80-10b8d8bd5270" name="Adamantium Belt Armour" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="65.0" />
       </costs>
      </selectionEntry>
      <selectionEntry id="1bde20ce-e86f-5838-a4fa-3f0645709797" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="6d521bf6-2975-5bb0-9ef0-bd324991ca0b" shared="false" includeChildSelections="false" />
