      <characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">One torpedo per tube. Bypasses Void Shields; Armourbane; Reload (2)</characteristic>
     </characteristics>
    </profile>
    <profile id="a696dcd7-4b90-5d3d-91b1-38dcd1abc8f6" name="Twin Lance Turret ×3" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
