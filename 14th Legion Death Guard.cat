       </constraints>
       <profiles>
        <profile id="0e4a3dc2-7ca3-5780-9c9b-a0b5e6892b5f" name="Deathshroud" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">One Crew point; +2 to its boarding die. Maximum 1 per ship, and it does not count against the Terminator limit. Enemy Crew killed by this unit are not replaced by any rule, and the enemy ship loses 1 further Crew at the end of the boarding action.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <categoryLinks>
        <categoryLink id="f7dbac44-575f-5fb7-b523-a89bfccbfaa2" name="Boarding Force" hidden="false" targetId="4d94b920-d5bc-5fd7-a967-4ba346019f56" primary="true" />
