      </selectionEntry>
      <selectionEntry id="9bd96291-4261-5bc6-9f32-0dddfc56e05c" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="62b19e92-5817-5df7-871b-7570fc0ccddd" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="2a5a812f-0c16-50d4-88f0-300ecb8cf36c" name="Plasma Drive Overhaul" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic>
         </characteristics>
        </profile>
       </profiles>
