      </selectionEntry>
      <selectionEntry id="5f874521-4596-509c-a490-66763befaa3e" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="4b5af949-f6ea-5286-ace9-f91122bd46b0" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="6c276fd2-3614-5b82-a9e6-a0cdf9390764" name="Plasma Drive Overhaul" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="30.0" />
