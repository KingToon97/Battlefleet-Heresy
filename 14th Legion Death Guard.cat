       <selectionEntries>
        <selectionEntry id="ae1921f8-e0a4-50b4-91e5-3d6a14e5525c" name="Veteran Crew" hidden="false" collective="false" import="true" type="upgrade">
         <constraints>
          <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="6a0c9a54-9ab7-5ce0-ab1c-883cbc7dd105" percentValue="false" includeChildSelections="false" includeChildForces="false" />
