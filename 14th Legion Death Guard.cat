      </selectionEntry>
      <selectionEntry id="ae51dd5d-ba9c-5fb2-af92-7af517a8c103" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="fa6d0b45-10ee-5b8b-988b-2b6188357220" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="61ab17ef-6122-5a84-829e-a0d083ec649b" name="Plasma Drive Overhaul" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="30.0" />
