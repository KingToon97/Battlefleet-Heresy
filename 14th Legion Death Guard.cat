        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="80.0" />
       </costs>
      </selectionEntry>
      <selectionEntry id="808af4a7-67fa-5468-82bb-1a982a82ec98" name="Deathshroud" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="c066bbf1-a2b6-5a81-9f4b-016dc7722ff0" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="9c765405-f44e-5581-afc9-b5aef15b9b9f" name="Deathshroud" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">One Crew point; +2 to its boarding die. Maximum 1 per ship, and it does not count against the Terminator limit. Enemy Crew killed by this unit are not replaced by any rule, and the enemy ship loses 1 further Crew at the end of the boarding action.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <categoryLinks>
        <categoryLink id="dc60a679-5e3a-5945-8aff-908106edb1f9" name="Boarding Force" hidden="false" targetId="4d94b920-d5bc-5fd7-a967-4ba346019f56" primary="true" />
       </categoryLinks>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="80.0" />
       </costs>
      </selectionEntry>
     </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="6fcaed05-6884-5344-b28a-b3c1624a34cb" name="Hull Upgrades" hidden="false">
     <constraints>
      <constraint type="max" value="6.0" field="selections" scope="parent" shared="false" id="05c49e8a-b580-5cc2-862a-c99a2d2e82c2" percentValue="false" includeChildSelections="false" includeChildForces="false" />
     </constraints>
     <selectionEntries>
      <selectionEntry id="59c84ee3-0c3f-5d90-9da6-0a6866d4292b" name="Adamantium Belt Armour" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="3662287f-e517-5df8-9b60-ff96678bd9e7" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="03892186-2ad5-5a15-8ade-ee9a2ae5ce23" name="Adamantium Belt Armour" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="75.0" />
       </costs>
      </selectionEntry>
      <selectionEntry id="05f96282-d8b7-59fa-885d-f2bf72fbfd30" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="042a9227-8232-54b8-8f74-f4931236ddb6" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="49d643ca-e634-5b6f-b83c-433a56209d83" name="Plasma Drive Overhaul" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="45.0" />
       </costs>
      </selectionEntry>
      <selectionEntry id="c37a11dc-6e98-5120-ae1d-16ad429626d1" name="Phosphex Shell Magazines" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="878b3234-ff22-55f7-83ac-d50edfcb2fca" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="04b8b953-1ab0-51d7-8710-7883a4bb2b91" name="Phosphex Shell Magazines" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Every Heavy Macro-Cannon Battery aboard fires phosphex: whenever one penetrates armour, the target takes 1 Critical Damage. Requires at least one Heavy Macro-Cannon Battery. Every Death Guard Capital Ship carries Phosphex Shell Magazines free of charge.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="30.0" />
       </costs>
      </selectionEntry>
      <selectionEntry id="447fdae4-4a60-5b11-9780-7dd1a8ddbcb9" name="Blast-Shielded Magazines" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="0e1a9357-fedd-51c3-881e-abea60d0d288" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="c5d52222-0f22-5b93-9350-8c9ab0359cf0" name="Blast-Shielded Magazines" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Damage Control caused by a Magazine Explosion by 1, to a minimum of 0. A Twin Lance Turret that would suffer 1 Damage Control instead suffers 0 and ignores the effect; a Triple Lance Turret that would suffer 2 instead suffers 1. No other effect of a Magazine Explosion is prevented or reduced. Once per ship. Not available to Gloriana class or above.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="30.0" />
       </costs>
      </selectionEntry>
      <selectionEntry id="0defaa9a-3742-58a1-b9c4-3d91ded33eba" name="Emergency Shield Capacitors" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="4896eaf3-f5aa-50d4-b86f-bba55149fa28" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="ab9fd220-143f-5ddc-a02e-a20cef721ba9" name="Emergency Shield Capacitors" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Re-roll failed Void Shield regeneration rolls. It confers no other benefit and can never raise a ship above its normal number of Void Shields; a shield burnt out after a failed re-roll stays burnt out for the rest of the battle. Once per ship.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="35.0" />
       </costs>
      </selectionEntry>
      <selectionEntry id="7db464c9-df98-5d1f-afee-6c250cec9138" name="Servitor Autoloaders" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="f01dd3af-7c3b-5960-a865-a8cca83dee03" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="b239e094-1de6-5053-82c7-d1e5477da42f" name="Servitor Autoloaders" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose one weapon type aboard this ship when you buy this upgrade and note it on the roster. That weapon type reduces its Reload value by 1, to a minimum of Reload (0) — Reload (3) becomes Reload (2), Reload (2) becomes Reload (1). A weapon at Reload (1) already fires every battle round and gains nothing. Once per ship. Not available to Gloriana class or above.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="75.0" />
       </costs>
      </selectionEntry>
     </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Drop Pod Loadout" id="410bb1d1-9674-59dd-a224-40c864913a58" hidden="false" collective="false" import="true">
     <constraints>
      <constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="6c539570-2fa0-5f1e-aa14-993519ec0bd9" percentValue="false" includeChildSelections="false" includeChildForces="false" />
     </constraints>
     <selectionEntries>
      <selectionEntry id="d9c45344-f76c-5b3d-8ad4-b4a21d417453" name="Dreadclaw Drop Pod" hidden="false" collective="false" import="true" type="upgrade">
       <profiles>
        <profile id="4efb7323-4a57-566d-967b-96522037e01a" name="Dreadclaw Drop Pod" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding pod, Armour 8, Speed 30″/round. Takes 1 rail. Launched at a target within 18″, striking the same turn. One Shot. Counts as aircraft and may be intercepted; a surviving pod locks on 2+, and on a failure is destroyed with all aboard. Delivers 1 Crew of boarders (+1 in the first round). Removed from play after its run.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" />
       </costs>
      </selectionEntry>
      <selectionEntry id="92df1583-cf7c-587d-8e2c-2e7d6b3444e8" name="Kharybdis Assault Claw" hidden="false" collective="false" import="true" type="upgrade">
       <profiles>
        <profile id="c05fb38f-f3d8-5852-8329-0e449f137a88" name="Kharybdis Assault Claw" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding pod, Armour 9, Speed 30″/round. Takes 2 rails and locks automatically — melta cutters breach any hull — delivering 2 Crew of boarders (a Dreadnought filling both places). One Shot: removed from play after its run.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" />
       </costs>
      </selectionEntry>
     </selectionEntries>
    </selectionEntryGroup>
   </selectionEntryGroups>
   <costs>
    <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="365.0" />
   </costs>
  </selectionEntry>
