      <profile id="11d38045-2401-5b50-be81-5bde70d99c90" name="Pattern" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
       <characteristics>
        <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">A gunnery refit that trades the torpedo tube for a heavier screen.</characteristic>
       </characteristics>
