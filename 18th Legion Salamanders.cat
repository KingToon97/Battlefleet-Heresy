    <profile id="50c569ec-ca93-5199-8471-d2ca630153e9" name="Pattern" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">A broadside grand cruiser, everything given over to weight of fire.</characteristic>
     </characteristics>
    </profile>
    <profile id="13cb11b5-0329-5eb7-b351-b884f1f71efa" name="Broadside" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ship Pattern: Avenger-class. Broadside: when firing at &lt;b&gt;Point Blank range&lt;/b&gt; through its Port or Starboard arc, each Macro-Cannon or Heavy Macro-Cannon Battery firing through that arc gains &lt;b&gt;+1 shot&lt;/b&gt;.</characteristic>
     </characteristics>
    </profile>
    <profile id="9a84c71e-df05-5d8f-b1bd-c52298e221dd" name="Defence Batteries (6)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship mounts 6 Defence Batteries. They fire only in answer to the Overwatch Fleet Order, at Strength 6, destroying one incoming craft on each 5+. See Defence Batteries.</characteristic>
     </characteristics>
    </profile>
