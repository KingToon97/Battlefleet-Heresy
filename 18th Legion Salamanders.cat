       <constraints>
        <constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="85736b8f-1967-5837-b7f5-ec25ede34fcb" percentValue="false" includeChildSelections="false" includeChildForces="false" />
        <constraint type="max" value="7.0" field="selections" scope="parent" shared="false" id="18733e63-f403-5163-a6f6-99e6e9c3dd1a" percentValue="false" includeChildSelections="false" includeChildForces="false" />
