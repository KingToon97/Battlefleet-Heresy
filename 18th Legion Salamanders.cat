      <profile id="bb4e0fba-11b5-58bf-8c53-a8833412751e" name="Pattern" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
       <characteristics>
        <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">The Navy's torpedo boat, and the pattern every other destroyer is measured against.</characteristic>
       </characteristics>
      </profile>
      <profile id="5e12c7e7-da3e-56ba-972b-fd44876e9d27" name="Wolf Pack" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
       <characteristics>
        <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ship Pattern: Cobra-class. Wolf Pack: &lt;b&gt;+1 to Armour Penetration rolls&lt;/b&gt; against an enemy ship that is already the target of another friendly Destroyer or Frigate this battle round. Any friendly Destroyer or Frigate counts, whatever squadron it belongs to, and the bonus applies once — it does not increase with the number of ships attacking.</characteristic>
       </characteristics>
      </profile>
      <profile id="d9a232c3-4949-5717-b70f-f8f647e51f05" name="Defence Batteries (1)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
       <characteristics>
        <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship mounts 1 Defence Batteries. They fire only in answer to the Overwatch Fleet Order, at Strength 6, destroying one incoming craft on each 5+. See Defence Batteries.</characteristic>
       </characteristics>
      </profile>
     </profiles>
