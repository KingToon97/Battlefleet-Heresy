      <profile id="a1d05ac3-7fec-5be9-82b0-e773cb6f3262" name="Pattern" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
       <characteristics>
        <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">The workhorse escort of the Imperial Navy, all broadside and endurance.</characteristic>
       </characteristics>
      </profile>
      <profile id="8f807e64-c2dd-5f88-b6e0-fa6cf0dd94d1" name="Escort Squadron" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
       <characteristics>
        <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ship Pattern: Sword-class. Escort Squadron: while this squadron contains &lt;b&gt;at least two Sword-class Frigates&lt;/b&gt;, each Sword in it may &lt;b&gt;re-roll one failed Macro-Cannon hit roll&lt;/b&gt; each time it shoots. One re-roll per Sword per shooting activation.</characteristic>
       </characteristics>
      </profile>
      <profile id="afd3d6bb-b193-5937-94a1-037d6fd54c5b" name="Defence Batteries (2)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
       <characteristics>
        <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship mounts 2 Defence Batteries. They fire only in answer to the Overwatch Fleet Order, at Strength 6, destroying one incoming craft on each 5+. See Defence Batteries.</characteristic>
       </characteristics>
      </profile>
     </profiles>
