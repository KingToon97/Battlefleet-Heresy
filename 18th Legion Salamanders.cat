         <selectionEntries>
          <selectionEntry id="a1f1ef46-9f27-5d0d-a445-dfd2c8909f05" name="Fleet Captain" hidden="false" collective="false" import="true" type="upgrade">
           <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="b16a74df-8549-535d-a790-592282eb5b44" type="max" />
           </constraints>
           <profiles>
            <profile id="11439c25-a3b0-5370-91f7-bf1dc5373ade" name="Fleet Captain" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
             <characteristics>
              <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Fleet Captain. See Characters &amp; Primarchs.</characteristic>
             </characteristics>
            </profile>
           </profiles>
           <categoryLinks>
            <categoryLink id="370b5e40-95ac-58bf-aced-70620b754e4f" name="Commander" hidden="false" targetId="6f3339ad-23a9-5687-b08f-3f11a43fe50b" primary="true" />
           </categoryLinks>
           <costs>
            <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" />
           </costs>
          </selectionEntry>
          <selectionEntry id="766af748-e505-599f-8a96-9634c4df7d5a" name="Artellus Numeon" hidden="false" collective="false" import="true" type="upgrade">
           <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="51cef486-bf6a-5c31-a78f-329bf5273d53" type="max" />
           </constraints>
           <profiles>
            <profile id="751f2c55-0c53-57e7-9feb-2bb161f53652" name="Artellus Numeon" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
             <characteristics>
              <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Character. Through Fire Unscathed: friendly Salamanders ships within &lt;b&gt;12″ of an enemy ship&lt;/b&gt; may re-roll failed Evade rolls. Fleet-wide. This does not enable, disable or modify Flame in any way.</characteristic>
             </characteristics>
            </profile>
           </profiles>
           <categoryLinks>
            <categoryLink id="e017a8d9-b315-511f-a31a-f1ebf110c05a" name="Commander" hidden="false" targetId="6f3339ad-23a9-5687-b08f-3f11a43fe50b" primary="true" />
           </categoryLinks>
           <costs>
            <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="155.0" />
           </costs>
          </selectionEntry>
          <selectionEntry id="851b0a1f-177b-556c-ad75-6235367b2ae2" name="Nomus Rhy’tan" hidden="false" collective="false" import="true" type="upgrade">
           <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7ff759c2-c8b9-55bd-a8aa-a52a3a3eb861" type="max" />
           </constraints>
           <profiles>
            <profile id="cb0288d9-b7f2-508b-85fc-87dbacfce302" name="Nomus Rhy’tan" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
             <characteristics>
              <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Character. Purging Broadside: friendly Salamanders ships trigger &lt;b&gt;Flame on a 3+&lt;/b&gt; rather than 4+. Fleet-wide. No weapon profile changes and a successful Flame roll still costs the target 1 Crew — Nomus only makes it more reliable.</characteristic>
             </characteristics>
            </profile>
           </profiles>
           <categoryLinks>
            <categoryLink id="a7efbb5f-3800-5ad9-96c8-2c0d9048ac46" name="Commander" hidden="false" targetId="6f3339ad-23a9-5687-b08f-3f11a43fe50b" primary="true" />
           </categoryLinks>
           <costs>
            <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="175.0" />
           </costs>
          </selectionEntry>
         </selectionEntries>
        </selectionEntryGroup>
       </selectionEntryGroups>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" />
       </costs>
      </selectionEntry>
     </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Crew Upgrade" id="8e1747bc-b64c-52ed-a427-6c2c316a7a5c" hidden="false" collective="false" import="true">
     <constraints>
      <constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="d6ed9fab-2665-5a8f-a1a3-ea6ee3f16ae8" percentValue="false" includeChildSelections="false" includeChildForces="false" />
     </constraints>
     <selectionEntries>
      <selectionEntry id="09125fac-af95-50fb-b990-b228f4a298e3" name="Veteran Crew" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="e15f503d-a475-5f0b-98eb-4aa800df66f7" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="80451814-b3af-589e-9893-eb2359f9979f" name="Veteran Crew" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Once per ship. +1 BS, to maximum BS 5.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <categoryLinks>
        <categoryLink id="5a96db64-adb4-5ca4-be8e-3253c4310814" name="Upgrade" hidden="false" targetId="7610de76-9ef1-58ab-9c7b-f97ede66e61d" primary="true" />
       </categoryLinks>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="100.0" />
       </costs>
      </selectionEntry>
      <selectionEntry id="bdf74203-acb1-55f4-92f1-dad194a73d35" name="Astartes Crew" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="25c85e3e-bc5f-515c-8b26-4054ae58f9cd" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="d3754aba-a462-54fa-97bd-666e36947cd8" name="Astartes Crew" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">The ship's entire complement is replaced by Legion Astartes. &lt;b&gt;Every Crew point aboard counts as Legiones Astartes (+1)&lt;/b&gt; when it fights, in attack and in defence alike, and the ship becomes eligible for Astartes boarding upgrades. It costs &lt;b&gt;20% of the ship's own points value&lt;/b&gt;, rounded to the nearest 5. Once per ship. Strike Cruisers, Battle Barges and Gloriana class vessels already carry Astartes Crew and may not buy it again.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="80.0" />
       </costs>
      </selectionEntry>
     </selectionEntries>
    </selectionEntryGroup>
