           <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0222e3fd-0a14-57cc-b342-d5b7c0f237cb" type="max" />
           </constraints>
           <profiles>
            <profile id="fbf16b14-a8f2-5435-ac26-aa248b07fff7" name="Fleet Captain" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
             <characteristics>
              <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Fleet Captain. See Characters &amp; Primarchs.</characteristic>
             </characteristics>
            </profile>
           </profiles>
           <categoryLinks>
            <categoryLink id="ee20d1b2-29fd-590c-bdf2-b9b87316fde1" name="Commander" hidden="false" targetId="6f3339ad-23a9-5687-b08f-3f11a43fe50b" primary="true" />
