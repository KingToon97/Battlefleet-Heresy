       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="65.0" />
       </costs>
      </selectionEntry>
      <selectionEntry id="5653e150-fe4c-5088-9241-0a255344766c" name="Contemptor Dreadnought" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="60593145-8c94-5625-b9a0-efdef49f48f5" percentValue="false" includeChildSelections="false" includeChildForces="false" />
        <constraint type="max" value="8.0" field="selections" scope="parent" shared="false" id="f4053db1-1504-5955-a70e-d54298caf213" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="129605be-80cf-558e-96dc-762728d98e7b" name="Boarding Force" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Counts as 2 Boarding Parties; fights as one warrior at +2 and gives −1 to the enemy die it faces. Limits as Terminators.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <categoryLinks>
        <categoryLink id="e205d04c-866c-5765-8959-97c67277d238" name="Boarding Force" hidden="false" targetId="4d94b920-d5bc-5fd7-a967-4ba346019f56" primary="true" />
       </categoryLinks>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="80.0" />
