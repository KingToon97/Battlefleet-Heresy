    <profile id="285d1940-be80-5768-9e11-ee044619d17c" name="Pattern" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">A Lunar's broadside married to a Mars's lance batteries — a compromise that outlived the designs it borrowed from.</characteristic>
     </characteristics>
    </profile>
    <profile id="9c32631d-9fe7-5b26-b38d-9ef3d5954491" name="Battleline Momentum" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ship Pattern: Armageddon-class. Battleline Momentum: this ship may &lt;b&gt;fire normally while under All Ahead Full&lt;/b&gt;, ignoring the restriction that would otherwise stop it shooting, and it may &lt;b&gt;declare a Ram in the same activation&lt;/b&gt;.</characteristic>
     </characteristics>
    </profile>
    <profile id="689fdaf3-2819-5372-8ae9-463966313e44" name="Defence Batteries (5)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship mounts 5 Defence Batteries. They fire only in answer to the Overwatch Fleet Order, at Strength 6, destroying one incoming craft on each 5+. See Defence Batteries.</characteristic>
     </characteristics>
    </profile>
   </profiles>
