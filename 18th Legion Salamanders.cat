   <selectionEntryGroups>
    <selectionEntryGroup name="Crew Upgrade" id="821c503f-7ae1-5274-83a9-0f731c6f3fab" hidden="false" collective="false" import="true">
     <constraints>
      <constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="f4305307-36d3-539e-86a0-8254d955b611" percentValue="false" includeChildSelections="false" includeChildForces="false" />
     </constraints>
     <selectionEntries>
      <selectionEntry id="ce5a22cb-298b-50bc-b080-cfd0355efca2" name="Veteran Crew" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="57027ed1-d59a-5fb2-a03e-107ccf6a1cdb" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="357227a4-5a4a-5f00-9d05-783481170a08" name="Veteran Crew" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Once per ship. +1 BS, to maximum BS 5.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <categoryLinks>
        <categoryLink id="e5211ef7-2652-5a57-be4c-85c47bcaa34c" name="Upgrade" hidden="false" targetId="7610de76-9ef1-58ab-9c7b-f97ede66e61d" primary="true" />
       </categoryLinks>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="65.0" />
       </costs>
      </selectionEntry>
      <selectionEntry id="ee2dac3b-680b-5dcd-832d-6f8fcbdc7c5f" name="Astartes Crew" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="d5330d60-2efe-574f-b5a7-c10094459b9e" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="44ae4e20-df8a-51d4-b03e-f1928468f036" name="Astartes Crew" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">The ship's entire complement is replaced by Legion Astartes. &lt;b&gt;Every Crew point aboard counts as Legiones Astartes (+1)&lt;/b&gt; when it fights, in attack and in defence alike, and the ship becomes eligible for Astartes boarding upgrades. It costs &lt;b&gt;20% of the ship's own points value&lt;/b&gt;, rounded to the nearest 5. Once per ship. Strike Cruisers, Battle Barges and Gloriana class vessels already carry Astartes Crew and may not buy it again.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="50.0" />
       </costs>
      </selectionEntry>
     </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="c733fd3d-2770-593b-b2e1-6c743991ec08" name="Hull Upgrades" hidden="false">
     <constraints>
      <constraint type="max" value="6.0" field="selections" scope="parent" shared="false" id="f07881f9-158a-5a95-ad9c-02836f05ffd1" percentValue="false" includeChildSelections="false" includeChildForces="false" />
     </constraints>
     <selectionEntries>
      <selectionEntry id="89077d54-14bc-5376-892f-33842bb3055b" name="Adamantium Belt Armour" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="8d75a7b4-4fe9-53d8-bb78-a2a84a4e137c" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="e613b4cf-7ee6-5eae-86e3-288c3684eb6d" name="Adamantium Belt Armour" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="50.0" />
       </costs>
      </selectionEntry>
      <selectionEntry id="365fe7b5-57b2-5f38-b651-ae7ae003645b" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="22cf1efb-a31e-592e-949d-caf1afaff89c" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="20867154-0aa3-55f6-9b44-3b6ee9b93412" name="Plasma Drive Overhaul" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="30.0" />
       </costs>
      </selectionEntry>
      <selectionEntry id="e5218cc0-c5f5-59ed-a187-d647a2f9cb1c" name="Phosphex Shell Magazines" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="326c38b2-9eff-5150-b112-c227801aee7c" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="9ed21302-044b-5b2a-88a7-0bac512fff43" name="Phosphex Shell Magazines" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Every Heavy Macro-Cannon Battery aboard fires phosphex: whenever one &lt;b&gt;penetrates armour&lt;/b&gt;, the target loses &lt;b&gt;1 Crew&lt;/b&gt; in addition to the Hull Points the hit inflicts. Requires at least one Heavy Macro-Cannon Battery. Every Death Guard Capital Ship carries Phosphex Shell Magazines free of charge.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="40.0" />
       </costs>
      </selectionEntry>
      <selectionEntry id="736f913b-2218-51b2-a0d3-e89877aa2c89" name="Emergency Shield Capacitors" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="9d4ee7b7-f0ff-549c-87e7-d61e0b61d5d4" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="3956b731-c9f8-53e1-be5e-e4f7b27dbeec" name="Emergency Shield Capacitors" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 to Void Shield regeneration rolls. It confers no other benefit and can never raise a ship above its normal number of Void Shields; a shield burnt out despite the bonus stays burnt out for the rest of the battle. Once per ship.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="25.0" />
       </costs>
      </selectionEntry>
     </selectionEntries>
    </selectionEntryGroup>
   </selectionEntryGroups>
   <costs>
    <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="255.0" />
   </costs>
  </selectionEntry>
