          <selectionEntry id="80800ac8-c10a-5f89-8658-0f9fc81fd10b" name="Artellus Numeon" hidden="false" collective="false" import="true" type="upgrade">
           <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="fe1318e3-724b-527f-b7ed-cd9e6c8b354d" type="max" />
           </constraints>
           <profiles>
            <profile id="4d893b8a-b3db-5e60-b47c-447fce7726bf" name="Artellus Numeon" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
             <characteristics>
              <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Character. Through Fire Unscathed: friendly Salamanders ships within &lt;b&gt;12″ of an enemy ship&lt;/b&gt; may re-roll failed Evade rolls. Fleet-wide. This does not enable, disable or modify Flame in any way.</characteristic>
             </characteristics>
            </profile>
           </profiles>
           <categoryLinks>
            <categoryLink id="2465f5ca-c8fe-5113-a1b5-87fca3ce0b42" name="Commander" hidden="false" targetId="6f3339ad-23a9-5687-b08f-3f11a43fe50b" primary="true" />
           </categoryLinks>
           <costs>
            <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="155.0" />
           </costs>
          </selectionEntry>
          <selectionEntry id="1b1f21c3-fff8-5d7f-a5b9-78ef007b7ef6" name="Nomus Rhy’tan" hidden="false" collective="false" import="true" type="upgrade">
           <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f497bed9-5bf7-59ed-8492-b42ca9457f56" type="max" />
           </constraints>
           <profiles>
            <profile id="9a885aa0-6a7b-5566-83c5-9a461fc34f01" name="Nomus Rhy’tan" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
             <characteristics>
              <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Character. Purging Broadside: friendly Salamanders ships trigger &lt;b&gt;Flame on a 3+&lt;/b&gt; rather than 4+. Fleet-wide. No weapon profile changes and a successful Flame roll still costs the target 1 Crew — Nomus only makes it more reliable.</characteristic>
             </characteristics>
            </profile>
           </profiles>
           <categoryLinks>
            <categoryLink id="195c33fb-00cd-5d24-9b1d-3d424c802d46" name="Commander" hidden="false" targetId="6f3339ad-23a9-5687-b08f-3f11a43fe50b" primary="true" />
           </categoryLinks>
           <costs>
            <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="175.0" />
           </costs>
          </selectionEntry>
         </selectionEntries>
        </selectionEntryGroup>
       </selectionEntryGroups>
