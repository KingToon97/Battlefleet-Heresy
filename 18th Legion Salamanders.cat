        <characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Reload (1); Devastating (2)</characteristic>
       </characteristics>
      </profile>
      <profile id="ce96283e-0599-5eb1-8739-eae418342603" name="Screen" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
       <characteristics>
        <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ship Pattern: Firestorm-class. Screen: enemy ships suffer &lt;b&gt;−1 BS&lt;/b&gt; when targeting a friendly Capital Ship within &lt;b&gt;3″&lt;/b&gt; of this ship. Non-cumulative: several screening Firestorms do not stack.</characteristic>
       </characteristics>
      </profile>
      <profile id="f44ed2c6-219f-5281-b0f0-fceaf032e65f" name="Defence Batteries (2)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
       <characteristics>
        <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship mounts 2 Defence Batteries. They fire only in answer to the Overwatch Fleet Order, at Strength 6, destroying one incoming craft on each 5+. See Defence Batteries.</characteristic>
       </characteristics>
      </profile>
     </profiles>
