   </constraints>
   <profiles>
    <profile id="70de4018-d8d1-516a-917c-c11ff9e93609" name="Strike Cruiser - Vanguard pattern" hidden="false" typeId="806f9ff1-fd51-5ddb-b005-ce73a5d09d65" typeName="Ship">
