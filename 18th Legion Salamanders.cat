        <constraint type="max" value="10.0" field="selections" scope="parent" shared="false" id="f7c02e61-59ff-5dd2-963f-af1bfa77962b" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="e3251747-3aea-53e3-8e54-d9538c9d85cc" name="Boarding Force" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Counts as 2 Boarding Parties; fights as one warrior at +2 and gives −1 to the enemy die it faces. Limits as Terminators.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <categoryLinks>
        <categoryLink id="26cf4eae-0174-5c59-860d-188ee6ba3067" name="Boarding Force" hidden="false" targetId="4d94b920-d5bc-5fd7-a967-4ba346019f56" primary="true" />
       </categoryLinks>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="80.0" />
       </costs>
      </selectionEntry>
      <selectionEntry id="4323c48e-a843-5b50-a5ee-a2cf1c0cd8a1" name="Firedrake Terminators" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="e76d959c-c855-5ab7-b33c-e8689408fc58" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="6e334e81-0114-557b-b970-8d465abf2eb1" name="Firedrake Terminators" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">One Boarding Party. Children of the Forge: &lt;b&gt;+1&lt;/b&gt; to its Boarding rolls, and an &lt;b&gt;unmodified successful roll of 5+&lt;/b&gt; inflicts &lt;b&gt;2 Crew casualties instead of 1&lt;/b&gt;. Other successful rolls inflict the normal single casualty. Salamanders Battleships and the Flamewrought only. Maximum 1 per ship, and it does not count against the Terminator limit.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <categoryLinks>
        <categoryLink id="40837f38-f006-5e02-9322-00eafcec096c" name="Boarding Force" hidden="false" targetId="4d94b920-d5bc-5fd7-a967-4ba346019f56" primary="true" />
       </categoryLinks>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="80.0" />
       </costs>
      </selectionEntry>
     </selectionEntries>
    </selectionEntryGroup>
