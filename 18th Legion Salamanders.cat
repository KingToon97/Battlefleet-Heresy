     <selectionEntries>
      <selectionEntry id="0f3fa0a7-34ac-5beb-9d3e-1b31c35e6e04" name="Fury Interceptor Squadron" hidden="false" collective="false" import="true" type="unit">
       <constraints>
        <constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="4ef92cef-fed6-5e4e-80f9-b098d9b7bdd9" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="23ff25ab-d27b-599d-858b-6e29ea66e9d9" name="Fury Interceptor" hidden="false" typeId="34b870bf-d65e-538e-b38c-9249374e6af1" typeName="Aircraft">
         <characteristics>
