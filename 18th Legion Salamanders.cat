            <profile id="b337fd92-71dd-5cd7-ac3d-ccd67e162d34" name="Artellus Numeon" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
             <characteristics>
              <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Character. Through Fire Unscathed: friendly Salamanders ships within &lt;b&gt;12″ of an enemy ship&lt;/b&gt; may re-roll failed Evade rolls. Fleet-wide. This does not enable, disable or modify Flame in any way.</characteristic>
