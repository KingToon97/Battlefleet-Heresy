    <profile id="1a348a5e-23ec-5900-9b7f-60b9086ca3d5" name="Master Artisans" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Drakefire Macro-Cannons aboard gain +1 on the Damage Table. Launch Bays (4).</characteristic>
     </characteristics>
    </profile>
    <profile id="19624b1f-aa30-5636-bbfb-6a6552fbd5a9" name="Drakefire Macro-Cannon ×6" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
