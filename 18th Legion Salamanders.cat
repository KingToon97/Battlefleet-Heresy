     <selectionEntryGroups>
      <selectionEntryGroup name="Crew Upgrade" id="11dfc52c-bdc7-527e-9def-292d5f298c4c" hidden="false" collective="false" import="true">
       <constraints>
        <constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="2e5e8b82-284b-5685-b34b-38646dde2788" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <selectionEntries>
        <selectionEntry id="83b91519-db22-568a-a8e8-03386721d013" name="Veteran Crew" hidden="false" collective="false" import="true" type="upgrade">
         <constraints>
          <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="32c5b191-b3e8-56c3-b132-a3408f81e026" percentValue="false" includeChildSelections="false" includeChildForces="false" />
         </constraints>
         <profiles>
          <profile id="629825fc-aff5-5d27-a58c-3d032fd0ea30" name="Veteran Crew" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
           <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Once per ship. +1 BS, to maximum BS 5.</characteristic>
           </characteristics>
          </profile>
         </profiles>
         <costs>
          <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="30.0" />
         </costs>
        </selectionEntry>
        <selectionEntry id="c3ccb433-2394-5c2a-9905-6bd6dd912026" name="Astartes Crew" hidden="false" collective="false" import="true" type="upgrade">
         <constraints>
          <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="5b0ece8b-5eef-5a14-bf4a-0f5890045c5c" percentValue="false" includeChildSelections="false" includeChildForces="false" />
         </constraints>
         <profiles>
          <profile id="87ed71f6-08f8-50e3-b8b5-3ce9654d323d" name="Astartes Crew" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
           <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">The ship's entire complement is replaced by Legion Astartes. &lt;b&gt;Every Crew point aboard counts as Legiones Astartes (+1)&lt;/b&gt; when it fights, in attack and in defence alike, and the ship becomes eligible for Astartes boarding upgrades. It costs &lt;b&gt;20% of the ship's own points value&lt;/b&gt;, rounded to the nearest 5. Once per ship. Strike Cruisers, Battle Barges and Gloriana class vessels already carry Astartes Crew and may not buy it again.</characteristic>
           </characteristics>
          </profile>
         </profiles>
         <costs>
          <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="25.0" />
         </costs>
        </selectionEntry>
       </selectionEntries>
      </selectionEntryGroup>
      <selectionEntryGroup name="Hull Upgrades" id="5cca7646-5cab-5127-bb16-1879e1202e21" hidden="false" collective="false" import="true">
       <constraints>
        <constraint type="max" value="5.0" field="selections" scope="parent" shared="false" id="468e1cf7-9ec2-5f13-8c13-522d40d833be" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <selectionEntries>
        <selectionEntry id="1f16cfa8-663f-563b-9f22-c29f15b86faf" name="Emergency Shield Capacitors" hidden="false" collective="false" import="true" type="upgrade">
         <constraints>
          <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="2e35b3cb-9c1d-58f1-93df-fb230ebeb116" percentValue="false" includeChildSelections="false" includeChildForces="false" />
         </constraints>
         <profiles>
          <profile id="98bc70a5-3187-5650-a56a-237f2689230d" name="Emergency Shield Capacitors" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
           <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 to Void Shield regeneration rolls. It confers no other benefit and can never raise a ship above its normal number of Void Shields; a shield burnt out despite the bonus stays burnt out for the rest of the battle. Once per ship.</characteristic>
           </characteristics>
          </profile>
         </profiles>
         <costs>
          <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" />
         </costs>
        </selectionEntry>
        <selectionEntry id="d5116e07-cefc-5fc3-9bcf-469a9f934e49" name="Adamantium Belt Armour" hidden="false" collective="false" import="true" type="upgrade">
         <constraints>
          <constraint field="selections" scope="parent" value="1.0" type="max" id="7eeaa3ab-5827-56c5-bf80-c459a9435017" shared="false" includeChildSelections="false" />
         </constraints>
         <profiles>
          <profile id="98682dd6-5962-58a3-aa6e-f4841b88247b" name="Adamantium Belt Armour" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
           <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic>
           </characteristics>
          </profile>
         </profiles>
         <costs>
          <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="25.0" />
         </costs>
        </selectionEntry>
        <selectionEntry id="0ea99d38-ab18-5618-9ed9-0fde99abbfc2" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
         <constraints>
          <constraint field="selections" scope="parent" value="1.0" type="max" id="ccf26716-0040-5587-8446-8496914e0cad" shared="false" includeChildSelections="false" />
         </constraints>
         <profiles>
          <profile id="f499c7e6-7748-543a-9a6e-adb15551e287" name="Plasma Drive Overhaul" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
           <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic>
           </characteristics>
          </profile>
         </profiles>
         <costs>
          <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="15.0" />
         </costs>
        </selectionEntry>
       </selectionEntries>
      </selectionEntryGroup>
     </selectionEntryGroups>
     <costs>
      <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="115.0" />
     </costs>
    </selectionEntry>
   </selectionEntries>
