       <profiles>
        <profile id="c2434c99-1c07-5cb8-8aa6-9a29b01b06ea" name="Boarding Force" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">One Boarding Party; +2. Limits: Line 1, Capital 2, Gloriana/Phalanx 4.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <categoryLinks>
        <categoryLink id="52fb1ca3-5179-5628-a420-fee17ae4d54e" name="Boarding Force" hidden="false" targetId="4d94b920-d5bc-5fd7-a967-4ba346019f56" primary="true" />
