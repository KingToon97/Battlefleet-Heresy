    <profile id="6dd8674b-6d10-5fc2-ad85-82053ec904eb" name="Pattern" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Built to shatter orbital defences before the drop.</characteristic>
     </characteristics>
    </profile>
    <profile id="b44d25e8-90fb-5798-a18d-c1a8488f578b" name="Siege Master" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ship Pattern: Bombardment. Siege Master: once per activation, this ship may &lt;b&gt;re-roll one failed Armour Penetration roll&lt;/b&gt; made by a Bombardment weapon.</characteristic>
     </characteristics>
    </profile>
    <profile id="03a166bd-adae-55ce-b1db-ecafdbd6d373" name="Defence Batteries (6)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship mounts 6 Defence Batteries. They fire only in answer to the Overwatch Fleet Order, at Strength 6, destroying one incoming craft on each 5+. See Defence Batteries.</characteristic>
     </characteristics>
    </profile>
   </profiles>
   <infoLinks>
