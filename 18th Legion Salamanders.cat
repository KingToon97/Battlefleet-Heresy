          <selectionEntry id="91203711-18dc-5681-b4a3-2f97523a46ca" name="Artellus Numeon" hidden="false" collective="false" import="true" type="upgrade">
           <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="b9f32644-539a-57b7-8db4-3e8bf2da598d" type="max" />
           </constraints>
           <profiles>
            <profile id="bd187886-918e-527a-891f-eb4666e93417" name="Artellus Numeon" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
             <characteristics>
              <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Character. Through Fire Unscathed: friendly Salamanders ships within &lt;b&gt;12″ of an enemy ship&lt;/b&gt; may re-roll failed Evade rolls. Fleet-wide. This does not enable, disable or modify Flame in any way.</characteristic>
             </characteristics>
            </profile>
           </profiles>
           <categoryLinks>
            <categoryLink id="462393f6-0d10-5d91-b9fa-2238c892ccd1" name="Commander" hidden="false" targetId="6f3339ad-23a9-5687-b08f-3f11a43fe50b" primary="true" />
           </categoryLinks>
