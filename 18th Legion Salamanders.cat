           <profiles>
            <profile id="b037df4e-0f1b-5593-acb9-a59c93f7eaf8" name="Artellus Numeon" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
             <characteristics>
              <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Character. Through Fire Unscathed: friendly Salamanders ships within &lt;b&gt;12″ of an enemy ship&lt;/b&gt; may re-roll failed Evade rolls. Fleet-wide. This does not enable, disable or modify Flame in any way.</characteristic>
             </characteristics>
            </profile>
           </profiles>
           <categoryLinks>
            <categoryLink id="80800681-a336-569e-938e-2cf544ca8691" name="Commander" hidden="false" targetId="6f3339ad-23a9-5687-b08f-3f11a43fe50b" primary="true" />
