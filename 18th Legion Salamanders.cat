          <selectionEntry id="3bba4aed-91e1-5478-92f1-1262ab7da9e1" name="Artellus Numeon" hidden="false" collective="false" import="true" type="upgrade">
           <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="87593d12-c4fd-5e4e-9f69-283b847b5e08" type="max" />
