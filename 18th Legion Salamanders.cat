       </constraints>
       <profiles>
        <profile id="d414cc9c-062b-5612-af99-a4a888310b11" name="Adamantium Belt Armour" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="70.0" />
       </costs>
      </selectionEntry>
      <selectionEntry id="85e1387d-30d8-5c8b-82ee-6e2c531169cb" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
