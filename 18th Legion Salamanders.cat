      <profile id="00ec5b95-1b8d-5972-ad59-e72e052a31f5" name="Pattern" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
       <characteristics>
        <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">A gunnery refit that trades the torpedo tube for a heavier screen.</characteristic>
       </characteristics>
      </profile>
      <profile id="0a4aafc8-5754-59b5-a3d2-bbfc4e2c8693" name="Strafing Run" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
       <characteristics>
        <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ship Pattern: Viper-class. Strafing Run: once per battle round, immediately after completing its Shooting activation, a Viper squadron may make a &lt;b&gt;second Shooting activation&lt;/b&gt; using only its &lt;b&gt;Macro-Cannon Batteries&lt;/b&gt;. No other weapon may fire in the second activation, and every normal rule for shooting applies to it.</characteristic>
       </characteristics>
      </profile>
      <profile id="b220f503-5b6b-5f47-9466-b97e12d732bc" name="Defence Batteries (1)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
       <characteristics>
        <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship mounts 1 Defence Batteries. They fire only in answer to the Overwatch Fleet Order, at Strength 6, destroying one incoming craft on each 5+. See Defence Batteries.</characteristic>
       </characteristics>
      </profile>
     </profiles>
