     <selectionEntries>
      <selectionEntry id="5d8360e7-9a0d-4dd1-a577-e7bff487af51" name="Nomus Rhy’tan" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="9e98016a-4ddd-482e-8a3d-0c9a0e946e25" type="max" />
       </constraints>
       <profiles>
        <profile id="e8add9e5-848c-4261-867c-90cd51dd3785" name="Nomus Rhy’tan" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Character. Purging Broadside: friendly Salamanders ships trigger &lt;b&gt;Flame on a 3+&lt;/b&gt; rather than 4+. Fleet-wide. No weapon profile changes and a successful Flame roll still costs the target 1 Crew — Nomus only makes it more reliable.</characteristic>
         </characteristics>
        </profile>
        <profile id="61fcab4c-e92d-4644-9255-ba7501ccf501" name="Primarch Retinue" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This character is embarked as the Primarch's additional named retinue. They do not add Fleet Orders or any command ability; only effects unrelated to the order economy apply.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <categoryLinks>
        <categoryLink id="37970c4f-38ba-4a25-b7b8-c5b343131e27" name="Retinue Character" hidden="false" targetId="194a7f31-dced-445a-b273-cca4996c8570" primary="false" />
       </categoryLinks>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="175.0" />
       </costs>
      </selectionEntry>
      <selectionEntry id="62b6e624-d235-4a23-bf6c-243f36b90df6" name="Artellus Numeon" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="360a723e-22cd-4c82-acbd-48b12fc6c3c8" type="max" />
       </constraints>
       <profiles>
        <profile id="84310652-df2d-4227-8cca-acedac347a69" name="Artellus Numeon" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Character. Through Fire Unscathed: friendly Salamanders ships within &lt;b&gt;12″ of an enemy ship&lt;/b&gt; may re-roll failed Evade rolls. Fleet-wide. This does not enable, disable or modify Flame in any way.</characteristic>
         </characteristics>
        </profile>
        <profile id="6a8995c2-0215-453c-84e5-d795319e93d8" name="Primarch Retinue" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This character is embarked as the Primarch's additional named retinue. They do not add Fleet Orders or any command ability; only effects unrelated to the order economy apply.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <categoryLinks>
