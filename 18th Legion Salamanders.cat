      <selectionEntry id="7b07d10b-d800-5cac-953c-c651bab7db2e" name="Contemptor Dreadnought" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="bd19819d-0cb3-58c4-bc13-0904efe05b6d" percentValue="false" includeChildSelections="false" includeChildForces="false" />
        <constraint type="max" value="8.0" field="selections" scope="parent" shared="false" id="685488ac-ac53-5dc3-9a6b-6affef3ba344" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="c946edaa-1499-5bf1-a101-1c86c15c1950" name="Boarding Force" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Counts as 2 Boarding Parties; fights as one warrior at +2 and gives −1 to the enemy die it faces. Limits as Terminators.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <categoryLinks>
        <categoryLink id="ed6f7e11-61bb-5a2b-a571-1a4c42460161" name="Boarding Force" hidden="false" targetId="4d94b920-d5bc-5fd7-a967-4ba346019f56" primary="true" />
