    <profile id="f659ae96-c71c-5919-a0d7-c70ad6839994" name="Bulwark of the Line" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ship Pattern: Apocalypse-class. Bulwark of the Line: apply &lt;b&gt;−1 to Damage Table rolls&lt;/b&gt; made against this ship.</characteristic>
     </characteristics>
    </profile>
    <profile id="558f161d-f131-5ef1-bc9c-b43c04522d23" name="Defence Batteries (8)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship mounts 8 Defence Batteries. They fire only in answer to the Overwatch Fleet Order, at Strength 6, destroying one incoming craft on each 5+. See Defence Batteries.</characteristic>
     </characteristics>
