    </profile>
    <profile id="e504f64a-f802-50a6-bec0-eed2161f4539" name="Pattern" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">The most numerous cruiser in the Imperium, and the most balanced: torpedoes, lances and a full broadside.</characteristic>
     </characteristics>
    </profile>
    <profile id="edc90891-9bce-56f9-b35e-767d97ba090f" name="Adaptable" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ship Pattern: Lunar-class. Adaptable: at the beginning of this ship's activation, choose one — • &lt;b&gt;Advance&lt;/b&gt;: +2″ Movement for this activation. • &lt;b&gt;Engage&lt;/b&gt;: this ship may split fire between two targets with no −1 BS penalty this activation. • &lt;b&gt;Brace&lt;/b&gt;: +1 to its next Evade roll this battle round. Only one option may be selected each activation.</characteristic>
     </characteristics>
    </profile>
    <profile id="63b77b9f-2820-5721-bcc9-f82ab5b11c45" name="Defence Batteries (4)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship mounts 4 Defence Batteries. They fire only in answer to the Overwatch Fleet Order, at Strength 6, destroying one incoming craft on each 5+. See Defence Batteries.</characteristic>
     </characteristics>
    </profile>
   </profiles>
