     </constraints>
     <selectionEntries>
      <selectionEntry id="b5af7217-1354-5f10-ba6b-b5d98c565e55" name="Adamantium Belt Armour" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="2b51f11e-8e10-58d3-84fd-b73b77a61444" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="7b753f2e-eb41-5b1a-b9e6-c9911cadafa0" name="Adamantium Belt Armour" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="60.0" />
       </costs>
      </selectionEntry>
      <selectionEntry id="f952074e-1116-56a5-8e5a-55b9759ce315" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
