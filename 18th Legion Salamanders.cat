           <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="4bd3a9b9-ef2a-5a05-9c41-aa7bf4f22069" type="max" />
           </constraints>
           <profiles>
            <profile id="5289364b-8353-51e4-ba5d-8e43be6e462a" name="Fleet Captain" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
             <characteristics>
              <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Fleet Captain. See Characters &amp; Primarchs.</characteristic>
             </characteristics>
            </profile>
           </profiles>
           <categoryLinks>
            <categoryLink id="6a8b67e9-b1c4-5b89-be4e-28de30c7b22b" name="Commander" hidden="false" targetId="6f3339ad-23a9-5687-b08f-3f11a43fe50b" primary="true" />
