     <selectionEntryGroups>
      <selectionEntryGroup name="Crew Upgrade" id="084a89cf-1004-57ba-899e-c6439209cdb3" hidden="false" collective="false" import="true">
       <constraints>
        <constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="322bc434-06bf-5cb2-8a89-7a9419981913" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <selectionEntries>
        <selectionEntry id="b12d6f21-2c44-525d-932f-b41e4be813ee" name="Veteran Crew" hidden="false" collective="false" import="true" type="upgrade">
         <constraints>
          <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="f8d00915-7751-538d-947d-3ad1c2a38a3e" percentValue="false" includeChildSelections="false" includeChildForces="false" />
         </constraints>
         <profiles>
          <profile id="cfa305be-a6e1-50e9-bee5-674c181087e2" name="Veteran Crew" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
           <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Once per ship. +1 BS, to maximum BS 5.</characteristic>
           </characteristics>
          </profile>
         </profiles>
         <costs>
          <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="30.0" />
         </costs>
        </selectionEntry>
        <selectionEntry id="f3dcb740-2b20-54d7-b8bd-1332937adfdd" name="Astartes Crew" hidden="false" collective="false" import="true" type="upgrade">
         <constraints>
          <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="b1ac10e7-668a-53ac-abb1-8610066fceaf" percentValue="false" includeChildSelections="false" includeChildForces="false" />
         </constraints>
         <profiles>
          <profile id="64389193-d349-5c32-a828-519a92859c60" name="Astartes Crew" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
           <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">The ship's entire complement is replaced by Legion Astartes. &lt;b&gt;Every Crew point aboard counts as Legiones Astartes (+1)&lt;/b&gt; when it fights, in attack and in defence alike, and the ship becomes eligible for Astartes boarding upgrades. It costs &lt;b&gt;20% of the ship's own points value&lt;/b&gt;, rounded to the nearest 5. Once per ship. Strike Cruisers, Battle Barges and Gloriana class vessels already carry Astartes Crew and may not buy it again.</characteristic>
           </characteristics>
          </profile>
         </profiles>
         <costs>
          <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="20.0" />
         </costs>
        </selectionEntry>
       </selectionEntries>
      </selectionEntryGroup>
      <selectionEntryGroup name="Hull Upgrades" id="0e3f61bb-b5ab-5955-bbde-3752b50f3281" hidden="false" collective="false" import="true">
       <constraints>
        <constraint type="max" value="5.0" field="selections" scope="parent" shared="false" id="a2f28c84-da72-5dee-a7e6-614c9657fdd5" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <selectionEntries>
        <selectionEntry id="25f4b8b3-d841-527b-96a0-33a3a6312626" name="Emergency Shield Capacitors" hidden="false" collective="false" import="true" type="upgrade">
         <constraints>
          <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="ba593499-bdc7-5940-99f7-adc12451db95" percentValue="false" includeChildSelections="false" includeChildForces="false" />
         </constraints>
         <profiles>
          <profile id="d7d897ba-6fbf-5b96-9bd3-b9462f5d9ef7" name="Emergency Shield Capacitors" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
           <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 to Void Shield regeneration rolls. It confers no other benefit and can never raise a ship above its normal number of Void Shields; a shield burnt out despite the bonus stays burnt out for the rest of the battle. Once per ship.</characteristic>
           </characteristics>
          </profile>
         </profiles>
         <costs>
          <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" />
         </costs>
        </selectionEntry>
        <selectionEntry id="031c22a1-a2e4-5b5e-b454-1f402a8586bb" name="Adamantium Belt Armour" hidden="false" collective="false" import="true" type="upgrade">
         <constraints>
          <constraint field="selections" scope="parent" value="1.0" type="max" id="61f79239-24d0-53dd-8f5b-f1793f7aa130" shared="false" includeChildSelections="false" />
         </constraints>
         <profiles>
          <profile id="f7632536-08df-5759-8191-82e6e235ca93" name="Adamantium Belt Armour" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
           <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic>
           </characteristics>
          </profile>
         </profiles>
         <costs>
          <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="20.0" />
         </costs>
        </selectionEntry>
        <selectionEntry id="40c46617-f7ef-5d62-b5cd-b26b92fe60bf" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
         <constraints>
          <constraint field="selections" scope="parent" value="1.0" type="max" id="6c0e1ec7-153b-599d-939b-627a7fd2055e" shared="false" includeChildSelections="false" />
         </constraints>
         <profiles>
          <profile id="715bf4ee-e09b-5ba0-8ae9-6ddd9841843d" name="Plasma Drive Overhaul" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
           <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic>
           </characteristics>
          </profile>
         </profiles>
         <costs>
          <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="15.0" />
         </costs>
        </selectionEntry>
       </selectionEntries>
      </selectionEntryGroup>
     </selectionEntryGroups>
     <costs>
      <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="110.0" />
     </costs>
    </selectionEntry>
   </selectionEntries>
   <selectionEntryGroups>
    <selectionEntryGroup name="Hull Upgrades" id="411630b0-3370-5613-ad50-2da1ce3e199e" hidden="false" collective="false" import="true">
     <constraints>
      <constraint type="max" value="3.0" field="selections" scope="parent" shared="false" id="f8fa491d-a94d-5aa9-8bf8-0b320aa3bde8" percentValue="false" includeChildSelections="false" includeChildForces="false" />
