      <profile id="63f4c285-21e3-5434-bf49-f4ada478d77f" name="Pattern" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
       <characteristics>
        <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">A minelayer variant that denies ground rather than holding it.</characteristic>
       </characteristics>
      </profile>
