     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">The lance pattern, her spine given over to heavy turrets.</characteristic>
     </characteristics>
    </profile>
    <profile id="e6cefe56-68f3-5357-95eb-a0eb1d79cb2f" name="Fire Control Coordination" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ship Pattern: Vengeance-class. Fire Control Coordination: this ship may &lt;b&gt;split its fire without suffering the −1 BS penalty&lt;/b&gt;, and may &lt;b&gt;split fire between three targets&lt;/b&gt; rather than two. All other restrictions on Splitting Fire still apply.</characteristic>
     </characteristics>
    </profile>
    <profile id="5acc09ca-069c-5088-ae72-b4a5af690b04" name="Defence Batteries (6)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship mounts 6 Defence Batteries. They fire only in answer to the Overwatch Fleet Order, at Strength 6, destroying one incoming craft on each 5+. See Defence Batteries.</characteristic>
     </characteristics>
    </profile>
