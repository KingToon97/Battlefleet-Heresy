    <selectionEntryGroup name="Crew Upgrade" id="2674f6b9-03e4-5792-8371-d11543c88430" hidden="false" collective="false" import="true">
     <constraints>
      <constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="803e7c88-7e27-555c-94f8-5678c938ddf7" percentValue="false" includeChildSelections="false" includeChildForces="false" />
     </constraints>
     <selectionEntries>
      <selectionEntry id="025dabcc-8f5c-59a1-9efb-85fbd1758c14" name="Veteran Crew" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
