    <profile id="4a91055c-fde5-50f2-b85c-244ecb6f2db3" name="Pattern" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">An old ramming pattern, her prow reinforced for the charge.</characteristic>
     </characteristics>
    </profile>
    <profile id="b4e0f31e-8b4e-567f-aa3c-ad2314c70386" name="Ancient Engines" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ship Pattern: Repulsive-class. Ancient Engines: &lt;b&gt;once per battle&lt;/b&gt;, before moving, this ship may fire her ancient drives. She gains &lt;b&gt;+4″ Movement&lt;/b&gt; for that activation and may make her first turn after moving only &lt;b&gt;2″&lt;/b&gt; rather than her normal minimum.</characteristic>
     </characteristics>
    </profile>
    <profile id="275952f7-3122-58c9-a0e5-e0eb346e78d8" name="Defence Batteries (6)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship mounts 6 Defence Batteries. They fire only in answer to the Overwatch Fleet Order, at Strength 6, destroying one incoming craft on each 5+. See Defence Batteries.</characteristic>
     </characteristics>
    </profile>
   </profiles>
