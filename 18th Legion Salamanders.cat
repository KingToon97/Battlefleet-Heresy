           <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="346d8514-90f8-5b80-9a3c-fa497fd52dc0" type="max" />
           </constraints>
           <profiles>
            <profile id="b81940c9-3ecd-53be-a2a2-9a1da59644f6" name="Nomus Rhy’tan" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
             <characteristics>
              <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Character. Purging Broadside: friendly Salamanders ships trigger &lt;b&gt;Flame on a 3+&lt;/b&gt; rather than 4+. Fleet-wide. No weapon profile changes and a successful Flame roll still costs the target 1 Crew — Nomus only makes it more reliable.</characteristic>
             </characteristics>
            </profile>
           </profiles>
           <categoryLinks>
            <categoryLink id="a47b83df-c6ea-5452-918f-7af30de39c15" name="Commander" hidden="false" targetId="6f3339ad-23a9-5687-b08f-3f11a43fe50b" primary="true" />
