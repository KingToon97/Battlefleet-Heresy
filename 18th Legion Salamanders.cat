    <profile id="995145fd-06da-5110-ade5-2e13cf966ecf" name="Pattern" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">The lance cruiser, built to gut armour at range.</characteristic>
     </characteristics>
    </profile>
    <profile id="f51a4f1e-c023-5477-8751-79964c23eb85" name="Lance Specialists" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ship Pattern: Gothic-class. Lance Specialists: this ship may &lt;b&gt;re-roll hit rolls of 1&lt;/b&gt; made with Lance weapons.</characteristic>
     </characteristics>
    </profile>
    <profile id="f72fde5c-14a5-502c-a416-73848487b6e0" name="Defence Batteries (4)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship mounts 4 Defence Batteries. They fire only in answer to the Overwatch Fleet Order, at Strength 6, destroying one incoming craft on each 5+. See Defence Batteries.</characteristic>
     </characteristics>
    </profile>
   </profiles>
