    <profile id="bcd7a476-7aa2-51d7-9f23-d573cf47f3d0" name="Pattern" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">The lance battleship: a nova cannon and torpedo tubes forward, triple lance turrets aloft and lance batteries down both broadsides — built to gut Capital armour and nothing else.</characteristic>
     </characteristics>
    </profile>
    <profile id="a271f7b1-7b9b-5dad-beff-e24f77499735" name="Target Lock" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ship Pattern: Victory-class. Target Lock: at the beginning of this ship's Shooting activation she may nominate one enemy ship. If she does, &lt;b&gt;every weapon she fires that activation must target the nominated ship&lt;/b&gt;, and that ship &lt;b&gt;cannot benefit from Screen&lt;/b&gt; against her attacks for that activation.</characteristic>
     </characteristics>
    </profile>
    <profile id="4c9df4a7-4842-5d1b-b9bf-e7ff56254932" name="Defence Batteries (8)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship mounts 8 Defence Batteries. They fire only in answer to the Overwatch Fleet Order, at Strength 6, destroying one incoming craft on each 5+. See Defence Batteries.</characteristic>
     </characteristics>
    </profile>
   </profiles>
