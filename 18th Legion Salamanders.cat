    <selectionEntryGroup name="Hull Upgrades" id="de8867f2-fa48-5803-9969-2aa4ce375971" hidden="false" collective="false" import="true">
     <constraints>
      <constraint type="max" value="3.0" field="selections" scope="parent" shared="false" id="b1c4a974-cf4b-5cf0-810e-e5f59bcba657" percentValue="false" includeChildSelections="false" includeChildForces="false" />
