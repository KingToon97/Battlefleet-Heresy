     </constraints>
     <selectionEntries>
      <selectionEntry id="b0e99417-6b0a-5657-9e0c-ae4bf62e6a19" name="Astartes Breacher Squad" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
