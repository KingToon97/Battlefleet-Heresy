      <selectionEntry id="77500262-bc10-4e74-b9d7-12bf003a09f9" name="Nomus Rhy’tan" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="284f78b3-6e5e-41e0-8a2f-1c2266c8f536" type="max" />
       </constraints>
       <profiles>
        <profile id="fccff3b3-000b-4087-b262-b81a16cbfa25" name="Nomus Rhy’tan" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Character. Purging Broadside: friendly Salamanders ships trigger &lt;b&gt;Flame on a 3+&lt;/b&gt; rather than 4+. Fleet-wide. No weapon profile changes and a successful Flame roll still costs the target 1 Crew — Nomus only makes it more reliable.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <categoryLinks>
        <categoryLink id="92775c2f-4a07-4238-8643-fff779847255" name="Commander" hidden="false" targetId="6f3339ad-23a9-5687-b08f-3f11a43fe50b" primary="true" />
       </categoryLinks>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="175.0" />
       </costs>
      </selectionEntry>
      <selectionEntry id="8160f69a-b69b-4feb-a8f7-f70d140c7caf" name="Vulkan" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="e1f8754f-32fb-4621-8a5e-4466301b03cc" type="max" />
       </constraints>
       <profiles>
        <profile id="dc1363aa-89a7-4103-96f9-8c7f2eb0b023" name="Vulkan" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Primarch. The Fires of Nocturne: while Vulkan commands the fleet, &lt;b&gt;every Flame roll made by a friendly Salamanders ship succeeds automatically&lt;/b&gt;. No D6 is rolled. Each successful Armour Penetration by a weapon with Flame therefore costs the target 1 Crew, on top of the Hull Points inflicted. Vulkan grants the normal Primarch allowance of 3 Fleet Orders per battle round.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <categoryLinks>
        <categoryLink id="794b4cf2-cf2d-42d1-8967-5a0aaab10a0f" name="Commander" hidden="false" targetId="6f3339ad-23a9-5687-b08f-3f11a43fe50b" primary="true" />
