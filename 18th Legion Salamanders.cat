     </characteristics>
    </profile>
    <profile id="13092c5f-31f9-5964-af51-6366c60e1435" name="Pattern" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">The classic fast hunter: a torpedo prow, a lance spine and enough broadside to finish what it starts.</characteristic>
     </characteristics>
    </profile>
    <profile id="ceff402e-e3bc-500c-8346-34b6a2a24b30" name="Independent Warship" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ship Pattern: Dauntless-class. Independent Warship: this ship may operate alone. It suffers no penalty for being outside squadron coherency, may be deployed anywhere in its deployment zone regardless of the rest of the fleet, and never requires a squadron to activate.</characteristic>
     </characteristics>
    </profile>
    <profile id="cbb1a531-c0c0-52d8-9463-761aa3656dba" name="Defence Batteries (3)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship mounts 3 Defence Batteries. They fire only in answer to the Overwatch Fleet Order, at Strength 6, destroying one incoming craft on each 5+. See Defence Batteries.</characteristic>
     </characteristics>
    </profile>
   </profiles>
