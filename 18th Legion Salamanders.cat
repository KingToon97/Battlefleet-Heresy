    <profile id="794402b1-bd8e-574e-957c-2ac09b08152b" name="Launch Bays (2)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship carries 2 Launch Bays, sited on her broadsides. Each holds one aircraft squadron, bought separately. See Launch Bays &amp; Aircraft.</characteristic>
     </characteristics>
    </profile>
    <profile id="e803a165-e59c-5d6b-858e-fec663cd9dad" name="Pattern" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">The archetypal battlecruiser: a nova cannon forward, launch bays amidships and lance batteries above.</characteristic>
     </characteristics>
    </profile>
    <profile id="b49a40f8-5986-5a47-8d07-fbd28938f996" name="Command Cruiser" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ship Pattern: Mars-class. Command Cruiser: once per battle round, this ship may &lt;b&gt;re-roll one failed Fleet Order roll&lt;/b&gt;. Fleet Orders remain fleet-wide and this consumes no additional order.</characteristic>
     </characteristics>
    </profile>
    <profile id="a9ccca28-9352-5008-afeb-ab75c18449ba" name="Defence Batteries (5)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship mounts 5 Defence Batteries. They fire only in answer to the Overwatch Fleet Order, at Strength 6, destroying one incoming craft on each 5+. See Defence Batteries.</characteristic>
     </characteristics>
    </profile>
   </profiles>
