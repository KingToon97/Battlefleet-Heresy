    <profile id="56295b45-3721-57d2-8452-7ae29dce5e31" name="Heavy Macro-Cannon Battery ×4" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
     <characteristics>
      <characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Starboard</characteristic>
