          <selectionEntry id="064b9ed2-31bf-5ee6-a6eb-33e78d894e0f" name="Artellus Numeon" hidden="false" collective="false" import="true" type="upgrade">
           <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="5c171244-8213-56d7-bff4-79915f8b5b69" type="max" />
           </constraints>
           <profiles>
            <profile id="03997062-8cd1-5e7d-ad91-003a258fa2d7" name="Artellus Numeon" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
             <characteristics>
              <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Character. Through Fire Unscathed: friendly Salamanders ships within &lt;b&gt;12″ of an enemy ship&lt;/b&gt; may re-roll failed Evade rolls. Fleet-wide. This does not enable, disable or modify Flame in any way.</characteristic>
             </characteristics>
            </profile>
           </profiles>
           <categoryLinks>
            <categoryLink id="0b83c2f6-2b8f-57aa-9e4b-6dbdb5e064e8" name="Commander" hidden="false" targetId="6f3339ad-23a9-5687-b08f-3f11a43fe50b" primary="true" />
           </categoryLinks>
           <costs>
            <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="155.0" />
           </costs>
