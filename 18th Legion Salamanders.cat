    </profile>
    <profile id="4e2a63a3-f843-5204-bcdd-7ba89fccaa50" name="Pattern" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">A heavier-gunned patrol vessel built for long independent cruises.</characteristic>
     </characteristics>
    </profile>
    <profile id="ab8fcfc2-21f6-5fe6-9fc0-2486d4c4abdd" name="Steadfast" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ship Pattern: Endeavour-class. Steadfast: this ship adds &lt;b&gt;+1 to its Evade rolls&lt;/b&gt;, and it may &lt;b&gt;re-roll a failed Evade roll once per battle&lt;/b&gt;.</characteristic>
     </characteristics>
    </profile>
    <profile id="bf1b7412-c123-5550-9919-16541ce4bb0d" name="Defence Batteries (3)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship mounts 3 Defence Batteries. They fire only in answer to the Overwatch Fleet Order, at Strength 6, destroying one incoming craft on each 5+. See Defence Batteries.</characteristic>
     </characteristics>
    </profile>
   </profiles>
