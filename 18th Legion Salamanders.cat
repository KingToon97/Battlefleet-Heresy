          <selectionEntry id="57bdc32a-f9bd-56b6-a099-a2e9ae29fdf3" name="Nomus Rhy’tan" hidden="false" collective="false" import="true" type="upgrade">
           <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="68626ce8-a4f1-5f77-8889-c7f77fc32a94" type="max" />
           </constraints>
           <profiles>
            <profile id="2c1f153b-5b1d-5df4-82c8-123cf3ca5e1e" name="Nomus Rhy’tan" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
             <characteristics>
              <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Character. Purging Broadside: friendly Salamanders ships trigger &lt;b&gt;Flame on a 3+&lt;/b&gt; rather than 4+. Fleet-wide. No weapon profile changes and a successful Flame roll still costs the target 1 Crew — Nomus only makes it more reliable.</characteristic>
             </characteristics>
            </profile>
           </profiles>
           <categoryLinks>
            <categoryLink id="17f7e09e-94ae-55ca-bfbe-97619ca78469" name="Commander" hidden="false" targetId="6f3339ad-23a9-5687-b08f-3f11a43fe50b" primary="true" />
           </categoryLinks>
           <costs>
            <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="175.0" />
           </costs>
          </selectionEntry>
