          <selectionEntry id="ad09267a-bc48-5698-8d82-5fb887d79ec8" name="Nomus Rhy’tan" hidden="false" collective="false" import="true" type="upgrade">
           <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="9a7a35ce-7317-5e39-98c6-5db6c470bcdd" type="max" />
           </constraints>
           <profiles>
            <profile id="3b4b0a6a-bc51-5934-999a-6f09e7b045b6" name="Nomus Rhy’tan" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
             <characteristics>
              <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Character. Purging Broadside: friendly Salamanders ships trigger &lt;b&gt;Flame on a 3+&lt;/b&gt; rather than 4+. Fleet-wide. No weapon profile changes and a successful Flame roll still costs the target 1 Crew — Nomus only makes it more reliable.</characteristic>
             </characteristics>
            </profile>
           </profiles>
           <categoryLinks>
            <categoryLink id="ec2dbc8d-f848-58f9-8a2f-ea7a2ee0551c" name="Commander" hidden="false" targetId="6f3339ad-23a9-5687-b08f-3f11a43fe50b" primary="true" />
           </categoryLinks>
           <costs>
            <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="175.0" />
