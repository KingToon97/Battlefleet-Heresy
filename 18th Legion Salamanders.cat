     <selectionEntryGroups>
      <selectionEntryGroup name="Crew Upgrade" id="cd2398d3-e3db-53af-adb9-c92ef16ab080" hidden="false" collective="false" import="true">
       <constraints>
        <constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="82d1e1f1-f571-520d-95c6-c82bb9ac2f95" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <selectionEntries>
        <selectionEntry id="d6f155bb-5081-59f2-908e-d274e9db20b4" name="Veteran Crew" hidden="false" collective="false" import="true" type="upgrade">
         <constraints>
          <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="b3b26b89-afa5-5836-91e4-e426853a96bd" percentValue="false" includeChildSelections="false" includeChildForces="false" />
         </constraints>
         <profiles>
          <profile id="46cc2228-8cfa-518c-819c-f30cd9f83217" name="Veteran Crew" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
           <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Once per ship. +1 BS, to maximum BS 5.</characteristic>
           </characteristics>
          </profile>
         </profiles>
         <costs>
          <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="15.0" />
         </costs>
        </selectionEntry>
        <selectionEntry id="98cd0877-aa50-5a71-9714-20e19138f742" name="Astartes Crew" hidden="false" collective="false" import="true" type="upgrade">
         <constraints>
          <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="538d7fb3-e080-5b64-8a4a-3c06e418b150" percentValue="false" includeChildSelections="false" includeChildForces="false" />
         </constraints>
         <profiles>
          <profile id="2729d1e2-2aac-5c30-9de8-4eed8ae6b6b0" name="Astartes Crew" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
           <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">The ship's entire complement is replaced by Legion Astartes. &lt;b&gt;Every Crew point aboard counts as Legiones Astartes (+1)&lt;/b&gt; when it fights, in attack and in defence alike, and the ship becomes eligible for Astartes boarding upgrades. It costs &lt;b&gt;20% of the ship's own points value&lt;/b&gt;, rounded to the nearest 5. Once per ship. Strike Cruisers, Battle Barges and Gloriana class vessels already carry Astartes Crew and may not buy it again.</characteristic>
           </characteristics>
          </profile>
         </profiles>
         <costs>
          <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" />
         </costs>
        </selectionEntry>
       </selectionEntries>
      </selectionEntryGroup>
      <selectionEntryGroup name="Hull Upgrades" id="5f44b6fe-f40b-5d9d-b15f-42141ed1514e" hidden="false" collective="false" import="true">
       <constraints>
        <constraint type="max" value="5.0" field="selections" scope="parent" shared="false" id="6ed15dd8-baf9-5ccf-b37e-ebe4d7e4b16e" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <selectionEntries>
        <selectionEntry id="c0d9e321-8355-5225-a3b0-a5b60d8704b7" name="Emergency Shield Capacitors" hidden="false" collective="false" import="true" type="upgrade">
         <constraints>
          <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="9a024ff0-162a-5b6d-a776-f52ac553572d" percentValue="false" includeChildSelections="false" includeChildForces="false" />
         </constraints>
         <profiles>
          <profile id="3ff4a7af-33cd-5ad4-b9e7-b72c18efde58" name="Emergency Shield Capacitors" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
           <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 to Void Shield regeneration rolls. It confers no other benefit and can never raise a ship above its normal number of Void Shields; a shield burnt out despite the bonus stays burnt out for the rest of the battle. Once per ship.</characteristic>
           </characteristics>
          </profile>
         </profiles>
         <costs>
          <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" />
         </costs>
        </selectionEntry>
        <selectionEntry id="aa6ffe97-9126-5d42-875b-f1ab2329f562" name="Adamantium Belt Armour" hidden="false" collective="false" import="true" type="upgrade">
         <constraints>
          <constraint field="selections" scope="parent" value="1.0" type="max" id="5e85baaa-4662-5b91-bb84-37fcf84d26e6" shared="false" includeChildSelections="false" />
         </constraints>
         <profiles>
          <profile id="613764ff-50bd-57a5-8e06-4a2d1c765480" name="Adamantium Belt Armour" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
           <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic>
           </characteristics>
          </profile>
         </profiles>
         <costs>
          <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" />
         </costs>
        </selectionEntry>
        <selectionEntry id="7a48c472-6d77-5f2b-8f9f-7a3bfcc73e98" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
         <constraints>
          <constraint field="selections" scope="parent" value="1.0" type="max" id="af2eb48d-3ede-5ff2-a04e-b3bcb3c96c9f" shared="false" includeChildSelections="false" />
         </constraints>
         <profiles>
          <profile id="92a1acf9-4288-5813-8ed5-befa17062216" name="Plasma Drive Overhaul" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
           <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic>
           </characteristics>
          </profile>
         </profiles>
         <costs>
          <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" />
         </costs>
        </selectionEntry>
       </selectionEntries>
      </selectionEntryGroup>
     </selectionEntryGroups>
     <costs>
      <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="60.0" />
     </costs>
    </selectionEntry>
   </selectionEntries>
   <selectionEntryGroups>
    <selectionEntryGroup name="Hull Upgrades" id="8dcb23e0-7e9d-5865-926e-3b5f30a7d261" hidden="false" collective="false" import="true">
     <constraints>
      <constraint type="max" value="3.0" field="selections" scope="parent" shared="false" id="f3940cd9-4a39-5be8-862c-a4c4531f1979" percentValue="false" includeChildSelections="false" includeChildForces="false" />
     </constraints>
     <selectionEntries>
      <selectionEntry id="920ffe6f-df90-5924-9916-b61d425f3517" name="Blast-Shielded Magazines" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="cbaea6bf-b085-5083-a8ee-83ac7e0285d4" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="40b1c970-8f06-56db-90ca-6fc0d7d811c5" name="Blast-Shielded Magazines" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Available only to a ship mounting a &lt;b&gt;Triple Lance Turret&lt;/b&gt; or a &lt;b&gt;Quad Warp Lance Turret&lt;/b&gt;. &lt;b&gt;Reduce the Hull Point loss from a Magazine Explosion by 1&lt;/b&gt;, to a minimum of 0. On a Triple Lance Turret ship that cancels the additional Hull Point the weapon inflicts, so a Magazine Explosion costs 1 Hull Point rather than 2. On a Quad Warp Lance Turret it costs 2 rather than 3. The Crew loss still applies. Once per ship.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="50.0" />
       </costs>
      </selectionEntry>
      <selectionEntry id="e2af1646-e0bd-5d63-9afd-0c192d577500" name="Emergency Shield Capacitors" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="ddc8daad-08f2-5e85-8e34-9ba2195d0d60" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="bf2cd904-9ba0-5102-b836-a4a006d5f6de" name="Emergency Shield Capacitors" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 to Void Shield regeneration rolls. It confers no other benefit and can never raise a ship above its normal number of Void Shields; a shield burnt out despite the bonus stays burnt out for the rest of the battle. Once per ship.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="75.0" />
       </costs>
      </selectionEntry>
     </selectionEntries>
    </selectionEntryGroup>
   </selectionEntryGroups>
