      <selectionEntry id="da1697e9-4fe9-5cf1-a20c-6a7e29950a17" name="Emergency Shield Capacitors" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="e9a91a48-07ea-54b0-8456-2eda3154618a" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="fb76c8b3-0fd1-5e4e-837c-2a306aebdb51" name="Emergency Shield Capacitors" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 to Void Shield regeneration rolls. It confers no other benefit and can never raise a ship above its normal number of Void Shields; a shield burnt out despite the bonus stays burnt out for the rest of the battle. Once per ship.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="20.0" />
       </costs>
      </selectionEntry>
     </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Drop Pod Loadout" id="da6694f6-78b7-5e16-b38b-281f0cbd34fe" hidden="false" collective="false" import="true">
     <constraints>
      <constraint type="max" value="3.0" field="selections" scope="parent" shared="false" id="9b6564b8-4e9e-559c-9ba3-c0c7a49e8518" percentValue="false" includeChildSelections="false" includeChildForces="false" />
     </constraints>
     <selectionEntries>
      <selectionEntry id="2681f03d-3e20-518f-b6ce-3a7f6819878e" name="Dreadclaw Drop Pod" hidden="false" collective="false" import="true" type="upgrade">
       <profiles>
        <profile id="ea4c8cf9-aea2-5f21-a50a-515d7115f066" name="Dreadclaw Drop Pod" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding pod, Armour 8, Speed 30″/round. Takes 1 rail. Launched at a target within 18″, striking the same turn. One Shot. Counts as aircraft and may be intercepted; a surviving pod locks on 2+, and on a failure is destroyed with all aboard. Delivers 1 Boarding Party (+1 in the first round). Removed from play after its run.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" />
       </costs>
      </selectionEntry>
     </selectionEntries>
    </selectionEntryGroup>
