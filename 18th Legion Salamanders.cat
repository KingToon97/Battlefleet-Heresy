    <profile id="902b1948-3486-5458-bc60-13741ca0c937" name="Pattern" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">A flexible flagship pattern, guns and bays in equal measure.</characteristic>
     </characteristics>
    </profile>
    <profile id="e868ee54-dc07-52e6-8748-8f3b980de043" name="Launch Bays (2)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship carries 2 Launch Bays, sited on her broadsides. Each holds one aircraft squadron, bought separately. See Launch Bays &amp; Aircraft.</characteristic>
     </characteristics>
    </profile>
    <profile id="c4487d1d-99a5-54c8-b877-e0ccec177602" name="Self-Sufficient" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ship Pattern: Oberon-class. Self-Sufficient: once per battle round, this ship may attempt &lt;b&gt;one Fleet Order on itself without consuming one of the fleet's available Fleet Orders&lt;/b&gt;. The roll is made normally, and only this ship benefits.</characteristic>
     </characteristics>
    </profile>
    <profile id="f75d819c-6cc1-5d3b-b9ec-34fe385ea0c9" name="Defence Batteries (8)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship mounts 8 Defence Batteries. They fire only in answer to the Overwatch Fleet Order, at Strength 6, destroying one incoming craft on each 5+. See Defence Batteries.</characteristic>
     </characteristics>
    </profile>
   </profiles>
