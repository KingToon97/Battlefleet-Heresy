    <profile id="1ea2016f-6527-5845-b8f0-7f1bb4958b41" name="Launch Bays (2)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship carries 2 Launch Bays, sited on her broadsides. Each holds one aircraft squadron, bought separately. See Launch Bays &amp; Aircraft.</characteristic>
     </characteristics>
    </profile>
    <profile id="e1aa6008-fa21-5e88-b2e8-16a431c38da1" name="Pattern" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">The archetypal battlecruiser: a nova cannon forward, launch bays amidships and lance batteries above.</characteristic>
     </characteristics>
    </profile>
    <profile id="904f6137-b999-5a7b-91ee-c4408d2c7d1e" name="Battleline Momentum" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ship Type: Battlecruiser. This ship may fire normally while under All Ahead Full, ignoring the restriction that would otherwise limit it to Defence Batteries.</characteristic>
     </characteristics>
    </profile>
