      <selectionEntry id="c44cd3f7-2b64-5380-b82c-7d7044c250db" name="Phosphex Shell Magazines" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="9a4e9560-a89f-53eb-955d-1bb8db4056cd" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="86c187b6-0666-515e-baa2-200319daff43" name="Phosphex Shell Magazines" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Every Heavy Macro-Cannon Battery aboard fires phosphex: whenever one penetrates armour, the target takes 1 Critical Damage. Requires at least one Heavy Macro-Cannon Battery. Every Death Guard Capital Ship carries Phosphex Shell Magazines free of charge.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="20.0" />
       </costs>
      </selectionEntry>
      <selectionEntry id="a6b77b3b-c76e-5d30-985c-8dda1d85fb1a" name="Blast-Shielded Magazines" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="fb7f36e4-116d-559f-b836-636bce4be163" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="56c9fce9-e2a3-53ba-8838-d0aa6b7a5ddb" name="Blast-Shielded Magazines" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Damage Control caused by a Magazine Explosion by 1, to a minimum of 0. A Twin Lance Turret that would suffer 1 Damage Control instead suffers 0 and ignores the effect; a Triple Lance Turret that would suffer 2 instead suffers 1. No other effect of a Magazine Explosion is prevented or reduced. Once per ship. Not available to Gloriana class or above.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="20.0" />
       </costs>
      </selectionEntry>
      <selectionEntry id="335d5692-6607-5c5d-8801-c64d6b3f9965" name="Emergency Shield Capacitors" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="d2f9b8b7-ad3c-5f74-828e-775dc850c7d5" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="eda668c4-328c-5310-ac59-5ccd9c661883" name="Emergency Shield Capacitors" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Re-roll failed Void Shield regeneration rolls. It confers no other benefit and can never raise a ship above its normal number of Void Shields; a shield burnt out after a failed re-roll stays burnt out for the rest of the battle. Once per ship.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="25.0" />
       </costs>
      </selectionEntry>
      <selectionEntry id="46be7a78-637c-5c6d-83ab-dad1eab92849" name="Servitor Autoloaders" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="21922c93-4150-5aff-a824-44645e2fdef4" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="a44f588e-e8ba-5f32-a45e-3560c9043638" name="Servitor Autoloaders" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Reload value of every weapon and system aboard this ship by 1, to a minimum of Reload 0 — Reload (3) becomes Reload (2), Reload (2) becomes Reload (1), Reload (1) becomes Reload (0). A weapon reduced to Reload (0) has no cooldown and may fire every applicable battle round. Once per ship. Not available to Gloriana class or above.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="70.0" />
       </costs>
      </selectionEntry>
     </selectionEntries>
    </selectionEntryGroup>
   </selectionEntryGroups>
