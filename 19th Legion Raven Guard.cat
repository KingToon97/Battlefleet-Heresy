      <selectionEntry id="c8805da6-9d6d-5edb-a8ea-baa890df5f84" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="54a2e9d1-8074-5d1b-bc4a-68942973583e" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="4af39461-33db-581b-a84e-eb6ebd78c4d3" name="Plasma Drive Overhaul" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="25.0" />
