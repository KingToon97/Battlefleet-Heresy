       </constraints>
       <profiles>
        <profile id="c92bb929-2ae9-5466-86ff-4c116e9680cd" name="Mor Deythan Shades" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">One Crew point; +2 to its boarding die. Maximum 1 per ship, and it does not count against the Terminator limit. The first round of any boarding action this unit joins is fought without the enemy rolling: its duels are won automatically.</characteristic>
