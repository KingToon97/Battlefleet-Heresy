      <selectionEntry id="61d5dd2a-a42c-54bf-aec1-8ecc4122c487" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="9442f54c-9418-5ee2-a179-160a77fa9386" shared="false" includeChildSelections="false" />
