    <profile id="dc39f57e-dcff-5597-9283-f1f2053b5b51" name="Launch Bays (4)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship carries 4 Launch Bays, sited on her broadsides. Each holds one aircraft squadron, bought separately. See Launch Bays &amp; Aircraft.</characteristic>
     </characteristics>
    </profile>
    <profile id="9bb4c59a-5ea6-5935-a36c-29e9ba40aa3a" name="Fire Control Coordination" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ship Type: Grand Cruiser. This ship may split its fire without suffering the −1 BS penalty for doing so. All other restrictions on Splitting Fire still apply.</characteristic>
     </characteristics>
    </profile>
