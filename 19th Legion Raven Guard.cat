 <sharedRules>
  <rule id="c7c5124b-fcd9-5ff5-ae25-1ef7ec84a1c3" name="19th Legion - Surgical Strikes" hidden="false">
   <description>Friendly ships held in reserve may arrive from battle round 2 within the opponent's deployment zone, facing any direction, rather than from a board edge. An arriving ship moves no further that round and may not arrive within 6″ of an enemy ship. All other reserve rules apply.</description>
  </rule>
 </sharedRules>
