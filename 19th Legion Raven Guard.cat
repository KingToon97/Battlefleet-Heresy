     </constraints>
     <selectionEntries>
      <selectionEntry id="48d2dc8a-45e8-5f08-b399-0d636204e9d6" name="Adamantium Belt Armour" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="4ec116d9-ed1a-51f1-80d1-1711a53e6e51" shared="false" includeChildSelections="false" />
