      <selectionEntry id="8baa88e8-0c38-5de5-a649-9b32ac3a77c5" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="38979021-b401-5797-ab22-c7cd0b9f3c2e" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="45c9793d-c958-57b6-a38b-9c5242d109c4" name="Plasma Drive Overhaul" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="60.0" />
