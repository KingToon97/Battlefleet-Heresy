    <profile id="c9d5a468-c0ac-569b-94ae-7da653cc3549" name="Launch Bays (5)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship carries 5 Launch Bays, sited on her broadsides. Each holds one aircraft squadron, bought separately. See Launch Bays &amp; Aircraft.</characteristic>
     </characteristics>
    </profile>
    <profile id="74099dbe-abbf-5270-8e51-3d69cb2f49c3" name="Pride of the Legion" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ship Type: Gloriana. This ship ignores the Crippled and Depleted −1 BS penalties, and friendly ships within 12″ may re-roll a failed Damage Control roll once each battle round. She must be the fleet's Flagship, one per battle, and may be fielded only at 2,000 points or more.</characteristic>
     </characteristics>
    </profile>
   </profiles>
