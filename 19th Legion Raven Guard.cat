      <selectionEntry id="6b060131-87cd-5ce7-a57b-8e6286df229e" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="2a893e91-a330-52f2-8c33-e4ce8c7c04eb" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="7103be3e-5a3a-5e9b-ab66-86c62cdf711a" name="Plasma Drive Overhaul" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
