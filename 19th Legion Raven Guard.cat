    <profile id="d8503653-036d-5f1d-950b-4400bc5bca65" name="Defence Battery ×4" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
     <characteristics>
      <characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">All-round</characteristic>
      <characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">6</characteristic>
      <characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">5</characteristic>
      <characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3 each</characteristic>
      <characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">12″</characteristic>
      <characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Skyfire; Interceptor. Aircraft to 12″; ships within 6″</characteristic>
     </characteristics>
    </profile>
    <profile id="b80d499a-48f1-56c3-8861-74203a5e60b7" name="Pattern" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">A carrier cruiser, her broadside cut back to make room for the bays.</characteristic>
     </characteristics>
    </profile>
    <profile id="c65c1fbf-e1c4-598a-8968-c63991acecbb" name="Launch Bays (2)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship carries 2 Launch Bays, sited on her broadsides. Each holds one aircraft squadron, bought separately. See Launch Bays &amp; Aircraft.</characteristic>
     </characteristics>
    </profile>
    <profile id="1a1a51ed-c852-5602-96db-0c094320b8d7" name="Enduring Hull" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
