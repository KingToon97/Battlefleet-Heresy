       </constraints>
       <profiles>
        <profile id="699b9db0-9c9c-5eb3-b771-d233a4daa854" name="Adamantium Belt Armour" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic>
