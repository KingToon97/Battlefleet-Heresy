       </constraints>
       <profiles>
        <profile id="26a3ef63-1383-5f66-ac08-d14f941aaf25" name="Mor Deythan Shades" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">One Crew point; +2 to its boarding die. Maximum 1 per ship, and it does not count against the Terminator limit. The first round of any boarding action this unit joins is fought without the enemy rolling: its duels are won automatically.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <categoryLinks>
        <categoryLink id="dc383963-3fbb-51b4-9605-0b2aa9142087" name="Boarding Force" hidden="false" targetId="4d94b920-d5bc-5fd7-a967-4ba346019f56" primary="true" />
