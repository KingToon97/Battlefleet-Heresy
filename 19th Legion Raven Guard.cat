      <selectionEntry id="c7a89874-3705-5a5b-bd34-0b5a08f30ab1" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="2c701ffb-6608-5cf5-8cf7-77e172ebf6c1" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="98c361f0-0b52-53b5-bc57-08b3eee20073" name="Plasma Drive Overhaul" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
