 <constraint type="max" value="5.0" field="selections" scope="parent" shared="false" id="51968a44-205d-5ee3-b0e9-d8916c5b36d2" percentValue="false" includeChildSelections="false" includeChildForces="false" />
 </constraints>
 <profiles>
 <profile id="483e6d14-ce50-5090-a12d-dc80ff461c9c" name="Boarding Force" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Counts as 2 Crew; fights as one warrior at +2 and gives −1 to the enemy die it faces. Limits as Terminators.</characteristic>
