<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="baa5cdd7-65c8-57c7-bc61-1fe1a58bcc94" name="15th Legion Thousand Sons" revision="8" battleScribeVersion="2.03" gameSystemId="86405571-5289-597b-b308-a9a2d68c00b9" gameSystemRevision="5" library="false">
