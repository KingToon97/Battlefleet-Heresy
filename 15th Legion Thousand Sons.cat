 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Friendly Lance Turrets, Twin and Triple Lance Turrets, and AP D weapons add +1 to their Damage Table rolls.</characteristic>
 </characteristics>
 </profile>
 <profile id="b8666499-d579-4697-a9bc-5b0c19cfdbee" name="Primarch Retinue" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This character is embarked as the Primarch's additional named retinue. They do not add Fleet Orders, Command range or any command ability; only effects unrelated to the order economy apply.</characteristic></characteristics></profile></profiles>
