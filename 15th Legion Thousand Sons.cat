 <selectionEntryGroup id="7439ef8f7da1b3d8c228238ce1a978cf" name="Hull Upgrades" hidden="false"><constraints><constraint type="max" value="6.0" field="selections" scope="parent" shared="false" id="9cc3855d-7908-5f99-93b4-524289f960ab" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="54ba2dde51b9c1e8488e7605fbd368c5" name="Side Armour Reinforcement" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="bebec4d2e7c9ce31c7ede7750f008406" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="64434aed2cf1caa259ea5854f8dd9700" name="Side Armour Reinforcement" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="120.0" /></costs></selectionEntry><selectionEntry id="9e343c0d4dbf5b605f3950de791ed479" name="Engine Refit" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="fc184c38ffd5f9d0f05357d022b518f7" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="6528f73b4f7ac3f9fee4057739146ec2" name="Engine Refit" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="160.0" /></costs></selectionEntry><selectionEntry id="796d3b33-1da8-57c6-9676-f2742a888831" name="Phosphex Shells" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="9d01732e-a403-5d5e-9e62-597144351619" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="f01b9375-0ea3-5d8e-8bba-85e17ffe8045" name="Phosphex Shells" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Every Heavy Macrobattery aboard fires phosphex: whenever one penetrates armour, the target takes 1 Critical Damage. Requires at least one Heavy Macrobattery.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="80.0" /></costs></selectionEntry><selectionEntry id="af750d1d-0ce1-5a4a-a4de-02d0671ee3e6" name="Reinforced Magazine Compartments" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="1761eb5e-6d59-5732-80b4-f0008a00ffc2" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="b925a2fc-7af4-56d0-af7e-7f82a4384ec3" name="Reinforced Magazine Compartments" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Damage Control caused by a Magazine Explosion by 1, to a minimum of 0. A Twin Lance Turret that would suffer 1 Damage Control instead suffers 0 and ignores the effect; a Triple Lance Turret that would suffer 2 instead suffers 1. No other effect of a Magazine Explosion is prevented or reduced. Once per ship. Not available to Gloriana class or above.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="80.0" /></costs></selectionEntry><selectionEntry id="adade6c6-233a-5ac1-9e5c-2788684d4216" name="Enhanced Void Shield Array" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="66747fac-dba1-5be2-ac00-cf4cb7168e0a" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="bbd0243b-f3a7-5277-867d-5d6056365ac5" name="Enhanced Void Shield Array" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">At the end of each battle round this ship regains 1 lost Void Shield, provided its Void Shields are currently active. It can never exceed its normal maximum. If its Void Shields have completely collapsed, been disabled, or are otherwise inactive, this upgrade cannot regenerate them; once at least one Void Shield is restored and the shields are active again, it resumes functioning normally. Once per ship. Not available to Gloriana class or above.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="120.0" /></costs></selectionEntry><selectionEntry id="4aa837ab-8c7b-5b26-ab1a-b56fc1637190" name="Autoloaders" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="a06dc2ef-5fff-5a14-8848-b2604b59ea3e" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="add38817-280a-54b0-99d7-b6ef32e91ba2" name="Autoloaders" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Reload value of every weapon and system aboard this ship by 1, to a minimum of Reload 0 — Reload (3) becomes Reload (2), Reload (2) becomes Reload (1), Reload (1) becomes Reload (0). A weapon reduced to Reload (0) has no cooldown and may fire every applicable battle round. Once per ship. Not available to Gloriana class or above.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="160.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
 <costs>
 <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="180.0" />
 </costs>
 </selectionEntry>
 <selectionEntry id="40059ec5-a064-5449-979f-e5a11dbdc972" name="Core Rules" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="force" shared="false" id="7ef4815e-e4b9-56df-858d-d100d1c21b81" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><rules><rule id="dd3c7256-db72-5aa9-af76-af1b2554776f" name="The Battle Round" hidden="false"><description>1. Muster — flip Reload tokens and remove any reaching 0, refresh the fleet's Fleet Order allowance, declare Reactor Overloads. In the first battle round roll off for Initiative; in every later round it passes to whoever finished the previous round. The holder moves, shoots and rams first for the whole round. 2. Movement — alternate one ship each, then one aircraft squadron each. 3. Shooting — alternate one ship or squadron each. 4. Ramming &amp; Boarding — alternate one ship each. 5. End of round — resolve dogfights, then Critical Damage. A game lasts six rounds, and every duration runs to the end of the battle round unless it names something else.</description></rule><rule id="75a954e1-a803-5730-a5e9-08787924a9dc" name="Movement" hidden="false"><description>A ship moves at least half its Speed and never more than 12″ (All Ahead Full excepted). It may make one turn per battle round, up to its Turn value, taken either at the start or at the end of its move — no straight run is required before turning. Ships may never overlap unless a Ram is declared; accidental contact stops the moving ship 1″ short.</description></rule><rule id="f33fea9f-5c77-5e30-80e5-66c65b78d823" name="Shooting" hidden="false"><description>A ship fires everything that bears at one enemy ship each round — it never divides its fire, though a squadron may. Roll a D6 per shot, hitting on 7 − BS. A natural 1 always misses and no modifier lowers the roll below 2+. Modifiers: target is a wreck +1 — a hulk cannot dodge. A ship that held station under Burn Retros fires its Port and Starboard broadsides at +1 BS.</description></rule><rule id="ea55d302-34c8-5e71-9e49-d3db83e90b64" name="Void Shields" hidden="false"><description>While Void Shield Rating is above 0 the shields are Armour Value 12 and every hit strikes them rather than the hull. Roll 1D6 + Strength against AV 12; equal or better collapses one layer and does nothing else — no Hull Points, no Damage Table. There is no save. At VS 0 the shields collapse permanently, with no restoration or repair, and AP applies in full. Torpedo Tubes, Vortex Torpedoes, Melta Mines and the Abyss's Warp Lance Batteries bypass shields entirely. Nothing else does.</description></rule><rule id="9aff8de1-0d4f-59fd-ac60-3f2a199a5f90" name="Penetration" hidden="false"><description>For each hit past the shields, roll 1D6 + Strength against the Armour Value of the facing struck. Equal = Glancing Hit: 1 Hull Point, no damage roll. Greater = Penetrating Hit: 1 Hull Point and a roll on the Damage Table. No Armour Value may exceed 14 by any means.</description></rule><rule id="83baf16a-1ec0-5422-9dad-03c1c266b0a1" name="Point-Blank Broadsides" hidden="false"><description>At 6″ or less, Port, Starboard and Dorsal weapons improve their AP by one step — a Macrobattery to AP 2, a Heavy Macrobattery to AP 1. A weapon whose printed AP is already 1 gains Armourbane instead. Never both, and Prow weapons get neither.</description></rule><rule id="a66a308c-c92e-53ed-9fe9-213e2d12d2a8" name="Stern Strike" hidden="false"><description>When a Strength 9+ weapon rolls a natural 6 on its penetration die against a target's Stern and beats the Stern AV, the hit also inflicts Engines Crippled at once. With Armourbane at least one of the two dice must show a 6. It does not stack with an Engines Crippled already rolled, and while shields hold the hit must bring them down first.</description></rule><rule id="3197704f-1478-50bb-90d2-ebc914ae383d" name="Ship Damage Table" hidden="false"><description>Roll a D6 when a Penetrating Hit is scored. Modifiers: AP 2 +1 • AP 1 +2 • Destroyer +3 in place of any AP modifier, +2 against a Gloriana, the Abyss or the Phalanx • Ramming +1 • Battleship target −1. A modified 7+ counts as Reactor Struck; below 1 counts as 1, and a 1 does nothing.
1 HELD • Immediate: none. • Ongoing: none.
2 BLAZE • Immediate: 1 Critical Damage. • Ongoing: the ship loses 1 Crew at the end of each battle round for each Critical Damage it carries. • Repair: Damage Control clears the whole stack at once.
3 HULL BREACH • Immediate: 1 Critical Damage. • Ongoing and repair: as Blaze.
4 MAGAZINE EXPLOSION • Immediate: 1 Hull Point, 2 if the ship mounts Triple Lance Turrets, plus 1 Critical Damage, and one random Port, Starboard or Dorsal weapon system destroyed. • Ongoing: the destroyed system cannot fire. • Repair: Damage Control may repair one destroyed system. • Note: Reinforced Magazine Compartments reduces the Damage Control suffered by 1, to a minimum of 0.
5 ENGINES CRIPPLED • Immediate: immobile, and Snap Shots only. • Ongoing: no Firing at anchor bonus, and −1 on Evade. It may still be issued Fleet Orders. A second result leaves the ship Adrift — 2D6″ straight ahead, no turning. • Repair: Damage Control clears it, Adrift becoming Engines Crippled.
6 REACTOR STRUCK • Immediate: a Line Ship suffers a Catastrophic Explosion at once; a Capital Ship takes D3 Hull Points then rolls a D6, detonating on a 6; a Gloriana or larger takes D3 and rolls 2D6, detonating if either die shows a 6. • Ongoing: none. • Repair: none.</description></rule><rule id="3281bd23-c96b-5500-a4d0-a2a5259305ea" name="Destruction" hidden="false"><description>At 0 Hull Points roll a D6 once: on a 6 the ship is torn apart in a Catastrophic Explosion and every ship within the blast radius suffers one hit against its nearest facing — Str 8 AP 3 from a Line Ship, Str 9 AP 2 from a Capital Ship or Void Fortress. On any other result it becomes a wreck. Blast radius: Destroyer, Frigate or Assault Barge 3″ · Cruiser D6″ · Grand Cruiser or Battle Barge D6+3″ · Battleship or Gloriana 2D6″ · Abyss 3D6″.</description></rule><rule id="294f1cd2-cdc0-5b24-8c3f-be5f2f5ed955" name="Ramming" hidden="false"><description>Free, needing no Fleet Order, against one enemy within 6″ of the rammer's prow. Roll a D6, −1 if the rammer mounts a prow Nova Cannon bought as an upgrade; the ram connects if it equals or beats the distance in inches. The target may Evade on 5+. On impact the target suffers one hit at Strength = the rammer's Prow AV, ignoring Void Shields, penetrating on 1D6 + Str with no Armourbane; a hit that glances or penetrates inflicts D6 Hull Points and a penetrating hit rolls on the Damage Table at +1. The rammer loses D3 Hull Points. Survivors remain Locked.</description></rule><rule id="77f261cc-284a-5b55-804c-6e7458d799a2" name="Fleet Orders" hidden="false"><description>Only the Flagship issues orders, within 24″ Command range, and no order needs a test. Each battle round the fleet may issue orders of each of the three types up to its commander's rank: Fleet Captain 1, Named Character 2, Primarch 3. No ship takes two orders of the same type in a round, ranks never combine, and nothing adds to the allowance. Unspent orders do not carry over.
DAMAGE CONTROL (Command) • Issued: in the ship's activation. • Target: one friendly ship in range. • Effect: roll a D6, Legion fleets re-rolling; on 4+ choose one — remove every Critical Damage, repair one destroyed weapon system, or clear Engines Crippled. • Duration: immediate. • Restriction: the ship fires only Snap Shots this round.
FOCUS FIRE (Command) • Issued: as the ship fires. • Target: one friendly ship, against one enemy ship. • Effect: +1 BS. • Duration: this round. • Restriction: shares the single +1 pool with the anchor bonus and accuracy auras.
BRACE FOR IMPACT (Command, Reaction) • Issued: the moment this ship is attacked. • Effect: halve all Hull Point loss, rounding up. • Duration: to the end of the round. • Restriction: the ship fires only Snap Shots until then.
ALL AHEAD FULL (Movement) • Issued: as the ship moves. • Effect: move +D6″, beyond the 12″ ceiling. • Restriction: may fire only Defence Batteries.
BURN RETROS (Movement) • Issued: as the ship moves. • Effect: move less than half Speed or not at all; a ship holding station (1″ or less) may pivot freely and fires its broadsides at +1 BS. • Restriction: −1 on Evade rolls.
EVADE (Movement, Reaction) • Issued: when this ship is shot at or rammed, before any dice are rolled. • Effect: on 5+ the whole attack misses, or the ram fails and the rammer is moved 1″ past. • Modifiers: +1 Destroyer or Frigate; −1 held station; −1 Crippled, Adrift or Engines Crippled; −1 mounting no standard Macrobatteries; never worse than −2. • Restriction: once per battle round; wrecks and Speed 0 installations never Evade.
RELOAD ORDNANCE (Shooting) • Issued: as the ship fires. • Target: one weapon system on a friendly ship. • Effect: remove one Reload token. • Restriction: a system bearing no token cannot be chosen.
RETURN FIRE (Shooting, Reaction) • Issued: when this ship is attacked and survives. • Effect: fire back at −1 to hit with every weapon that bears on the attacker. • Restriction: not systems already fired this round, nor one-shot or reloading weapons.
OVERWATCH (Shooting, Reaction) • Issued: when a boarding craft or drop pod runs at this ship. • Effect: snap-fire Defence Batteries at that craft; destroyed on 5+. • Restriction: Defence Batteries only.</description></rule><rule id="c1f369ab-5721-5f56-8ef1-e588964aa916" name="Reactions" hidden="false"><description>Brace for Impact, Return Fire and Overwatch are Fleet Orders with a trigger, issued the moment a friendly ship is attacked or targeted, whether or not that ship has already acted. They count against the round's allowance however many ships are under fire — an order spent defending is one you no longer have for your own turn.</description></rule><rule id="2d7e84d6-b0f8-531c-b2c9-26c23e2eaf47" name="Evade" hidden="false"><description>A Movement order, declared when the ship is shot at or rammed and before any dice are rolled. Roll a D6: on a 5+ the whole attack misses, or the ram fails and the rammer is moved 1″ past its intended victim. Modifiers: +1 Destroyer or Frigate · −1 held station · −1 Crippled, Adrift or Engines Crippled · −1 mounting no standard Macrobatteries. Never worse than −2. Once per battle round; wrecks and Speed 0 installations never Evade.</description></rule><rule id="3857b0f7-4959-5a15-a8d7-a747b5daf153" name="Boarding Actions" hidden="false"><description>Crew are the hit points of boarding, and an action begins and ends in one Ramming &amp; Boarding step. Declare the Crew committed and the delivery method, then deduct them; a ship always keeps 1 aboard. Every fighter rolls his own D6 with his own bonus, and bonuses never combine into one roll. Starting with the boarders, players alternate nominating duels: the higher total fells its opponent, and ties re-roll until one is higher. Fight on until one side reaches 0 Crew or the boarders withdraw. Defenders reduced to 0 lose the ship — Capture or Scuttle. Modifiers to every die on that side: +1 boarders in the first round if delivered by craft, pod or teleport (never a Hull Assault) · +1 boarders if the enemy ship is Crippled · +1 boarders if it is Engines Crippled · −1 defenders if the ship carries any Critical Damage.</description></rule><rule id="c6a76010-993d-552b-9f34-26948f58d75a" name="Hit-and-Run" hidden="false"><description>Instead of a full boarding, commit 1 Crew — so never a Dreadnought, which is two. Roll D6 plus the raider's own bonus. On 4+ choose one: destroy one weapon system or Hangar Bay; inflict 1 Critical Damage; cripple the enginarium (Engines Crippled); or sabotage the shields, reducing VS Rating by D3, or D6 against a Capital Ship, permanently. The raider returns. On a failure the raider is lost.</description></rule><rule id="056274f6-a34b-50ff-80ec-c8ea9499da44" name="Attrition" hidden="false"><description>There is no Morale. Ships do not flee and take no tests — they fight until wrecked, taken, or the battle ends, and they fight worse as they break down. Crippled and Depleted stack, so a ship can fire at −2. Broken Fleet: once three quarters of a fleet's starting points are lost it loses the battle at once. Count a lost ship at full cost, upgrades and any Fleet Commander aboard included; aircraft never count.</description></rule><rule id="a5b2d0f7-5f7f-5d59-9f91-2755968588db" name="Fleet Construction" hidden="false"><description>Capital Ship allowance is generated by Line Ships: for every 4 individual Line Ships in the fleet you may include 1 Capital Ship. 0–3 Line Ships permit no Capital Ship; 4–7 permit 1; 8–11 permit 2; 12–15 permit 3, and so on — maximum Capital Ships = Line Ships ÷ 4, rounded down. Individual vessels count, not roster entries: a squadron of four Destroyers is four Line Ships. Line Ships are the Destroyer, Frigate, Light Cruiser, Assault Barge and Cruiser. Capital Ships are the Grand Cruiser, Battle Barge, Battleship, Emperor Battleship, Gloriana and Abyss, and the Phalanx above them. No single ship may exceed 50% of the fleet's points, upgrades included. Destroyers and Frigates have the Squadron keyword: each is taken singly, and up to 3 may be grouped into one squadron. Minimum game size: Gloriana 2,000; Abyss and Phalanx 3,000.</description></rule><rule id="67192dc2-0994-5e43-ae2b-1a12c16ac396" name="Veteran Crews &amp; Commanders" hidden="false"><description>Any ship may take a Veteran Crew once: +1 Ballistic Skill for the battle, 60 pts for a Line Ship and 150 pts for a Capital Ship. No ship exceeds BS 5, and a ship takes at most one +1 BS from position or command — Firing at anchor, Focus Fire and accuracy auras never stack with each other. A Veteran Crew's +1 is a paid upgrade and stacks on top. Every fleet has exactly one commander, the highest rank present, riding the Flagship and lost if that ship is destroyed, captured or wrecked. Each rank carries its own command ability: Ship’s Master, Practised Command, or The Fleet Obeys.</description></rule><rule id="c3eb45c7-8160-502a-808f-40bbd1fe5d4c" name="Keyword: Armourbane" hidden="false"><description>Roll 2D6 + Strength to penetrate instead of 1D6, at 6″ or less, against shields or hull alike. Torpedo Tubes and the Starhawk's plasma bombs carry it outright; a broadside or dorsal weapon of printed AP 1 gains it inside 6″ in place of the AP step it cannot take. Macrobatteries never gain it, and neither do rams — the Conqueror's Ursus Claws excepted. Destroyer weapons never roll to penetrate, so it does nothing for them.</description></rule><rule id="b0166c44-b66d-5369-b776-c853a3eb84a8" name="Keyword: Destroyer (D)" hidden="false"><description>Any weapon of AP D. Strength never exceeds 12. It penetrates automatically — no roll, whatever the Armour Value — and can never merely glance. Every Damage Table roll it causes is made at +3 in place of any AP modifier, or +2 against a Gloriana, the Abyss or the Phalanx. It is always at least Devastating (3). It does not pass Void Shields: while they hold it beats AV 12 automatically and collapses 3 layers, and does nothing else.</description></rule><rule id="c2981fcd-298f-5339-81cd-7cf95cc1ade8" name="Keyword: Devastating (X)" hidden="false"><description>Each unsaved hit costs the target X Hull Points instead of 1, whether it glances or penetrates. A penetrating Devastating hit still rolls once on the Damage Table, keeping its AP modifier. Against active shields a Devastating hit still costs only 1 Void Shield Rating, however large its X.</description></rule><rule id="0051097d-d0f9-58de-8e56-ed1cf9992151" name="Keyword: Gets Hot" hidden="false"><description>After a Lance Turret or Twin Lance Turret has resolved its attacks, roll a D6. On a 1 the firing ship suffers 1 Hull Point. Each mount rolls separately. Self-inflicted rolls have no attacker or facing: the owning player makes any choices, from any facing, but must choose a functioning system.</description></rule><rule id="182683e5-a875-5131-9a02-7ee3d291e475" name="Keyword: One Shot" hidden="false"><description>Fired once per battle, then spent. It takes no Reload tokens.</description></rule><rule id="5c130922-7c0e-54f7-8dbf-fab0e7892a6b" name="Keyword: Reload (X)" hidden="false"><description>After firing, place X Reload tokens on the mount. Flip the token at the end of each battle round — 2 becomes 1 — and remove it when it would reach 0. The mount cannot fire while it bears a token, so Reload (1) speaks every round and Reload (2) every second. The Reload Ordnance order removes one counter early.</description></rule><rule id="625e4033-0e77-5707-8de1-2bf941cf1bb6" name="Keyword: Skyfire" hidden="false"><description>Fires at full Ballistic Skill against aircraft.</description></rule><rule id="bde290e1-2dae-571e-ac80-7a2a2578b23e" name="Keyword: Twin-Linked" hidden="false"><description>Re-roll failed To Hit rolls.</description></rule><rule id="4008c0c5-84dd-5559-a994-6135b12da6e9" name="Keyword: Volatile" hidden="false"><description>An unmodified 1 To Hit resolves the attack against the firing ship instead, at the full profile — against the facing the launcher is mounted in. The launcher is spent either way.</description></rule><rule id="1ac488c0-617a-5817-a2f5-72a3317c71c7" name="Keyword: Critical Damage" hidden="false"><description>Fires, breaches and burning phosphex — one rule for all of them. A ship may carry up to 3 Critical Damage, marked with a single token. At the end of each battle round it loses 1 Crew for each Critical Damage it carries, always, with no roll. A successful Damage Control order clears the whole stack at once.</description></rule><rule id="a86e7c28-bf32-5791-8b74-1357caa5b4e4" name="Mounts &amp; Arcs" hidden="false"><description>Prow — the forward 90° arc. Port / Starboard — that side's 90° arc; these are the broadsides. Dorsal — every arc but the Stern; counts as a broadside for Point-Blank Broadsides, but gains no Firing at anchor bonus. All-round — every arc. Straight ahead — Torpedo Tubes only: a line drawn directly forward from the prow, and only a ship that line crosses may be targeted. The facing struck is whichever of the target's arcs the firer sits in. Broadsides are per side: each line of a datasheet is its own weapon system in that facing.</description></rule><rule id="dfb1709a-95d7-53d3-954b-a1fef9b49be9" name="State: Adrift" hidden="false"><description>A second Engines Crippled. The ship moves 2D6″ straight ahead when it would move, cannot turn, and fires Snap Shots only.</description></rule><rule id="a18e958f-a4a7-5a4e-9443-66f6332256f8" name="State: Crippled" hidden="false"><description>Below half starting Hull Points: −1 BS and half Speed.</description></rule><rule id="f59b25a2-2489-5ba9-a9db-629ce0cab3e6" name="State: Depleted" hidden="false"><description>At half starting Crew or less: −1 BS. Stacks with Crippled.</description></rule><rule id="7d8a1b2f-33b1-5115-8a56-32ada12cf0fe" name="State: Engaged" hidden="false"><description>Two aircraft squadrons within 1″. Neither may act against ships, and no ship may fire on either — Defence Batteries, Interceptor and Overwatch included. Resolved at the end of the battle round.</description></rule><rule id="97227816-fcde-5a36-92ee-d490e1de35ad" name="State: Engines Crippled" hidden="false"><description>Immobile and Snap Shots only until repaired. It may still be issued Fleet Orders. It gains no Firing at anchor bonus for standing still, though it still suffers −1 on Evade.</description></rule><rule id="2beaf30f-70ce-560f-a19b-70ef1c1942f5" name="State: Held station" hidden="false"><description>Moved 1″ or less under Burn Retros. Broadsides fire at +1 BS; −1 on Evade. A ship holding station may pivot freely on the spot.</description></rule><rule id="90f9a03c-e36e-5818-ad98-c0a4976b8ac4" name="State: Locked" hidden="false"><description>Two ships joined by a ram. Neither may move; the rammer may not fire on its victim, who fires back at −1 BS against the rammer's Prow. Both fire at other enemies normally. Break Away on 5+, when the ship would move, once each per battle round: the rammer disengages 1″ away, a defender tears free 1″ away and suffers D3 Hull Points.</description></rule><rule id="21d7c642-117a-5dd9-8027-0132a7fbb109" name="State: Snap Shots" hidden="false"><description>Firing at BS 1 — hits only on a 6.</description></rule><rule id="d2768ca7-d2ba-511c-872a-1d1b5b934f36" name="State: Wreck" hidden="false"><description>0 Hull Points without exploding. It becomes obscuring terrain: impassable, blocks line of sight, and no straight-line weapon may fire across it. It never moves, never drifts and never Evades, and having no Crew it cannot be boarded or captured.</description></rule><rule id="a7b2d83e-215e-5ee4-aab4-7314e02605e5" name="Keyword: Turning" hidden="false"><description>Turning is universal: any ship may turn at the start or the end of its move.</description></rule><rule id="7f2a8d78-beee-5e59-9f21-e57c2b54cae6" name="Keyword: Interceptor" hidden="false"><description>A Defence Battery may fire the moment an enemy squadron comes within 12″ as the enemy moves, before it attacks — but then does nothing else that battle round, Overwatch included.</description></rule><rule id="fa7b5fcb-660f-5899-8962-6eaab645c858" name="Keyword: Breachers" hidden="false"><description>+1 to all Boarding combat rolls, and enemy dice fighting them suffer −1. The −1 of a Dreadnought, or of an Astartes Breacher defending his own ship, falls on the one enemy die paired against him.</description></rule><rule id="b7f7034a-5420-5275-8746-5b800573ebe3" name="Keyword: Intervention" hidden="false"><description>Destroyers and Frigates only, and it costs no order. When a friendly ship within 3″ is attacked, rammed, or targeted by torpedoes, a Destroyer or Frigate no more than 10″ from the attacker may thrust into the firing line: it does not move, and the whole attack resolves against it instead, striking whichever facing lies toward the attacker. Once per ship per battle round.</description></rule><rule id="ca93d969-f524-5361-a400-e6a86f760ff4" name="Keyword: Wolf Pack" hidden="false"><description>Destroyers of one squadron within 6″ may combine fire on a single target, adding +1 to penetration. Gunnery only, never Torpedo Tubes. Frigates do not have Wolf Pack.</description></rule><rule id="adbc2b90-eba2-544b-a4b0-3c6af4b94fa6" name="Keyword: Melta Mines" hidden="false"><description>Each Frigate may carry two Melta Mines. No other class may take them. In the Movement step, after the Frigate has moved and instead of shooting, place a mine on a 32mm base in contact with the ship's base — one mine per round, Reload (2), and never within 6″ of an enemy ship. A mine detonates the moment any part of a non-Frigate ship's base passes over it. Every ship within 3″, friend or foe and including the ship that triggered it, immediately suffers one hit at Strength 9, AP 2 with Armourbane, resolved against the facing nearest the mine. Melta Mines bypass Void Shields entirely. Frigates of either fleet pass over mines safely, and aircraft ignore them. Remove the marker once the blast is resolved.</description></rule><rule id="34a006f7-7e9a-5439-815a-36f2d6421b17" name="Keyword: Broken Fleet" hidden="false"><description>Once three quarters of a fleet's starting points are lost, it loses the battle at once.</description></rule></rules><categoryLinks>
 <categoryLink id="3e5f05b5-682d-5b42-8bb3-d6764a82bcd0" name="Rules" hidden="false" targetId="52616092-abd8-519e-a6fb-94b622114fa5" primary="true" /></categoryLinks>
 <costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" /></costs></selectionEntry><selectionEntry id="06b86bfe-203e-54f2-9e28-fbe79dcaab01" name="Damage Table" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="force" shared="false" id="b01c4254-5007-570e-bc39-969f61e838cd" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><rules><rule id="4d33c981-2823-5f62-b1a0-88474eb16cf5" name="Ship Damage Table" hidden="false"><description>Roll a D6 when a Penetrating Hit is scored. Modifiers: AP 2 +1 • AP 1 +2 • Destroyer +3 in place of any AP modifier, +2 against a Gloriana, the Abyss or the Phalanx • Ramming +1 • Battleship target −1. A modified 7+ counts as Reactor Struck; below 1 counts as 1, and a 1 does nothing.
1 HELD • Immediate: none. • Ongoing: none.
2 BLAZE • Immediate: 1 Critical Damage. • Ongoing: the ship loses 1 Crew at the end of each battle round for each Critical Damage it carries. • Repair: Damage Control clears the whole stack at once.
3 HULL BREACH • Immediate: 1 Critical Damage. • Ongoing and repair: as Blaze.
4 MAGAZINE EXPLOSION • Immediate: 1 Hull Point, 2 if the ship mounts Triple Lance Turrets, plus 1 Critical Damage, and one random Port, Starboard or Dorsal weapon system destroyed. • Ongoing: the destroyed system cannot fire. • Repair: Damage Control may repair one destroyed system. • Note: Reinforced Magazine Compartments reduces the Damage Control suffered by 1, to a minimum of 0.
5 ENGINES CRIPPLED • Immediate: immobile, and Snap Shots only. • Ongoing: no Firing at anchor bonus, and −1 on Evade. It may still be issued Fleet Orders. A second result leaves the ship Adrift — 2D6″ straight ahead, no turning. • Repair: Damage Control clears it, Adrift becoming Engines Crippled.
6 REACTOR STRUCK • Immediate: a Line Ship suffers a Catastrophic Explosion at once; a Capital Ship takes D3 Hull Points then rolls a D6, detonating on a 6; a Gloriana or larger takes D3 and rolls 2D6, detonating if either die shows a 6. • Ongoing: none. • Repair: none.</description></rule><rule id="ad62778b-4d0a-53ed-b86a-63643635729d" name="Penetration" hidden="false"><description>For each hit past the shields, roll 1D6 + Strength against the Armour Value of the facing struck. Equal = Glancing Hit: 1 Hull Point, no damage roll. Greater = Penetrating Hit: 1 Hull Point and a roll on the Damage Table. No Armour Value may exceed 14 by any means.</description></rule><rule id="aee38e5d-051e-5c59-b8a4-bb2bbab51a57" name="Stern Strike" hidden="false"><description>When a Strength 9+ weapon rolls a natural 6 on its penetration die against a target's Stern and beats the Stern AV, the hit also inflicts Engines Crippled at once. With Armourbane at least one of the two dice must show a 6. It does not stack with an Engines Crippled already rolled, and while shields hold the hit must bring them down first.</description></rule><rule id="b3eb23cf-2083-54fd-80ee-d7da793520e2" name="Destruction" hidden="false"><description>At 0 Hull Points roll a D6 once: on a 6 the ship is torn apart in a Catastrophic Explosion and every ship within the blast radius suffers one hit against its nearest facing — Str 8 AP 3 from a Line Ship, Str 9 AP 2 from a Capital Ship or Void Fortress. On any other result it becomes a wreck. Blast radius: Destroyer, Frigate or Assault Barge 3″ · Cruiser D6″ · Grand Cruiser or Battle Barge D6+3″ · Battleship or Gloriana 2D6″ · Abyss 3D6″.</description></rule><rule id="cfcd085d-e4e2-5ad7-a977-9769eec67d0e" name="Keyword: Devastating (X)" hidden="false"><description>Each unsaved hit costs the target X Hull Points instead of 1, whether it glances or penetrates. A penetrating Devastating hit still rolls once on the Damage Table, keeping its AP modifier. Against active shields a Devastating hit still costs only 1 Void Shield Rating, however large its X.</description></rule><rule id="30e82b5d-ca67-5d84-b119-2d94c73b0788" name="Keyword: Critical Damage" hidden="false"><description>Fires, breaches and burning phosphex — one rule for all of them. A ship may carry up to 3 Critical Damage, marked with a single token. At the end of each battle round it loses 1 Crew for each Critical Damage it carries, always, with no roll. A successful Damage Control order clears the whole stack at once.</description></rule></rules><categoryLinks><categoryLink id="2c3acbc2-f6f6-546e-8395-fc7e68673cab" name="Rules" hidden="false" targetId="52616092-abd8-519e-a6fb-94b622114fa5" primary="true" /></categoryLinks><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" /></costs></selectionEntry><selectionEntry id="15111bfc-eb60-576f-af68-812a0f2391db" name="Fleet Construction Rules" hidden="false" collective="false" import="true" type="upgrade">
 <profiles>
 </profiles>
 <rules><rule id="a93004bc-1e2d-5951-baa2-74ee6e90ba7c" name="Fleet Construction" hidden="false"><description>Capital Ship allowance is generated by Line Ships: for every 4 individual Line Ships in the fleet you may include 1 Capital Ship. 0–3 Line Ships permit no Capital Ship; 4–7 permit 1; 8–11 permit 2; 12–15 permit 3, and so on — maximum Capital Ships = Line Ships ÷ 4, rounded down. Individual vessels count, not roster entries: a squadron of four Destroyers is four Line Ships. Line Ships are the Destroyer, Frigate, Light Cruiser, Assault Barge and Cruiser. Capital Ships are the Grand Cruiser, Battle Barge, Battleship, Emperor Battleship, Gloriana and Abyss, and the Phalanx above them. No single ship may exceed 50% of the fleet's points, upgrades included. Destroyers and Frigates have the Squadron keyword: each is taken singly, and up to 3 may be grouped into one squadron. Minimum game size: Gloriana 2,000; Abyss and Phalanx 3,000.</description></rule><rule id="9ef7a057-f47b-5238-a77b-7dd69417b7e6" name="Ship Construction" hidden="false"><description>Ships are bought as a bare chassis and armed hardpoint by hardpoint. Every weapon and Defence Battery on a mount is paid for separately; Hangar Bay slots are built-in hull capacity and cost 0 pts. Each mount group shows its capacity — Defence Mounts 0/8, for instance — and you choose how many of that mount to fill. A hull filled with its standard armament costs exactly its rulebook price. There is no separate upgrade-spend ceiling: mount count and facing are the limits.</description></rule></rules><categoryLinks>
 <categoryLink id="8bfe586e-43bc-5e88-863c-bd25349ad523" name="Rules" hidden="false" targetId="52616092-abd8-519e-a6fb-94b622114fa5" primary="true" /></categoryLinks>
 <costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" /></costs></selectionEntry>
 <selectionEntry id="3374cd82-3003-50e5-b2d9-8e603af67375" name="Fleet Orders" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="force" shared="false" id="14df4384-3216-5efa-828b-3e8e4434d244" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><rules><rule id="30ddd97e-7299-56a1-9f5c-d49c37d20d77" name="Fleet Orders" hidden="false"><description>Only the Flagship issues orders, within 24″ Command range, and no order needs a test. Each battle round the fleet may issue orders of each of the three types up to its commander's rank: Fleet Captain 1, Named Character 2, Primarch 3. No ship takes two orders of the same type in a round, ranks never combine, and nothing adds to the allowance. Unspent orders do not carry over.
DAMAGE CONTROL (Command) • Issued: in the ship's activation. • Target: one friendly ship in range. • Effect: roll a D6, Legion fleets re-rolling; on 4+ choose one — remove every Critical Damage, repair one destroyed weapon system, or clear Engines Crippled. • Duration: immediate. • Restriction: the ship fires only Snap Shots this round.
FOCUS FIRE (Command) • Issued: as the ship fires. • Target: one friendly ship, against one enemy ship. • Effect: +1 BS. • Duration: this round. • Restriction: shares the single +1 pool with the anchor bonus and accuracy auras.
BRACE FOR IMPACT (Command, Reaction) • Issued: the moment this ship is attacked. • Effect: halve all Hull Point loss, rounding up. • Duration: to the end of the round. • Restriction: the ship fires only Snap Shots until then.
ALL AHEAD FULL (Movement) • Issued: as the ship moves. • Effect: move +D6″, beyond the 12″ ceiling. • Restriction: may fire only Defence Batteries.
BURN RETROS (Movement) • Issued: as the ship moves. • Effect: move less than half Speed or not at all; a ship holding station (1″ or less) may pivot freely and fires its broadsides at +1 BS. • Restriction: −1 on Evade rolls.
EVADE (Movement, Reaction) • Issued: when this ship is shot at or rammed, before any dice are rolled. • Effect: on 5+ the whole attack misses, or the ram fails and the rammer is moved 1″ past. • Modifiers: +1 Destroyer or Frigate; −1 held station; −1 Crippled, Adrift or Engines Crippled; −1 mounting no standard Macrobatteries; never worse than −2. • Restriction: once per battle round; wrecks and Speed 0 installations never Evade.
RELOAD ORDNANCE (Shooting) • Issued: as the ship fires. • Target: one weapon system on a friendly ship. • Effect: remove one Reload token. • Restriction: a system bearing no token cannot be chosen.
RETURN FIRE (Shooting, Reaction) • Issued: when this ship is attacked and survives. • Effect: fire back at −1 to hit with every weapon that bears on the attacker. • Restriction: not systems already fired this round, nor one-shot or reloading weapons.
OVERWATCH (Shooting, Reaction) • Issued: when a boarding craft or drop pod runs at this ship. • Effect: snap-fire Defence Batteries at that craft; destroyed on 5+. • Restriction: Defence Batteries only.</description></rule><rule id="fa1537eb-6bcd-5314-b46e-e2b56fbeea92" name="Reactions" hidden="false"><description>Brace for Impact, Return Fire and Overwatch are Fleet Orders with a trigger, issued the moment a friendly ship is attacked or targeted, whether or not that ship has already acted. They count against the round's allowance however many ships are under fire — an order spent defending is one you no longer have for your own turn.</description></rule><rule id="8599c6ee-414d-59e4-ba38-0032d699a640" name="Evade" hidden="false"><description>A Movement order, declared when the ship is shot at or rammed and before any dice are rolled. Roll a D6: on a 5+ the whole attack misses, or the ram fails and the rammer is moved 1″ past its intended victim. Modifiers: +1 Destroyer or Frigate · −1 held station · −1 Crippled, Adrift or Engines Crippled · −1 mounting no standard Macrobatteries. Never worse than −2. Once per battle round; wrecks and Speed 0 installations never Evade.</description></rule><rule id="e6c2d90c-ec34-5bb4-af5c-cc14e28f2f96" name="Orders Need No Test" hidden="false"><description>No Fleet Order needs a test — the word is given and obeyed. There is no Morale, no Leadership and no test of a crew's nerve anywhere in the game; a damaged ship is measured by the Crippled and Depleted penalties alone. Command ranks instead carry their own abilities: Ship's Master, Practised Command, and the Primarch's own.</description></rule></rules><categoryLinks><categoryLink id="7ab67a45-f27e-58e2-b359-4f88ebe2a55e" name="Rules" hidden="false" targetId="52616092-abd8-519e-a6fb-94b622114fa5" primary="true" /></categoryLinks><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" /></costs></selectionEntry><selectionEntry id="046fd88c-f0ff-555d-bf59-8bda529963de" name="Photep" hidden="false" collective="false" import="true" type="unit">
 <constraints>
 <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="67c986cf-9206-5ae6-b8b6-4b3819ab8efd" type="max" />
 </constraints>
 <profiles>
 <profile id="f0360aaa-4973-5ec7-b808-c215169e0772" name="Photep" hidden="false" typeId="806f9ff1-fd51-5ddb-b005-ce73a5d09d65" typeName="Ship">
 <characteristics>
 <characteristic name="BS" typeId="d130e705-611e-5a0a-bd7d-ea8e848fdb2e">4</characteristic>
 <characteristic name="Prow" typeId="84a55377-edbc-5825-a2bf-70c6155018f2">14</characteristic>
 <characteristic name="Side" typeId="5f595433-7397-5c4b-9d4a-8f35d83a2b29">14</characteristic>
 <characteristic name="Stern" typeId="cd9ec76e-f959-5560-8845-9ab242f16e71">13</characteristic>
 <characteristic name="HP" typeId="ef713781-2034-5fb4-83d1-e49d1d683694">16</characteristic>
 <characteristic name="VS" typeId="84309751-688d-50ef-8940-d8d042261a56">12</characteristic>
 <characteristic name="Speed" typeId="25d0e01e-8e74-55b3-8a2a-17773c881625">7″</characteristic>
 <characteristic name="Turn" typeId="899e9c58-70ef-5da5-8495-5bf6a8b7f8f0">45°</characteristic>
 <characteristic name="Crew" typeId="2f6312dd-493e-53c6-96e2-d901afca0e81">10</characteristic>
 </characteristics>
 </profile>
 <profile id="1b04fa09-34a7-5bb4-a4ed-f8eea39a636b" name="Gloriana Common Rules" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">A Primarch’s Flagship: never suffers the Crippled −1 BS penalty; must be the Flagship; one per battle; games of 2,000+ points. Gloriana Reactors: once per battle, when VS would reach 0 it remains at 1. Dorsal Twin Lance Turrets fire into all arcs and never Gets Hot. Heavy Macrobatteries use Reload (1). Armament fixed: a Gloriana buys no mounts and takes no Universal Ship Upgrades.</characteristic>
 </characteristics>
 </profile>
 <profile id="6572d319-5fc3-5e9e-ad9c-b05364afca70" name="Warp Sight" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Re-roll one die relating to this ship every player turn. Hangar Bays (4).</characteristic>
 </characteristics>
 </profile>
 <profile id="b0bbe7fb-07eb-506b-a42c-8f0408d3ecb7" name="Psychic Lance" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Prow</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">12</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">D</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">45″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Reload (2). Ignores Void Shields. Resolve hull damage as a Nova Cannon hit against an unshielded ship. On a natural 6 To Hit, inflict one additional hit</characteristic></characteristics></profile><profile id="44f91e0a-2e76-54d9-9c3b-079f901f569c" name="Nova Cannon" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Prow</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">12</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">D</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">60″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Prow only. Min range 18″; Devastating (3); Reload (2)</characteristic></characteristics></profile><profile id="d12420fe-cf37-5610-8203-aed289a9c18b" name="Heavy Macrobattery ×3" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Port</characteristic><characteris