 </profile>
 <profile id="f558f272-1f69-4d0f-895f-6008dfe34396" name="Primarch Retinue" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This character is embarked as the Primarch's additional named retinue. They do not add Fleet Orders, Command range or any command ability; only effects unrelated to the order economy apply.</characteristic></characteristics></profile></profiles>
