 </selectionEntryGroup>
 <selectionEntryGroup name="Hull Upgrades" id="12739578-adc1-5b2e-9dc8-111a60d96fe7" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="5.0" field="selections" scope="parent" shared="false" id="ed0937de-8196-53af-ba16-65f1e84614cd" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="e049a516-055b-504d-8363-9640c05049ad" name="Reinforced Magazine Compartments" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="c6d54794-c8d7-513d-aae6-2a6fca6044a0" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="baca798a-caa3-53d4-af01-d1d63667875e" name="Reinforced Magazine Compartments" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Damage Control caused by a Magazine Explosion by 1, to a minimum of 0. A Twin Lance Turret that would suffer 1 Damage Control instead suffers 0 and ignores the effect; a Triple Lance Turret that would suffer 2 instead suffers 1. No other effect of a Magazine Explosion is prevented or reduced. Once per ship. Not available to Gloriana class or above.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="20.0" /></costs></selectionEntry><selectionEntry id="41c693ec-682e-53e1-9c5c-6afdd13ebea0" name="Enhanced Void Shield Array" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="0dfdee30-a75f-56c7-8335-f27810d60466" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="302186b8-2652-5252-9c28-f03e0e68cd22" name="Enhanced Void Shield Array" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">At the end of each battle round this ship regains 1 lost Void Shield, provided its Void Shields are currently active. It can never exceed its normal maximum. If its Void Shields have completely collapsed, been disabled, or are otherwise inactive, this upgrade cannot regenerate them; once at least one Void Shield is restored and the shields are active again, it resumes functioning normally. Once per ship. Not available to Gloriana class or above.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="30.0" /></costs></selectionEntry><selectionEntry id="1a476b36-ac95-5443-8cf1-346b913f33b0" name="Autoloaders" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="bcc66225-e00e-50d3-a409-ea71636dd67e" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="b877f376-613f-56a3-bc45-f87b37828e9d" name="Autoloaders" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Reload value of every weapon and system aboard this ship by 1, to a minimum of Reload 0 — Reload (3) becomes Reload (2), Reload (2) becomes Reload (1), Reload (1) becomes Reload (0). A weapon reduced to Reload (0) has no cooldown and may fire every applicable battle round. Once per ship. Not available to Gloriana class or above.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="40.0" /></costs></selectionEntry><selectionEntry id="464b5642-e539-55f9-8ef7-b17bd51948d5" name="Side Armour Reinforcement" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="e010a43c-489f-5d3a-8364-acbf12aee4cf" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="73597fef-632b-510f-8b39-6ab514b87b94" name="Side Armour Reinforcement" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="30.0" /></costs></selectionEntry><selectionEntry id="62356a7a-95c5-5c51-811e-95403210afc3" name="Engine Refit" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="bcb40137-883b-5472-abf5-626ba49eda39" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="90a7d38e-0767-5ec5-9e86-c15ab04a207c" name="Engine Refit" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="40.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
 <costs>
 <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" />
 </costs>
 </selectionEntry>
 </selectionEntries>
 <selectionEntryGroups><selectionEntryGroup name="Hull Upgrades" id="2039baec-457f-5e97-aa43-60516442195a" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="3.0" field="selections" scope="parent" shared="false" id="43b59fb7-a6ae-5cff-9d09-c12985825644" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="e2d4fb39-3197-554b-8faa-6f41850a47cb" name="Reinforced Magazine Compartments" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="0e9f0017-d1eb-5a40-a0bd-27445c2d2d1b" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="1a350312-a942-5a28-9fba-aab215e5c20b" name="Reinforced Magazine Compartments" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Damage Control caused by a Magazine Explosion by 1, to a minimum of 0. A Twin Lance Turret that would suffer 1 Damage Control instead suffers 0 and ignores the effect; a Triple Lance Turret that would suffer 2 instead suffers 1. No other effect of a Magazine Explosion is prevented or reduced.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="50.0" /></costs></selectionEntry><selectionEntry id="8d92d6bc-30b3-5d43-b697-ecef6c12a831" name="Enhanced Void Shield Array" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="e97d2175-80f0-564d-bbae-8a4a71cc5fed" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="2ec2410b-4c08-5fae-a8b4-11b94eeaca43" name="Enhanced Void Shield Array" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">At the end of each battle round this ship regains 1 lost Void Shield, provided its Void Shields are currently active. It can never exceed its normal maximum. If its Void Shields have completely collapsed, been disabled, or are otherwise inactive, this upgrade cannot regenerate them; once at least one shield has been restored by other means and the shields are active again, it resumes functioning normally.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="75.0" /></costs></selectionEntry><selectionEntry id="a3119506-c791-5fa5-ba4a-47f7e6e2da8a" name="Autoloaders" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="1b44a318-a9d3-5618-bcc5-8d52c0fd3f4e" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="4c225d27-788c-57fd-98e4-96a888a1ba43" name="Autoloaders" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Reload value of all weapons and systems aboard this ship by 1, to a minimum of Reload 0. Reload (3) becomes Reload (2), Reload (2) becomes Reload (1), and Reload (1) becomes Reload (0). A weapon at Reload (0) has no cooldown and may fire every applicable battle round.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="100.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" /></costs></selectionEntry>
 <selectionEntry id="045feb20-66f4-568f-9e21-9105b9cbec25" name="Frigates" hidden="false" collective="false" import="true" type="unit">
 <constraints><constraint type="max" value="5.0" field="selections" scope="roster" shared="false" id="03ea541c-1ce1-52c0-b2ae-7126c91168b6" percentValue="false" includeChildSelections="false" includeChildForces="true" /></constraints><profiles /><categoryLinks>
 <categoryLink id="3a17b6db-7a26-5fcc-8a73-ee01e3974df0" name="Line" hidden="false" targetId="96572996-e9b1-54a7-a2a9-2108e1dfc993" primary="true" /></categoryLinks>
 <selectionEntries>
 <selectionEntry id="36fdac49-5d71-5f7b-a461-f65207a1b211" name="Frigate" hidden="false" collective="false" import="true" type="model">
 <constraints>
 <constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="ccaa3938-4289-553a-9673-828a5c608ac1" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="3.0" field="selections" scope="parent" shared="false" id="7c919f7b-74d6-5ac0-8c59-8d779c915b92" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints>
 <profiles>
 <profile id="2562bd1d-243b-5a48-a239-e82d2418ffff" name="Frigate" hidden="false" typeId="806f9ff1-fd51-5ddb-b005-ce73a5d09d65" typeName="Ship">
 <characteristics>
 <characteristic name="BS" typeId="d130e705-611e-5a0a-bd7d-ea8e848fdb2e">3</characteristic>
 <characteristic name="Prow" typeId="84a55377-edbc-5825-a2bf-70c6155018f2">11</characteristic>
 <characteristic name="Side" typeId="5f595433-7397-5c4b-9d4a-8f35d83a2b29">10</characteristic>
 <characteristic name="Stern" typeId="cd9ec76e-f959-5560-8845-9ab242f16e71">9</characteristic>
 <characteristic name="HP" typeId="ef713781-2034-5fb4-83d1-e49d1d683694">4</characteristic>
 <characteristic name="VS" typeId="84309751-688d-50ef-8940-d8d042261a56">2</characteristic>
 <characteristic name="Speed" typeId="25d0e01e-8e74-55b3-8a2a-17773c881625">12″</characteristic>
 <characteristic name="Turn" typeId="899e9c58-70ef-5da5-8495-5bf6a8b7f8f0">90°</characteristic>
 <characteristic name="Crew" typeId="2f6312dd-493e-53c6-96e2-d901afca0e81">3</characteristic>
 </characteristics>
 </profile>
 </profiles>
 <rules><rule id="6667a853-e694-5fc9-a0c2-b4704a1698b6" name="Intervention" hidden="false"><description>Costs no order. When a friendly ship within 3″ is attacked, rammed, or targeted by torpedoes, this ship may thrust into the firing line from up to 10″ of the attacker: it does not move, and the whole attack resolves against it instead. Once per battle round.</description></rule><rule id="ac9be3d9-73c1-56f1-953d-fbe2381cb8ae" name="Gets Hot" hidden="false"><description>After a Lance Turret or Twin Lance Turret resolves its attacks, roll a D6. On a 1 the firing ship loses 1 Hull Point. Each mount rolls separately.</description></rule><rule id="d31c22ea-c987-5803-be1f-a2a0eff480aa" name="Line" hidden="false"><description>Counts as a Line Ship for every rule that names one, and toward the fleet's Line minimum.</description></rule><rule id="ffbaefb9-c977-5d96-bdc0-2cc7b537e5a3" name="Reload (X)" hidden="false"><description>After firing, place X Reload tokens on the mount; flip one at the end of each battle round. The mount cannot fire while it bears a token.</description></rule><rule id="bab9a3c1-65e5-56c8-85e5-3f43c86d4a10" name="Devastating (X)" hidden="false"><description>Each hit costs X Hull Points, or 1 Void Shield Rating against live shields.</description></rule><rule id="ca35143e-5aa7-5556-9eaf-dcc83d658c15" name="Armourbane" hidden="false"><description>Roll 2D6 + Strength to penetrate instead of 1D6, at 6″ or less, against shields or hull alike.</description></rule><rule id="ee4e077f-6673-5a2f-aa86-6950a046c4f3" name="Point-Blank Broadsides" hidden="false"><description>At 6″ or less, Port, Starboard and Dorsal weapons improve AP by one step — or gain Armourbane instead if their printed AP is already 1. Prow weapons get neither.</description></rule><rule id="97c741f0-6680-50a7-bb34-9487d51abe5a" name="Crippled" hidden="false"><description>Below half starting Hull Points: −1 BS and half Speed.</description></rule><rule id="2ca265c5-8e3a-5aa0-b542-484409d7f266" name="Depleted" hidden="false"><description>At half starting Crew or less: −1 BS. Stacks with Crippled.</description></rule><rule id="158cb2e4-f3bd-5a57-98c9-cfe3e159b748" name="Locked" hidden="false"><description>Joined by a ram. Neither ship may move; the rammer may not fire on its victim, who fires back at −1 BS. Break Away on 5+.</description></rule><rule id="195eaf88-4ef5-5b8e-bc78-b88e02ebcb67" name="Snap Shots" hidden="false"><description>Firing at BS 1 — hits only on a 6.</description></rule><rule id="84956677-0d6e-5dbd-a9ed-8a9dd7962f1b" name="Wreck" hidden="false"><description>0 Hull Points without exploding. Becomes impassable, obscuring terrain; never moves and never Evades.</description></rule><rule id="ad423bc3-7656-5311-bec9-1107a96b5d3e" name="Held station" hidden="false"><description>Moved 1″ or less under Burn Retros. Broadsides fire at +1 BS; −1 on Evade.</description></rule><rule id="a1d534d4-0e2d-5622-910a-ffc2dae388ee" name="Screen" hidden="false"><description>A friendly Capital Ship within 3″ of one or more friendly Frigates is harder to pick out of the formation: enemy ships suffer −1 BS when targeting it. Screen protects only friendly Capital Ships, never the Frigate itself, and multiple Frigates do not stack — the modifier is never worse than −1.</description></rule><rule id="d00b6686-379e-506d-974c-a85549ab9d92" name="Squadron" hidden="false"><description>Squadron: this vessel is taken singly, and up to 3 may be grouped into one squadron. A squadron moves and shoots as one unit and must keep coherency, each ship within 6″ of another in the squadron. It may split its fire, but every ship fires all of its own weapons at the one target it chooses.</description></rule></rules><categoryLinks>
 <categoryLink id="289635c7-2982-5301-a2fe-869a9810af42" name="Line" hidden="false" targetId="96572996-e9b1-54a7-a2a9-2108e1dfc993" primary="true" />
 </categoryLinks>
 <selectionEntryGroups>
 <selectionEntryGroup name="Prow Mounts" id="d3194ac4-1baf-5f12-a95b-5b1f8b3a82ec" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="d33f2aac-34b1-50a0-9979-41de62261caf" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="d5d8526b-d306-5e23-b3b2-ff07786f6469" name="Torpedo Tube" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="01fc4b31-2848-5e8d-b8c9-c89086b6a744" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="062982b5-da14-5067-8620-5ed0b3672b0e" name="Torpedo Tube" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Prow</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">9</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">2</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">60″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">One torpedo per tube. Bypasses Void Shields; Armourbane within 6″; Reload (2)</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Port Mounts" id="ac5bb3ef-f4b5-52c7-baa1-ede7f60175d2" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="d0e164fa-db75-5fe7-9edb-ec2e1198bd57" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="d2f4dec0-ff31-583b-b8ea-11511b96beef" name="Macrobattery (Port)" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="6cd77f2d-2a6f-542f-b0ed-36d409716819" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="79a3428f-b998-54e2-8b8a-73c231846768" name="Macrobattery (Port)" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Port</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">8</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">3</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">30″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">—</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Starboard Mounts" id="8af3a210-f814-5f02-8f0c-8874bedd63d2" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="aee5ea8a-e2e9-5cc3-8896-97cb3973b7a5" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="a2d832df-6bca-5232-ab1d-68ca66cc6742" name="Macrobattery (Starboard)" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="7373c0eb-2e17-57ef-a20d-3b801d93a2e3" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="227efac3-a811-55b7-b743-7febe5eab3b0" name="Macrobattery (Starboard)" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Starboard</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">8</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">3</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">30″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">—</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Crew Upgrade" id="b278f370-4272-52e1-b983-005e08b57f02" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="1ef2f462-6544-5475-8618-3c290eb6cf97" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="a5db0d1a-5193-5226-810c-68045f3c19de" name="Veteran Crew - Frigate" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="b2abf666-d74a-56c1-88fe-bbb946fc34b8" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="6fe9ff67-4ed3-57c4-803b-56ace99c4813" name="Veteran Crew" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Once per ship. +1 BS, to maximum BS 5.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="55.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Stern Mounts" id="7fd97a60-a469-5a22-9fd4-1163cb60f758" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="7fccbb07-f2fa-5a9d-8ab4-c2139ccb0fa6" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="533edb9d-e283-5fe9-96ed-976db8f7968a" name="Melta Mine Layer" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="440fb814-76f9-54a7-9b50-8a1233aa2e7d" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="157623fd-3af6-5567-8b43-f844ac927847" name="Melta Mine Layer" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Stern</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">9</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">2</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">3″ blast</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Armourbane. Carries 2 mines; Reload (2). Laid on a 32mm base instead of shooting. Triggers when any part of a non-Frigate ship passes over it: every ship within 3″ — including the ship that triggered it — suffers one hit resolved against its Armour. Aircraft pass over mines safely. Remove the mine once the attack is resolved.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="20.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Defence Mounts" id="0a7a01b1-a4ab-5887-87eb-3f433967a65b" hidden="false" collective="false" import="true">
 <constraints>
 <constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="2ca68c8a-7fae-5be5-ad81-ea7876b3b556" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints>
 <selectionEntries>
 <selectionEntry id="4d2f4a30-12d2-5d21-b7ce-9487283ff059" name="Defence Battery" hidden="false" collective="false" import="true" type="upgrade">
 <constraints>
 <constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="dc05bb5c-1cfb-55a7-8b17-5ccc9e470c92" percentValue="false" includeChildSelections="false" includeChildForces="false" />
 </constraints>
 <profiles>
 <profile id="9d1df7cb-f629-5e06-b425-fc323b1d6fd5" name="Defence Battery" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
 <characteristics>
 <characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">All-round</characteristic>
 <characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">6</characteristic>
 <characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">5</characteristic>
 <characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3</characteristic>
 <characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">12″</characteristic>
 <characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Skyfire; Interceptor. Aircraft to 12″; ships within 6″</characteristic>
 </characteristics>
 </profile>
