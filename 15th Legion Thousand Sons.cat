 <profiles>
 <profile id="13c96ea7-2136-4de0-9a8b-3c76525f1148" name="Magnus the Red" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Primarch. The Fleet Obeys: friendly ships within 12″ ignore the first Critical Damage they would suffer each battle round. Friendly Twin Lance Turrets and Destroyer weapons may re-roll failed hits. Demigod of War +3.</characteristic>
 </characteristics>
 </profile>
 <profile id="15375259-c8dd-4e0a-b3b5-743106f09c0b" name="Primarch Embarkation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Primarch. The Fleet Obeys: friendly ships within 12″ ignore the first Critical Damage they would suffer each battle round. May only be selected in a 2,000+ point fleet and must ride this Legion's Gloriana as Fleet Commander. Rogal Dorn is assigned to the Phalanx or the Eternal Crusader when the fleet is built, and does not move between them.</characteristic></characteristics></profile></profiles>
