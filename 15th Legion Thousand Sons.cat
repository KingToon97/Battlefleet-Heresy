 <selectionEntryGroup id="5f7156ff6532e03b813f087fcd9f1591" name="Hull Upgrades" hidden="false"><constraints><constraint type="max" value="6.0" field="selections" scope="parent" shared="false" id="44eaf5d2-2143-5913-b117-3aefe9669abc" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="b96e7a1751fd6a15fd30aceef497f973" name="Side Armour Reinforcement" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="481e652b5907eff9c8cac4e20c758b7d" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="6a8e21f6f0cccc06585f5050fb209f61" name="Side Armour Reinforcement" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="90.0" /></costs></selectionEntry><selectionEntry id="b82d4c6c77babd505d598de014972302" name="Engine Refit" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="2e2ba4c55b6ff16ebcc25fc8e7deb03d" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="d6f5838befad94d22553c228eae8ea8a" name="Engine Refit" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="120.0" /></costs></selectionEntry><selectionEntry id="d272c1b2-4648-556a-acef-7a5176c35a61" name="Phosphex Shells" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="a7845022-10c1-56e7-b987-17fe2af025bc" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="b86cfc3e-2452-5661-9a5c-cccb4f7d0221" name="Phosphex Shells" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Every Heavy Macrobattery aboard fires phosphex: whenever one penetrates armour, the target takes 1 Critical Damage. Requires at least one Heavy Macrobattery.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="60.0" /></costs></selectionEntry><selectionEntry id="ecbea7e2-6ade-5480-810c-71c7bb73ae83" name="Reinforced Magazine Compartments" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="d5b54cca-c08e-5d9c-8360-2b5a674f568a" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="75ad206f-4d6e-560a-827a-643b3b4b0bdf" name="Reinforced Magazine Compartments" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Damage Control caused by a Magazine Explosion by 1, to a minimum of 0. A Twin Lance Turret that would suffer 1 Damage Control instead suffers 0 and ignores the effect; a Triple Lance Turret that would suffer 2 instead suffers 1. No other effect of a Magazine Explosion is prevented or reduced. Once per ship. Not available to Gloriana class or above.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="60.0" /></costs></selectionEntry><selectionEntry id="a7f7c4b2-0a64-56c2-8d2d-8871fe86ae82" name="Enhanced Void Shield Array" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="73ba44a4-748e-52c3-a0ed-595dd20dbb83" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="b4189ac9-8fe4-5ad3-9be3-7af7d2603d56" name="Enhanced Void Shield Array" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">At the end of each battle round this ship regains 1 lost Void Shield, provided its Void Shields are currently active. It can never exceed its normal maximum. If its Void Shields have completely collapsed, been disabled, or are otherwise inactive, this upgrade cannot regenerate them; once at least one Void Shield is restored and the shields are active again, it resumes functioning normally. Once per ship. Not available to Gloriana class or above.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="90.0" /></costs></selectionEntry><selectionEntry id="ac02ff1e-04b6-54a1-b5eb-210e1d2743fe" name="Autoloaders" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="ac31533d-cc7d-582f-afc4-3104f02908dd" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="69544230-74b8-5c65-880a-27f4913529a5" name="Autoloaders" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Reload value of every weapon and system aboard this ship by 1, to a minimum of Reload 0 — Reload (3) becomes Reload (2), Reload (2) becomes Reload (1), Reload (1) becomes Reload (0). A weapon reduced to Reload (0) has no cooldown and may fire every applicable battle round. Once per ship. Not available to Gloriana class or above.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="120.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Boarding Forces" id="f9c66a20-6e4a-5e5f-8cec-8d130f7a5eff" hidden="false" collective="false" import="true">
