 </selectionEntryGroup>
 <selectionEntryGroup name="Hull Upgrades" id="7e3d0926-b9e2-5a83-9f95-4b55de3eb21d" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="5.0" field="selections" scope="parent" shared="false" id="df962e11-ae3e-5d50-862f-1b01438f08ae" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="ca159e10-43ea-5e4d-b72b-56a1b9e216fd" name="Reinforced Magazine Compartments" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="621e7e7e-fb3e-56e3-8bef-7932601b89ba" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="d6b89b25-8861-5ae7-852c-d3596cbf8c62" name="Reinforced Magazine Compartments" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Damage Control caused by a Magazine Explosion by 1, to a minimum of 0. A Twin Lance Turret that would suffer 1 Damage Control instead suffers 0 and ignores the effect; a Triple Lance Turret that would suffer 2 instead suffers 1. No other effect of a Magazine Explosion is prevented or reduced. Once per ship. Not available to Gloriana class or above.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="30.0" /></costs></selectionEntry><selectionEntry id="35b7287b-66aa-50da-8d45-a95f21481476" name="Enhanced Void Shield Array" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="a283a35e-15cf-5ec8-a8e9-1f5c4383b59e" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="4e0b1731-6b4d-5105-ae61-e35344980bbe" name="Enhanced Void Shield Array" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">At the end of each battle round this ship regains 1 lost Void Shield, provided its Void Shields are currently active. It can never exceed its normal maximum. If its Void Shields have completely collapsed, been disabled, or are otherwise inactive, this upgrade cannot regenerate them; once at least one Void Shield is restored and the shields are active again, it resumes functioning normally. Once per ship. Not available to Gloriana class or above.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="45.0" /></costs></selectionEntry><selectionEntry id="e5fa55fe-b5a7-5205-9095-c7b5b68333e1" name="Autoloaders" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="cba98ff7-e3f2-5666-8401-51b7cbe6d9f4" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="a381e896-f1fc-5e3e-a28e-59f722a4f443" name="Autoloaders" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Reload value of every weapon and system aboard this ship by 1, to a minimum of Reload 0 — Reload (3) becomes Reload (2), Reload (2) becomes Reload (1), Reload (1) becomes Reload (0). A weapon reduced to Reload (0) has no cooldown and may fire every applicable battle round. Once per ship. Not available to Gloriana class or above.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="60.0" /></costs></selectionEntry><selectionEntry id="49d074c1-a5d2-5664-a737-7a6ab4b98d6b" name="Side Armour Reinforcement" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="d31ea759-35fd-59a6-9d2d-48bc2ec2da7f" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="ad37369b-213c-58c1-8f25-e383f08dfb8f" name="Side Armour Reinforcement" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="45.0" /></costs></selectionEntry><selectionEntry id="e7bd426a-d3d3-58f7-93fc-22b078dea507" name="Engine Refit" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="6d76c3bc-95f6-5d5a-a8ef-c5f3d8d83b0c" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="37d16930-4f7a-52fe-b539-2bc30d34c3c0" name="Engine Refit" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="60.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
 <costs>
 <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="40.0" />
 </costs>
 </selectionEntry>
