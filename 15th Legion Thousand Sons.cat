 <selectionEntryGroup id="6745ea5c-caa6-5c88-800f-42ba2484aa3c" name="Hull Upgrades" hidden="false"><constraints><constraint type="max" value="6.0" field="selections" scope="parent" shared="false" id="d6a2b286-9f6b-5d79-a64a-5603b4fed24d" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="a08b126e-42e8-5087-9d57-d662022e078d" name="Side Armour Reinforcement" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="c9ac807d-e59d-5ab1-a4b8-cfa1372de53f" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="b520bf9e-00a7-5fb7-acd8-dab0cd4d74ac" name="Side Armour Reinforcement" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="60.0" /></costs></selectionEntry><selectionEntry id="ba78b95c-36a8-50a7-a430-ac0a642a493a" name="Engine Refit" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="2c82802b-a8e2-5494-afe0-97105f6f8cbf" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="a15b8e05-3d0f-589f-a63f-80c4210c7a22" name="Engine Refit" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="80.0" /></costs></selectionEntry><selectionEntry id="76bb52c8-07b0-52d3-bbe9-35b294c937e2" name="Phosphex Shells" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="9115b3d8-f2c0-5861-b652-cfff6ed867e1" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="bf7e3b0f-ac0f-545d-b093-3f3544d600fa" name="Phosphex Shells" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Every Heavy Macrobattery aboard fires phosphex: whenever one penetrates armour, the target takes 1 Critical Damage. Requires at least one Heavy Macrobattery.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="40.0" /></costs></selectionEntry><selectionEntry id="5d7d7c16-019f-5a89-8c74-2a68fce23455" name="Reinforced Magazine Compartments" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="17bbf3d1-a0a3-56cc-a659-1ed58122b64c" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="c6adc8d9-33a3-5a75-9865-d7a39d4da31f" name="Reinforced Magazine Compartments" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Damage Control caused by a Magazine Explosion by 1, to a minimum of 0. A Twin Lance Turret that would suffer 1 Damage Control instead suffers 0 and ignores the effect; a Triple Lance Turret that would suffer 2 instead suffers 1. No other effect of a Magazine Explosion is prevented or reduced. Once per ship. Not available to Gloriana class or above.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="40.0" /></costs></selectionEntry><selectionEntry id="b65239f7-3d5a-5bf0-a2e1-d516ecdb5ca7" name="Enhanced Void Shield Array" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="6fad82ed-bd36-5783-81ff-6c9ffd7cddd6" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="71caa53c-d09d-59e6-a985-bba327a2c9d4" name="Enhanced Void Shield Array" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">At the end of each battle round this ship regains 1 lost Void Shield, provided its Void Shields are currently active. It can never exceed its normal maximum. If its Void Shields have completely collapsed, been disabled, or are otherwise inactive, this upgrade cannot regenerate them; once at least one Void Shield is restored and the shields are active again, it resumes functioning normally. Once per ship. Not available to Gloriana class or above.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="60.0" /></costs></selectionEntry><selectionEntry id="674960c3-64a5-5c36-8406-a4c561c44ce5" name="Autoloaders" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="002b7437-f5a4-590b-a625-8f067511f212" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="3df37bd2-8422-5e5c-aae0-9f8babee209f" name="Autoloaders" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Reload value of every weapon and system aboard this ship by 1, to a minimum of Reload 0 — Reload (3) becomes Reload (2), Reload (2) becomes Reload (1), Reload (1) becomes Reload (0). A weapon reduced to Reload (0) has no cooldown and may fire every applicable battle round. Once per ship. Not available to Gloriana class or above.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="80.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
 <costs>
 <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="60.0" />
 </costs>
 </selectionEntry>
