        </profile>
        <profile id="09c3fb90-6130-5ca9-a137-95f3ce4ed614" name="Hangar Loadout Validation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Maximum 2 aircraft squadrons: one per Hangar Bay.</characteristic>
          </characteristics>
        </profile>
        <profile id="bbf80d97-7bdd-5783-9ee1-5d65843b9446" name="Boarding Forces Validation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding forces are bought against the ship’s Crew. Terminator/Dreadnought class limits are enforced; remember a Contemptor occupies 2 Crew slots.</characteristic>
          </characteristics>
        </profile>
        <profile id="ff0e7997-95f1-5db6-90f5-852dec1f0391" name="Hardpoint Construction" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Bare chassis. Every mounted weapon is purchased separately. No upgrade-spend ceiling. Legal choices are controlled by hull class, hardpoint type and facing; each hardpoint must contain exactly one weapon.</characteristic>
          </characteristics>
        </profile>
      <profile id="e99d461c-aa3c-4a01-9515-e0eacf5410cd" name="Mount Capacity" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Port: 3 · Port Heavy: 2 · Starboard: 3 · Starboard Heavy: 2 · Prow Ordnance: 4 · Prow Super-Heavy: 1 · Dorsal: 4 · Defence: 8 · Hangar: 2</characteristic></characteristics></profile><profile id="21a17fb7-6c9c-4767-b8f4-72023c252e5a" name="Hardpoint Configuration" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Every physical weapon, defence and hangar hardpoint must be filled exactly once. There is no separate upgrade-spend cap; the hull's mount layout is the limit.</characteristic></characteristics></profile><profile id="8b219a35-de41-499f-887a-051ae9a244c4" name="Roster Builder Summary" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Crew 8 · Port 3 · Port Heavy 2 · Starboard 3 · Starboard Heavy 2 · Prow Ordnance 4 · Prow Super-Heavy 1 · Dorsal 4 · Defence 8 · Hangars 2. Fill every physical hardpoint exactly once; aircraft are purchased separately up to Hangar capacity.</characteristic></characteristics></profile></profiles>
      <selectionEntryGroups>
        <selectionEntryGroup id="05afc8fa-f34c-47e4-9773-5fdf164a2dfd" name="Fleet Role" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="47463bba-ccdb-45d0-9ae9-867cd612f857" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="36c4fc80-baed-4013-b786-e642b169ee22" name="Designate as Flagship" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" /></costs><categoryLinks><categoryLink id="19d406fc-4644-47e3-85be-f115261b7952" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" /></categoryLinks><profiles><profile id="aae59c5b-1d4b-4071-a1cc-d792ceafbfdb" name="Flagship" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship is the fleet's Flagship. Exactly one Flagship is required in a standard fleet.</characteristic></characteristics></profile><profile id="a332fc02-9e5e-48ed-b1b7-4d01eaa24ae8" name="Commander Embarkation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander here. The Commander is embarked on this Flagship.</characteristic></characteristics></profile></profiles><selectionEntryGroups><selectionEntryGroup id="bb430243-4d02-4376-babb-3388be63be0d" name="Fleet Commander" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="7802ae45-f7ec-42f6-99ee-e6408c51cda6" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" 