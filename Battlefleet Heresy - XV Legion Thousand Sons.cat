        <categoryLink id="2dc8d964-5149-44cd-962b-8d0d0aa88ccc" name="Commander" hidden="false" targetId="6f3339ad-23a9-5687-b08f-3f11a43fe50b" primary="true" />
      </categoryLinks>
      <profiles>
        <profile id="c07fca3c-e5b6-4978-b2a2-73ddea97ac34" name="Ahzek Ahriman" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Once per turn force one enemy within 18″ to re-roll a successful Repair or Morale test.</characteristic>
          </characteristics>
