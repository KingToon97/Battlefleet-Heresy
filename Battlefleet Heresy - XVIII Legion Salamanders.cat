      </categoryLinks>
      <profiles>
        <profile id="6d44ee8f-4a0c-4ae5-be29-5580d8b8b84e" name="Fleet Captain" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Flagship issues 2 Fleet Orders each phase. Friendly ships within 6″ gain +1 Leadership.</characteristic>
