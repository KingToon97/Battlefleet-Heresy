    <profiles><profile id="ee0bc800-e770-46e0-a502-b597e6d2523f" name="Mount Capacity" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Port: 1 · Starboard: 1 · Prow Ordnance: 2 · Dorsal: 1 · Defence: 2</characteristic></characteristics></profile><profile id="a32355bf-7114-4269-a2b8-8b5bcb9595d0" name="Hardpoint Configuration" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Every physical weapon, defence and hangar hardpoint must be filled exactly once. There is no separate upgrade-spend cap; the hull's mount layout is the limit.</characteristic></characteristics></profile><profile id="2d0b3b76-c12a-4d62-9476-26382fdd8129" name="Roster Builder Summary" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Crew 3. Fill every physical hardpoint exactly once; aircraft are purchased separately up to Hangar capacity.</characteristic></characteristics></profile></profiles></selectionEntry>
    <selectionEntry id="a26af397-0f6b-5f0c-a195-cfb72c83066a" name="Assault Barge" hidden="false" collective="false" import="true" type="unit">
      <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="62.0" />
      </costs>
      <categoryLinks>
