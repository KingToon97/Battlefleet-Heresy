      </categoryLinks>
      <profiles>
        <profile id="1fa01433-113f-50cf-bf69-6f9d4d563569" name="Battle Barge" hidden="false" typeId="806f9ff1-fd51-5ddb-b005-ce73a5d09d65" typeName="Ship">
          <characteristics>
            <characteristic name="BS" typeId="d130e705-611e-5a0a-bd7d-ea8e848fdb2e">3</characteristic>
            <characteristic name="Prow" typeId="84a55377-edbc-5825-a2bf-70c6155018f2">13</characteristic>
            <characteristic name="Broadside" typeId="5f595433-7397-5c4b-9d4a-8f35d83a2b29">12</characteristic>
            <characteristic name="Stern" typeId="cd9ec76e-f959-5560-8845-9ab242f16e71">11</characteristic>
            <characteristic name="HP" typeId="ef713781-2034-5fb4-83d1-e49d1d683694">10</characteristic>
            <characteristic name="VS" typeId="84309751-688d-50ef-8940-d8d042261a56">7</characteristic>
            <characteristic name="Speed" typeId="25d0e01e-8e74-55b3-8a2a-17773c881625">9″</characteristic>
            <characteristic name="Turn" typeId="899e9c58-70ef-5da5-8495-5bf6a8b7f8f0">45°</characteristic>
            <characteristic name="Crew" typeId="2f6312dd-493e-53c6-96e2-d901afca0e81">9</characteristic>
          </characteristics>
        </profile>
        <profile id="6b9efb91-6d1d-59b7-a93a-b6d861c25050" name="Hangar Bays (2)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">2 physical Hangar Bay mounts; each bay costs 10 pts and carries one aircraft squadron.</characteristic>
          </characteristics>
        </profile>
        <profile id="325e78f8-af80-5db8-9b41-8d5a2ea89123" name="Void Marines" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">All Crew count as Legiones Astartes (+1), free; may commit up to full current Crew in a Hull Assault, keeping 1 aboard.</characteristic>
          </characteristics>
        </profile>
        <profile id="de74516b-bdf1-5992-9388-736a1a353036" name="Hangar Loadout Validation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Maximum 3 aircraft squadrons: one per Hangar Bay.</characteristic>
          </characteristics>
        </profile>
        <profile id="40557d6b-5e48-5a70-8c12-e6211d3488c3" name="Boarding Forces Validation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding forces are bought against the ship’s Crew. Terminator/Dreadnought class limits are enforced; remember a Contemptor occupies 2 Crew slots.</characteristic>
          </characteristics>
        </profile>
        <profile id="e6c1907f-3d5b-5a73-8a9c-f4ba00a48cb8" name="Hardpoint Construction" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Bare chassis. Every mounted weapon is purchased separately. No upgrade-spend ceiling. Legal choices are controlled by hull class, hardpoint type and facing; each hardpoint must contain exactly one weapon.</characteristic>
          </characteristics>
        </profile>
      <profile id="239277bf-0ed9-4cdf-b99f-00a93a235d6f" name="Mount Capacity" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Port: 3 · Starboard: 3 · Prow Weapon: 1 · Prow Assault: 4 · Defence: 6 · Hangar: 2</characteristic></characteristics></profile><profile id="40b82e2b-2903-413d-9744-2bbc655ea723" name="Hardpoint Configuration" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Every physical weapon, defence and hangar hardpoint must be filled exactly once. There is no separate upgrade-spend cap; the hull's mount layout is the limit.</characteristic></characteristics></profile><profile id="f6575e57-4a90-40b5-b604-f317dea95eae" name="Roster Builder Summary" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Crew 9 · Port 3 · Starboard 3 · Prow 1 · Prow Assault 4 · Defence 6 · Hangars 2. Fill every physical hardpoint exactly once; aircraft are purchased separately up to Hangar capacity.</characteristic></characteristics></profile></profiles>
      <selectionEntryGroups>
        <selectionEntryGroup id="57469328-f3f5-4983-a161-f013da5145d7" name="Fleet Role" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="e5608d6f-aa4a-4f87-b527-2fd9f5f9a4fe" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="1f6e527c-7aa6-4cc5-b4af-1fd45d4de1c2" name="Designate as Flagship" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" /></costs><categoryLinks><categoryLink id="7b5b0dd1-f2f5-4ed2-8051-233d9b485e1d" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" /></categoryLinks><profiles><profile id="8ed4d52f-1f2b-419a-9d7e-64974a8f804d" name="Flagship" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship is the fleet's Flagship. Exactly one Flagship is required in a standard fleet.</characteristic></characteristics></profile><profile id="9a3ade93-98fa-45d7-a517-4eb32d20c334" name="Commander Embarkation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander here. The Commander is embarked on this Flagship.</characteristic></characteristics></profile></profiles><selectionEntryGroups><selectionEntryGroup id="57caf3fd-d480-4dd4-a6b4-379f92bac1cf" name="Fleet Commander" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="a3fcc13c-572a-4b77-8064-a9adc8b409e2" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="207f9119-fa2d-4ced-9b9d-c7e88288fde2" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="01fbdc2e-bc75-4522-95b0-5a2b9c4160d0" name="Fleet Captain" hidden="false" collective="false" import="true" type="upgrade">
