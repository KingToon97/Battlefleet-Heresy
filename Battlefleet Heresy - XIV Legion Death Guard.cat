      </categoryLinks>
      <profiles>
        <profile id="8374816d-8f59-4a47-80fc-4a5b77e723ee" name="Fleet Captain" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Flagship issues 2 Fleet Orders each phase. Friendly ships within 6″ gain +1 Leadership.</characteristic>
