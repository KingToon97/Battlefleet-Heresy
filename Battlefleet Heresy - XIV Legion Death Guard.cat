      <profiles>
        <profile id="42616dd3-148c-44ca-a024-894c41d19737" name="Nathaniel Garro" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Friendly ships at half Crew or less do not suffer −1 BS for depleted Crew.</characteristic>
