  <selectionEntries>
    <selectionEntry id="cd897248-882f-5b2d-a889-d5b044bc5bcf" name="Escort Squadron" hidden="false" collective="false" import="true" type="unit">
      <profiles><profile id="d585d52d-fcbd-425d-bf55-89b3b4126158" name="Mount Capacity" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Port: 1 · Starboard: 1 · Prow Ordnance: 1 · Defence: 1</characteristic></characteristics></profile><profile id="4509d507-afe5-4a79-840d-4696852925e3" name="Hardpoint Configuration" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ships begin with no weapons or Defence Batteries selected. Hangar Bay slots represent built-in hull capacity and cost 0 pts. Each physical hardpoint may take at most one legal component. There is no separate upgrade-spend cap; the hull's mount layout is the limit.</characteristic></characteristics></profile><profile id="a1fa95fd-6932-4b90-b329-9238becc2d05" name="Roster Builder Summary" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Crew 2. Ships start unequipped. Fill only the weapon and Defence hardpoints you want to purchase; each may contain at most one component. Hangar Bay slots cost 0 pts. Aircraft are purchased separately up to Hangar capacity.</characteristic></characteristics></profile></profiles><categoryLinks>
        <categoryLink id="eb5490c130bab5c8e6ae1af68e853ef6" name="Line Ship" hidden="false" targetId="96572996-e9b1-54a7-a2a9-2108e1dfc993" primary="true" /></categoryLinks>
