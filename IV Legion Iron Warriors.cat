      <profile id="0a3032c6-ea06-42d9-9b6d-5b617ed17d75" name="Primarch Embarkation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">May only be selected in a 2,000+ point fleet and must ride this Legion's Gloriana as Fleet Commander. Rogal Dorn may instead ride the Phalanx where permitted.</characteristic></characteristics></profile></profiles>
