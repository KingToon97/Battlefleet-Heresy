            <profile id="520596fc-1f13-51ee-8b59-72835ed394b1" name="Mount Capacity" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
              <characteristics>
                <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Port: 1 | Starboard: 1 | Prow torpedo: 2 | Dorsal: 1 | Defence: 2</characteristic>
              </characteristics>
            </profile>
            <profile id="b40c4c4d-464f-5fac-8a02-d1e6088512aa" name="Hardpoint Construction" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
              <characteristics>
                <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Bare chassis only. Every weapon on a physical hardpoint is paid separately. There is no upgrade-spend ceiling: facing and mount count are the limits. v0.7 component prices are balanced around sustained fire, armour penetration, shield interaction, firing arc, reload and one-shot restrictions.</characteristic>
              </characteristics>
            </profile>
          </profiles>
