    <selectionEntry id="a9698f94-9562-563b-a87e-53086b15ca76" name="Fleet Construction Rules" hidden="false" collective="false" import="true" type="upgrade">
      <profiles>
        <profile id="517ca2e4-30de-5f14-bb1e-3828dd9989a0" name="Fleet Construction Rules" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Capital Ships: minimum 1. Maximum by fleet size: 1 at 1,000; 2 at 1,500; 3 at 2,000; 4 at 2,500; 5 at 3,000. Minimum Line Ships: 4/5/6/7/8 respectively. No single ship may exceed 50% of fleet points including upgrades. Gloriana 2,000+; Abyss/Phalanx 3,000+. Escorts/Frigates squadrons 3–6; Assault Barges up to 4. This v0.2 catalogue displays these rules but automatic variable-points bracket validation is still in development.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    <categoryLinks>
        <categoryLink id="f30fafc6-53e4-57a9-b920-6b5a7bf9263b" name="Upgrade" hidden="false" targetId="7610de76-9ef1-58ab-9c7b-f97ede66e61d" primary="true" />
      </categoryLinks>
      </selectionEntry>
    <selectionEntry id="e723804f-ad14-5fa0-86fc-cb28be08db6a" name="IV Legion - The Hammer of Olympia" hidden="false" collective="false" import="true" type="upgrade">
      <rules><rule id="52455554-2c35-5bf9-9cbe-1de3a39f8353" name="IV Legion - The Hammer of Olympia" hidden="false"><description>Capital Ships add +1 Strength to ranged weapons with a Strength value; does not grant Strength-9 threshold rules and never grants Armourbane.</description></rule></rules><categoryLinks>
        <categoryLink id="3f8f478d-c5e6-59f2-8f40-84bbf3ad1702" name="Upgrade" hidden="false" targetId="7610de76-9ef1-58ab-9c7b-f97ede66e61d" primary="true" />
      </categoryLinks>
      </selectionEntry>
    <selectionEntry id="90675f90-5aeb-4092-99a2-73daa0734024" name="Battle Carrier" hidden="false" collective="false" import="true" type="unit">
      <profiles>
        <profile id="7ddf51e8-f25c-4599-a8ec-b518600ca583" name="Battle Carrier" hidden="false" typeId="806f9ff1-fd51-5ddb-b005-ce73a5d09d65" typeName="Ship">
          <characteristics>
            <characteristic name="BS" typeId="d130e705-611e-5a0a-bd7d-ea8e848fdb2e">3</characteristic>
            <characteristic name="Prow" typeId="84a55377-edbc-5825-a2bf-70c6155018f2">14</characteristic>
            <characteristic name="Broadside" typeId="5f595433-7397-5c4b-9d4a-8f35d83a2b29">13</characteristic>
            <characteristic name="Stern" typeId="cd9ec76e-f959-5560-8845-9ab242f16e71">12</characteristic>
            <characteristic name="HP" typeId="ef713781-2034-5fb4-83d1-e49d1d683694">13</characteristic>
            <characteristic name="VS" typeId="84309751-688d-50ef-8940-d8d042261a56">8</characteristic>
            <characteristic name="Speed" typeId="25d0e01e-8e74-55b3-8a2a-17773c881625">6″</characteristic>
            <characteristic name="Turn" typeId="899e9c58-70ef-5da5-8495-5bf6a8b7f8f0">45°</characteristic>
            <characteristic name="Crew" typeId="2f6312dd-493e-53c6-96e2-d901afca0e81">8</characteristic>
          </characteristics>
        </profile>
        <profile id="3cbceae5-8d61-43be-8e8d-82dca68ff97e" name="Hangar Bays (6)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">6 physical Hangar Bay mounts; each bay costs 10 pts and carries one aircraft squadron.</characteristic>
          </characteristics>
        </profile>
        <profile id="b032a570-1e00-444a-ba36-00897c3481d1" name="Bulwark of the Line" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Enemy Damage Table rolls against this ship suffer −1.</characteristic>
          </characteristics>
        </profile>
        <profile id="45636461-d87f-411f-b3fe-1e5667aaf204" name="Hangar Loadout Validation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Maximum 8 aircraft squadrons.</characteristic>
          </characteristics>
        </profile>
        <profile id="ff8d0239-1033-4a28-a0e3-e46469df61f7" name="Boarding Forces Validation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding forces are bought against the ship’s Crew. Terminator/Dreadnought class limits are enforced; remember a Contemptor occupies 2 Crew slots.</characteristic>
          </characteristics>
        </profile>
        <profile id="78cb2316-dbb8-4284-a117-34e617b4a76c" name="Hardpoint Construction" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Bare chassis. Every mounted weapon is purchased separately. No upgrade-spend ceiling. Legal choices are controlled by hull class, hardpoint type and facing; each hardpoint must contain exactly one weapon.</characteristic>
          </characteristics>
        </profile>
      <profile id="43abc8ff-e9d2-4935-9282-cd3bcb83795b" name="Mount Capacity" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Port Heavy: 1 · Starboard Heavy: 1 · Prow Ordnance: 6 · Dorsal: 4 · Defence: 10 · Hangar: 6</characteristic></characteristics></profile><profile id="893c2d4b-60d2-4754-b1cc-c3fe08a46cb8" name="Hardpoint Configuration" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ships begin with no weapons or Defence Batteries selected. Hangar Bay slots represent built-in hull capacity and cost 0 pts. Each physical hardpoint may take at most one legal component. There is no separate upgrade-spend cap; the hull's mount layout is the limit.</characteristic></characteristics></profile><profile id="1235d363-3f82-4a0b-98c8-4d0114abd2c6" name="Carrier Flagship Priority" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">A Battle Carrier must be the fleet's Flagship unless a Gloriana is present. New Recruit enforces this through the Fleet Role selection.</characteristic></characteristics></profile><profile id="c95f536b-bd1c-4b79-a5ca-a1ce1e31360f" name="Roster Builder Summary" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Crew 8 · Port Heavy 1 · Starboard Heavy 1 · Prow Ordnance 6 · Dorsal 4 · Defence 10 · Hangars 6. Ships start unequipped. Fill only the weapon and Defence hardpoints you want to purchase; each may contain at most one component. Hangar Bay slots cost 0 pts. Aircraft are purchased separately up to Hangar capacity.</characteristic></characteristics></profile></profiles>
      <categoryLinks>
        <categoryLink id="fc93457a-8517-43fd-bece-203713e3e67b" name="Capital Ship" hidden="false" targetId="bd422ebf-10b3-5085-89cc-263568c40fe0" primary="true" />
      </categoryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup id="b98c6f8e-3b9e-4eaa-9349-75a7a8a7ff66" name="Fleet Role" hidden="false" collective="false" import="true"><modifiers><modifier type="set" field="076f299c-dc16-4d05-9378-1af1658f5f4b" value="0.0"><conditions><condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="6e49ea9d-e24f-5916-8418-787496f3214a" type="atLeast" /></conditions></modifier></modifiers><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="aeee6299-8ec0-4757-83cf-666ad2382895" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="076f299c-dc16-4d05-9378-1af1658f5f4b" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="7ef9aa33-162b-4d7b-b7a7-7222f0f0c7c7" name="Designate as Flagship" hidden="false" collective="false" import="true" type="upgrade"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="6e49ea9d-e24f-5916-8418-787496f3214a" type="atLeast" /></conditions></modifier></modifiers><profiles><profile id="3a750bf4-0f35-4bce-b8b0-5c5f7d884bb9" name="Flagship" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Mandatory when the fleet contains no Gloriana. If a Gloriana is selected, this option is automatically hidden and the requirement is removed.</characteristic></characteristics></profile><profile id="4d9966b3-e2d8-4785-a4c0-9df008c1f527" name="Commander Embarkation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander here. The Commander is embarked on this Flagship.</characteristic></characteristics></profile></profiles><categoryLinks><categoryLink id="f41a20ec-c84b-4eec-88b3-9c7d597d20f0" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" /></categoryLinks><selectionEntryGroups><selectionEntryGroup id="b8acf641-713f-44ef-8636-d2ad132d1fb8" name="Fleet Commander" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="68d2696e-0b26-4fba-8e4e-1c65e1be2c1c" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="8eacaf27-0a39-41a9-9941-a4da03d20aba" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="0c72490c-6007-44c9-99b6-bba26dda91bd" name="Fleet Captain" hidden="false" collective="false" import="true" type="upgrade">
