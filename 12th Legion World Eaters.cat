      <profile id="c4f01ec6-275c-5b6f-80bc-07c217c64755" name="Macro-Cannon Battery ×2" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
       <characteristics>
        <characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Starboard</characteristic>
        <characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">8</characteristic>
        <characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">—</characteristic>
        <characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">8 each</characteristic>
        <characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">30″</characteristic>
        <characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">—</characteristic>
       </characteristics>
      </profile>
      <profile id="dd13e3ef-6803-5eec-b2a6-ecaffab0e54d" name="Pattern" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
       <characteristics>
        <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">The workhorse escort of the Imperial Navy, all broadside and endurance.</characteristic>
       </characteristics>
      </profile>
      <profile id="5fa0adaf-3c7b-5da8-aa29-8f79344d8ada" name="Screen" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
       <characteristics>
        <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ship Type: Frigate. Enemy ships suffer −1 BS when targeting a friendly Capital Ship within 3″ of one or more friendly Frigates. Screen protects only Capital Ships, never the Frigate itself, and multiple instances never stack — the maximum is −1 BS.</characteristic>
       </characteristics>
      </profile>
      <profile id="3365acd3-b64a-5c13-a810-6ba76fd52fdc" name="Defence Batteries (2)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
       <characteristics>
        <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship mounts 2 Defence Batteries. They fire only in answer to the Overwatch Fleet Order, at Strength 6, destroying one incoming craft on each 5+. See Defence Batteries.</characteristic>
       </characteristics>
      </profile>
     </profiles>
