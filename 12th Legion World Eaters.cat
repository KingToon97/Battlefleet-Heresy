      <selectionEntry id="035e4fcf-2e8e-5085-8822-622baf856399" name="Red Butchers" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="5490db64-af9d-5caf-b296-c190d4bef7f4" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="d9f3bfd0-d93d-5312-aff3-4bb277ddedcc" name="Red Butchers" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">One Crew point. +2 to its Boarding rolls, and each successful Boarding roll made by this unit inflicts &lt;b&gt;1 additional Crew casualty&lt;/b&gt; — this stacks with Khârn's Blood for the Blood God rather than being replaced by it. Once committed, Red Butchers may never be withdrawn. They may not deploy by Drop Pod; they board by Hull Assault, Assault Ram or Assault Claw only. Battleships and the Conqueror only. Maximum 1 per ship, and it does not count against the Terminator limit.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <categoryLinks>
        <categoryLink id="69194a42-3e1d-5ff2-8297-41cf20baec07" name="Boarding Force" hidden="false" targetId="4d94b920-d5bc-5fd7-a967-4ba346019f56" primary="true" />
