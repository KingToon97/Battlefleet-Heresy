 <sharedSelectionEntryGroups />
 <sharedRules>
  <rule id="cf189106-f0ae-519e-924d-3b43249e8f5f" name="12th Legion - The Red Path" hidden="false">
   <description>At the start of each battle round, name one enemy ship as the World Eaters' chosen target. All friendly World Eaters ships gain &lt;b&gt;+1 to Boarding rolls&lt;/b&gt; against that ship until the end of the round. The bonus does not apply against any other enemy ship. Nothing is tracked beyond which ship was named.</description>
  </rule>
 </sharedRules>
</catalogue>