     <selectionEntries>
      <selectionEntry id="80189e5e-0820-5517-b71d-d628b01b2f5e" name="Adamantium Belt Armour" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="655ac943-11ac-5dd1-8a75-b1ad952e0552" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="9d976aea-d98a-5348-b41a-c3e842a588df" name="Adamantium Belt Armour" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="35.0" />
