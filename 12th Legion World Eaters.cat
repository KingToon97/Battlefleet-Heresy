       <categoryLinks>
        <categoryLink id="dfbc75bd-4ce0-55a0-82e2-08ebdeb26891" name="Boarding Force" hidden="false" targetId="4d94b920-d5bc-5fd7-a967-4ba346019f56" primary="true" />
