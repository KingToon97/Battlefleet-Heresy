      <selectionEntry id="f9796b62-d973-55b2-bbe7-6a2eef4b3e99" name="Caestus Assault Ram" hidden="false" collective="false" import="true" type="upgrade">
       <profiles>
        <profile id="bb8c4723-2e79-5b76-9696-9d390e399695" name="Caestus Assault Ram" hidden="false" typeId="34b870bf-d65e-538e-b38c-9249374e6af1" typeName="Aircraft">
         <characteristics>
          <characteristic name="BS" typeId="019df8fe-0c3f-558c-89a4-b7a49b64f590">4</characteristic>
