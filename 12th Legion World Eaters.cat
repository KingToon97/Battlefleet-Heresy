      <selectionEntry id="536b1c0e-be59-569c-8582-901ff5d8bc7e" name="Contemptor Dreadnought" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="6834d718-eade-550f-948c-1ee1d71874fc" percentValue="false" includeChildSelections="false" includeChildForces="false" />
        <constraint type="max" value="9.0" field="selections" scope="parent" shared="false" id="da11ce79-22d1-5659-87e4-cf01517dca3e" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="453faaf4-9b52-5cbc-a170-02dc0d7f1544" name="Boarding Force" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Counts as 2 Crew; fights as one warrior at +2 and gives −1 to the enemy die it faces. Limits as Terminators.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <categoryLinks>
        <categoryLink id="fdfddffa-e783-5b8b-aad8-399fd3f21239" name="Boarding Force" hidden="false" targetId="4d94b920-d5bc-5fd7-a967-4ba346019f56" primary="true" />
       </categoryLinks>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="80.0" />
