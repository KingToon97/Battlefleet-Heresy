     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">A broadside grand cruiser, everything given over to weight of fire.</characteristic>
     </characteristics>
    </profile>
    <profile id="fd7e9717-c808-5081-8fad-1a348271f8a5" name="Fire Control Coordination" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ship Type: Grand Cruiser. This ship may split its fire without suffering the −1 BS penalty for doing so. All other restrictions on Splitting Fire still apply.</characteristic>
     </characteristics>
    </profile>
    <profile id="743b6952-b572-5956-838c-8cb521fbf40a" name="Defence Batteries (6)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship mounts 6 Defence Batteries. They fire only in answer to the Overwatch Fleet Order, at Strength 6, destroying one incoming craft on each 5+. See Defence Batteries.</characteristic>
     </characteristics>
    </profile>
   </profiles>
