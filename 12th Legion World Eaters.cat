       <selectionEntries>
        <selectionEntry id="adee2687-aead-53e2-b105-d5ef41b63d45" name="Emergency Shield Capacitors" hidden="false" collective="false" import="true" type="upgrade">
         <constraints>
          <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="61940600-64ef-56ec-9a1c-d4c7b7276051" percentValue="false" includeChildSelections="false" includeChildForces="false" />
         </constraints>
         <profiles>
          <profile id="5472960d-a9b3-510f-a519-d0e96042b80b" name="Emergency Shield Capacitors" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
           <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 to Void Shield regeneration rolls. It confers no other benefit and can never raise a ship above its normal number of Void Shields; a shield burnt out despite the bonus stays burnt out for the rest of the battle. Once per ship.</characteristic>
           </characteristics>
          </profile>
         </profiles>
         <costs>
          <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" />
         </costs>
        </selectionEntry>
        <selectionEntry id="3c01d382-5e6b-5470-babf-8b0765af36a2" name="Adamantium Belt Armour" hidden="false" collective="false" import="true" type="upgrade">
         <constraints>
          <constraint field="selections" scope="parent" value="1.0" type="max" id="382a4139-986e-551e-8fda-0c11f66431e1" shared="false" includeChildSelections="false" />
         </constraints>
         <profiles>
          <profile id="9a0d23fc-4a87-51e3-84ac-376682091760" name="Adamantium Belt Armour" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
           <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic>
           </characteristics>
          </profile>
         </profiles>
         <costs>
          <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="20.0" />
         </costs>
        </selectionEntry>
        <selectionEntry id="2fbb536f-c503-528e-9336-52bb89ff9693" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
         <constraints>
          <constraint field="selections" scope="parent" value="1.0" type="max" id="df7168b4-b8ff-5120-a294-4ebf5674ca01" shared="false" includeChildSelections="false" />
         </constraints>
         <profiles>
          <profile id="ce981ce5-1636-51a0-b7c5-148c11df555d" name="Plasma Drive Overhaul" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
           <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic>
           </characteristics>
          </profile>
