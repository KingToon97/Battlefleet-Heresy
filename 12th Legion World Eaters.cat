      <selectionEntry id="f24f5a2c-ce35-5f56-8411-5b61b7effa14" name="Red Butchers" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="5877e624-1434-5d71-a047-4e6c6d8b5f9b" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="889a340c-0985-55a7-95f0-822f67938ef5" name="Red Butchers" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">One Crew point. +2 to its Boarding rolls, and each successful Boarding roll made by this unit inflicts &lt;b&gt;1 additional Crew casualty&lt;/b&gt; — this stacks with Khârn's Blood for the Blood God rather than being replaced by it. Once committed, Red Butchers may never be withdrawn. They may not deploy by Drop Pod; they board by Hull Assault, Assault Ram or Assault Claw only. Battleships and the Conqueror only. Maximum 1 per ship, and it does not count against the Terminator limit.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <categoryLinks>
        <categoryLink id="e5b3805e-6949-5d19-be29-da4e49b03bc9" name="Boarding Force" hidden="false" targetId="4d94b920-d5bc-5fd7-a967-4ba346019f56" primary="true" />
       </categoryLinks>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="75.0" />
       </costs>
      </selectionEntry>
     </selectionEntries>
    </selectionEntryGroup>
