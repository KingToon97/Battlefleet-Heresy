      </selectionEntry>
      <selectionEntry id="0710b20f-def6-5936-a1d4-02ce39984b3c" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="3100bb08-1885-5515-ab57-cabc371b1823" shared="false" includeChildSelections="false" />
