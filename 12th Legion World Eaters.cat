      <selectionEntry id="30c9c408-b578-5d38-8091-c98f977bb36d" name="Contemptor Dreadnought" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="4.0" field="selections" scope="parent" shared="false" id="47d4d0dd-b31f-57f6-bb27-5f811ec55368" percentValue="false" includeChildSelections="false" includeChildForces="false" />
        <constraint type="max" value="14.0" field="selections" scope="parent" shared="false" id="00dfc661-2800-533b-bf04-e65c69626e57" percentValue="false" includeChildSelections="false" includeChildForces="false" />
