        <selectionEntry id="0e64dd5b-e603-509a-bae2-01a8f01a6531" name="Veteran Crew" hidden="false" collective="false" import="true" type="upgrade">
         <constraints>
          <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="411b9453-394c-56b2-949b-2c1b90432d6c" percentValue="false" includeChildSelections="false" includeChildForces="false" />
         </constraints>
         <profiles>
          <profile id="7dcc5ba7-1bfb-5c34-8e7a-9ca6ed660a30" name="Veteran Crew" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
           <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Once per ship. +1 BS, to maximum BS 5.</characteristic>
           </characteristics>
          </profile>
         </profiles>
