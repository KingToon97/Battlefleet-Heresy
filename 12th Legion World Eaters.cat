       <profiles>
        <profile id="3118eb6e-909d-5454-bd5c-d6cf380e7052" name="Emergency Shield Capacitors" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
