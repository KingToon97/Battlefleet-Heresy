      <profile id="bec05b88-6a3e-57ea-a1c3-21194802ff19" name="Pattern" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
       <characteristics>
        <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">A gunnery refit that trades the torpedo tube for a heavier screen.</characteristic>
       </characteristics>
      </profile>
      <profile id="0d33ff08-462a-533b-9828-c8a2d6b5960f" name="Wolf Pack" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
       <characteristics>
        <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ship Type: Destroyer. Destroyers of one squadron within 6″ may combine their Torpedo Tubes against a single target, adding +1 to penetration. Torpedoes only — gunnery is never combined.</characteristic>
       </characteristics>
      </profile>
      <profile id="8064dc23-27b7-5e76-bcc8-2406125f1de6" name="Defence Batteries (1)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
       <characteristics>
        <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship mounts 1 Defence Batteries. They fire only in answer to the Overwatch Fleet Order, at Strength 6, destroying one incoming craft on each 5+. See Defence Batteries.</characteristic>
       </characteristics>
      </profile>
     </profiles>
