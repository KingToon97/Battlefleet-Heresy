   </constraints>
   <profiles>
    <profile id="22d361fc-1193-5065-ac8d-e3b5d531ae19" name="Battle Barge - Standard pattern" hidden="false" typeId="806f9ff1-fd51-5ddb-b005-ce73a5d09d65" typeName="Ship">
