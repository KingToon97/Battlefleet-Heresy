          <profile id="e8f3a730-3bbb-52ac-8358-d7e4eec4b760" name="Emergency Shield Capacitors" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
           <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 to Void Shield regeneration rolls. It confers no other benefit and can never raise a ship above its normal number of Void Shields; a shield burnt out despite the bonus stays burnt out for the rest of the battle. Once per ship.</characteristic>
           </characteristics>
          </profile>
         </profiles>
         <costs>
          <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" />
         </costs>
        </selectionEntry>
        <selectionEntry id="098bcc9d-a2ec-50af-9719-65325fb58c4f" name="Adamantium Belt Armour" hidden="false" collective="false" import="true" type="upgrade">
         <constraints>
          <constraint field="selections" scope="parent" value="1.0" type="max" id="0e7a245d-5eb6-5c75-99a5-03e92b227101" shared="false" includeChildSelections="false" />
