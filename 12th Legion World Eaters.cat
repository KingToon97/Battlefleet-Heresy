       <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="8719d47d-98bf-4858-af09-8e86a7a1ab35" type="max" />
       </constraints>
       <profiles>
        <profile id="acdf2251-ccac-40d2-a51d-0d82a263c3c7" name="Khârn" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Character. Blood for the Blood God: when this ship boards, each successful Boarding roll made by its Crew inflicts &lt;b&gt;2 Crew casualties instead of 1&lt;/b&gt;, and each unmodified Boarding roll of 1 inflicts &lt;b&gt;2 Crew casualties on this ship&lt;/b&gt;. This stacks with Red Butchers rather than replacing their additional Crew damage.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <categoryLinks>
        <categoryLink id="4d0da43f-dfbd-48ab-817a-64dcc25612a0" name="Commander" hidden="false" targetId="6f3339ad-23a9-5687-b08f-3f11a43fe50b" primary="true" />
