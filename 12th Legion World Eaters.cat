   </constraints>
   <profiles>
    <profile id="0180e40e-6bd6-5536-88ff-a0472c49c94b" name="Battle Barge - Invasion pattern" hidden="false" typeId="806f9ff1-fd51-5ddb-b005-ce73a5d09d65" typeName="Ship">
