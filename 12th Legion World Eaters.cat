      <characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">One Use. One torpedo per tube. Bypasses Void Shields; Armourbane</characteristic>
     </characteristics>
    </profile>
    <profile id="b5b53255-b74e-5df4-94aa-5614226d7ea4" name="Twin Lance Turret ×4" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
