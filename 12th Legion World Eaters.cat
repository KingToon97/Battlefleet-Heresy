      <characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">—</characteristic>
     </characteristics>
    </profile>
    <profile id="9b768063-c2bb-5349-8ed3-6acdb5f6cfe7" name="Pattern" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">The line battleship: torpedoes forward, lances aloft and a broadside that ends arguments.</characteristic>
     </characteristics>
    </profile>
    <profile id="8ddff0ff-4729-52be-b85b-bf66413ced62" name="Bulwark of the Line" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ship Type: Battleship. Apply −1 to Damage Table rolls made against this ship.</characteristic>
     </characteristics>
    </profile>
    <profile id="6470b753-abe3-58b9-bdcf-5959294f3865" name="Defence Batteries (8)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship mounts 8 Defence Batteries. They fire only in answer to the Overwatch Fleet Order, at Strength 6, destroying one incoming craft on each 5+. See Defence Batteries.</characteristic>
     </characteristics>
    </profile>
