      <selectionEntry id="1c4a1c31-17e8-5a05-9824-24bd7e863fcd" name="Red Butchers" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="f40c3e65-3d1c-5a9c-8c92-0e37677d6861" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="02150ba8-d4cc-5e6d-9c2d-5dd43e4c1c25" name="Red Butchers" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">One Crew point. +2 to its Boarding rolls, and each successful Boarding roll made by this unit inflicts &lt;b&gt;1 additional Crew casualty&lt;/b&gt; — this stacks with Khârn's Blood for the Blood God rather than being replaced by it. Once committed, Red Butchers may never be withdrawn. They may not deploy by Drop Pod; they board by Hull Assault, Assault Ram or Assault Claw only. Battleships and the Conqueror only. Maximum 1 per ship, and it does not count against the Terminator limit.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <categoryLinks>
        <categoryLink id="432b7410-0f52-53ad-8985-bd2e99c08c11" name="Boarding Force" hidden="false" targetId="4d94b920-d5bc-5fd7-a967-4ba346019f56" primary="true" />
