      <profile id="a04d474e-2eb4-5a5e-a0d3-b83d067c6b17" name="Pattern" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
       <characteristics>
        <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">The Navy's torpedo boat, and the pattern every other destroyer is measured against.</characteristic>
       </characteristics>
      </profile>
      <profile id="525c1ed4-6ecb-5107-9c1f-e80df03006a3" name="Wolf Pack" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
       <characteristics>
        <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ship Type: Destroyer. Destroyers of one squadron within 6″ may combine their Torpedo Tubes against a single target, adding +1 to penetration. Torpedoes only — gunnery is never combined.</characteristic>
       </characteristics>
      </profile>
      <profile id="72e654b7-eb78-5e44-b828-49e984f1a86d" name="Defence Batteries (1)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
       <characteristics>
        <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship mounts 1 Defence Batteries. They fire only in answer to the Overwatch Fleet Order, at Strength 6, destroying one incoming craft on each 5+. See Defence Batteries.</characteristic>
       </characteristics>
      </profile>
     </profiles>
