   <profiles>
    <profile id="c0ab8d02-a95e-5d38-9700-387feb2adec9" name="Gloriana - Conqueror" hidden="false" typeId="806f9ff1-fd51-5ddb-b005-ce73a5d09d65" typeName="Ship">
     <characteristics>
      <characteristic name="BS" typeId="d130e705-611e-5a0a-bd7d-ea8e848fdb2e">4</characteristic>
