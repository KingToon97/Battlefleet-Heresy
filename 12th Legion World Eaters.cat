     <selectionEntries>
      <selectionEntry id="6e065286-20c8-5c07-bd76-6f19fbd612e1" name="Adamantium Belt Armour" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="a7ecaacb-44f1-551e-a739-0e620f6df9bf" shared="false" includeChildSelections="false" />
