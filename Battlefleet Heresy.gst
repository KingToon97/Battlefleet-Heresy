          <constraints>
            <constraint field="selections" scope="force" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="8db5ddce-8cd8-5305-85d4-694f07b9609b" type="max" />
          </constraints>
