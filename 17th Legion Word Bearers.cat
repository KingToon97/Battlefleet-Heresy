      <selectionEntry id="188100f1-2b7e-586b-bd4d-dc14fc3b5eaa" name="The Anointed" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="9fa1e47c-98dc-5626-abd2-f5b46e013deb" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="b6c1a454-560f-5b0c-a3e0-79478bb00793" name="The Anointed" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">One Crew point; +2 to its boarding die. Maximum 1 per ship, and it does not count against the Terminator limit. When this unit wins a duel, roll a D6: on a 5+ the enemy ship also suffers 1 Critical Damage.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <categoryLinks>
