    </profile>
    <profile id="bdc4db29-aa6d-5cbe-aa45-e5c2ffc4bc35" name="Pattern" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">A Lunar's broadside married to a Mars's lance batteries — a compromise that outlived the designs it borrowed from.</characteristic>
     </characteristics>
    </profile>
    <profile id="acdac174-4f2d-592e-997a-a64646dee9c8" name="Battleline Momentum" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ship Type: Battlecruiser. This ship may fire normally while under All Ahead Full, ignoring the restriction that would otherwise limit it to Defence Batteries.</characteristic>
     </characteristics>
    </profile>
   </profiles>
