    <profile id="b5ec7304-22f9-519f-86d5-8d2fd5aae3bd" name="Pattern" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">The most numerous cruiser in the Imperium, and the most balanced: torpedoes, lances and a full broadside.</characteristic>
     </characteristics>
    </profile>
    <profile id="26524d26-c265-5c82-a4ec-71cf6776c2b6" name="Enduring Hull" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ship Type: Cruiser. This ship succeeds on Damage Control rolls on a 3+ rather than 4+.</characteristic>
