      <characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">5</characteristic>
      <characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3 each</characteristic>
      <characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">12″</characteristic>
      <characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Skyfire; Interceptor. Aircraft to 12″; ships within 6″</characteristic>
     </characteristics>
    </profile>
    <profile id="094cd2a1-0c10-51c5-983a-d3e18561a828" name="Pattern" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">A gunnery battlecruiser, lances and broadside in equal measure and no nova cannon to reload around.</characteristic>
     </characteristics>
    </profile>
    <profile id="a373d0a5-d52d-5078-8426-9625604cc680" name="Battleline Momentum" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ship Type: Battlecruiser. This ship may fire normally while under All Ahead Full, ignoring the restriction that would otherwise limit it to Defence Batteries.</characteristic>
     </characteristics>
    </profile>
