      </selectionEntry>
      <selectionEntry id="1bedb710-53cb-52be-8b65-0db0ea12e2f8" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="7cd4f417-507b-52d2-8677-2d3223ad8b1a" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="461bf754-1db7-59db-9689-4affc95e8424" name="Plasma Drive Overhaul" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="15.0" />
