       <selectionEntries>
        <selectionEntry id="be243efe-9c2a-578b-8d23-1bcbf9e97e62" name="Blast-Shielded Magazines" hidden="false" collective="false" import="true" type="upgrade">
         <constraints>
          <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="53e5d6bd-498d-58f3-923d-8742a3b87008" percentValue="false" includeChildSelections="false" includeChildForces="false" />
         </constraints>
         <profiles>
          <profile id="defa551a-786b-53dd-9aa6-8b990c8223e5" name="Blast-Shielded Magazines" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
           <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Damage Control caused by a Magazine Explosion by 1, to a minimum of 0. A Twin Lance Turret that would suffer 1 Damage Control instead suffers 0 and ignores the effect; a Triple Lance Turret that would suffer 2 instead suffers 1. No other effect of a Magazine Explosion is prevented or reduced. Once per ship. Not available to Gloriana class or above.</characteristic>
           </characteristics>
          </profile>
         </profiles>
         <costs>
          <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" />
         </costs>
        </selectionEntry>
        <selectionEntry id="95edfac4-7308-58c0-85be-2a700817dfcf" name="Emergency Shield Capacitors" hidden="false" collective="false" import="true" type="upgrade">
         <constraints>
          <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="cf458ec7-d197-5a49-b536-5b157bbc6098" percentValue="false" includeChildSelections="false" includeChildForces="false" />
         </constraints>
         <profiles>
          <profile id="933e47d5-5a2e-57c7-9c2f-2a80ce08bc35" name="Emergency Shield Capacitors" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
           <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 to Void Shield regeneration rolls. It confers no other benefit and can never raise a ship above its normal number of Void Shields; a shield burnt out despite the bonus stays burnt out for the rest of the battle. Once per ship.</characteristic>
           </characteristics>
          </profile>
         </profiles>
         <costs>
          <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" />
         </costs>
        </selectionEntry>
        <selectionEntry id="9c8fbcee-2208-5ef1-93af-dcc30a2589ea" name="Servitor Autoloaders" hidden="false" collective="false" import="true" type="upgrade">
         <constraints>
          <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="279a5ad2-2ce2-5384-9f6a-5448bc3ec20b" percentValue="false" includeChildSelections="false" includeChildForces="false" />
         </constraints>
         <profiles>
          <profile id="694ebb23-7c53-5dc5-9ec6-0ac0adf7be22" name="Servitor Autoloaders" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
           <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose one weapon type aboard this ship when you buy this upgrade and note it on the roster. That weapon type reduces its Reload value by 1, to a minimum of Reload (0) — Reload (3) becomes Reload (2), Reload (2) becomes Reload (1). A weapon at Reload (1) already fires every battle round and gains nothing. Once per ship. Not available to Gloriana class or above.</characteristic>
           </characteristics>
          </profile>
         </profiles>
         <costs>
          <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" />
         </costs>
        </selectionEntry>
        <selectionEntry id="6423d579-d809-598b-a278-fca3c5ce1875" name="Adamantium Belt Armour" hidden="false" collective="false" import="true" type="upgrade">
         <constraints>
          <constraint field="selections" scope="parent" value="1.0" type="max" id="9a0c3dad-56d9-52d9-af3e-f0f04a42cd97" shared="false" includeChildSelections="false" />
         </constraints>
         <profiles>
          <profile id="24f74c14-1d17-583a-960b-3617bae7d576" name="Adamantium Belt Armour" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
           <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic>
           </characteristics>
          </profile>
         </profiles>
         <costs>
          <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" />
         </costs>
        </selectionEntry>
