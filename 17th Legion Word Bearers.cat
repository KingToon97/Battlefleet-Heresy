     <selectionEntries>
      <selectionEntry id="9b8361eb-b68f-52ab-95b6-0c80e0c2264b" name="Adamantium Belt Armour" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="a7308ecc-b5c6-55ec-bb6a-6476d2a21c7b" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="561d1c22-1ede-5b3e-b2da-c1880c10735f" name="Adamantium Belt Armour" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic>
         </characteristics>
