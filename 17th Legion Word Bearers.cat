     <selectionEntries>
      <selectionEntry id="499758c5-e652-572d-90f3-7516a0b8fe53" name="Adamantium Belt Armour" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="f596f3a3-4ae8-5742-9bd3-3cf9e2064c58" shared="false" includeChildSelections="false" />
