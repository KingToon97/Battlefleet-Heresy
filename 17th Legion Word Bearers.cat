    <profile id="56edc2c8-f452-516c-9a58-80aead268b0d" name="Fanatical Devotion" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Friendly ships within 18″ ignore the Depleted −1 BS penalty. Launch Bays (4).</characteristic>
