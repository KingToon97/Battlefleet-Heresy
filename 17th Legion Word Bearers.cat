       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="20f52d21-0391-57f8-9ead-5c03f89b766c" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="30b7f549-1812-5270-bcfa-6a8e12cb8fd5" name="Plasma Drive Overhaul" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic>
         </characteristics>
        </profile>
       </profiles>
