     <selectionEntries>
      <selectionEntry id="9d948895-0170-522a-8339-532fb908acf9" name="Adamantium Belt Armour" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="8e9341db-a737-540b-a00a-9c463065041f" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="98139b05-162f-5af0-afd7-1cde1ad2ffc4" name="Adamantium Belt Armour" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="85.0" />
       </costs>
      </selectionEntry>
      <selectionEntry id="cde2e87b-da44-5469-9e11-068cb1db2d1a" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="e68b75b0-38b1-55d1-9ddb-b25204d462a7" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="d8def8ca-2877-5951-96cf-e1fae5c8a33b" name="Plasma Drive Overhaul" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="50.0" />
