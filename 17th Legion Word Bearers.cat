      </selectionEntry>
      <selectionEntry id="7c86c913-8b54-5aca-b652-480f3e046ae7" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="86e12311-316f-53b9-81b1-760df22de8e3" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="f159b70e-8424-5eab-84b8-d414c8c2238c" name="Plasma Drive Overhaul" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="25.0" />
