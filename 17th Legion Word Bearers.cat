     </constraints>
     <selectionEntries>
      <selectionEntry id="cbf84fa3-de68-59c7-983e-2e19e858149f" name="Adamantium Belt Armour" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="37a7c776-af10-5ada-9468-e5dee32bcad4" shared="false" includeChildSelections="false" />
