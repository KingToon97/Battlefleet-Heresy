    <profile id="c059af9c-e98d-5306-a23c-43128c6e1622" name="Launch Bays (2)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship carries 2 Launch Bays, sited on her broadsides. Each holds one aircraft squadron, bought separately. See Launch Bays &amp; Aircraft.</characteristic>
     </characteristics>
    </profile>
    <profile id="13effa38-110d-5a6d-9d84-0f861860d9b7" name="Engage the Enemy" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
