    <profile id="a76836fe-c797-5f3a-a80b-d4d9f59d4d8b" name="Launch Bays (4)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship carries 4 Launch Bays, sited on her broadsides. Each holds one aircraft squadron, bought separately. See Launch Bays &amp; Aircraft.</characteristic>
     </characteristics>
    </profile>
    <profile id="f1ac43d8-91f4-5cf4-8610-868bbdae262a" name="Pride of the Legion" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ship Type: Gloriana. This ship ignores the Crippled and Depleted −1 BS penalties, and friendly ships within 12″ may re-roll a failed Damage Control roll once each battle round. She must be the fleet's Flagship, one per battle, and may be fielded only at 2,000 points or more.</characteristic>
     </characteristics>
    </profile>
