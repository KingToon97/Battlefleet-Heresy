       <profiles>
        <profile id="2dd57de6-8872-5ac5-a0b2-1de6b7cefe87" name="The Anointed" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">One Crew point; +2 to its boarding die. Maximum 1 per ship, and it does not count against the Terminator limit. When this unit wins a duel, roll a D6: on a 5+ the enemy ship also suffers 1 Critical Damage.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <categoryLinks>
        <categoryLink id="82c5abfa-2dff-565c-bf95-42997c6ba4a9" name="Boarding Force" hidden="false" targetId="4d94b920-d5bc-5fd7-a967-4ba346019f56" primary="true" />
