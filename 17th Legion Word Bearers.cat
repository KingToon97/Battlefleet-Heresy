    <profile id="5a42ca83-65f5-5f9f-82ff-a95e6e0674f0" name="Pattern" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">A flexible flagship pattern, guns and bays in equal measure.</characteristic>
     </characteristics>
    </profile>
    <profile id="e3138b73-76d6-53ed-a5ad-518f9f62c780" name="Launch Bays (2)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship carries 2 Launch Bays, sited on her broadsides. Each holds one aircraft squadron, bought separately. See Launch Bays &amp; Aircraft.</characteristic>
     </characteristics>
    </profile>
    <profile id="6a019bc5-641a-53b0-a6f8-49efdaf4c4b0" name="Bulwark of the Line" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ship Type: Battleship. Apply −1 to Damage Table rolls made against this ship.</characteristic>
     </characteristics>
    </profile>
