      <characteristic name="Turn" typeId="899e9c58-70ef-5da5-8495-5bf6a8b7f8f0">45°</characteristic>
      <characteristic name="Crew" typeId="2f6312dd-493e-53c6-96e2-d901afca0e81">12</characteristic>
     </characteristics>
    </profile>
    <profile id="a7b5e4f2-6ff8-5bba-af82-9227b0e1749a" name="Leviathan of Ruin" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Word Bearers only; games 3,000+ points. Explodes on 5+ rather than 6, radius 3D6″. Bound Reactor: Warp Lances fire into all arcs. Launch Bays (6). Armament fixed.</characteristic>
     </characteristics>
    </profile>
    <profile id="811caf45-f362-574e-b448-cc90bc508913" name="Nova Cannon ×2" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
     <characteristics>
      <characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Prow</characteristic>
      <characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">12</characteristic>
      <characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">D</characteristic>
      <characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1 each</characteristic>
      <characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">60″</characteristic>
      <characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Prow only. Devastating (3); Reload (2)</characteristic>
     </characteristics>
    </profile>
    <profile id="16a81be6-c803-5aa3-b3ed-b9feeb9922ae" name="Vortex Torpedo ×3" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
     <characteristics>
      <characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Prow</characteristic>
      <characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">12</characteristic>
      <characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">D</characteristic>
      <characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1 each</characteristic>
      <characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">60″</characteristic>
      <characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">One Shot; Devastating (3); Volatile. Bypasses Void Shields entirely, resolving against the hull facing struck. Prow mount only</characteristic>
     </characteristics>
    </profile>
    <profile id="dcbadd2c-a938-57d6-b0ca-df51a24aee0b" name="Quad Warp Lance Turret ×6" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
     <characteristics>
      <characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Dorsal</characteristic>
      <characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">12</characteristic>
      <characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">D</characteristic>
      <characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">4 each</characteristic>
      <characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">60″</characteristic>
      <characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Reload (3); Devastating (3). Ignores Void Shields entirely, resolving against the hull facing struck. All arcs — Bound Reactor. Structural Integrity: after this weapon resolves its attacks, roll a D6; on a 1 or a 6 it suffers a Magazine Explosion. Unstable Core: a Magazine Explosion from this weapon costs the ship 3 Hull Points in place of the normal loss, and every other effect of a Magazine Explosion still applies.</characteristic>
     </characteristics>
    </profile>
    <profile id="3354daf4-7da4-5c40-8405-49f82076d286" name="Heavy Macro-Cannon Battery ×5" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
