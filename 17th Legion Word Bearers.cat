    <selectionEntryGroup name="Hull Upgrades" id="0b5a34d9-5fce-5cf8-8284-d11c459bb227" hidden="false" collective="false" import="true">
     <constraints>
      <constraint type="max" value="3.0" field="selections" scope="parent" shared="false" id="25350aab-d484-591e-8603-a12a60930080" percentValue="false" includeChildSelections="false" includeChildForces="false" />
