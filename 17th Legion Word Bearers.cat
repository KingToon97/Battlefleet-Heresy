      <characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">One torpedo per tube. Bypasses Void Shields; Armourbane; Reload (2)</characteristic>
     </characteristics>
    </profile>
    <profile id="799df14d-399b-5428-a568-353d184ad8d0" name="Lance Turret ×2" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
