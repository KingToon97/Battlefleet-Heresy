 <sharedRules>
  <rule id="fd170906-9c42-5061-987d-258f46f45460" name="17th Legion - Daemonic Incursion" hidden="false">
   <description>Once per battle round, select one enemy ship and roll off against its owner, each rolling a D6. If you win, that ship suffers 1 Critical Damage; on a tie nothing happens. Only a Word Bearers fleet may field the Abyss.</description>
  </rule>
 </sharedRules>
</catalogue>