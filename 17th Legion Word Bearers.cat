       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="9af0723d-894f-5220-9a95-9613dfe490b8" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="d1bf6aff-4308-5282-9986-82a87213fe56" name="The Anointed" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">One Crew point; +2 to its boarding die. Maximum 1 per ship, and it does not count against the Terminator limit. When this unit wins a duel, roll a D6: on a 5+ the enemy ship also suffers 1 Critical Damage.</characteristic>
         </characteristics>
        </profile>
       </profiles>
