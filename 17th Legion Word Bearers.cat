     <selectionEntries>
      <selectionEntry id="5289ebcc-0928-5dae-94b5-ae7a0f044488" name="Veteran Crew" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="ff3e184c-da3e-5517-ae06-8f18659d5086" percentValue="false" includeChildSelections="false" includeChildForces="false" />
