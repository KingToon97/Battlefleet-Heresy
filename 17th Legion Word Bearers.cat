    <profile id="1aa42bc0-5f5c-5e34-b397-4f05d32099a1" name="Macro-Cannon Battery ×2" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
