      </selectionEntry>
      <selectionEntry id="9bd353a7-31bc-5a09-a1d4-9cd16e989211" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="9cd018e9-e70f-5952-b3a1-f9109f71bcdc" shared="false" includeChildSelections="false" />
