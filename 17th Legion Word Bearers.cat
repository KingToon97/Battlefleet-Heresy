       <profiles>
        <profile id="0481e563-dd6b-52c6-bbff-ce7e6eeb22aa" name="Boarding Force" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
