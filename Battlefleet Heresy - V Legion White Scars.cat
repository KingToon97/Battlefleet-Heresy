              </costs>
              <profiles>
                <profile id="8f1f78b6-1e41-46c9-bc89-53f024af5b86" name="Macrobattery" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
                  <characteristics>
                    <characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Port</characteristic>
                    <characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">8</characteristic>
