            <characteristic name="Turn" typeId="899e9c58-70ef-5da5-8495-5bf6a8b7f8f0">45°</characteristic>
            <characteristic name="Crew" typeId="2f6312dd-493e-53c6-96e2-d901afca0e81">7</characteristic>
          </characteristics>
        </profile>
        <profile id="077cdbf2-7a42-5d19-a127-e4cae97b9c30" name="Hardpoint Construction" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Bare chassis. Every mounted weapon is purchased separately. No upgrade-spend ceiling. Legal choices are controlled by hull class, hardpoint type and facing; each hardpoint must contain exactly one weapon.</characteristic>
          </characteristics>
        </profile>
      <profile id="4977eedb-f680-4ded-b3ec-04e528381765" name="Hangar Bays (1)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">1 physical Hangar Bay mount; each bay costs 10 pts and carries one aircraft squadron.</characteristic></characteristics></profile><profile id="38427ca2-fe1e-417a-8060-9102595164b4" name="Mount Capacity" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Port: 3 · Starboard: 3 · Prow Ordnance: 3 · Dorsal: 3 · Defence: 6 · Hangar: 1</characteristic></characteristics></profile><profile id="856d8713-5149-4f72-b394-86b14c7ec783" name="Hardpoint Configuration" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Every physical weapon, defence and hangar hardpoint must be filled exactly once. There is no separate upgrade-spend cap; the hull's mount layout is the limit.</characteristic></characteristics></profile><profile id="f71e84d1-b56c-4a8c-b963-09026c8c8d6e" name="Roster Builder Summary" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Crew 7 · Port 3 · Starboard 3 · Prow Ordnance 3 · Dorsal 3 · Defence 6 · Hangars 1. Fill every physical hardpoint exactly once; aircraft are purchased separately up to Hangar capacity.</characteristic></characteristics></profile></profiles>
      <selectionEntryGroups>
        <selectionEntryGroup id="f3b84092-4469-4669-8583-3c6106382a9e" name="Fleet Role" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="d5640223-6615-431b-9c50-97866ae41f7d" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="5ead3dd2-d5ec-4ce9-902d-964ac4009c37" name="Designate as Flagship" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" /></costs><categoryLinks><categoryLink id="fa636510-4c35-46c5-bb70-6b122a4c2c72" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" /></categoryLinks><profiles><profile id="661f215c-f807-43d3-aef9-2494bd9b583d" name="Flagship" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship is the fleet's Flagship. Exactly one Flagship is required in a standard fleet.</characteristic></characteristics></profile><profile id="fb275df7-60dc-4b32-bcb2-394861e48964" name="Commander Embarkation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander here. The Commander is embarked on this Flagship.</characteristic></characteristics></profile></profiles><selectionEntryGroups><selectionEntryGroup id="be25f4b7-79a2-4d92-8b65-ecf50e98b84b" name="Fleet Commander" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="bd712e7d-5978-450f-85a6-8360d8f085d6" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" 