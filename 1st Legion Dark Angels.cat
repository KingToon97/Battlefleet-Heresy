 <selectionEntryGroup id="70c639f5f90103fecdcd524581f211b8" name="Hull Upgrades" hidden="false"><constraints><constraint type="max" value="6.0" field="selections" scope="parent" shared="false" id="71a2fb45-eece-50d8-ac03-a765004fd0d6" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="50e7a2792b00e0b5392a9eda8efa3ca7" name="Side Armour Reinforcement" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="9e710dc0a12e0dded584f4e426c4344a" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="c6e686f0762f2071d9a13c8319abb84f" name="Side Armour Reinforcement" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="120.0" /></costs></selectionEntry><selectionEntry id="50eece935aacf13fc3498f4d819c4c14" name="Engine Refit" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="68f6dbdfa510a1f06f1872322bee4f65" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="e37c95b77da60a268db4eede5e21ebff" name="Engine Refit" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="160.0" /></costs></selectionEntry><selectionEntry id="474c355d-3734-5d99-836c-ff8499188f37" name="Phosphex Shells" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="6dde6788-0fe8-5919-b77e-ba6758281211" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="8e0b2da3-c94a-52c6-b6a5-a6d1015deec1" name="Phosphex Shells" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Every Heavy Macro-Cannon Battery aboard fires phosphex: whenever one penetrates armour, the target takes 1 Critical Damage. Requires at least one Heavy Macro-Cannon Battery. Every Death Guard Capital Ship carries Phosphex Shells free of charge.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="80.0" /></costs></selectionEntry><selectionEntry id="7f284edd-f118-5ef0-8026-b46ee06076f9" name="Reinforced Magazine Compartments" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="260fd6b9-b98c-5ce4-97f9-04c26f53cd48" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="e381c1aa-642e-502d-9e3d-ddf0ce5475ef" name="Reinforced Magazine Compartments" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Damage Control caused by a Magazine Explosion by 1, to a minimum of 0. A Twin Lance Turret that would suffer 1 Damage Control instead suffers 0 and ignores the effect; a Triple Lance Turret that would suffer 2 instead suffers 1. No other effect of a Magazine Explosion is prevented or reduced. Once per ship. Not available to Gloriana class or above.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="80.0" /></costs></selectionEntry><selectionEntry id="28126779-ed40-505f-a1af-c9ace914b9eb" name="Enhanced Void Shield Array" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="a96704fb-c437-5c1e-b1bd-b5645e2c8c77" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="ad073c3e-7325-564e-a35b-1e4ca59e5976" name="Enhanced Void Shield Array" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">At the end of each battle round this ship regains 1 lost Void Shield, provided its Void Shields are currently active. It can never exceed its normal maximum. If its Void Shields have completely collapsed, been disabled, or are otherwise inactive, this upgrade cannot regenerate them; once at least one Void Shield is restored and the shields are active again, it resumes functioning normally. Once per ship. Not available to Gloriana class or above.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="120.0" /></costs></selectionEntry><selectionEntry id="2428a74d-3fef-5ff3-b779-9ea1e99bea8d" name="Autoloaders" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="fce4cf62-57e0-5d0f-a769-669b60a6a121" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="8e6bd537-4171-53a0-b84f-23609094dc1a" name="Autoloaders" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Reload value of every weapon and system aboard this ship by 1, to a minimum of Reload 0 — Reload (3) becomes Reload (2), Reload (2) becomes Reload (1), Reload (1) becomes Reload (0). A weapon reduced to Reload (0) has no cooldown and may fire every applicable battle round. Once per ship. Not available to Gloriana class or above.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="160.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
 <costs>
 <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="180.0" />
 </costs>
 </selectionEntry>
 <selectionEntry id="b235fa62-e81c-5fed-88c5-5f64800c7de7" name="1st Legion - The First Legion" hidden="false" collective="false" import="true" type="upgrade">
 <rules><rule id="07f22a70-11f5-51fc-8779-373c93d4b1a2" name="1st Legion - The First Legion" hidden="false"><description>Each friendly ship may re-roll one failed ranged Penetration roll per battle round.</description></rule></rules><categoryLinks>
 <categoryLink id="5d15d960-0965-5a18-8f97-5e99a5e9a339" name="Rules" hidden="false" targetId="52616092-abd8-519e-a6fb-94b622114fa5" primary="true" /></categoryLinks>
 <costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" /></costs></selectionEntry>
 <selectionEntry id="f74294c0-faa6-5e6d-8e33-f4c0ca41e282" name="Core Rules" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="force" shared="false" id="dc90f864-a5f8-58b7-adf1-514f4113c3a1" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><rules><rule id="10429b35-b21e-5abc-9f65-4f9d0b63bf2d" name="The Battle Round" hidden="false"><description>1. Muster — flip Reload tokens and remove any reaching 0, refresh the fleet's Fleet Order allowance, declare Reactor Overloads. In the first battle round roll off for Initiative; in every later round it passes to whoever finished the previous round. The holder moves, shoots and rams first for the whole round. 2. Movement — alternate one ship each, then one aircraft squadron each. 3. Shooting — alternate one ship or squadron each. 4. Ramming &amp; Boarding — alternate one ship each. 5. End of round — resolve dogfights, then Critical Damage. A game lasts six rounds, and every duration runs to the end of the battle round unless it names something else.</description></rule><rule id="3d94b4d3-fef7-5ebf-8084-eb3c5f3f6364" name="Movement" hidden="false"><description>A ship moves at least half its Speed and never more than 12″ (All Ahead Full excepted). It may make one turn per battle round, up to its Turn value, taken either at the start or at the end of its move — no straight run is required before turning. Ships may never overlap unless a Ram is declared; accidental contact stops the moving ship 1″ short.</description></rule><rule id="9b7fcd8f-69a1-5506-8f85-295f3811eb38" name="Shooting" hidden="false"><description>A ship normally fires everything that bears at one enemy ship. It may instead split its fire between targets, but every weapon aboard then fires at −1 BS for that round. A squadron may always divide its fire between its own ships without penalty, since each ship still fires all of its own weapons at the one target it chose. Roll a D6 per shot, hitting on 7 − BS. A natural 1 always misses and no modifier lowers the roll below 2+. Modifiers: target is a wreck +1 — a hulk cannot dodge. A ship that held station under Burn Retros fires its Port and Starboard broadsides at +1 BS.</description></rule><rule id="8546a1c5-3743-585c-920c-94df6d07d0a8" name="Void Shields" hidden="false"><description>While Void Shield Rating is above 0 the shields are Armour Value 12 and every hit strikes them rather than the hull. Roll 1D6 + Strength against AV 12; equal or better collapses one layer and does nothing else — no Hull Points, no Damage Table. There is no save. At VS 0 the shields collapse permanently, with no restoration or repair, and AP applies in full. Torpedo Tubes, Vortex Torpedoes, Melta Mines and the Abyss's Quad Warp Lance Turrets bypass shields entirely. Nothing else does.</description></rule><rule id="b8079842-7b5c-55d6-8a60-a9238fce0bbd" name="Penetration" hidden="false"><description>For each hit past the shields, roll 1D6 + Strength against the Armour Value of the facing struck. Equal = Glancing Hit: 1 Hull Point, no damage roll. Greater = Penetrating Hit: 1 Hull Point and a roll on the Damage Table. No Armour Value may exceed 14 by any means.</description></rule><rule id="aa7a129f-f65f-5ffe-9dad-c017c60920ca" name="Point-Blank Broadsides" hidden="false"><description>At 6″ or less, Port, Starboard and Dorsal weapons improve their AP by one step — a Macro-Cannon Battery to AP 2, a Heavy Macro-Cannon Battery to AP 1. A weapon whose printed AP is already 1 gains Armourbane instead. Never both, and Prow weapons get neither.</description></rule><rule id="1fe64f53-6074-51a3-8758-30e5606529ab" name="Stern Strike" hidden="false"><description>When a Strength 9+ weapon rolls a natural 6 on its penetration die against a target's Stern and beats the Stern AV, the hit also inflicts Engines Crippled at once. With Armourbane at least one of the two dice must show a 6. It does not stack with an Engines Crippled already rolled, and while shields hold the hit must bring them down first.</description></rule><rule id="ba9695c6-3a11-5289-bbdf-f81082459ebb" name="Ship Damage Table" hidden="false"><description>Roll a D6 when a Penetrating Hit is scored. Modifiers: AP 2 +1 • AP 1 +2 • Destroyer +3 in place of any AP modifier, +2 against a Gloriana, the Abyss or the Phalanx • Ramming +1 • Battleship target −1. A modified 7+ counts as Reactor Struck; below 1 counts as 1, and a 1 does nothing.
1 HELD • Immediate: none. • Ongoing: none.
2 BLAZE • Immediate: 1 Critical Damage. • Ongoing: the ship loses 1 Crew at the end of each battle round for each Critical Damage it carries. • Repair: Damage Control clears the whole stack at once.
3 HULL BREACH • Immediate: 1 Critical Damage. • Ongoing and repair: as Blaze.
4 MAGAZINE EXPLOSION • Immediate: 1 Hull Point, 2 if the ship mounts Triple Lance Turrets, plus 1 Critical Damage, and one random Port, Starboard or Dorsal weapon system destroyed. • Ongoing: the destroyed system cannot fire. • Repair: Damage Control may repair one destroyed system. • Note: Reinforced Magazine Compartments reduces the Damage Control suffered by 1, to a minimum of 0.
5 ENGINES CRIPPLED • Immediate: immobile, and Snap Shots only. • Ongoing: no Firing at anchor bonus, and −1 on Evade. It may still be issued Fleet Orders. • Second result: the ship is Adrift — 2D6″ straight ahead, no turning. • Repair: Damage Control clears it; Adrift becomes Engines Crippled.
6 REACTOR STRUCK • Immediate: a Line Ship suffers a Catastrophic Explosion at once; a Capital Ship takes D3 Hull Points then rolls a D6, detonating on a 6; a Gloriana or larger takes D3 and rolls 2D6, detonating if either die shows a 6. • Ongoing: none. • Repair: none.</description></rule><rule id="c027fef0-2cb9-5225-a1fc-80baea6124fc" name="Destruction" hidden="false"><description>At 0 Hull Points roll a D6 once: on a 6 the ship is torn apart in a Catastrophic Explosion and every ship within the blast radius suffers one hit against its nearest facing — Str 8 AP 3 from a Line Ship, Str 9 AP 2 from a Capital Ship or Void Fortress. On any other result it becomes a wreck. Blast radius: Destroyer, Frigate or Strike Cruiser 3″ · Light Cruiser or Cruiser D6″ · Grand Cruiser or Battle Barge D6+3″ · Battleship, Emperor-class Battleship or Gloriana 2D6″ · Abyss or Phalanx 3D6″.</description></rule><rule id="de62d242-ac96-55ac-9ef0-71b240bf22dc" name="Ramming" hidden="false"><description>Free, needing no Fleet Order, against one enemy within 6″ of the rammer's prow. Roll a D6, −1 if the rammer mounts a prow Nova Cannon bought as an upgrade; the ram connects if it equals or beats the distance in inches. The target may Evade on 5+. On impact the target suffers one hit at Strength = the rammer's Prow AV, ignoring Void Shields, penetrating on 1D6 + Str with no Armourbane; a hit that glances or penetrates inflicts D6 Hull Points and a penetrating hit rolls on the Damage Table at +1. The rammer loses D3 Hull Points. Survivors remain Locked.</description></rule><rule id="e4f87e4a-4e2e-52c1-8264-d97cd0f5c84d" name="Fleet Orders" hidden="false"><description>Only the Flagship issues orders, within 24″ Command range, and no order needs a test. Each battle round the fleet may issue orders of each of the three types up to its commander's rank: Fleet Captain 1, Named Character 2, Primarch 3. No ship takes two orders of the same type in a round, ranks never combine, and nothing adds to the allowance except where a Legion trait, Character or Primarch expressly says otherwise. Unspent orders do not carry over.
DAMAGE CONTROL (Command) • Issued: in the ship's activation. • Target: one friendly ship in range. • Effect: roll a D6; on 4+ choose one — remove every Critical Damage, repair one destroyed weapon system, or clear Engines Crippled. • Duration: immediate.
FOCUS FIRE (Command) • Issued: as the ship fires. • Target: one friendly ship, against one enemy ship. • Effect: +1 BS. • Duration: this round. • Restriction: shares the single +1 pool with the anchor bonus and accuracy auras.
BRACE FOR IMPACT (Command, Reaction) • Issued: the moment this ship is shot or rammed, not both. • Effect: halve all Hull Point loss, rounding up. • Duration: to the end of the round. • Restriction: the ship fires only Snap Shots until then.
ALL AHEAD FULL (Movement) • Issued: as the ship moves. • Effect: move +D6″. • Restriction: may fire only Defence Batteries.
BURN RETROS (Movement) • Issued: as the ship moves. • Effect: a ship holding station — 1″ or less — may pivot freely and fires its broadsides at +1 BS. • Restriction: −1 on Evade rolls.
EVADE (Movement, Reaction) • Issued: when this ship is shot at or rammed, before any dice are rolled. • Effect: on 5+ the whole attack misses, or the ram fails and the rammer is moved 1″ past. • Modifiers: +1 Destroyer or Frigate; −1 held station; −1 Crippled, Adrift or Engines Crippled; never worse than −2. • Restriction: once per battle round; wrecks and Speed 0 installations never Evade.
RELOAD ORDNANCE (Shooting) • Issued: as the ship fires. • Target: one weapon type aboard a friendly ship. • Effect: remove one Reload token, freeing every weapon of that type aboard. • Restriction: a weapon type bearing no token cannot be chosen.
RETURN FIRE (Shooting, Reaction) • Issued: when this ship is attacked and survives. • Effect: fire back at −1 to hit with every weapon that bears on the attacker. • Restriction: not systems already fired this round, nor one-shot or reloading weapons.
OVERWATCH (Shooting, Reaction) • Issued: when a boarding craft or drop pod runs at this ship, for the rest of that battle round. • Effect: snap-fire Defence Batteries at that craft; destroyed on 5+. • Restriction: Defence Batteries only.</description></rule><rule id="4b48c192-59cc-5656-8214-84c9895d97ab" name="Reactions" hidden="false"><description>Brace for Impact, Return Fire and Overwatch are Fleet Orders with a trigger, issued the moment a friendly ship is attacked or targeted, whether or not that ship has already acted. They count against the round's allowance however many ships are under fire — an order spent defending is one you no longer have for your own turn.</description></rule><rule id="68a9c148-236e-5c2e-b75f-9ef97b3867e8" name="Evade" hidden="false"><description>A Movement order, declared when the ship is shot at or rammed and before any dice are rolled. Roll a D6: on a 5+ the whole attack misses, or the ram fails and the rammer is moved 1″ past its intended victim. Modifiers: +1 Destroyer or Frigate · −1 held station · −1 Crippled, Adrift or Engines Crippled. Never worse than −2. Once per battle round; wrecks and Speed 0 installations never Evade.</description></rule><rule id="7de2ccd4-a6ae-5642-8f5b-d5ad03456892" name="Boarding Actions" hidden="false"><description>Crew are the hit points of boarding, and an action begins and ends in one Ramming &amp; Boarding step. Declare the Crew committed and the delivery method, then deduct them; a ship always keeps 1 aboard. Every fighter rolls his own D6 with his own bonus, and bonuses never combine into one roll. Starting with the boarders, players alternate nominating duels: the higher total fells its opponent, and ties re-roll until one is higher. Fight on until one side reaches 0 Crew or the boarders withdraw. Defenders reduced to 0 lose the ship — Capture or Scuttle. Modifiers to every die on that side: +1 boarders in the first round if delivered by craft, pod or teleport (never a Hull Assault) · +1 boarders if the enemy ship is Crippled · +1 boarders if it is Engines Crippled · −1 defenders if the ship carries any Critical Damage.</description></rule><rule id="99513124-89cd-52ea-ba94-40c0798d80ce" name="Hit-and-Run" hidden="false"><description>Instead of a full boarding, commit 1 Crew — so never a Dreadnought, which is two. Roll D6 plus the raider's own bonus. On 4+ choose one: destroy one weapon system or Launch Bay; inflict 1 Critical Damage; cripple the enginarium (Engines Crippled); or sabotage the shields, reducing VS Rating by D3, or D6 against a Capital Ship, permanently. The raider returns. On a failure the raider is lost.</description></rule><rule id="9f02dc2d-065f-5ad6-993a-d07c20b8898d" name="Attrition" hidden="false"><description>There is no Morale. Ships do not flee and take no tests — they fight until wrecked, taken, or the battle ends, and they fight worse as they break down. Crippled and Depleted stack, so a ship can fire at −2. Broken Fleet: once three quarters of a fleet's starting points are lost it loses the battle at once. Count a lost ship at full cost, upgrades and any Fleet Commander aboard included; aircraft never count.</description></rule><rule id="5254a611-e110-5967-beb2-1684053b5e6b" name="Fleet Construction" hidden="false"><description>Capital Ship allowance is generated by Line Ships: for every 4 individual Line Ships in the fleet you may include 1 Capital Ship. 0–3 Line Ships permit no Capital Ship; 4–7 permit 1; 8–11 permit 2; 12–15 permit 3, and so on — maximum Capital Ships = Line Ships ÷ 4, rounded down. Individual vessels count, not roster entries: a squadron of four Destroyers is four Line Ships. Line Ships are the Destroyer, Frigate, Light Cruiser, Strike Cruiser and Cruiser. Capital Ships are the Grand Cruiser, Battle Barge, Battleship, Emperor-class Battleship, Gloriana and Abyss, and the Phalanx above them. No single ship may exceed 50% of the fleet's points, upgrades included. Destroyers and Frigates have the Squadron keyword: each is taken singly, and up to 3 may be grouped into one squadron. Minimum game size: Gloriana 2,000; Abyss and Phalanx 3,000.</description></rule><rule id="6519abee-257e-5831-900d-1717acb5ebeb" name="Veteran Crews &amp; Commanders" hidden="false"><description>Any ship may take a Veteran Crew once: +1 Ballistic Skill for the battle, 60 pts for a Line Ship and 150 pts for a Capital Ship. No ship exceeds BS 5, and a ship takes at most one +1 BS from position or command — Firing at anchor, Focus Fire and accuracy auras never stack with each other. A Veteran Crew's +1 is a paid upgrade and stacks on top. Every fleet has exactly one commander, the highest rank present, riding the Flagship and lost if that ship is destroyed, captured or wrecked. Each rank carries its own command ability: Ship’s Master, Practised Command, or The Fleet Obeys.</description></rule><rule id="11a944d8-5ef1-5d45-84d9-dcc8d0a74b3a" name="Keyword: Armourbane" hidden="false"><description>Roll 2D6 + Strength to penetrate instead of 1D6, at 6″ or less, against shields or hull alike. Torpedo Tubes and the Starhawk's plasma bombs carry it outright; a broadside or dorsal weapon of printed AP 1 gains it inside 6″ in place of the AP step it cannot take. Macro-Cannon Batteries never gain it, and neither do rams — the Conqueror's Ursus Claws excepted. Destroyer weapons never roll to penetrate, so it does nothing for them.</description></rule><rule id="95efaf31-67d2-5249-b47f-d0d3ba20ccdc" name="Keyword: Destroyer (D)" hidden="false"><description>Any weapon of AP D. Strength never exceeds 12. It penetrates automatically — no roll, whatever the Armour Value — and can never merely glance. Every Damage Table roll it causes is made at +3 in place of any AP modifier, or +2 against a Gloriana, the Abyss or the Phalanx. It is always at least Devastating (3). It does not pass Void Shields — the Vortex Torpedo alone excepted, being a torpedo: while they hold it beats AV 12 automatically and collapses 3 layers, and does nothing else.</description></rule><rule id="3bfe1d83-af7e-5cb1-b0b6-d92d58d0f269" name="Keyword: Devastating (X)" hidden="false"><description>Each unsaved hit costs the target X Hull Points instead of 1, whether it glances or penetrates. A penetrating Devastating hit still rolls once on the Damage Table, keeping its AP modifier. Against active shields a Devastating hit still costs only 1 Void Shield Rating, however large its X.</description></rule><rule id="e1433f89-fcb4-5047-a78e-9516c16473d5" name="Keyword: Gets Hot" hidden="false"><description>After a Lance Turret or Twin Lance Turret has resolved its attacks, roll a D6. On a 1 the firing ship suffers 1 Hull Point. Each mount rolls separately. Self-inflicted rolls have no attacker or facing: the owning player makes any choices, from any facing, but must choose a functioning system.</description></rule><rule id="274d3129-b670-5e9c-94ef-02ad37b0a8e1" name="Keyword: One Shot" hidden="false"><description>Fired once per battle, then spent. It takes no Reload tokens.</description></rule><rule id="c0aba380-6268-5164-a4bb-c03aec84fb45" name="Keyword: Reload (X)" hidden="false"><description>After firing, place X Reload tokens against that weapon type aboard the ship. Flip the token at the end of each battle round — 2 becomes 1 — and remove it when it would reach 0. The mount cannot fire while it bears a token, so Reload (1) speaks every round and Reload (2) every second. The Reload Ordnance order removes one counter early.</description></rule><rule id="d5668354-a437-53d0-8cc8-c952e2f3e309" name="Keyword: Skyfire" hidden="false"><description>Fires at full Ballistic Skill against aircraft.</description></rule><rule id="8613db23-cea7-51f0-ba0f-ee2eda1681e8" name="Keyword: Twin-Linked" hidden="false"><description>Re-roll failed To Hit rolls.</description></rule><rule id="9d730e88-539e-548f-9c76-ff3550133ff0" name="Keyword: Volatile" hidden="false"><description>An unmodified 1 To Hit resolves the attack against the firing ship instead, at the full profile — against the facing the launcher is mounted in. The launcher is spent either way.</description></rule><rule id="d71afbf9-fe66-5744-bc12-0f025b4f7f9a" name="Keyword: Critical Damage" hidden="false"><description>Fires, breaches and burning phosphex — one rule for all of them. A ship may carry up to 3 Critical Damage, marked with a single token. At the end of each battle round it loses 1 Crew for each Critical Damage it carries, always, with no roll. A successful Damage Control order clears the whole stack at once.</description></rule><rule id="9935d9c0-e922-5f8b-aad0-df92003d1a35" name="Mounts &amp; Arcs" hidden="false"><description>Prow — the forward 90° arc. Port / Starboard — that side's 90° arc; these are the broadsides. Dorsal — every arc but the Stern; counts as a broadside for Point-Blank Broadsides, but gains no Firing at anchor bonus. All-round — every arc. Straight ahead — Torpedo Tubes only: a line drawn directly forward from the prow, and only a ship that line crosses may be targeted. The facing struck is whichever of the target's arcs the firer sits in. Broadsides are per side: each line of a datasheet is its own weapon system in that facing.</description></rule><rule id="55f52616-3d80-5537-a784-0d426a7b9fe7" name="State: Adrift" hidden="false"><description>A second Engines Crippled. The ship moves 2D6″ straight ahead when it would move, cannot turn, and fires Snap Shots only.</description></rule><rule id="17b68176-c120-5858-a43f-12a431f96c6a" name="State: Crippled" hidden="false"><description>Below half starting Hull Points: −1 BS and half Speed.</description></rule><rule id="8a31087b-0578-514a-a265-1c9de8ef1703" name="State: Depleted" hidden="false"><description>At half starting Crew or less: −1 BS. Stacks with Crippled.</description></rule><rule id="bc5df32c-72e0-51c2-81ee-84ca5d5def65" name="State: Engaged" hidden="false"><description>Two aircraft squadrons within 1″. Neither may act against ships, and no ship may fire on either — Defence Batteries, Interceptor and Overwatch included. Resolved at the end of the battle round.</description></rule><rule id="56087587-83de-558b-a2bf-390433748614" name="State: Engines Crippled" hidden="false"><description>Immobile and Snap Shots only until repaired. It may still be issued Fleet Orders. It gains no Firing at anchor bonus for standing still, though it still suffers −1 on Evade.</description></rule><rule id="86e0fbd3-f914-5b1a-a846-27070b31ca26" name="State: Held station" hidden="false"><description>Moved 1″ or less under Burn Retros. Broadsides fire at +1 BS; −1 on Evade. A ship holding station may pivot freely on the spot.</description></rule><rule id="dee347f6-d7ca-576e-b410-a6b721d45f1c" name="State: Locked" hidden="false"><description>Two ships joined by a ram. Neither may move; the rammer may not fire on its victim, who fires back at −1 BS against the rammer's Prow. Both fire at other enemies normally. Break Away on 5+, when the ship would move, once each per battle round: the rammer disengages 1″ away, a defender tears free 1″ away and suffers D3 Hull Points.</description></rule><rule id="eb3dca26-5abd-57fe-8be8-e107518fa7e9" name="State: Snap Shots" hidden="false"><description>Firing at BS 1 — hits only on a 6.</description></rule><rule id="963bea00-295f-530b-902a-2587b395283b" name="State: Wreck" hidden="false"><description>0 Hull Points without exploding. It becomes obscuring terrain: impassable, blocks line of sight, and no straight-line weapon may fire across it. It never moves, never drifts and never Evades, and having no Crew it cannot be boarded or captured.</description></rule><rule id="7f552004-a8f1-5d7c-822b-cca22e5e2c46" name="Keyword: Turning" hidden="false"><description>Turning is universal: any ship may turn at the start or the end of its move.</description></rule><rule id="36f7da9c-794c-52f9-a769-c659f0c0e529" name="Keyword: Interceptor" hidden="false"><description>A Defence Battery may fire the moment an enemy squadron comes within 12″ as the enemy moves, before it attacks — but then does nothing else that battle round, Overwatch included.</description></rule><rule id="4a3dbc7d-55cd-5481-bb40-8617901d0f6c" name="Keyword: Breachers" hidden="false"><description>+1 to all Boarding combat rolls, and enemy dice fighting them suffer −1. The −1 of a Dreadnought, or of an Astartes Breacher defending his own ship, falls on the one enemy die paired against him.</description></rule><rule id="52c5bc7a-de70-52c7-bc3d-f2e8e0c15ee0" name="Keyword: Intervention" hidden="false"><description>Destroyers and Frigates only, and it costs no order. When a friendly ship within 3″ is attacked, rammed, or targeted by torpedoes, a Destroyer or Frigate no more than 10″ from the attacker may thrust into the firing line: it does not move, and the whole attack resolves against it instead, striking whichever facing lies toward the attacker. Once per ship per battle round.</description></rule><rule id="ced1716f-4d9e-5afd-8e6d-0b47b03ad760" name="Keyword: Wolf Pack" hidden="false"><description>Destroyers of one squadron within 6″ may combine fire on a single target, adding +1 to penetration. Gunnery only, never Torpedo Tubes. Frigates do not have Wolf Pack.</description></rule><rule id="1bd5b930-8456-5258-8e25-0288b9054fc4" name="Keyword: Melta Mines" hidden="false"><description>Each Frigate may carry two Melta Mines. No other class may take them. In the Movement step, after the Frigate has moved and instead of shooting, place a mine on a 32mm base in contact with the ship's base — one mine per round, Reload (2), and never within 6″ of an enemy ship. A mine detonates the moment any part of a non-Frigate ship's base passes over it. Every ship within 3″, friend or foe and including the ship that triggered it, immediately suffers one hit at Strength 9, AP 2 with Armourbane, resolved against the facing nearest the mine. Melta Mines bypass Void Shields entirely. Frigates of either fleet pass over mines safely, and aircraft ignore them. Remove the marker once the blast is resolved.</description></rule><rule id="a29ec255-2b44-5923-a6d7-99a36c7a29f0" name="Keyword: Broken Fleet" hidden="false"><description>Once three quarters of a fleet's starting points are lost, it loses the battle at once.</description></rule></rules><categoryLinks>
 <categoryLink id="4fe4d909-fe59-565b-91f1-2b2aba749a17" name="Rules" hidden="false" targetId="52616092-abd8-519e-a6fb-94b622114fa5" primary="true" /></categoryLinks>
 <costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" /></costs></selectionEntry><selectionEntry id="687f94bb-7149-585f-afe1-f4c6d3892491" name="Damage Table" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="force" shared="false" id="7f5b1daf-e213-5f55-9ed8-d36e96179091" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><rules><rule id="9f942c52-3b6f-52c1-8321-f0b0439cda1d" name="Ship Damage Table" hidden="false"><description>Roll a D6 when a Penetrating Hit is scored. Modifiers: AP 2 +1 • AP 1 +2 • Destroyer +3 in place of any AP modifier, +2 against a Gloriana, the Abyss or the Phalanx • Ramming +1 • Battleship target −1. A modified 7+ counts as Reactor Struck; below 1 counts as 1, and a 1 does nothing.
1 HELD • Immediate: none. • Ongoing: none.
2 BLAZE • Immediate: 1 Critical Damage. • Ongoing: the ship loses 1 Crew at the end of each battle round for each Critical Damage it carries. • Repair: Damage Control clears the whole stack at once.
3 HULL BREACH • Immediate: 1 Critical Damage. • Ongoing and repair: as Blaze.
4 MAGAZINE EXPLOSION • Immediate: 1 Hull Point, 2 if the ship mounts Triple Lance Turrets, plus 1 Critical Damage, and one random Port, Starboard or Dorsal weapon system destroyed. • Ongoing: the destroyed system cannot fire. • Repair: Damage Control may repair one destroyed system. • Note: Reinforced Magazine Compartments reduces the Damage Control suffered by 1, to a minimum of 0.
5 ENGINES CRIPPLED • Immediate: immobile, and Snap Shots only. • Ongoing: no Firing at anchor bonus, and −1 on Evade. It may still be issued Fleet Orders. • Second result: the ship is Adrift — 2D6″ straight ahead, no turning. • Repair: Damage Control clears it; Adrift becomes Engines Crippled.
6 REACTOR STRUCK • Immediate: a Line Ship suffers a Catastrophic Explosion at once; a Capital Ship takes D3 Hull Points then rolls a D6, detonating on a 6; a Gloriana or larger takes D3 and rolls 2D6, detonating if either die shows a 6. • Ongoing: none. • Repair: none.</description></rule><rule id="4d9f4a62-4e22-577a-803c-debfead97b25" name="Penetration" hidden="false"><description>For each hit past the shields, roll 1D6 + Strength against the Armour Value of the facing struck. Equal = Glancing Hit: 1 Hull Point, no damage roll. Greater = Penetrating Hit: 1 Hull Point and a roll on the Damage Table. No Armour Value may exceed 14 by any means.</description></rule><rule id="0722a069-bede-5b66-9ac6-4a4eb7d21cd8" name="Stern Strike" hidden="false"><description>When a Strength 9+ weapon rolls a natural 6 on its penetration die against a target's Stern and beats the Stern AV, the hit also inflicts Engines Crippled at once. With Armourbane at least one of the two dice must show a 6. It does not stack with an Engines Crippled already rolled, and while shields hold the hit must bring them down first.</description></rule><rule id="e0927922-960b-5f24-b0c9-5618ae94f902" name="Destruction" hidden="false"><description>At 0 Hull Points roll a D6 once: on a 6 the ship is torn apart in a Catastrophic Explosion and every ship within the blast radius suffers one hit against its nearest facing — Str 8 AP 3 from a Line Ship, Str 9 AP 2 from a Capital Ship or Void Fortress. On any other result it becomes a wreck. Blast radius: Destroyer, Frigate or Strike Cruiser 3″ · Light Cruiser or Cruiser D6″ · Grand Cruiser or Battle Barge D6+3″ · Battleship, Emperor-class Battleship or Gloriana 2D6″ · Abyss or Phalanx 3D6″.</description></rule><rule id="cace44c7-0cea-5747-8f12-ac1c123bd0ed" name="Keyword: Devastating (X)" hidden="false"><description>Each unsaved hit costs the target X Hull Points instead of 1, whether it glances or penetrates. A penetrating Devastating hit still rolls once on the Damage Table, keeping its AP modifier. Against active shields a Devastating hit still costs only 1 Void Shield Rating, however large its X.</description></rule><rule id="ce3c1cb7-35f0-58f9-94a2-c7b5a0937cda" name="Keyword: Critical Damage" hidden="false"><description>Fires, breaches and burning phosphex — one rule for all of them. A ship may carry up to 3 Critical Damage, marked with a single token. At the end of each battle round it loses 1 Crew for each Critical Damage it carries, always, with no roll. A successful Damage Control order clears the whole stack at once.</description></rule></rules><categoryLinks><categoryLink id="6e9f06e1-0af1-5c8f-a551-89bcdcbaad4c" name="Rules" hidden="false" targetId="52616092-abd8-519e-a6fb-94b622114fa5" primary="true" /></categoryLinks><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" /></costs></selectionEntry><selectionEntry id="871b4e58-5377-5855-b540-39e95e292f10" name="Fleet Construction Rules" hidden="false" collective="false" import="true" type="upgrade">
 <profiles>
 </profiles>
 <rules><rule id="7b4afeda-bef2-5850-a0ce-572d60bf6db8" name="Fleet Construction" hidden="false"><description>Capital Ship allowance is generated by Line Ships: for every 4 individual Line Ships in the fleet you may include 1 Capital Ship. 0–3 Line Ships permit no Capital Ship; 4–7 permit 1; 8–11 permit 2; 12–15 permit 3, and so on — maximum Capital Ships = Line Ships ÷ 4, rounded down. Individual vessels count, not roster entries: a squadron of four Destroyers is four Line Ships. Line Ships are the Destroyer, Frigate, Light Cruiser, Strike Cruiser and Cruiser. Capital Ships are the Grand Cruiser, Battle Barge, Battleship, Emperor-class Battleship, Gloriana and Abyss, and the Phalanx above them. No single ship may exceed 50% of the fleet's points, upgrades included. Destroyers and Frigates have the Squadron keyword: each is taken singly, and up to 3 may be grouped into one squadron. Minimum game size: Gloriana 2,000; Abyss and Phalanx 3,000.</description></rule><rule id="cf4729d6-b49a-5613-b122-82e15d5565a1" name="Ship Construction" hidden="false"><description>Ships are bought as a bare chassis and armed hardpoint by hardpoint. Every weapon and Defence Battery on a mount is paid for separately; Launch Bay slots are built-in hull capacity and cost 0 pts. Each mount group shows its capacity — Defence Mounts 0/8, for instance — and you choose how many of that mount to fill. A hull filled with its standard armament costs exactly its rulebook price. There is no separate upgrade-spend ceiling: mount count and facing are the limits.</description></rule></rules><categoryLinks>
 <categoryLink id="6ddc8fce-dc6c-54b1-ad63-741941534086" name="Rules" hidden="false" targetId="52616092-abd8-519e-a6fb-94b622114fa5" primary="true" /></categoryLinks>
 <costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" /></costs></selectionEntry>
 <selectionEntry id="96aff7c1-c2b5-54ca-b42e-f91ececd3980" name="Fleet Orders" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="force" shared="false" id="fc624eb9-f905-5193-8e94-5f39175851ac" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><rules><rule id="ecfa719c-f877-5161-809c-e6f10945c7e2" name="Fleet Orders" hidden="false"><description>Only the Flagship issues orders, within 24″ Command range, and no order needs a test. Each battle round the fleet may issue orders of each of the three types up to its commander's rank: Fleet Captain 1, Named Character 2, Primarch 3. No ship takes two orders of the same type in a round, ranks never combine, and nothing adds to the allowance except where a Legion trait, Character or Primarch expressly says otherwise. Unspent orders do not carry over.
DAMAGE CONTROL (Command) • Issued: in the ship's activation. • Target: one friendly ship in range. • Effect: roll a D6; on 4+ choose one — remove every Critical Damage, repair one destroyed weapon system, or clear Engines Crippled. • Duration: immediate.
FOCUS FIRE (Command) • Issued: as the ship fires. • Target: one friendly ship, against one enemy ship. • Effect: +1 BS. • Duration: this round. • Restriction: shares the single +1 pool with the anchor bonus and accuracy auras.
BRACE FOR IMPACT (Command, Reaction) • Issued: the moment this ship is shot or rammed, not both. • Effect: halve all Hull Point loss, rounding up. • Duration: to the end of the round. • Restriction: the ship fires only Snap Shots until then.
ALL AHEAD FULL (Movement) • Issued: as the ship moves. • Effect: move +D6″. • Restriction: may fire only Defence Batteries.
BURN RETROS (Movement) • Issued: as the ship moves. • Effect: a ship holding station — 1″ or less — may pivot freely and fires its broadsides at +1 BS. • Restriction: −1 on Evade rolls.
EVADE (Movement, Reaction) • Issued: when this ship is shot at or rammed, before any dice are rolled. • Effect: on 5+ the whole attack misses, or the ram fails and the rammer is moved 1″ past. • Modifiers: +1 Destroyer or Frigate; −1 held station; −1 Crippled, Adrift or Engines Crippled; never worse than −2. • Restriction: once per battle round; wrecks and Speed 0 installations never Evade.
RELOAD ORDNANCE (Shooting) • Issued: as the ship fires. • Target: one weapon type aboard a friendly ship. • Effect: remove one Reload token, freeing every weapon of that type aboard. • Restriction: a weapon type bearing no token cannot be chosen.
RETURN FIRE (Shooting, Reaction) • Issued: when this ship is attacked and survives. • Effect: fire back at −1 to hit with every weapon that bears on the attacker. • Restriction: not systems already fired this round, nor one-shot or reloading weapons.
OVERWATCH (Shooting, Reaction) • Issued: when a boarding craft or drop pod runs at this ship, for the rest of that battle round. • Effect: snap-fire Defence Batteries at that craft; destroyed on 5+. • Restriction: Defence Batteries only.</description></rule><rule id="25914b47-2b69-5322-8ddd-65bfef4292e7" name="Reactions" hidden="false"><description>Brace for Impact, Return Fire and Overwatch are Fleet Orders with a trigger, issued the moment a friendly ship is attacked or targeted, whether or not that ship has already acted. They count against the round's allowance however many ships are under fire — an order spent defending is one you no longer have for your own turn.</description></rule><rule id="54d8b57c-c2ee-5eb0-84c6-d8dc6a592f4a" name="Evade" hidden="false"><description>A Movement order, declared when the ship is shot at or rammed and before any dice are rolled. Roll a D6: on a 5+ the whole attack misses, or the ram fails and the rammer is moved 1″ past its intended victim. Modifiers: +1 Destroyer or Frigate · −1 held station · −1 Crippled, Adrift or Engines Crippled. Never worse than −2. Once per battle round; wrecks and Speed 0 installations never Evade.</description></rule><rule id="b1ad01d0-3979-5efb-b2ed-f0abab18cad6" name="Orders Need No Test" hidden="false"><description>No Fleet Order needs a test — the word is given and obeyed. There is no Morale, no Leadership and no test of a crew's nerve anywhere in the game; a damaged ship is measured by the Crippled and Depleted penalties alone. Command ranks instead carry their own abilities: Ship's Master, Practised Command, and the Primarch's own.</description></rule></rules><categoryLinks><categoryLink id="271ce339-4be9-5af1-a19f-f5300a9834d7" name="Rules" hidden="false" targetId="52616092-abd8-519e-a6fb-94b622114fa5" primary="true" /></categoryLinks><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" /></costs></selectionEntry><selectionEntry id="371ece82-979f-532a-b3a1-a2900cf86c96" name="Invincible Reason" hidden="false" collective="false" import="true" type="unit">
 <constraints>
 <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="73ab788f-8447-5da2-ba2e-a2d9c8ceb07c" type="max" />
 </constraints>
 <profiles>
 <profile id="9ef8558a-2c04-5bd4-922c-46de36a0ea9e" name="Invincible Reason" hidden="false" typeId="806f9ff1-fd51-5ddb-b005-ce73a5d09d65" typeName="Ship">
 <characteristics>
 <characteristic name="BS" typeId="d130e705-611e-5a0a-bd7d-ea8e848fdb2e">4</characteristic>
 <characteristic name="Prow" typeId="84a55377-edbc-5825-a2bf-70c6155018f2">14</characteristic>
 <characteristic name="Side" typeId="5f595433-7397-5c4b-9d4a-8f35d83a2b29">14</characteristic>
 <characteristic name="Stern" typeId="cd9ec76e-f959-5560-8845-9ab242f16e71">13</characteristic>
 <characteristic name="HP" typeId="ef713781-2034-5fb4-83d1-e49d1d683694">16</characteristic>
 <characteristic name="VS" typeId="84309751-688d-50ef-8940-d8d042261a56">12</characteristic>
 <characteristic name="Speed" typeId="25d0e01e-8e74-55b3-8a2a-17773c881625">7″</characteristic>
 <characteristic name="Turn" typeId="899e9c58-70ef-5da5-8495-5bf6a8b7f8f0">45°</characteristic>
 <characteristic name="Crew" typeId="2f6312dd-493e-53c6-96e2-d901afca0e81">10</characteristic>
 </characteristics>
 </profile>
 <profile id="b81770fd-b96b-59c1-b6f9-ed4f9ffd4ae3" name="Gloriana Common Rules" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">A Primarch’s Flagship: never suffers the Crippled −1 BS penalty; must be the Flagship; one per battle; games of 2,000+ points. Gloriana Reactors: once per battle, when VS would reach 0 it remains at 1. Dorsal Twin Lance Turrets fire into all arcs and never Gets Hot. Heavy Macro-Cannon Batteries use Reload (1). Armament fixed: a Gloriana buys no mounts and takes no Universal Ship Upgrades.</characteristic>
 </characteristics>
 </profile>
 <profile id="c31e5c02-3612-53f1-87d7-442b81694710" name="Secrets of the First" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">In each Muster step choose one weapon system aboard; until the end of the battle round it gains +1 Strength, +12″ Range, or Armourbane. Launch Bays (4).</characteristic>
 </characteristics>
 </profile>
 <profile id="e2c4f815-f9ce-5a07-8d3f-7c324ce50990" name="Excindio Pattern Lance Array" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Prow</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">10</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">1</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">60″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Twin-Linked; Reload (2); Devastating (2). Its hits cannot be reduced by any rule that would raise the target's effective Armour Value or lower its penetration roll</characteristic></characteristics></profile><profile id="8d4cda64-c6df-56c1-9a60-6a9ed72c4a25" name="Torpedo Tube ×3" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Prow</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">9</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">2</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1 each</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">60″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">One torpedo per tube. Bypasses Void Shields; Armourbane within 6″; Reload (2)</characteristic></characteristics></profile><profile id="bf0c8315-103c-53a7-89a7-9e0b639e8a7f" name="Vortex Torpedo ×2" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Prow</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">12</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">D</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1 each</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">60″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">One Shot; Devastating (3); Volatile. Bypasses Void Shields entirely, resolving against the hull facing struck. Prow mount only</characteristic></characteristics></profile><profile id="06d98d7b-3119-57f1-b602-4a6d9a03cb50" name="Heavy Macro-Cannon Battery ×4" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Port</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">9</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">2</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3 each</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">30″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">—</characteristic></characteristics></profile><profile id="cc64fa72-a256-501b-b869-5020770552f3" name="Heavy Macro-Cannon Battery ×4" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Starboard</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">9</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">2</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3 each</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">30″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">—</characteristic></characteristics></profile><profile id="2bb9c7d4-2c85-542d-a740-4ecb6c9be275" name="Twin Lance Turret ×2" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Dorsal</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">10</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">1</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">2 each</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">46″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Twin-Linked; Reload (2); Devastating (2). All arcs and never Gets Hot — Gloriana Reactors</characteristic></characteristics></profile><profile id="ebd0fce3-82df-597e-931a-422914cc81f7" name="Triple Lance Turret ×4" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Dorsal</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">10</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">1</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3 each</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">46″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Twin-Linked; Reload (2); Devastating (2). All arcs and never Gets Hot — Gloriana Reactors</characteristic></characteristics></profile><profile id="aee4d724-b6c2-54fa-ab80-9e5fde018c85" name="Defence Battery ×10" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">All-round</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">6</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">5</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3 each</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">12″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Skyfire; Interceptor. Aircraft to 12″; ships within 6″</characteristic></characteristics></profile></profiles>
