 <profile id="325e78f8-af80-5db8-9b41-8d5a2ea89123" name="Astartes Crew" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">All Crew count as Legiones Astartes (+1), free; may commit up to full current Crew in a Hull Assault, keeping 1 aboard.</characteristic>
 </characteristics>
 </profile>
 </profiles>
 <rules><rule id="65c8001c-bccc-5200-9d62-e03195067704" name="Gets Hot" hidden="false"><description>After a Lance Turret or Twin Lance Turret resolves its attacks, roll a D6. On a 1 the firing ship loses 1 Hull Point. Each mount rolls separately.</description></rule><rule id="c2dbc839-0d46-5a56-805d-cac05e1bf6d8" name="Capital" hidden="false"><description>Counts as a Capital Ship for every rule that names one, and fills a Capital slot.</description></rule><rule id="0b2125c8-f470-5e69-8174-33c3c0538362" name="Reload (X)" hidden="false"><description>After firing, place X Reload tokens on the mount; flip one at the end of each battle round. The mount cannot fire while it bears a token.</description></rule><rule id="60bfe37e-9785-509b-a8e2-1d501f8c01a6" name="Devastating (X)" hidden="false"><description>Each hit costs X Hull Points, or 1 Void Shield Rating against live shields.</description></rule><rule id="cb533f73-917c-55ab-9957-e5a12a2e0321" name="Armourbane" hidden="false"><description>Roll 2D6 + Strength to penetrate instead of 1D6, at 6″ or less, against shields or hull alike.</description></rule><rule id="b6c83bc0-7467-5f27-83d8-5c5007bf0ba1" name="Point-Blank Broadsides" hidden="false"><description>At 6″ or less, Port, Starboard and Dorsal weapons improve AP by one step — or gain Armourbane instead if their printed AP is already 1. Prow weapons get neither.</description></rule><rule id="105778d9-1208-5c8b-9f22-1658c4534f76" name="Crippled" hidden="false"><description>Below half starting Hull Points: −1 BS and half Speed.</description></rule><rule id="50808998-07f8-527e-bdd2-f337e099e840" name="Depleted" hidden="false"><description>At half starting Crew or less: −1 BS. Stacks with Crippled.</description></rule><rule id="7bf5e6b6-98cd-5e13-9d71-6a5b32c1babb" name="Locked" hidden="false"><description>Joined by a ram. Neither ship may move; the rammer may not fire on its victim, who fires back at −1 BS. Break Away on 5+.</description></rule><rule id="0517d09c-a44a-5acb-89e0-68ab02244594" name="Snap Shots" hidden="false"><description>Firing at BS 1 — hits only on a 6.</description></rule><rule id="4cf5e3e7-1595-5f53-81cb-c031da0c6eca" name="Wreck" hidden="false"><description>0 Hull Points without exploding. Becomes impassable, obscuring terrain; never moves and never Evades.</description></rule><rule id="759f84b6-a332-5036-9619-9bb27b882104" name="Held station" hidden="false"><description>Moved 1″ or less under Burn Retros. Broadsides fire at +1 BS; −1 on Evade.</description></rule></rules><categoryLinks>
 <categoryLink id="49eb430d-973c-5239-9719-1e2d58da536d" name="Capital" hidden="false" targetId="bd422ebf-10b3-5085-89cc-263568c40fe0" primary="true" />
 </categoryLinks>
 <selectionEntryGroups>
 <selectionEntryGroup name="Prow Mounts" id="d4d51570-d483-574e-9251-0500739b14a2" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="4.0" field="selections" scope="parent" shared="false" id="95b3b6ca-aa53-51c4-a1d7-1c041e75b535" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="05132d9b-95a6-5811-b791-ed38d88185ce" name="Torpedo Tube" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="4.0" field="selections" scope="parent" shared="false" id="af7b36f8-4f42-5759-a002-b722c556c15a" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="9279f107-81b3-5e79-9a2b-de953ead851d" name="Torpedo Tube" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Prow</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">9</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">2</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">60″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">One torpedo per tube. Bypasses Void Shields; Armourbane within 6″; Reload (2)</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" /></costs></selectionEntry><selectionEntry id="c83aac20-e733-59cc-a619-045e0ce3a2f1" name="Drop Pod Launcher" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="4.0" field="selections" scope="parent" shared="false" id="8dc63806-2289-574c-8390-4d9ecebf16f1" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="f85e6c1e-1dc8-56b9-aae8-9b183b3f4d0b" name="Drop Pod Launcher" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Prow</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">—</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">—</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1 pod/rail</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">18″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">One pod per rail. Reload (2)</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Dorsal Mounts" id="b1b15a4f-79ad-5a07-9ff2-fb36415865a2" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="3.0" field="selections" scope="parent" shared="false" id="a725b9d6-f26e-5177-9905-ec81a232a566" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="2e9622aa-45d5-5c25-9d38-7004455c6a9a" name="Lance Turret" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="3.0" field="selections" scope="parent" shared="false" id="1daacbc9-bdcd-55a1-9557-f5be69aa621b" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="efe478e7-2e80-5fbb-b0ea-720615bdb620" name="Lance Turret" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characterist