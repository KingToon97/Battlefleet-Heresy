d="selections" scope="parent" shared="false" id="bbbe209f-924c-5c89-b356-9278e379a062" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="5e9f4138-b808-5734-a8fe-15cbb03f9b9c" name="Torpedo Tube" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Prow</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">9</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">2</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">60″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">One torpedo per tube. Bypasses Void Shields; Armourbane within 6″; Reload (2)</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" /></costs></selectionEntry><selectionEntry id="58ed47c7-db69-5cbd-beba-5203a98acef0" name="Twin Lance Turret" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="min" value="4.0" field="selections" scope="parent" shared="false" id="513e40b2-3c38-5bb9-92b9-d072d7dcf1a1" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="4.0" field="selections" scope="parent" shared="false" id="f4647d3c-7e0b-5317-b693-cf8c5ee581b2" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="c66802c8-0538-5292-a2f3-d6554441e7db" name="Twin Lance Turret" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Dorsal</char