 <selectionEntryGroup id="6ce9018a-2319-59e0-a013-7df41ac8543d" name="Hull Upgrades" hidden="false"><constraints><constraint type="max" value="6.0" field="selections" scope="parent" shared="false" id="67964164-001c-5b21-b388-1a0f7837dbf0" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="c7384ced-abd5-512f-a858-3d8af49336c1" name="Side Armour Reinforcement" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="4c191f54-3b41-5610-a8c1-74122cc5d198" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="decf2fca-8134-5dbc-a29c-ca3668dc6cef" name="Side Armour Reinforcement" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="75.0" /></costs></selectionEntry><selectionEntry id="16e58785-fcb4-574d-9172-1e8e73907019" name="Engine Refit" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="ce7b371f-d62c-5fdf-a991-228307942e20" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="7d2a15d5-fee6-5799-8866-7b7cff4a19e7" name="Engine Refit" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="100.0" /></costs></selectionEntry><selectionEntry id="f65ed0ee-05b0-5f74-858d-2da7c1712e02" name="Phosphex Shells" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="6bdf8af2-6629-5d2b-a9b9-3a8116767aeb" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="53680e1a-2d7d-50ce-8442-9e96468ce30e" name="Phosphex Shells" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Every Heavy Macro-Cannon Battery aboard fires phosphex: whenever one penetrates armour, the target takes 1 Critical Damage. Requires at least one Heavy Macro-Cannon Battery. Every Death Guard Capital Ship carries Phosphex Shells free of charge.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="50.0" /></costs></selectionEntry><selectionEntry id="ee39b494-7f74-5b2f-b545-752e7251cde8" name="Reinforced Magazine Compartments" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="bfbf4bc9-a119-5dcc-9718-14a4356a36f2" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="024b7c36-a73d-5b53-997e-72e2c20e7170" name="Reinforced Magazine Compartments" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Damage Control caused by a Magazine Explosion by 1, to a minimum of 0. A Twin Lance Turret that would suffer 1 Damage Control instead suffers 0 and ignores the effect; a Triple Lance Turret that would suffer 2 instead suffers 1. No other effect of a Magazine Explosion is prevented or reduced. Once per ship. Not available to Gloriana class or above.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="50.0" /></costs></selectionEntry><selectionEntry id="26e7efd8-5ad2-54aa-a602-d6b7491f1d73" name="Enhanced Void Shield Array" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="a50117d8-b800-59e6-8e02-a60df1e852f4" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="6ad8a1e7-0dc1-5085-8c1c-1a1f03cf4cf0" name="Enhanced Void Shield Array" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">At the end of each battle round this ship regains 1 lost Void Shield, provided its Void Shields are currently active. It can never exceed its normal maximum. If its Void Shields have completely collapsed, been disabled, or are otherwise inactive, this upgrade cannot regenerate them; once at least one Void Shield is restored and the shields are active again, it resumes functioning normally. Once per ship. Not available to Gloriana class or above.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="75.0" /></costs></selectionEntry><selectionEntry id="d98cad17-7bd0-51cf-b021-245cd61b2d85" name="Autoloaders" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="739f6af2-df71-5cc2-80d1-72dd74a8b852" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="21862480-f1c1-5ebf-9e51-47f22d9a518a" name="Autoloaders" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Reload value of every weapon and system aboard this ship by 1, to a minimum of Reload 0 — Reload (3) becomes Reload (2), Reload (2) becomes Reload (1), Reload (1) becomes Reload (0). A weapon reduced to Reload (0) has no cooldown and may fire every applicable battle round. Once per ship. Not available to Gloriana class or above.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="100.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
 <costs>
 <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="80.0" />
 </costs>
 </selectionEntry>
