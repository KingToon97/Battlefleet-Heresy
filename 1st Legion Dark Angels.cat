 </selectionEntries><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" /></costs></selectionEntry><selectionEntry id="dd37bbf6-3a40-52bd-aa79-636289eae6fd" name="Tyrant-class" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="ff50504f-bd88-5b03-91a5-93e0f220e61a" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="623b5efa-7b43-545c-98a3-d6e580230f12" name="Tyrant-class" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">A heavy-gun refit, trading torpedoes for weight of shot. Armament: 1× Armoured Prow (Prow), 1× Torpedo Tube (Prow), 2× Lance Turret (Dorsal), 3× Heavy Macro-Cannon Battery (Port), 3× Heavy Macro-Cannon Battery (Starboard), 4× Defence Battery. A ship built to a pattern takes this loadout entire and does not buy mounts separately.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="6bac87cb-7233-5236-91d4-b71ba5c7a6ac" name="Armoured Prow" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="c5a573f8-4c7a-53f1-b334-ead801e37789" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="ab5010b5-272c-5d9e-8ec7-a40aa45e9115" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="8e564eb8-07f1-5205-8a9d-0a0cbfc1d506" name="Armoured Prow" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Prow</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">Prow AV</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">—</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">—</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Ram weapon — resolved as part of a Ram, at Strength equal to this ship's Prow Armour Value. Devastating (3); Armourbane.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="50.0" /></costs></selectionEntry><selectionEntry id="ac48e1bf-9945-559c-83cc-7f699e6da1fb" name="Torpedo Tube" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="bcba31dc-871b-57b0-9759-a99725f49d93" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="68f2754d-8b3e-5ca9-ad13-d32afaf88396" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="cbe8f3ff-a187-5525-a24b-f5560a30bed8" name="Torpedo Tube" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Prow</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">9</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">2</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">60″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">One torpedo per tube. Bypasses Void Shields; Armourbane within 6″; Reload (2)</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" /></costs></selectionEntry><selectionEntry id="f21aca08-5ff3-5147-8d01-8b1d3a49c14e" name="Lance Turret" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="min" value="2.0" field="selections" scope="parent" shared="false" id="77ebce95-3a14-523e-9359-3552da36ee14" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="d728dd73-0651-552e-8c65-8bc55798b7ff" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="ed53fd04-da75-582c-9490-771ce0b60e02" name="Lance Turret" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Dorsal</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">10</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">1</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">46″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Gets Hot; Reload (1); Devastating (2)</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" /></costs></selectionEntry><selectionEntry id="481fe8d7-6eeb-57bd-a861-947670474638" name="Heavy Macro-Cannon Battery (Port)" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint ty