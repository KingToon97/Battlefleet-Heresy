stic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="15.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Port Mounts" id="6aced67d-8104-5866-b99c-3f0cf80cfc1d" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="3.0" field="selections" scope="parent" shared="false" id="787a1b3e-f187-5f9c-b5e5-995de1c14caf" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="9fc8db77-d6cd-541d-85ae-7377931ac531" name="Macro-Cannon Battery (Port)" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="3.0" field="selections" scope="parent" shared="false" id="49502d2f-f520-551b-b48c-a94d03589d93" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="b0ef5b5c-ee2c-5cbf-ae63-9e58c29b5722" name="Macro-Cannon Battery (Port)" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Port</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">8</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">3</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">30″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">—</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" /></costs></selectionEntry><selectionEntry id="1d988e32-a576-5f76-b9aa-75a1817d43fd" name="Heavy Macro-Cannon Battery (Port)" hidden="false" collective="false"