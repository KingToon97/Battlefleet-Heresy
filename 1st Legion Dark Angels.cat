stics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="71f791dc-e3fa-48a3-b4ea-28111290e531" name="Fleet Role" hidden="false" collective="false" import="true" defaultSelectionEntryId="b2b1da95-3b6a-4548-8d45-45f7df9f7de9"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="d718720b-d164-48b0-8170-cf9c43d715e0" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="b2b1da95-3b6a-4548-8d45-45f7df9f7de9" name="Designate as Flagship" hidden="false" collective="false" import="true" type="upgrade"><profiles /><rules><rule id="fb65434d-119a-55c1-8ebc-4a57698f726d" name="Flagship" hidden="false"><description>This ship is the fleet's Flagship. Exactly one Flagship is required in a standard fleet.</description></rule></rules><categoryLinks><categoryLink id="b4ccc449-b504-4d0c-903e-10efacb724c5" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" /></categoryLinks><selectionEntryGroups><selectionEntryGroup id="c5686f56-1a2b-4236-a871-5ce779a01446" name="Fleet Commander" hidden="false" collective="false" import="true" defaultSelectionEntryId="5041a4d8-c09d-4d6a-b295-0db68accef3a"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="1ecd9a61-a7e4-4576-aa90-8d0023e9454e" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="6747ba66-395e-4a8c-bbd9-4b2bbd0bac54" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="5041a4d8-c09d-4d6a-b295-0db68accef3a" name="Fleet Captain" hidden="false" collective="false" import="true" type="upgrade">
