 <selectionEntryGroup id="2b377567-b226-5320-bb12-a591fd662e25" name="Hull Upgrades" hidden="false"><constraints><constraint type="max" value="5.0" field="selections" scope="parent" shared="false" id="63e1b300-3d97-5234-b39c-4794c0325ce8" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="a7edc845-00a9-5f74-ad30-e18386c3893e" name="Side Armour Reinforcement" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="b7c708e0-b5f8-56b3-bfe5-66900f6d5a60" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="f893dbf4-0d7b-5115-ad99-8826f947ce73" name="Side Armour Reinforcement" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="60.0" /></costs></selectionEntry><selectionEntry id="b2c9f3c4-2e91-5746-b3eb-92718af9a09c" name="Engine Refit" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="a8080ab0-db7a-5961-80d5-686adc9a945d" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="61120c93-7040-5e6a-b50a-6d55254ea8d0" name="Engine Refit" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="80.0" /></costs></selectionEntry><selectionEntry id="2b094ff5-7c54-58dd-9171-1443ce086d50" name="Reinforced Magazine Compartments" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="950d70b7-f60f-5b38-a281-087fb892e905" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="dbcacc2b-7905-52ca-8d1e-3f399e526678" name="Reinforced Magazine Compartments" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Damage Control caused by a Magazine Explosion by 1, to a minimum of 0. A Twin Lance Turret that would suffer 1 Damage Control instead suffers 0 and ignores the effect; a Triple Lance Turret that would suffer 2 instead suffers 1. No other effect of a Magazine Explosion is prevented or reduced. Once per ship. Not available to Gloriana class or above.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="40.0" /></costs></selectionEntry><selectionEntry id="ca0e9e8b-f6ab-58ef-8334-feae5eaba8c7" name="Enhanced Void Shield Array" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="7566763a-78ec-573a-b8db-e48a30de52a9" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="221437d2-568f-5c84-b274-21bcf0fcc47b" name="Enhanced Void Shield Array" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">At the end of each battle round this ship regains 1 lost Void Shield, provided its Void Shields are currently active. It can never exceed its normal maximum. If its Void Shields have completely collapsed, been disabled, or are otherwise inactive, this upgrade cannot regenerate them; once at least one Void Shield is restored and the shields are active again, it resumes functioning normally. Once per ship. Not available to Gloriana class or above.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="60.0" /></costs></selectionEntry><selectionEntry id="02e4619a-0c43-5683-8b27-251ffe479d74" name="Autoloaders" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="ffe88a58-9f12-5f5d-a447-31c33a2e0217" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="73aba02d-3bdb-579c-9fe1-2a5cbf8efbfa" name="Autoloaders" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Reload value of every weapon and system aboard this ship by 1, to a minimum of Reload 0 — Reload (3) becomes Reload (2), Reload (2) becomes Reload (1), Reload (1) becomes Reload (0). A weapon reduced to Reload (0) has no cooldown and may fire every applicable battle round. Once per ship. Not available to Gloriana class or above.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="80.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Drop Pod Loadout" id="11068a68-97fa-50b5-919f-12e176a06451" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="665a8deb-f10e-5744-bdaf-af5e17cb235e" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="ab04f0ca-db3d-5ee8-bcce-dc7f1154b533" name="Dreadclaw Drop Pod" hidden="false" collective="false" import="true" type="upgrade"><profiles><profile id="40d554c4-727c-52fb-8ad4-0434b4a107f5" name="Dreadclaw Drop Pod" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding pod, Armour 8, Speed 30″/round. Takes 1 rail. Launched at a target within 18″, striking the same turn. One Shot. Counts as aircraft and may be intercepted; a surviving pod locks on 2+, and on a failure is destroyed with all aboard. Delivers 1 Crew of boarders (+1 in the first round). Removed from play after its run.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" /></costs></selectionEntry><selectionEntry id="c24e477a-c8ff-516c-83a3-7ecd744f6cae" name="Kharybdis Assault Claw" hidden="false" collective="false" import="true" type="upgrade"><profiles><profile id="e1d8886a-db97-52b4-ba73-dc25b02e305d" name="Kharybdis Assault Claw" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding pod, Armour 9, Speed 30″/round. Takes 2 rails and locks automatically — melta cutters breach any hull — delivering 2 Crew of boarders (a Dreadnought filling both places). One Shot: removed from play after its run.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
 <costs>
 <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="55.0" />
 </costs>
 </selectionEntry>
 <selectionEntry id="5610d804-4b52-5ad9-a7e6-0c403e24f3b9" name="Cruiser" hidden="false" collective="false" import="true" type="unit">
 <constraints><constraint type="max" value="5.0" field="selections" scope="roster" shared="false" id="4d7f0f78-153a-5bcc-800b-ceda853394f5" percentValue="false" includeChildSelections="false" includeChildForces="true" /></constraints><profiles>
 <profile id="34b98c15-b53c-5411-b3cf-887ac432f7b8" name="Cruiser" hidden="false" typeId="806f9ff1-fd51-5ddb-b005-ce73a5d09d65" typeName="Ship">
 <characteristics>
 <characteristic name="BS" typeId="d130e705-611e-5a0a-bd7d-ea8e848fdb2e">3</characteristic>
 <characteristic name="Prow" typeId="84a55377-edbc-5825-a2bf-70c6155018f2">12</characteristic>
 <characteristic name="Side" typeId="5f595433-7397-5c4b-9d4a-8f35d83a2b29">11</characteristic>
 <characteristic name="Stern" typeId="cd9ec76e-f959-5560-8845-9ab242f16e71">10</characteristic>
 <characteristic name="HP" typeId="ef713781-2034-5fb4-83d1-e49d1d683694">6</characteristic>
 <characteristic name="VS" typeId="84309751-688d-50ef-8940-d8d042261a56">4</characteristic>
 <characteristic name="Speed" typeId="25d0e01e-8e74-55b3-8a2a-17773c881625">10″</characteristic>
 <characteristic name="Turn" typeId="899e9c58-70ef-5da5-8495-5bf6a8b7f8f0">45°</characteristic>
 <characteristic name="Crew" typeId="2f6312dd-493e-53c6-96e2-d901afca0e81">5</characteristic>
 </characteristics>
 </profile>
 </profiles>
 <rules><rule id="304aed70-c405-5aac-80e6-119217537905" name="Gets Hot" hidden="false"><description>After a Lance Turret or Twin Lance Turret resolves its attacks, roll a D6. On a 1 the firing ship loses 1 Hull Point. Each mount rolls separately.</description></rule><rule id="c5bd86e7-7824-5a83-8e00-0ce88a52f08c" name="Line" hidden="false"><description>Counts as a Line Ship for every rule that names one, and toward the fleet's Line minimum.</description></rule><rule id="cea88c5e-0f50-5be2-afef-dead66e1ba5a" name="Reload (X)" hidden="false"><description>After firing, place X Reload tokens on the mount; flip one at the end of each battle round. The mount cannot fire while it bears a token.</description></rule><rule id="c22a5940-5a37-5f78-ac8e-7c8d87abd2b0" name="Devastating (X)" hidden="false"><description>Each hit costs X Hull Points, or 1 Void Shield Rating against live shields.</description></rule><rule id="4ef02bcc-af3a-53c4-8467-c3a1d87fdb6b" name="Armourbane" hidden="false"><description>Roll 2D6 + Strength to penetrate instead of 1D6, at 6″ or less, against shields or hull alike.</description></rule><rule id="cef539fd-60f8-5369-8743-5facf7d2f938" name="Point-Blank Broadsides" hidden="false"><description>At 6″ or less, Port, Starboard and Dorsal weapons improve AP by one step — or gain Armourbane instead if their printed AP is already 1. Prow weapons get neither.</description></rule><rule id="2d2b9be9-8c52-5c23-8d9e-3ed88f3df021" name="Crippled" hidden="false"><description>Below half starting Hull Points: −1 BS and half Speed.</description></rule><rule id="47edf593-0a26-5feb-b40c-9a6035c75e60" name="Depleted" hidden="false"><description>At half starting Crew or less: −1 BS. Stacks with Crippled.</description></rule><rule id="56e62110-8e71-5f89-99b3-05817c1dca63" name="Locked" hidden="false"><description>Joined by a ram. Neither ship may move; the rammer may not fire on its victim, who fires back at −1 BS. Break Away on 5+.</description></rule><rule id="24688e1d-1aec-5ebb-af28-d0334a479dc0" name="Snap Shots" hidden="false"><description>Firing at BS 1 — hits only on a 6.</description></rule><rule id="72dfc20b-8a14-56e5-9199-580422baab4a" name="Wreck" hidden="false"><description>0 Hull Points without exploding. Becomes impassable, obscuring terrain; never moves and never Evades.</description></rule><rule id="2fb0196d-3f92-513f-a535-70a71c116184" name="Held station" hidden="false"><description>Moved 1″ or less under Burn Retros. Broadsides fire at +1 BS; −1 on Evade.</description></rule></rules><categoryLinks>
 <categoryLink id="92b39826-e029-520f-bc10-deb2f12aca04" name="Line" hidden="false" targetId="96572996-e9b1-54a7-a2a9-2108e1dfc993" primary="true" />
 </categoryLinks>
 <selectionEntryGroups>
 <selectionEntryGroup name="Prow Mounts" id="717b881e-5c56-58ce-86fd-1c5c03c016b6" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="84e062bd-902d-5786-a2dc-a90e3f66e908" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="e1fa48c0-1168-53b9-87f9-73ab8d01d71a" name="Torpedo Tube" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="0c7fea56-8202-5c34-82f1-c75c144b4426" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="7f02b0f7-0e81-55b2-b363-9f4bcb0f9732" name="Torpedo Tube" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Prow</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">9</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">2</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">60″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">One torpedo per tube. Bypasses Void Shields; Armourbane within 6″; Reload (2)</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" /></costs></selectionEntry><selectionEntry id="563f22b1-19a4-5c4d-a0d3-8697ea73e097" name="Armoured Prow" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="d1c47ac7-e578-5971-b9f4-598f638d5a0a" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="4ecb6b4c-af60-561a-beb8-171b9843818c" name="Armoured Prow" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Prow</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">Prow AV</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">—</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">—</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Ram weapon — resolved as part of a Ram, at Strength equal to this ship's Prow Armour Value. Devastating (3); Armourbane.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="50.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Dorsal Mounts" id="d973f59a-c2a3-5678-a2a9-1b6f4d9b99fb" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="bdb7013f-c51b-590e-86aa-575ac19619e4" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="aa187ae0-b830-5ed8-b32a-fe3824660857" name="Lance Turret" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="cd3c88e7-fb7a-5d86-9d68-f2e16279c8b8" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="10c52a53-4d43-5f31-844e-38475b85934f" name="Lance Turret" hidden="false