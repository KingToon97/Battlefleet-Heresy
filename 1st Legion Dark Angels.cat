 </selectionEntries><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" /></costs></selectionEntry><selectionEntry id="4a37fa11-b596-5c3a-81d7-31d4cb1bad0e" name="Firestorm-class" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="79bf5ad6-2f41-58d9-ab6f-83d9892b97bb" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="ebeb9822-6685-5dbf-8852-aa60a9a9b54d" name="Firestorm-class" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">A minelayer variant that denies ground rather than holding it. Armament: 2× Macro-Cannon Battery (Port), 2× Macro-Cannon Battery (Starboard), 1× Melta Mine Layer (Stern), 2× Defence Battery. A ship built to a pattern takes this loadout entire and does not buy mounts separately.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="8c73e6e3-410c-5739-92ee-f9b889d0e700" name="Macro-Cannon Battery (Port)" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="min" value="2.0" field="selections" scope="parent" shared="false" id="34babe33-4871-55e3-ae29-de0a563f2cf8" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="cfd08de5-3875-5c0a-8aa2-1d0783c17be7" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="20a57099-f6d1-5149-b66c-b39cd320d044" name="Macro-Cannon Battery (Port)" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Port</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">8</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">3</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">30″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">—</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" /></costs></selectionEntry><selectionEntry id="ba364c50-9839-50bf-8d36-9f504addbc54" name="Macro-Cannon Battery (Starboard)" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="min" value="2.0" field="selections" scope="parent" shared="false" id="8ec8f4f8-fa1c-52ec-b0d1-011866f26591" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="b41a1811-eecd-5f40-936e-e38d5499acff" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="c1fe3f98-a9a3-5de7-ba7b-4ccc1c21d768" name="Macro-Cannon Battery (Starboard)" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Starboard</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">8</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">3</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">30″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">—</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" /></costs></selectionEntry><selectionEntry id="677bbf17-4462-53ba-a922-223f5cb5ace6" name="Melta Mine Layer" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="a124bf09-26dd-5bcc-b98b-fe38adad3cec" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="5366b769-0b00-596b-b9eb-dd72331f82b0" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="be64b3b1-b263-5433-82d5-2c7c7eeb9de4" name="Melta Mine Layer" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Stern</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">9</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">2</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">3″ blast</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Armourbane. Carries 2 mines; Reload (2). Laid on a 32mm base instead of shooting. Triggers when any part of a non-Frigate ship passes over it: every ship within 3″ — including the ship that triggered it — suffers one hit resolved against its Armour. Aircraft pass over mines safely. Remove the mine once the attack is resolved.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="20.0" /></costs></selectionEntry><selectionEntry id="8ac4cc0e-690e-5675-be59-5426ed020cba" na