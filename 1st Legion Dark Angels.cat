 <characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Skyfire; Interceptor. Aircraft to 12″; ships within 6″</characteristic>
 </characteristics>
 </profile>
 </profiles>
 <costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" /></costs></selectionEntry>
 </selectionEntries>
 </selectionEntryGroup>
 <selectionEntryGroup name="Hull Upgrades" id="57fbf8d7-7d2d-5fa8-8aed-3ba49fc0c42e" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="5.0" field="selections" scope="parent" shared="false" id="6434cd2a-ad94-5592-a42a-bec93f425086" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="75f21e5b-2d3e-54b0-a284-90ec51e385d4" name="Reinforced Magazine Compartments" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="f141245a-f634-535f-b9ae-04cc5fc873f3" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="d538cd1c-1c2b-5863-abb6-397069d11476" name="Reinforced Magazine Compartments" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Damage Control caused by a Magazine Explosion by 1, to a minimum of 0. A Twin Lance Turret that would suffer 1 Damage Control instead suffers 0 and ignores the effect; a Triple Lance Turret that would suffer 2 instead suffers 1. No other effect of a Magazine Explosion is prevented or reduced. Once per ship. Not available to Gloriana class or above.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="30.0" /></costs></selectionEntry><selectionEntry id="945bc268-5f82-5580-b3d7-56fd61d26ea5" name="Enhanced Void Shield Array" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="cdb09ca2-1415-5aea-86ac-17c1ca60e7da" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="85809443-41fd-525c-b9f1-8dc57e73b7b3" name="Enhanced Void Shield Array" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">At the end of each battle round this ship regains 1 lost Void Shield, provided its Void Shields are currently active. It can never exceed its normal maximum. If its Void Shields have completely collapsed, been disabled, or are otherwise inactive, this upgrade cannot regenerate them; once at least one Void Shield is restored and the shields are active again, it resumes functioning normally. Once per ship. Not available to Gloriana class or above.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="45.0" /></costs></selectionEntry><selectionEntry id="aa579da8-4654-5a7f-bffa-b8f681a0a5e9" name="Autoloaders" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="220e3a46-a6a6-51ec-9161-269866cdc74f" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="a9dc3f8b-624f-5c65-ae6d-7311e16ac783" name="Autoloaders" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Reload value of every weapon and system aboard this ship by 1, to a minimum of Reload 0 — Reload (3) becomes Reload (2), Reload (2) becomes Reload (1), Reload (1) becomes Reload (0). A weapon reduced to Reload (0) has no cooldown and may fire every applicable battle round. Once per ship. Not available to Gloriana class or above.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="60.0" /></costs></selectionEntry><selectionEntry id="b3a24742-22e4-5a8c-ad5c-d752d380bc4c" name="Side Armour Reinforcement" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="351439c0-b3b3-51d0-ae9e-e147623559b7" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="58b77060-5637-5b77-bfe4-d342b953db73" name="Side Armour Reinforcement" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="45.0" /></costs></selectionEntry><selectionEntry id="4a95d0c4-8d01-5186-b829-5c8df3431c7b" name="Engine Refit" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="3157fe81-bded-514f-b051-373de3875d92" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="a8e64d8c-314b-5dea-a9dc-09e932710801" name="Engine Refit" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="60.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
