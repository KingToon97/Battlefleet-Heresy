annon Battery (Starboard)" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Starboard</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">9</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">2</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">30″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">—</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="15.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Hull Pattern" id="f1a5793d-2773-5076-92c7-2d5ccf6ea27f" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="f9e54255-368c-51f9-a35d-244e59155604" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="185a6b05-8652-50e4-81f2-8d5fb1af0874" name="Dauntless-class" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="a708e86c-ca95-58f6-b268-478bc539c316" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="bfb70841-657b-5400-a2a2-1781feb36900" name="Dauntless-class" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">The classic fast hunter: a torpedo prow, a lance spine and enough broadside to finish what it starts. Armament: 1× Torpedo Tube (Prow), 1× Lance Turret (Dorsal), 2× Macro-Cannon Battery (Port), 2× Macro-Cannon Battery (Starboard), 3× Defence Battery. A ship built to a pattern takes this loadout entire and does not buy mounts separately.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="9bd6b6bc-6c9b-5e09-90b8-95854b4399bf" name="Torpedo Tube" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="1ea0d1b8-41f1-59da-9079-886f503a2760" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="bf3386fa-0bf6-565b-9dd0-95e10537dff4" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="2cde0d8f-7d7d-511f-93e3-2f5d3f2491c8" name="Torpedo Tube" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Prow</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">9</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">2</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">60″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">One torpedo per tube. Bypasses Void Shields; Armourbane within 6″; Reload (2)</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" /></costs></selectionEntry><selectionEntry id="7e342abf-c4e2-5c94-b245-ff2968cc8999" name="Lance Turret" hidden="false" collective="false" import="true" type="upgrade"><c