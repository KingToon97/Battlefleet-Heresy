 <profile id="ab91f3d6-d4ae-4f26-a9cb-555c5cf90f86" name="Holguin" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Character. Deathwing Discipline: Once per battle round, after this ship fails a To Hit roll with a ranged weapon, it may re-roll that roll. This is separate from the Legion's Penetration re-roll.</characteristic>
 </characteristics>
 </profile>
