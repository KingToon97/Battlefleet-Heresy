 </selectionEntries><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" /></costs></selectionEntry><selectionEntry id="a286e63c-327b-5e91-8acb-c4004725ddb8" name="Emperor-class (Gunnery)" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="68d2ec88-94dc-50fd-9c1b-055aad25ccbd" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="84fd56a6-eca6-58d0-b369-2bdd38eeb343" name="Emperor-class (Gunnery)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">A gunnery refit, half her bays plated over. Armament: 1× Nova Cannon (Prow), 3× Torpedo Tube (Prow), 4× Triple Lance Turret (Dorsal), 3× Heavy Macro-Cannon Battery (Port), 2× Launch Bay (Port), 3× Heavy Macro-Cannon Battery (Starboard), 2× Launch Bay (Starboard), 10× Defence Battery. A ship built to a pattern takes this loadout entire and does not buy mounts separately.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="6b004d1d-ea3b-5e05-988c-f3b1007c41a2" name="Nova Cannon" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="2f343203-f024-5272-a806-667c9df0ca76" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="d30e7d66-ca96-5f02-b5fc-b4080c8a6d60" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="1c8cbc11-fbf9-5b86-9e15-440662ddc97f" name="Nova Cannon" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Prow</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">12</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">D</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">60″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Prow only. Min range 18″; Devastating (3); Reload (2)</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="30.0" /></costs></selectionEntry><selectionEntry id="0538460c-3be2-5ae9-ae4a-44342607dd10" name="Torpedo Tube" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="min" value="3.0" field="selections" scope="parent" shared="false" id="6d4fd15c-aa72-5f93-8840-4abab0c5137d" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="3.0" field="selections" scope="parent" shared="false" id="719cfc77-b14d-5419-886c-ea494d14fb7d" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="c4d7a729-3c35-5dfe-9f70-895cdb035f1d" name="Torpedo Tube" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Prow</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">9</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">2</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">60″</characteristic><characteristic name="Spec