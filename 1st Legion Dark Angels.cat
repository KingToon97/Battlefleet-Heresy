alse" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="a29251c3-f52a-5cf9-9cbf-aded78507db5" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="41001294-cd0d-59d9-9fd0-84d693d906bf" name="Vanguard pattern" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">The standard Legion strike cruiser: pod rails forward and the guns to clear a landing zone. Armament: 2× Drop Pod Launcher (Prow), 1× Torpedo Tube (Prow), 1× Lance Turret (Dorsal), 2× Macro-Cannon Battery (Port), 1× Launch Bay (Port), 2× Macro-Cannon Battery (Starboard), 1× Launch Bay (Starboard), 3× Defence Battery. A ship built to a pattern takes this loadout entire and does not buy mounts separately.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="5a5e5b69-636e-5cd1-8fa3-860403fcaf96" name="Drop Pod Launcher" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="min" value="2.0" field="selections" scope="parent" shared="false" id="ddfead9e-512f-5d8b-aed9-52bcf26f024a" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="395b2246-024c-556b-933d-79e9d8b97eb8" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="59bbe3d6-498e-570f-9dfc-f829da18bee2" name="Drop Pod Launcher" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Prow</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">—</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">—</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1 pod/rail</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">18″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">One pod per rail. Reload (2)</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" /></costs></selectionEntry><selectionEntry id="a9648a20-5cc0-5913-9cdf-e4536c7972ef" name="Torpedo Tube" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="4d3da838-d7b3-5c27-8bca-2b94f373cec0" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="9306ae77-fd78-5532-b0f8-2821256836be" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="cd65dc1a-ab7b-53f5-9ce8-ac69ba060c11" name="Torpedo Tube" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Prow</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">9</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">2</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">60″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">One torpedo per tube. Bypasses Void Shields; Armourbane within 6″; Reload (2)</characteristic></characteristics></profile></profiles><costs><cost name="pt