 <constraint type="max" value="7.0" field="selections" scope="parent" shared="false" id="9066fc77-5ecb-5e54-9e31-f503d8d1d023" percentValue="false" includeChildSelections="false" includeChildForces="false" />
 </constraints>
 <profiles>
 <profile id="fff31336-5e37-5910-a9c6-58fa7b31b387" name="Boarding Force" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Counts as 2 Crew; fights as one warrior at +2 and gives −1 to the enemy die it faces. Limits as Terminators.</characteristic>
 </characteristics>
 </profile>
 </profiles>
