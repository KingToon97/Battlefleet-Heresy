 </constraints>
 <profiles>
 <profile id="c9532d1a-93cb-40f0-958e-401c28b7aa69" name="Calas Typhon" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Enemy ships boarded by this fleet suffer an additional Crew loss after each boarding round.</characteristic>
 </characteristics>
 </profile>
 <profile id="ba072b2b-ec42-4175-823a-7aae7cb01533" name="Primarch Retinue" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This character is embarked as the Primarch's additional named retinue. They do not add Fleet Orders, Command range or any command ability; only effects unrelated to the order economy apply.</characteristic></characteristics></profile></profiles>
