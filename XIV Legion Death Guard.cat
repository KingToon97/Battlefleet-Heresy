 <selectionEntryGroup id="55e90c76de50aa0f8791831cc75cc230" name="Hull Upgrades" hidden="false"><constraints><constraint type="max" value="3.0" field="selections" scope="parent" shared="false" id="cbe09275-0b75-544a-b9c5-60f7b418dfeb" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="a3bbd139cced92cfa14e33ff2694d174" name="Side Armour Reinforcement" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="f23fa79e4cd95d7444748ef0da55829a" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="195a678334b7ffa47ef5af484ed7af20" name="Side Armour Reinforcement" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="120.0" /></costs></selectionEntry><selectionEntry id="021b2bafa6f360dcc72d7135dcf0693f" name="Engine Refit" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="fef47549468d104a29f3b96c87f302df" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="dc5b855fb5bb76579120910dc13c67ce" name="Engine Refit" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="100.0" /></costs></selectionEntry><selectionEntry id="19e19ab9-bb68-51a9-88bc-fde81b3e23d7" name="Phosphex Shells" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="6cf1d7d9-e38b-58ed-af4d-e7e76e5405a9" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="8c3e42c0-427a-5aeb-9209-2086965e2dcd" name="Phosphex Shells" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Every Heavy Macrobattery aboard fires phosphex: whenever one penetrates armour, the target takes 1 Critical Damage. Requires at least one Heavy Macrobattery. Every Death Guard Capital Ship carries Phosphex Shells free of charge.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Drop Pod Loadout" id="ec8afa52-a6d5-5a53-a67a-5cc0f9a73797" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="4.0" field="selections" scope="parent" shared="false" id="dd2788b1-ca64-545b-9cc7-0ca30b9f5c8b" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="4b1f8b41-2340-5db4-9cbb-ea22cc3c0cdc" name="Dreadclaw Drop Pod" hidden="false" collective="false" import="true" type="upgrade"><profiles><profile id="cbc9ab21-7590-5c3d-9dc7-762ad718614d" name="Dreadclaw Drop Pod" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding pod, Armour 8, Speed 30″/round. Takes 1 rail. Launched at a target within 18″, striking the same turn. One Shot. Counts as aircraft and may be intercepted; a surviving pod locks on 2+, and on a failure is destroyed with all aboard. Delivers 1 Crew of boarders (+1 in the first round). Removed from play after its run.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" /></costs></selectionEntry><selectionEntry id="728fc9f0-35c8-5c80-a5ab-6d049170d127" name="Kharybdis Assault Claw" hidden="false" collective="false" import="true" type="upgrade"><profiles><profile id="54283f1d-ba4f-52b3-a221-ab282e388cd1" name="Kharybdis Assault Claw" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding pod, Armour 9, Speed 30″/round. Takes 2 rails and locks automatically — melta cutters breach any hull — delivering 2 Crew of boarders (a Dreadnought filling both places). One Shot: removed from play after its run.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
 <costs>
 <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="140.0" />
 </costs>
 </selectionEntry>
 <selectionEntry id="81d44df7-c8bf-5864-afa5-3674282807ac" name="Battleship" hidden="false" collective="false" import="true" type="unit">
 <constraints><constraint type="max" value="3.0" field="selections" scope="roster" shared="false" id="a4d3df5a-07fd-5f84-b3a4-23fb01146a2b" percentValue="false" includeChildSelections="false" includeChildForces="true" /></constraints><profiles>
 <profile id="0e9dbe0e-d611-5196-b185-4701b98f0717" name="Battleship" hidden="false" typeId="806f9ff1-fd51-5ddb-b005-ce73a5d09d65" typeName="Ship">
 <characteristics>
 <characteristic name="BS" typeId="d130e705-611e-5a0a-bd7d-ea8e848fdb2e">3</characteristic>
 <characteristic name="Prow" typeId="84a55377-edbc-5825-a2bf-70c6155018f2">14</characteristic>
 <characteristic name="Side" typeId="5f595433-7397-5c4b-9d4a-8f35d83a2b29">13</characteristic>
 <characteristic name="Stern" typeId="cd9ec76e-f959-5560-8845-9ab242f16e71">12</characteristic>
 <characteristic name="HP" typeId="ef713781-2034-5fb4-83d1-e49d1d683694">13</characteristic>
 <characteristic name="VS" typeId="84309751-688d-50ef-8940-d8d042261a56">8</characteristic>
 <characteristic name="Speed" typeId="25d0e01e-8e74-55b3-8a2a-17773c881625">8″</characteristic>
 <characteristic name="Turn" typeId="899e9c58-70ef-5da5-8495-5bf6a8b7f8f0">45°</characteristic>
 <characteristic name="Crew" typeId="2f6312dd-493e-53c6-96e2-d901afca0e81">8</characteristic>
 </characteristics>
 </profile>
 <profile id="21c4f8b0-cd3d-5fdd-895c-578f9305a826" name="Bulwark of the Line" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Enemy Damage Table rolls against this ship suffer −1.</characteristic>
 </characteristics>
 </profile>
 <profile id="85a7987e-afc8-51d0-bdd5-bfa56a58ca93" name="Boarding Forces Validation" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding forces are bought against the ship’s Crew. Terminator/Dreadnought class limits are enforced; remember a Contemptor occupies 2 Crew slots.</characteristic>
 </characteristics>
 </profile>
 <profile id="3ba205b4-8c06-532d-b62a-0be72fe36bd5" name="Hardpoint Construction" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Bare chassis. Every mounted weapon is purchased separately. No upgrade-spend ceiling. Legal choices are controlled by hull class, hardpoint type and facing; each hardpoint must contain exactly one weapon.</characteristic>
 </characteristics>
 </profile>
 <profile id="e8fefbd3-b3ba-4cbd-a11b-556908e0d157" name="Mount Capacity" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Port: 3 · Port Heavy: 2 · Starboard: 3 · Starboard Heavy: 2 · Prow Ordnance: 4 · Prow Super-Heavy: 1 · Dorsal: 4 · Defence: 8 · Hangar: 2</characteristic></characteristics></profile><profile id="6ee73d07-a069-438b-927d-ddd12bb08820" name="Hardpoint Configuration" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ships begin with no weapons or Defence Batteries selected. Hangar Bay slots represent built-in hull capacity and cost 0 pts. Each physical hardpoint may take at most one legal component. There is no separate upgrade-spend cap; the hull's mount layout is the limit.</characteristic></characteristics></profile><profile id="9022d7c0-976a-45f9-a567-23861dee55a5" name="Roster Builder Summary" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Crew 8 · Port 3 · Port Heavy 2 · Starboard 3 · Starboard Heavy 2 · Prow Ordnance 4 · Prow Super-Heavy 1 · Dorsal 4 · Defence 8 · Hangars 2. Ships start unequipped. Fill only the weapon and Defence hardpoints you want to purchase; each may contain at most one component. Hangar Bay slots cost 0 pts. Aircraft are purchased separately up to Hangar capacity.</characteristic></characteristics></profile></profiles>
 <rules><rule id="67da797b-786c-5125-9c67-bb082e155ab5" name="Gets Hot" hidden="false"><description>After a Lance Turret or Twin Lance Turret resolves its attacks, roll a D6. On a 1 the firing ship loses 1 Hull Point. Each mount rolls separately.</description></rule><rule id="ee250178-e86c-5e57-a9e9-87756945d9db" name="Twin-Linked" hidden="false"><description>Re-roll failed To Hit rolls.</description></rule><rule id="59ef5305-e373-5a65-88fa-e55f8e02f927" name="Capital" hidden="false"><description>Counts as a Capital Ship for every rule that names one, and fills a Capital slot.</description></rule><rule id="f1191df8-c1f3-5815-85b1-610e0e21930f" name="Reload (X)" hidden="false"><description>After firing, place X Reload tokens on the mount; flip one at the end of each battle round. The mount cannot fire while it bears a token.</description></rule><rule id="5db07d9a-672b-5cbf-ad89-407b5cfc55bf" name="Devastating (X)" hidden="false"><description>Each hit costs X Hull Points, or 1 Void Shield Rating against live shields.</description></rule><rule id="60dd92e6-7cf1-5060-bd5e-59988c2512ca" name="Armourbane" hidden="false"><description>Roll 2D6 + Strength to penetrate instead of 1D6, at 6″ or less, against shields or hull alike.</description></rule><rule id="10cddf2f-b6c5-5970-b71d-5b04542a27fd" name="Point-Blank Broadsides" hidden="false"><description>At 6″ or less, Port, Starboard and Dorsal weapons improve AP by one step — or gain Armourbane instead if their printed AP is already 1. Prow weapons get neither.</description></rule><rule id="849cb728-2439-53ba-96e8-f1ca71f5c818" name="Crippled" hidden="false"><description>Below half starting Hull Points: −1 BS and half Speed.</description></rule><rule id="a49f4c1b-e224-535b-9935-5d539d3ceaaa" name="Depleted" hidden="false"><description>At half starting Crew or less: −1 BS. Stacks with Crippled.</description></rule><rule id="a97c6635-6fd1-515a-9191-996c6a6a0d81" name="Locked" hidden="false"><description>Joined by a ram. Neither ship may move; the rammer may not fire on its victim, who fires back at −1 BS. Break Away on 5+.</description></rule><rule id="1caf30a2-e5ea-55e8-892d-2b20761d6e8e" name="Snap Shots" hidden="false"><description>Firing at BS 1 — hits only on a 6.</description></rule><rule id="4d67d68c-a6e4-50a5-836d-e990e3a287c9" name="Wreck" hidden="false"><description>0 Hull Points without exploding. Becomes impassable, obscuring terrain; never moves and never Evades.</description></rule><rule id="9d360092-54c4-53c3-ab07-cb13761d0ce8" name="Held station" hidden="false"><description>Moved 1″ or less under Burn Retros. Broadsides fire at +1 BS; −1 on Evade.</description></rule></rules><categoryLinks>
 <categoryLink id="78797cf8-6737-54b4-80ff-fd3f8e358728" name="Capital" hidden="false" targetId="bd422ebf-10b3-5085-89cc-263568c40fe0" primary="true" />
 </categoryLinks>
 <selectionEntryGroups>
 <selectionEntryGroup name="Prow Mounts" id="dcd480ca-417a-5575-a2b3-ff82906bfe59" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="4.0" field="selections" scope="parent" shared="false" id="43af5ed2-3490-556c-948e-7c2121198633" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="3b379f15-de9c-557d-a5a8-c71617c4fa41" name="Torpedo Tube" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="4.0" field="selections" scope="parent" shared="false" id="f3452b33-b2f7-5e6c-810a-a0a6262b9dac" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="04fd387d-4cf3-51c6-8ba5-d070c92e5389" name="Torpedo Tube" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Prow</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">9</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">2</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">60″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">One torpedo per tube. Bypasses Void Shields; Armourbane within 6″; Reload (2)</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" /></costs></selectionEntry><selectionEntry id="b09eb069-2107-57d8-8d85-eab233484ba1" name="Nova Cannon" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="4.0" field="selections" scope="parent" shared="false" id="f4402ee4-d1da-58d0-8d49-a37097a40277" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="006c5f0c-6321-5a9b-a83c-783fb95d2900" name="Nova Cannon" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Prow</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">12</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">D</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">60″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Min range 18″; Devastating (3); Reload (2)</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="100.0" /></costs></selectionEntry><selectionEntry id="1eb4d13d-0dfc-55f2-9a42-0b8824e83f21" name="Void Missile Launcher (Prow)" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="4.0" field="selections" scope="parent" shared="false" id="a226239d-a3a8-5bc2-9fdf-71115653883a" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="24b21024-5c65-570e-97b1-aeebd3126768" name="Void Missile Launcher (Prow)" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Prow</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">12</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">D</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">60″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">One Shot; Devastating (3); Volatile</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="100.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Dorsal Mounts" id="a5c0186c-2c37-5ba9-9fb0-4e66a1ac12bb" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="4.0" field="selections" scope="parent" shared="false" id="8d775c94-d1bb-5938-a696-78baa048d1bf" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="fb9d89b7-658c-5b58-a4da-fa80a9b5942a" name="Lance Turret" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="4.0" field="selections" scope="parent" shared="false" id="0b44018d-bec4-5ed8-a45c-788fe11599dd" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="72643911-90dd-51bb-9108-3ad550e49551" name="Lance Turret" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Dorsal</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">10</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">1</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">46″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Gets Hot; Reload (1); Devastating (2)</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="57