 <selectionEntryGroup id="223edc14cca3942fac113fb3d605a18b" name="Hull Upgrades" hidden="false"><constraints><constraint type="max" value="3.0" field="selections" scope="parent" shared="false" id="17a92acf-7836-5c2b-b83a-5eaa91dd7c05" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="f31a6b3f58d2c24efe1ae6c4aaefc775" name="Side Armour Reinforcement" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="3d7824ea2d1b55e0612207992ded1a87" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="bb45c2a3a02cfa2deccbf6b4e30e4f12" name="Side Armour Reinforcement" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="120.0" /></costs></selectionEntry><selectionEntry id="dd120876575d783118d7d5fcf34c609c" name="Engine Refit" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="b56e137ff0999bb2ef5b433f2381df4d" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="f524ff6eff13efae022b8ed4516b7d5b" name="Engine Refit" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="100.0" /></costs></selectionEntry><selectionEntry id="acaa2cca-4d86-5c92-a036-5ef636b65346" name="Phosphex Shells" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="a9bbeacf-a376-5dde-816e-e81d8301de04" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="dca5b5ed-b592-5340-997a-53e9917a966b" name="Phosphex Shells" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Every Heavy Macrobattery aboard fires phosphex: whenever one penetrates armour, the target takes 1 Critical Damage. Requires at least one Heavy Macrobattery. Every Death Guard Capital Ship carries Phosphex Shells free of charge.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Boarding Forces" id="6245e2e9-deba-5732-83f8-d7431408416e" hidden="false" collective="false" import="true">
