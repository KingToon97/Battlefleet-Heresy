 <selectionEntryGroup id="b6ead2539bf71daee6afa018be046c74" name="Hull Upgrades" hidden="false"><constraints><constraint type="max" value="3.0" field="selections" scope="parent" shared="false" id="af299dd8-3be6-523c-9b84-2167614faa51" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="908971f9481f5d447068cba43d7edf1c" name="Side Armour Reinforcement" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="52761b1effb6a016c4acc9b99cd172c8" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="91d156f15c41b28fd9ca87593b619ca8" name="Side Armour Reinforcement" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="120.0" /></costs></selectionEntry><selectionEntry id="c2db03322d7b49285e9a5da9e45a5317" name="Engine Refit" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="75989aabc40e945add8d1687c35e7a8a" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="80542979655c7c60e9ed346f47325609" name="Engine Refit" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="100.0" /></costs></selectionEntry><selectionEntry id="bba308bc-278c-515d-a6c0-d445a4f3acf4" name="Phosphex Shells" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="faacb16b-c5d8-502c-bd9c-0ccfb563b2f6" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="2fa48415-5d71-55db-bfc7-f1bcc7065e95" name="Phosphex Shells" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Every Heavy Macrobattery aboard fires phosphex: whenever one penetrates armour, the target takes 1 Critical Damage. Requires at least one Heavy Macrobattery. Every Death Guard Capital Ship carries Phosphex Shells free of charge.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
