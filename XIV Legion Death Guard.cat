istics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Dorsal</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">10</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">1</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">2</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">46″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Twin-Linked; Gets Hot; Reload (2); Devastating (2)</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="15.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Port Mounts" id="85061adb-48e8-557a-b82c-c0e52c3c66ec" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="4.0" field="selections" scope="parent" shared="false" id="0bb9f316-a287-55b9-82df-0ab28d7907f5" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="3cac77f1-3e1f-5143-a9b4-287b0e8bcac8" name="Macrobattery (Port)" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="4.0" field="selections" scope="parent" shared="false" id="b53570e3-a130-5459-af0c-37fb08667400" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="cd70da74-66a7-5cb4-93b1-c749cc2e7039" name="Macrobattery (Port)" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Port</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">8</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">3</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">30″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">—</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" /></costs></selectionEntry><selectionEntry id="453e9bf1-d06f-53f2-9b5d-ea09f3fe5b5c" name="Heavy Macrobattery (Port)" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="4.0" field="selections" scope="parent" shared="false" id="1c57f0db-1b94-5880-ba00-dca54c165741" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="a04a919b-7c53-59cc-97ce-cb636e146535" name="Heavy Macrobattery (Port)" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Port</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">9</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">2</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">30″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">—</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="15.0" /></costs></selectionEntry><selectionEntry id="b8fd575d-2d37-5976-9678-fd4848470e62" name="Hangar Bay" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="c9fc0ce3-43b5-5b2b-94af-c775349cb34a" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="c718dea5-f8a1-5aa0-8591-d2ca5240cd8e" name="Hangar Bay" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Holds one aircraft squadron, bought separately. Occupies one broadside mount that could otherwise carry a weapon, and may not be mounted on the Prow or Dorsally.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Starboard Mounts" id="c8ddf6ea-15f4-5ffd-a7d9-50db32a39912" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="4.0" field="selections" scope="parent" shared="false" id="a0529ba8-5432-5591-83d5-788462621ba1" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="e7d10f8e-57ca-54a9-a331-cd412f8eb4c0" name="Macrobattery (Starboard)" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="4.0" field="selections" scope="parent" shared="false" id="4a806aab-5f37-58a2-a753-ce02aa450051" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="1e03b214-3cdd-5b66-862f-b9d092757584" name="Macrobattery (Starboard)" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Starboard</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">8</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">3</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">30″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">—</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" /></costs></selectionEntry><selectionEntry id="1507333f-b260-5851-a597-214379bb1bb7" name="Heavy Macrobattery (Starboard)" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="4.0" field="selections" scope="parent" shared="false" id="8d8cb509-cd9c-55fe-979e-82b7c1572448" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="54f5b5d9-c62b-5e96-a5a6-1b7cf1b4ba74" name="Heavy Macrobattery (Starboard)" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Starboard</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">9</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">2</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">30″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">—</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="15.0" /></costs></selectionEntry><selectionEntry id="f1e2a356-533a-578e-b95f-a70ffe0f9907" name="Hangar Bay" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="13915a5b-fdd6-5354-b789-f88e19f676c4" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="7993f431-2c24-50c1-a9dc-02e8c098db5f" name="Hangar Bay" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Holds one aircraft squadron, bought separately. Occupies one broadside mount that could otherwise carry a weapon, and may not be mounted on the Prow or Dorsally.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="5053827a-8351-49a5-889e-e575c5b4575d" name="Fleet Role" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="a814c2f0-793c-4e45-8229-1f2c177364e2" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="5c4cbd7a-c81d-4749-8fe3-0ab3c46d3211" name="Designate as Flagship" hidden="false" collective="false" import="true" type="upgrade"><profiles><profile id="c0b29ac9-772b-4504-87a0-0d71d7be522f" name="Commander Embarkation" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander here. The Commander is embarked on this Flagship.</characteristic></characteristics></profile></profiles><rules><rule id="0b913aa5-fc75-51ab-870d-b8c289b05cb6" name="Flagship" hidden="false"><description>This ship is the fleet's Flagship. Exactly one Flagship is required in a standard fleet.</description></rule></rules><categoryLinks><categoryLink id="bb3841ab-2f9e-462f-8a6c-a5bd518fa26c" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" /></categoryLinks><selectionEntryGroups><selectionEntryGroup id="70ec4762-3260-40eb-a2c0-bf307e57d9a0" name="Fleet Commander" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="8bd4c1cf-4ef9-4144-8f07-6016a98d2868" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="3055ae5d-1572-43ef-94a2-fcc6410322d0" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="2eb4c1ce-6a13-4e11-8bfd-3e0c35a826ed" name="Fleet Captain" hidden="false" collective="false" import="true" type="upgrade">
 <constraints>
 <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0bae44c2-0c70-48ea-8e16-9d58e4e845f3" type="max" />
