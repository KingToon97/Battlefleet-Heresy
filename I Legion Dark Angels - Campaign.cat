 Battery)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="c4326a98-6797-51e9-9655-1e29b6cc3510" /><entryLink id="c1d2178e-bed9-5dc4-a0d9-518cda730c21" name="Practised Broadside" hidden="false" collective="false" import="true" type="selectionEntry" targetId="dc71b595-1124-57c2-9354-323cf1f870c6" /><entryLink id="e3a7552b-33ba-517e-a11a-da45f417b310" name="Iron Discipline" hidden="false" collective="false" import="true" type="selectionEntry" targetId="d5b7974b-4b9d-531c-a172-10eb462837fc" /><entryLink id="474c2607-cd4c-52cd-9f99-543de9b1ef48" name="Damage Control Veterans" hidden="false" collective="false" import="true" type="selectionEntry" targetId="a7b1bcf4-853c-5d08-b46f-2af4bc804a71" /><entryLink id="87443ce3-5335-509f-b590-e4a2536a752e" name="Old Warhorse" hidden="false" collective="false" import="true" type="selectionEntry" targetId="6d745b94-7897-55ef-9c3e-c3f857219e29" /><entryLink id="d6db676f-12b0-5e6b-a706-01006bf7c18b" name="Never Abandon Ship" hidden="false" collective="false" import="true" type="selectionEntry" targetId="bee216cf-a6d2-5c11-a2d3-b77eec81b2ad" /><entryLink id="f9dae501-6a15-578d-a95d-83f4a9fa6929" name="Steady Bridge" hidden="false" collective="false" import="true" type="selectionEntry" targetId="81722513-7d76-5a02-88b1-39f047502b9a" /><entryLink id="4a8cc7e8-a5ee-536b-9bcf-d2d5b9db27cf" name="Grim Resolve" hidden="false" collective="false" import="true" type="selectionEntry" targetId="5a4d1e67-dd59-5a7e-b2d6-be8c0c52ca46" /><entryLink id="8a1f52dd-35b6-5715-88d0-215e1828740d" name="Master Helmsman" hidden="false" collective="false" import="true" type="selectionEntry" targetId="ba700258-e1d6-5460-a8e4-e7d6796a7dbf" /><entryLink id="7f3bb306-53ea-5dd5-beb0-06fedc26f496" name="Flank Speed" hidden="false" collective="false" import="true" type="selectionEntry" targetId="d97176f0-a3f8-557b-8f8e-a72339eb41b6" /><entryLink id="509623dd-06a7-531f-a348-18a3a569c43c" name="Veteran Navigator" hidden="false" collectiv