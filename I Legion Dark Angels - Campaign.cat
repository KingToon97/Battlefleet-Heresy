 <selectionEntryGroup id="391bf7b9-5032-5a77-b3cd-5a8b1fe2b2a1" name="Hull Upgrades" hidden="false"><constraints><constraint type="max" value="3.0" field="selections" scope="parent" shared="false" id="ce2787d5-2c88-5dac-87d1-a7df6189e08d" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="8991a359-86e6-5410-bb72-b25016d8ac85" name="Side Armour Reinforcement" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="d8d7eeb1-c56b-5cc0-97bc-c7010a0aa10f" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="b36cd6b7-2512-5e35-8d9a-ebe481cce016" name="Side Armour Reinforcement" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="120.0" /></costs></selectionEntry><selectionEntry id="1a11c42a-a6aa-54e7-be5f-6037d6daab13" name="Engine Refit" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="cd862351-eddf-522d-96df-9e4ca9b2620c" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="70cff2da-e073-5099-a93a-cb8fe927e23e" name="Engine Refit" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="100.0" /></costs></selectionEntry><selectionEntry id="c0b290df-9d40-51b8-975e-47bd876813cd" name="Phosphex Shells" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="35a8722b-e59a-505c-98b6-6747ba4607f9" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="148c726d-f24b-5aa6-816f-03c27e9009a7" name="Phosphex Shells" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Every Heavy Macrobattery aboard fires phosphex: whenever one penetrates armour, the target takes 1 Critical Damage. Requires at least one Heavy Macrobattery.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="50.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Drop Pod Loadout" id="8131ad24-662c-55d2-b891-834a5fa38761" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="4.0" field="selections" scope="parent" shared="false" id="24ec83ad-692e-5601-b1f4-90fb4b8428df" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="c3fd356d-da5f-594e-a952-0e7335c29f59" name="Dreadclaw Drop Pod" hidden="false" collective="false" import="true" type="upgrade"><profiles><profile id="3c8713f4-66d0-5482-8bc1-72cfae9d5c4a" name="Dreadclaw Drop Pod" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding pod, Armour 8, Speed 30″/round. Takes 1 rail. Launched at a target within 18″, striking the same turn. One Shot. Counts as aircraft and may be intercepted; a surviving pod locks on 2+, and on a failure is destroyed with all aboard. Delivers 1 Crew of boarders (+1 in the first round). Removed from play after its run.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" /></costs></selectionEntry><selectionEntry id="0d4f1376-4c31-5313-b4f3-ac6bb9c67fcf" name="Kharybdis Assault Claw" hidden="false" collective="false" import="true" type="upgrade"><profiles><profile id="061e1685-da6f-556f-b11f-8ccf664b86ae" name="Kharybdis Assault Claw" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding pod, Armour 9, Speed 30″/round. Takes 2 rails and locks automatically — melta cutters breach any hull — delivering 2 Crew of boarders (a Dreadnought filling both places). One Shot: removed from play after its run.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Campaign Record" id="a4009566-2087-52bd-9e32-88bc04e4ec66" hidden="false" collective="false" import="true"><selectionEntryGroups><selectionEntryGroup name="Veteran Level" id="29da6e1d-3f2f-51a6-bc94-46c70ef8ab50" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="263c6acd-c7d6-5934-bfac-772f39562cda" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><entryLinks><entryLink id="9dc71cb3-b67e-5a88-b3fa-2e3ac4f87f35" name="Level I — Blooded" hidden="false" collective="false" import="true" type="selectionEntry" targetId="fb150655-9734-5d36-9575-218ce0df23a2" /><entryLink id="465aa77b-872f-5083-a697-4d9de9ccf4f0" name="Level II — Proven" hidden="false" collective="false"