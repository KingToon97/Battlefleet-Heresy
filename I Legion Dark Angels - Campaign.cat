k id="ae7013ff-2a78-5409-9443-937872b06f7d" name="Corridor Fighters" hidden="false" collective="false" import="true" type="selectionEntry" targetId="c6996d56-0f96-5d2f-885e-c34f14593067" /><entryLink id="00faaad1-352d-5733-8a6b-a3f509fe2ee2" name="Ready at the Ramp (restricted: does not already have Assault Ramp)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="be55ef8f-456b-5a3e-9c0d-6b079703ae93" /><entryLink id="4099fff4-d06c-54c8-985a-2541d433968d" name="Butcher's Bill" hidden="false" collective="false" import="true" type="selectionEntry" targetId="cbff2c57-52b3-5420-a6cc-961412cb34f3" /><entryLink id="ec3cf6ba-29d5-52fd-91e9-8e5f43ceeb6f" name="Prize Crew" hidden="false" collective="false" import="true" type="selectionEntry" targetId="fabd84fc-d5c9-509f-b556-fef9dd7ce7e0" /><entryLink id="97d38a51-e845-5adc-b36d-d0a79d540d0c" name="Terror of the Void" hidden="false" collective="false" import="true" type="selectionEntry" targetId="16693f6f-1197-5873-a9b9-d5168ebeab9b" /><entryLink id="f120d65e-d8fc-5bd5-923c-1923fc7aefcd" name="The Unsinkable" hidden="false" collective="false" import="true" type="selectionEntry" targetId="44f53a0a-bb85-5bda-9db9-0edc79c273c4" /><entryLink id="f64050ab-8c61-5b91-8e69-2753d8085a0d" name="Legend of the Line" hidden="false" collective="false" import="true" type="selectionEntry" targetId="7a183f3f-4d40-5397-b820-ec1748e2ab8d" /><entryLink id="08c0943a-8459-50ca-a3b1-392eca3c4102" name="She Remembers" hidden="false" collective="false" import="true" type="selectionEntry" targetId="b0d72102-ee75-5231-af8f-74381b23ea87" /><entryLink id="acb3f564-ef80-53d4-9710-907c64971dab" name="The Emperor's Own" hidden="false" collective="false" import="true" type="selectionEntry" targetId="5227d6ed-d8f0-5856-9c00-b58e5b84e344" /></entryLinks></selectionEntryGroup><selectionEntryGroup name="Battle Scars" id="00755889-976b-58aa-9f2a-2e984b5be69a" hidden="false" collective="false" import="true"><entryLinks><entryLink id="206145d3-4e38-53de-9c56-d10330fc76ca" name="Scar: Warped Keel (1)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="e8883d4e-3ac3-52fb-b2b4-7aac3be72df8" /><entryLink id="9d535f7d-5c51-56b7-9f3d-f881e1bf5b9b" name="Scar: Scarred Plate (2)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="92329a1d-0356-5f74-b0c4-a6fe87b6ed91" /><entryLink id="22b9a1db-687d-5766-9078-b9ce2fc8a3e6" name="Scar: Ruined Gun Deck (3)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="6f159232-7885-576c-827f-b1eb3770d5b0" /><entryLink id="c21b02bb-beac-5061-8c22-8199d051b3a6" name="Scar: Cracked Reactor (4)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="44cbea77-b505-5ce6-bc03-ff7629eeb7b5" /><entryLink id="175e1269-0ce4-55d0-891a-1eab70e91087" name="Scar: Thinned Complement (5)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="74d0dcba-3c78-5baa-bbec-103a5f264bb3" /><entryLink id="7e5cbe45-2f6c-5fae-bdb4-e426f5e2d10f" name="Scar: Haunted Decks (6)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="f87d2855-77a3-5740-bcd1-c6733c72332e" /></entryLinks></selectionEntryGroup></selectionEntryGroups></selectionEntryGroup></selectionEntryGroups>
 <costs>
 <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="1100.0" />
 </costs>
 </selectionEntry>
 <selectionEntry id="b3359f21-1aaf-5fbf-a645-5ee0aa7475aa" name="I Legion - The First Legion" hidden="false" collective="false" import="true" type="upgrade">
 <rules><rule id="ca3d5903-14cd-58ff-ab5e-ddd0e6d7dac2" name="I Legion - The First Legion" hidden="false"><description /></rule></rules><categoryLinks>
 <categoryLink id="29d250b5-9111-5ca6-8782-05a02d64b66f" name="Open Play Fleet" hidden="false" targetId="f4a1bdc9-d680-5abd-a007-4b0b71797ecd" primary="false" /><categoryLink id="889eee22-69c0-5170-a132-d7b7f3b64d1e" name="Rules" hidden="false" targetId="52616092-abd8-519e-a6fb-94b622114fa5" primary="false" /><categoryLink id="bb62e400-dab7-5e3a-bbe6-ac452360fbc1" name="Campaign Fleet" hidden="false" targetId="69270169-f826-5f6c-8c3d-26f416055ec0" primary="true" /></categoryLinks>
 </selectionEntry>
 <selectionEntry id="cb9ce595-777b-59dd-9a13-7204252df3e8" name="Battle Carrier" hidden="false" collective="false" import="true" type="unit">
 <constraints><constraint type="max" value="3.0" field="selections" scope="roster" shared="false" id="232e902e-46cf-5864-bf25-780061ddee62" percentValue="false" includeChildSelections="false" includeChildForces="true" /></constraints><profiles>
 <profile id="135fc700-b88d-5dff-8908-11138e0d8203" name="Battle Carrier" hidden="false" typeId="806f9ff1-fd51-5ddb-b005-ce73a5d09d65" typeName="Ship">
 <characteristics>
 <characteristic name="BS" typeId="d130e705-611e-5a0a-bd7d-ea8e848fdb2e">3</characteristic>
 <characteristic name="Prow" typeId="84a55377-edbc-5825-a2bf-70c6155018f2">14</characteristic>
 <characteristic name="Side" typeId="5f595433-7397-5c4b-9d4a-8f35d83a2b29">13</characteristic>
 <characteristic name="Stern" typeId="cd9ec76e-f959-5560-8845-9ab242f16e71">12</characteristic>
 <characteristic name="HP" typeId="ef713781-2034-5fb4-83d1-e49d1d683694">13</characteristic>
 <characteristic name="VS" typeId="84309751-688d-50ef-8940-d8d042261a56">8</characteristic>
 <characteristic name="Speed" typeId="25d0e01e-8e74-55b3-8a2a-17773c881625">6″</characteristic>
 <characteristic name="Turn" typeId="899e9c58-70ef-5da5-8495-5bf6a8b7f8f0">45°</characteristic>
 <characteristic name="Crew" typeId="2f6312dd-493e-53c6-96e2-d901afca0e81">8</characteristic>
 </characteristics>
 </profile>
 <profile id="2f9a6e95-a19a-5063-895b-dd2f1f65fed8" name="Bulwark of the Line" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Enemy Damage Table rolls against this ship suffer −1.</characteristic>
 </characteristics>
 </profile>
 <profile id="55a4840d-1f10-50f4-89a1-5d49a46d8151" name="Boarding Forces Validation" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding forces are bought against the ship’s Crew. Terminator/Dreadnought class limits are enforced; remember a Contemptor occupies 2 Crew slots.</characteristic>
 </characteristics>
 </profile>
 <profile id="89341e66-e06b-5a9e-bf8e-ebe6f07d1dcb" name="Hardpoint Construction" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Bare chassis. Every mounted weapon is purchased separately. No upgrade-spend ceiling. Legal choices are controlled by hull class, hardpoint type and facing; each hardpoint must contain exactly one weapon.</characteristic>
 </characteristics>
 </profile>
 <profile id="8d5726a9-1cc7-5c5f-aac2-16ed7232087d" name="Mount Capacity" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Port Heavy: 1 · Starboard Heavy: 1 · Prow Ordnance: 6 · Dorsal: 4 · Defence: 10 · Hangar: 6</characteristic></characteristics></profile><profile id="70311670-5ff7-54b1-863e-38869e947b13" name="Hardpoint Configuration" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ships begin with no weapons or Defence Batteries selected. Hangar Bay slots represent built-in hull capacity and cost 0 pts. Each physical hardpoint may take at most one legal component. There is no separate upgrade-spend cap; the hull's mount layout is the limit.</characteristic></characteristics></profile><profile id="56edc28a-5be2-55dc-9a74-c88870339c3f" name="Carrier Flagship Priority" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">A Battle Carrier must be the fleet's Flagship unless a Gloriana is present. New Recruit enforces this through the Fleet Role selection.</characteristic></characteristics></profile><profile id="cf803d0b-bf96-56d9-a491-d89792384a4a" name="Roster Builder Summary" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Crew 8 · Port Heavy 1 · Starboard Heavy 1 · Prow Ordnance 6 · Dorsal 4 · Defence 10 · Hangars 6. Ships start unequipped. Fill only the weapon and Defence hardpoints you want to purchase; each may contain at most one component. Hangar Bay slots cost 0 pts. Aircraft are purchased separately up to Hangar capacity.</characteristic></characteristics></profile></profiles>
 <rules><rule id="5138ad38-5c01-5029-9eac-6932a711ac70" name="Gets Hot" hidden="false"><description>After a Lance Turret or Lance Battery resolves its attacks, roll a D6. On a 1 the firing ship loses 1 Hull Point. Each mount rolls separately.</description></rule><rule id="f7ef3b9d-1ef9-5729-ab87-440f2f126224" name="Twin-Linked" hidden="false"><description>Re-roll failed To Hit rolls.</description></rule><rule id="c31205a1-6392-5e35-a2dd-d99bca2c5868" name="Air Group" hidden="false"><description>Carries six aircraft squadrons free of charge, chosen when the fleet is built. Further squadrons may be bought, but she has nowhere to put them.</description></rule><rule id="75816dfb-eead-5d2c-9c99-8344fdc4e965" name="Capital Ship" hidden="false"><description>Counts as a Capital Ship for every rule that names one, and fills a Capital slot.</description></rule><rule id="07b4ed5b-2c59-5360-9396-87245b4b53d0" name="Reload (X)" hidden="false"><description>After firing, place X Reload tokens on the mount; flip one at the end of each battle round. The mount cannot fire while it bears a token.</description></rule><rule id="ee3a6e2f-c350-59a1-a858-7f60bbd847c9" name="Devastating (X)" hidden="false"><description>Each hit costs X Hull Points, or 1 Void Shield Rating against live shields.</description></rule><rule id="4a070e27-b5c1-5838-b0b5-05cd9417301b" name="Armourbane" hidden="false"><description>Roll 2D6 + Strength to penetrate instead of 1D6, at 6″ or less, against shields or hull alike.</description></rule><rule id="3bc335ab-b9e9-58fc-9a60-2696161e56cc" name="Point-Blank Broadsides" hidden="false"><description>At 6″ or less, Port, Starboard and Dorsal weapons improve AP by one step — or gain Armourbane instead if their printed AP is already 1. Prow weapons get neither.</description></rule><rule id="33577491-f86c-5c72-8bc8-a901815d6b56" name="Crippled" hidden="false"><description>Below half starting Hull Points: −1 BS and half Speed.</description></rule><rule id="924f232b-b4c9-5755-8f97-58e9fd979a55" name="Depleted" hidden="false"><description>At half starting Crew or less: −1 BS. Stacks with Crippled.</description></rule><rule id="d9e63975-95a8-5e42-b1d9-640a81ef1e1d" name="Locked" hidden="false"><description>Joined by a ram. Neither ship may move; the rammer may not fire on its victim, who fires back at −1 BS. Break Away on 5+.</description></rule><rule id="16083564-1413-54c1-a044-e6c7c1cc6b03" name="Snap Shots" hidden="false"><description>Firing at BS 1 — hits only on a 6.</description></rule><rule id="5116da88-3d74-508a-b28c-856524071da5" name="Wreck" hidden="false"><description>0 Hull Points without exploding. Becomes impassable, obscuring terrain; never moves and never Evades.</description></rule><rule id="1d761fed-ca1e-524f-8fc5-11570c43e999" name="Held station" hidden="false"><description>Moved 1″ or less under Burn Retros. Broadsides fire at +1 BS; −1 on Evade.</description></rule></rules><categoryLinks>
 <categoryLink id="43bd6beb-fa3d-5f27-9db1-578d2cda13e1" name="Capital Ship" hidden="false" targetId="bd422ebf-10b3-5085-89cc-263568c40fe0" primary="false" />
 <categoryLink id="0598d79a-a8ca-55e7-ad79-aa32aaccfffb" name="Open Play Fleet" hidden="false" targetId="f4a1bdc9-d680-5abd-a007-4b0b71797ecd" primary="false" /><categoryLink id="f335c960-3fa2-545e-a63c-b0f2522a7c8e" name="Campaign Fleet" hidden="false" targetId="69270169-f826-5f6c-8c3d-26f416055ec0" primary="true" /></categoryLinks>
 <selectionEntryGroups>
 <selectionEntryGroup id="99773383-2bfe-5a0d-9fc8-def7a9df6b29" name="Fleet Role" hidden="false" collective="false" import="true"><modifiers><modifier type="set" field="53cea0eb-8f64-4a78-81f3-588091e8082a" value="0.0"><conditions><condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="6e49ea9d-e24f-5916-8418-787496f3214a" type="atLeast" /></conditions></modifier></modifiers><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="91c73f28-834f-5b63-87f9-127e2933d8fa" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="ff32f842-6e40-551c-b4cd-51e56de3b878" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="ea5ddfdc-3ad5-55bb-bd14-6dd86c1e1c5a" name="Designate as Flagship" hidden="false" collective="false" import="true" type="upgrade"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="6e49ea9d-e24f-5916-8418-787496f3214a" type="atLeast" /></conditions></modifier></modifiers><profiles><profile id="d01cabcb-a23a-5112-a692-5ef1661dcb2f" name="Commander Embarkation" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander here. The Commander is embarked on this Flagship.</characteristic></characteristics></profile></profiles><rules><rule id="d87deb45-dc67-50f7-93e6-c4804283b738" name="Flagship" hidden="false"><description>Mandatory when the fleet contains no Gloriana. If a Gloriana is selected, this option is automatically hidden and the requirement is removed.</description></rule></rules><categoryLinks><categoryLink id="301b817a-94a9-53a3-a5cd-97f983b1d726" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" /></categoryLinks><selectionEntryGroups><selectionEntryGroup id="6ae4c8e5-f0ea-557c-93b0-64dec27feb56" name="Fleet Commander" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="84689873-bc6e-5148-aa4d-bd03f22075a7" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="6404faf2-22fa-543f-a9ee-88ff1a91499d" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="fa6b7247-ab5e-599d-add3-4c163b437a20" name="Fleet Captain" hidden="false" collective="false" import="true" type="upgrade">
 <constraints>
 <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="96dd0ac0-9b11-51e4-aa3b-ad8e3086a96a" type="max" />
 </constraints>
 <profiles>
 <profile id="1b57c663-2c4e-5239-a7f1-4f2b14c947ef" name="Fleet Captain" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Fleet Captain. 1 Fleet Order of each type each battle round. Ship’s Master: once per battle, the Flagship may re-roll a single failed Evade roll.</characteristic>
 </characteristics>
 </profile>
 </profiles>
 <categoryLinks>
