 <selectionEntry id="c0c1fed7-3718-5933-8d1f-aefcaa8d6216" name="Holguin" hidden="false" collective="false" import="true" type="upgrade">
 <constraints>
 <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="32ba85b1-c163-5f8f-838a-e5744838cb78" type="max" />
 </constraints>
 <profiles>
 <profile id="fe37bad9-666a-5c50-8eef-df3359cead97" name="Holguin" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Named Character. 2 Fleet Orders of each type each battle round. Practised Command: once per battle round, one friendly ship within Command range may re-roll a single failed Evade roll. Once per turn, one friendly ship within 12″ may re-roll failed hits against the nearest target.</characteristic>
