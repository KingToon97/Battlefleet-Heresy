 <selectionEntryGroup id="2d157ea5-780d-5284-a005-254521ed4094" name="Fleet Role" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="55492dc1-f771-5e75-85d0-ff11255cd657" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="3115c26c-27dc-55ee-a225-315079392475" name="Designate as Flagship" hidden="false" collective="false" import="true" type="upgrade"><profiles><profile id="5be8c99f-afb9-503a-a13f-38d5b4920ec1" name="Commander Embarkation" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander here. The Commander is embarked on this Flagship.</characteristic></characteristics></profile></profiles><rules><rule id="fb7716d8-e258-5436-8682-5a6be896c033" name="Flagship" hidden="false"><description>This ship is the fleet's Flagship. Exactly one Flagship is required in a standard fleet.</description></rule></rules><categoryLinks><categoryLink id="4ff507f5-b64f-523f-b5c3-b2942ff2a58c" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" /></categoryLinks><selectionEntryGroups><selectionEntryGroup id="15d5e26e-817a-5514-95e2-ccbef83d85b9" name="Fleet Commander" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="c8e19b38-c2e1-54d6-bff0-d4eeb068e191" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="0baeeeed-4591-5662-8e19-3b30046837c0" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="72ae61e9-d5d4-5158-bff9-361e722c7f6c" name="Fleet Captain" hidden="false" collective="false" import="true" type="upgrade">
 <constraints>
 <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="2fe3b348-20ee-51ce-85dc-5c30dbb436a8" type="max" />
 </constraints>
 <profiles>
 <profile id="0a4e5352-dd2c-5a62-bcf6-6e57ddb2048e" name="Fleet Captain" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Fleet Captain. 1 Fleet Order of each type each battle round. Ship’s Master: once per battle, the Flagship may re-roll a single failed Evade roll.</characteristic>
 </characteristics>
 </profile>
 </profiles>
