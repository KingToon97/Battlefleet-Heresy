ctive="false" import="true" type="selectionEntry" targetId="5227d6ed-d8f0-5856-9c00-b58e5b84e344" /></entryLinks></selectionEntryGroup><selectionEntryGroup name="Battle Scars" id="f27a3ba5-b410-5373-9721-f27da28ba033" hidden="false" collective="false" import="true"><entryLinks><entryLink id="78d02d76-949e-57a4-be24-7c9ff8cc7e6b" name="Scar: Warped Keel (1)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="e8883d4e-3ac3-52fb-b2b4-7aac3be72df8" /><entryLink id="e400c160-bc9f-5b3e-b44a-b4b1108a5295" name="Scar: Scarred Plate (2)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="92329a1d-0356-5f74-b0c4-a6fe87b6ed91" /><entryLink id="44236349-a0d7-5e6f-bb1d-ada3694acb56" name="Scar: Ruined Gun Deck (3)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="6f159232-7885-576c-827f-b1eb3770d5b0" /><entryLink id="f364594b-c099-58bd-837c-1bd31dd9e861" name="Scar: Cracked Reactor (4)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="44cbea77-b505-5ce6-bc03-ff7629eeb7b5" /><entryLink id="3ffb49af-0f4e-507b-9d9c-a096e5c952b9" name="Scar: Thinned Complement (5)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="74d0dcba-3c78-5baa-bbec-103a5f264bb3" /><entryLink id="ab9d327e-a8e4-5695-9376-e022375cc71c" name="Scar: Haunted Decks (6)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="f87d2855-77a3-5740-bcd1-c6733c72332e" /></entryLinks></selectionEntryGroup></selectionEntryGroups></selectionEntryGroup></selectionEntryGroups>
 <costs>
 <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="140.0" />
 </costs>
 </selectionEntry>
 <selectionEntry id="336ead29-6f73-545d-bdd0-063ed90f5850" name="Battleship" hidden="false" collective="false" import="true" type="unit">
 <constraints><constraint type="max" value="3.0" field="selections" scope="roster" shared="false" id="970ed690-7958-5085-a15c-bf111f0fb74d" percentValue="false" includeChildSelections="false" includeChildForces="true" /></constraints><profiles>
 <profile id="34660a2c-e2d5-5bd2-88af-470c25627b1d" name="Battleship" hidden="false" typeId="806f9ff1-fd51-5ddb-b005-ce73a5d09d65" typeName="Ship">
 <characteristics>
 <characteristic name="BS" typeId="d130e705-611e-5a0a-bd7d-ea8e848fdb2e">3</characteristic>
 <characteristic name="Prow" typeId="84a55377-edbc-5825-a2bf-70c6155018f2">14</characteristic>
 <characteristic name="Side" typeId="5f595433-7397-5c4b-9d4a-8f35d83a2b29">13</characteristic>
 <characteristic name="Stern" typeId="cd9ec76e-f959-5560-8845-9ab242f16e71">12</characteristic>
 <characteristic name="HP" typeId="ef713781-2034-5fb4-83d1-e49d1d683694">13</characteristic>
 <characteristic name="VS" typeId="84309751-688d-50ef-8940-d8d042261a56">8</characteristic>
 <characteristic name="Speed" typeId="25d0e01e-8e74-55b3-8a2a-17773c881625">8″</characteristic>
 <characteristic name="Turn" typeId="899e9c58-70ef-5da5-8495-5bf6a8b7f8f0">45°</characteristic>
 <characteristic name="Crew" typeId="2f6312dd-493e-53c6-96e2-d901afca0e81">8</characteristic>
 </characteristics>
 </profile>
 <profile id="d4e7ed23-50ac-5882-84a6-4994b2eee74a" name="Bulwark of the Line" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Enemy Damage Table rolls against this ship suffer −1.</characteristic>
 </characteristics>
 </profile>
 <profile id="d18c60a1-4c06-55e0-bddc-3948261797af" name="Boarding Forces Validation" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding forces are bought against the ship’s Crew. Terminator/Dreadnought class limits are enforced; remember a Contemptor occupies 2 Crew slots.</characteristic>
 </characteristics>
 </profile>
 <profile id="63cc4575-d831-5a62-b8ed-1ccaede233bc" name="Hardpoint Construction" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Bare chassis. Every mounted weapon is purchased separately. No upgrade-spend ceiling. Legal choices are controlled by hull class, hardpoint type and facing; each hardpoint must contain exactly one weapon.</characteristic>
 </characteristics>
 </profile>
 <profile id="283ac08f-9c72-521a-87d0-1a9a2805621b" name="Mount Capacity" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Port: 3 · Port Heavy: 2 · Starboard: 3 · Starboard Heavy: 2 · Prow Ordnance: 4 · Prow Super-Heavy: 1 · Dorsal: 4 · Defence: 8 · Hangar: 2</characteristic></characteristics></profile><profile id="c9ae98c6-e085-569a-ba12-412cd850512c" name="Hardpoint Configuration" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ships begin with no weapons or Defence Batteries selected. Hangar Bay slots represent built-in hull capacity and cost 0 pts. Each physical hardpoint may take at most one legal component. There is no separate upgrade-spend cap; the hull's mount layout is the limit.</characteristic></characteristics></profile><profile id="7a5faa76-37dc-530c-bbe6-0a18414318e7" name="Roster Builder Summary" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Crew 8 · Port 3 · Port Heavy 2 · Starboard 3 · Starboard Heavy 2 · Prow Ordnance 4 · Prow Super-Heavy 1 · Dorsal 4 · Defence 8 · Hangars 2. Ships start unequipped. Fill only the weapon and Defence hardpoints you want to purchase; each may contain at most one component. Hangar Bay slots cost 0 pts. Aircraft are purchased separately up to Hangar capacity.</characteristic></characteristics></profile></profiles>
 <rules><rule id="27c0f295-c567-598c-adb0-d3a844a5be41" name="Gets Hot" hidden="false"><description>After a Lance Turret or Lance Battery resolves its attacks, roll a D6. On a 1 the firing ship loses 1 Hull Point. Each mount rolls separately.</description></rule><rule id="4473edf8-3efe-58f0-96d6-131433f72d5c" name="Twin-Linked" hidden="false"><description>Re-roll failed To Hit rolls.</description></rule><rule id="8fcdff2a-0de6-5e8f-b217-197077a7ce81" name="Capital Ship" hidden="false"><description>Counts as a Capital Ship for every rule that names one, and fills a Capital slot.</description></rule><rule id="2b659095-6dd2-5ee5-bc1d-e7419b8c39bf" name="Reload (X)" hidden="false"><description>After firing, place X Reload tokens on the mount; flip one at the end of each battle round. The mount cannot fire while it bears a token.</description></rule><rule id="953a434c-e7b9-51da-8bea-f0219b3fdeaa" name="Devastating (X)" hidden="false"><description>Each hit costs X Hull Points, or 1 Void Shield Rating against live shields.</description></rule><rule id="cd358c66-f5b0-5465-9e9c-65fbc9760cb7" name="Armourbane" hidden="false"><description>Roll 2D6 + Strength to penetrate instead of 1D6, at 6″ or less, against shields or hull alike.</description></rule><rule id="aecae2f4-bb61-5977-a863-e5d1a646c3a9" name="Point-Blank Broadsides" hidden="false"><description>At 6″ or less, Port, Starboard and Dorsal weapons improve AP by one step — or gain Armourbane instead if their printed AP is already 1. Prow weapons get neither.</description></rule><rule id="72d2dcae-ff7a-57b3-bf38-4e4948c69efc" name="Crippled" hidden="false"><description>Below half starting Hull Points: −1 BS and half Speed.</description></rule><rule id="f713276a-149c-5ff8-955d-b222075aa2a0" name="Depleted" hidden="false"><description>At half starting Crew or less: −1 BS. Stacks with Crippled.</description></rule><rule id="d608ee2d-4337-5fcb-9b95-53a3928166cd" name="Locked" hidden="false"><description>Joined by a ram. Neither ship may move; the rammer may not fire on its victim, who fires back at −1 BS. Break Away on 5+.</description></rule><rule id="c1e525d2-b212-557c-9e2b-c37a15dbca04" name="Snap Shots" hidden="false"><description>Firing at BS 1 — hits only on a 6.</description></rule><rule id="c8b65c5c-cce4-5058-8b89-f2a1243547a8" name="Wreck" hidden="false"><description>0 Hull Points without exploding. Becomes impassable, obscuring terrain; never moves and never Evades.</description></rule><rule id="729dd23b-f229-5de5-8358-e6daff5cd4f0" name="Held station" hidden="false"><description>Moved 1″ or less under Burn Retros. Broadsides fire at +1 BS; −1 on Evade.</description></rule></rules><categoryLinks>
 <categoryLink id="aa8556d3-ffc6-54ef-b02c-a3a148e9af2e" name="Capital Ship" hidden="false" targetId="bd422ebf-10b3-5085-89cc-263568c40fe0" primary="false" />
 <categoryLink id="3cff4d8d-be6b-5766-949a-90cf86b1f1b4" name="Open Play Fleet" hidden="false" targetId="f4a1bdc9-d680-5abd-a007-4b0b71797ecd" primary="false" /><categoryLink id="a4a49c30-7d27-5dfa-80af-274e15e6de8f" name="Campaign Fleet" hidden="false" targetId="69270169-f826-5f6c-8c3d-26f416055ec0" primary="true" /></categoryLinks>
 <selectionEntryGroups>
 <selectionEntryGroup id="688badef-da98-5451-8c64-e98117a83623" name="Fleet Role" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="4c799b57-f613-546d-bf6f-4550521aec15" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="c3a29dbf-7ba8-5c9e-a7f4-337ce582d83e" name="Designate as Flagship" hidden="false" collective="false" import="true" type="upgrade"><profiles><profile id="405cf649-050e-5c28-8e2e-b1e1612b1167" name="Commander Embarkation" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander here. The Commander is embarked on this Flagship.</characteristic></characteristics></profile></profiles><rules><rule id="5c734e0d-b45c-5ff9-878c-2a835674aa51" name="Flagship" hidden="false"><description>This ship is the fleet's Flagship. Exactly one Flagship is required in a standard fleet.</description></rule></rules><categoryLinks><categoryLink id="abcda053-a65e-5f51-b1c4-eeb0f8d1f95e" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" /></categoryLinks><selectionEntryGroups><selectionEntryGroup id="f3a59be0-d2e8-589f-ace8-20b2ea18ce27" name="Fleet Commander" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="50245035-bfbc-5b91-bf22-cfd8129cdedf" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="eb2377bf-560f-53d6-b893-b363be5df1af" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="b48723be-20ba-54fc-abf9-1364610d9286" name="Fleet Captain" hidden="false" collective="false" import="true" type="upgrade">
 <constraints>
 <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="83096c0b-16eb-521d-9874-0707ecd91da3" type="max" />
 </constraints>
 <profiles>
 <profile id="ee6f25a5-7cc9-501a-992a-723c364b7697" name="Fleet Captain" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Fleet Captain. 1 Fleet Order of each type each battle round. Ship’s Master: once per battle, the Flagship may re-roll a single failed Evade roll.</characteristic>
 </characteristics>
 </profile>
 </profiles>
 <categoryLinks>
 <categoryLink id="c16e1320-f522-5fed-a4c4-b4e00149ae3d" name="Commander" hidden="false" targetId="6f3339ad-23a9-5687-b08f-3f11a43fe50b" primary="true" />
