 <selectionEntryGroups>
 <selectionEntryGroup id="1fe5ac7b-f6ec-586c-83d9-39463cc4b478" name="Fleet Role" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="26241e86-2735-5323-a7f6-7a8d733d7010" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="326d708f-6b24-5f6c-918b-6fed96496953" name="Designate as Flagship" hidden="false" collective="false" import="true" type="upgrade"><profiles><profile id="f1721f74-0944-50b6-9699-5f1a3eac86ac" name="Commander Embarkation" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander here. The Commander is embarked on this Flagship.</characteristic></characteristics></profile></profiles><rules><rule id="ac6c8334-1f58-587a-a260-638d7d0b0e06" name="Flagship" hidden="false"><description>This ship is the fleet's Flagship. Exactly one Flagship is required in a standard fleet.</description></rule></rules><categoryLinks><categoryLink id="1c6dda11-6768-5a3c-8d0c-043115730bee" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" /></categoryLinks><selectionEntryGroups><selectionEntryGroup id="a3abfb46-f8da-557f-a519-6b0a312365bc" name="Fleet Commander" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="74b5b337-0793-59b8-9baf-014646cfbae2" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="49f9e287-bd47-5169-9dd9-d34ccf8fb390" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="92278080-aa94-5bbf-899d-6d1b497b10fc" name="Fleet Captain" hidden="false" collective="false" import="true" type="upgrade">
 <constraints>
 <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="aa38cf8c-5f10-52fd-b904-dd3bd259f268" type="max" />
 </constraints>
 <profiles>
 <profile id="710a948f-2b92-5442-a0e8-02161366e2a8" name="Fleet Captain" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Fleet Captain. 1 Fleet Order of each type each battle round. Ship’s Master: once per battle, the Flagship may re-roll a single failed Evade roll.</characteristic>
 </characteristics>
 </profile>
 </profiles>
