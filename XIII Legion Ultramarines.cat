        <profile id="18b7de86-b06e-50ed-89d3-d6e836927d9d" name="Gloriana Common Rules" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">A Primarch’s Flagship: Leadership 10; never suffers the Crippled −1 BS penalty; must be the Flagship; one per battle; games of 2,000+ points. Gloriana Reactors: once per battle, when VS would reach 0 it remains at 1. Dorsal Lance Batteries fire into all arcs and never Gets Hot. Heavy Macrobatteries use Reload (1). Armament fixed: no Section 11b refits.</characteristic>
          </characteristics>
        </profile>
        <profile id="947cac8f-f271-5fce-81a3-fd34c028d8f1" name="Perfect Coordination" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Flagship Fleet Orders have unlimited range and she may issue one additional Fleet Order each phase, to the fleet ceiling of four. Hangar Bays (4).</characteristic>
          </characteristics>
        </profile>
        <profile id="2fbc0f3f-95b1-5ccb-8e3b-ba35bf7de1b6" name="Hangar Loadout Validation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Maximum 4 aircraft squadrons: one per Hangar Bay.</characteristic>
          </characteristics>
        </profile>
        <profile id="e296aac0-d938-5259-8592-9d750d65de1a" name="Boarding Forces Validation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding forces are bought against the ship’s Crew. Terminator/Dreadnought class limits are enforced; remember a Contemptor occupies 2 Crew slots.</characteristic>
          </characteristics>
        </profile>
        <profile id="fe04fc85-551f-5c38-a014-1c0d22e4da7a" name="Mount Capacity" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Port: 4 | Starboard: 4 | Prow: 4 | Dorsal: 7 | All-round: 10 | Hangar Bays: 4. Mounts, not arbitrary refit counts, are the limiting factor for weapon configuration.</characteristic>
          </characteristics>
        </profile>
      <profile id="60665c93-b1c4-403c-a618-379964da4d4c" name="Commander Embarkation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander. This character is embarked aboard this Flagship.</characteristic></characteristics></profile><profile id="857f633f-de21-4268-9e1e-8f4446d74d41" name="Retinue Eligibility" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">The Primarch Retinue slot may only be used when the Primarch is selected as this ship's Fleet Commander. Choose at most one named Character of the same Legion.</characteristic></characteristics></profile><profile id="5d0c40f0-930c-440b-b276-cfc763c703a6" name="Roster Builder Summary" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Crew 10. Ships start unequipped. Fill only the weapon and Defence hardpoints you want to purchase; each may contain at most one component. Hangar Bay slots cost 0 pts. Aircraft are purchased separately up to Hangar capacity.</characteristic></characteristics></profile></profiles>
      <categoryLinks>
        <categoryLink id="da9c3fdf-dc9d-5f67-b1d6-2304b52fe364" name="Capital Ship" hidden="false" targetId="bd422ebf-10b3-5085-89cc-263568c40fe0" primary="true" />
        <categoryLink id="49dce166-7fc1-5650-ab71-444c9dde9321" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" />
