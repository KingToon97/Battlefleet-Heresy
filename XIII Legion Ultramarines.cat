      <selectionEntryGroups>
        <selectionEntryGroup id="709a6f5c-c2df-4c40-acd8-6d41071256f2" name="Fleet Role" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="8e9f5996-3843-41c9-9110-fcc4f416784b" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="d47eecad-8fb8-4112-8788-aa4685178360" name="Designate as Flagship" hidden="false" collective="false" import="true" type="upgrade"><profiles><profile id="11c42fff-ed16-444d-9355-33a3c8b497db" name="Flagship" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship is the fleet's Flagship. Exactly one Flagship is required in a standard fleet.</characteristic></characteristics></profile><profile id="6953b2e4-7f70-4458-a560-d101b69f79b7" name="Commander Embarkation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander here. The Commander is embarked on this Flagship.</characteristic></characteristics></profile></profiles><categoryLinks><categoryLink id="040e33a5-c33e-45ad-a8b3-ace98eff76c4" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" /></categoryLinks><selectionEntryGroups><selectionEntryGroup id="049b8e35-d1dd-4cee-8ea9-d737dcf9ca72" name="Fleet Commander" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="2444b71b-5cc5-4b9d-b922-902e8cb4a52a" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="51918a23-f038-4ddd-8e00-bf4