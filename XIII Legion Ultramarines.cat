    <profiles>
        <profile id="e79c72e0-73b8-4d7a-b818-ff5209ebca2e" name="Marius Gage" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Increase Command range by 12″ to 36″; one additional ship may receive an Order each phase.</characteristic>
          </characteristics>
        </profile>
      <profile id="95709192-a3ea-4405-9140-9b2d4137e9a9" name="Primarch Retinue" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This character is embarked as the Primarch's additional named retinue. They do not add Fleet Orders, Command range or Leadership; only effects unrelated to the order economy apply.</characteristic></characteristics></profile></profiles>
