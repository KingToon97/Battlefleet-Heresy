  <selectionEntries>
    <selectionEntry id="cd897248-882f-5b2d-a889-d5b044bc5bcf" name="Escort Squadron" hidden="false" collective="false" import="true" type="unit">
      <profiles><profile id="3b0c4f4a-2d79-4761-ad9c-b24ffbce72df" name="Mount Capacity" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Port: 1 · Starboard: 1 · Prow Ordnance: 1 · Defence: 1</characteristic></characteristics></profile><profile id="e21aa662-8bd5-4357-99a2-3694fa128a3f" name="Hardpoint Configuration" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ships begin with no weapons or Defence Batteries selected. Hangar Bay slots represent built-in hull capacity and cost 0 pts. Each physical hardpoint may take at most one legal component. There is no separate upgrade-spend cap; the hull's mount layout is the limit.</characteristic></characteristics></profile><profile id="ea4e83ad-c5ce-4f19-be90-6ca43e39c2da" name="Roster Builder Summary" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Crew 2. Ships start unequipped. Fill only the weapon and Defence hardpoints you want to purchase; each may contain at most one component. Hangar Bay slots cost 0 pts. Aircraft are purchased separately up to Hangar capacity.</characteristic></characteristics></profile></profiles><categoryLinks>
        <categoryLink id="167e57237ae9dd88f7755c723b194897" name="Line Ship" hidden="false" targetId="96572996-e9b1-54a7-a2a9-2108e1dfc993" primary="true" /></categoryLinks>
