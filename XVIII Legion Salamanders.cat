        <selectionEntryGroup id="5856aff392511ca79c47f16b82e4308c" name="Hull Upgrades" hidden="false"><constraints><constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="48d923a1-da71-5fdd-b3be-1e2985e3154e" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="1dbeac5e93a521b0dcd464ff28d14e45" name="Side Armour Reinforcement" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="aae7c799eba0fed1700b0aeab90de1a0" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="b719d5d1920a39f6b5869ccb5ef1cc8e" name="Side Armour Reinforcement" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="120.0" /></costs></selectionEntry><selectionEntry id="8a86f75907a2c9b88cb03ed4e209797e" name="Engine Refit" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="c7686f85fc0fbc8915dc650f22f5f7f3" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="acec4ab401503c9205627319cc6afdc1" name="Engine Refit" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="100.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
