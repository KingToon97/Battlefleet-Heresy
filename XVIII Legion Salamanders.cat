      <selectionEntryGroups>
        <selectionEntryGroup id="349e372f-d28b-4e56-855d-6c5ec3c690b3" name="Fleet Role" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="07e4bc08-c052-48c2-a1ee-d63023a269a6" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="274a5500-246e-4b34-88f1-3a5c102509c1" name="Designate as Flagship" hidden="false" collective="false" import="true" type="upgrade"><profiles><profile id="6b5837cf-eabf-4f77-8d8e-131c9ff9f12b" name="Flagship" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship is the fleet's Flagship. Exactly one Flagship is required in a standard fleet.</characteristic></characteristics></profile><profile id="bdbfeab2-a671-4c7b-8588-d143de4477c1" name="Commander Embarkation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander here. The Commander is embarked on this Flagship.</characteristic></characteristics></profile></profiles><categoryLinks><categoryLink id="d8e16b9a-7a57-4767-830e-a3fb66b0676a" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" /></categoryLinks><selectionEntryGroups><selectionEntryGroup id="3f99f580-76d0-4b16-8054-0b5d14e28abc" name="Fleet Commander" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="fbdb7234-7282-4570-b068-7ef26e4e7c86" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="623229ee-6fe9-4d0c-8909-fd1