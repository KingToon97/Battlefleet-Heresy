        <profile id="9e37c55a-38ca-590d-96d3-773d2e785bc4" name="Gloriana Common Rules" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">A Primarch’s Flagship: Leadership 10; never suffers the Crippled −1 BS penalty; must be the Flagship; one per battle; games of 2,000+ points. Gloriana Reactors: once per battle, when VS would reach 0 it remains at 1. Dorsal Lance Batteries fire into all arcs and never Gets Hot. Heavy Macrobatteries use Reload (1). Armament fixed: no Section 11b refits.</characteristic>
          </characteristics>
        </profile>
        <profile id="1a348a5e-23ec-5900-9b7f-60b9086ca3d5" name="Master Artisans" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Bombardment Cannons and Arrays aboard gain a further +1 on Damage Table. Hangar Bays (4).</characteristic>
          </characteristics>
        </profile>
        <profile id="e8bf8bf5-e396-53a1-b6b5-11c3fc19be66" name="Hangar Loadout Validation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Maximum 4 aircraft squadrons: one per Hangar Bay.</characteristic>
          </characteristics>
        </profile>
        <profile id="d18f12d8-7966-5b4f-842a-53d783947eb1" name="Boarding Forces Validation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding forces are bought against the ship’s Crew. Terminator/Dreadnought class limits are enforced; remember a Contemptor occupies 2 Crew slots.</characteristic>
          </characteristics>
        </profile>
        <profile id="7a189ca4-a93c-53eb-bf55-910c010286d8" name="Mount Capacity" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Port: 6 | Starboard: 6 | Dorsal: 6 | All-round: 8 | Hangar Bays: 4. Mounts, not arbitrary refit counts, are the limiting factor for weapon configuration.</characteristic>
          </characteristics>
        </profile>
      <profile id="19d4e0d7-0a70-49be-9d4c-7c43e8ced183" name="Commander Embarkation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander. This character is embarked aboard this Flagship.</characteristic></characteristics></profile><profile id="7f5d3983-078d-4b17-b735-2ab1aa0b2363" name="Retinue Eligibility" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">The Primarch Retinue slot may only be used when the Primarch is selected as this ship's Fleet Commander. Choose at most one named Character of the same Legion.</characteristic></characteristics></profile><profile id="8642c45c-da63-4490-b970-89922315c3d3" name="Roster Builder Summary" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Crew 10. Ships start unequipped. Fill only the weapon and Defence hardpoints you want to purchase; each may contain at most one component. Hangar Bay slots cost 0 pts. Aircraft are purchased separately up to Hangar capacity.</characteristic></characteristics></profile></profiles>
      <categoryLinks>
