            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding parties gain +1 if charging from Thunderhawks or Assault Claws.</characteristic>
          </characteristics>
        </profile>
      <profile id="0a94cb41-4a31-435f-96f2-42b6b00e116f" name="Primarch Retinue" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This character is embarked as the Primarch's additional named retinue. They do not add Fleet Orders, Command range or Leadership; only effects unrelated to the order economy apply.</characteristic></characteristics></profile></profiles>
