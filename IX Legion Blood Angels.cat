        <selectionEntryGroup id="220e4c4feef11cf80cbc897e05ea0699" name="Hull Upgrades" hidden="false"><selectionEntries><selectionEntry id="a1914ac76b76dc816de5950635c5e657" name="Side Armour Reinforcement" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="e21d9a20a598ac9c21c9c5eb8a845ee5" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="93a6dce959df88023f91ee29f1cace59" name="Side Armour Reinforcement" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="120.0" /></costs></selectionEntry><selectionEntry id="56a0ac9789edb7b3b620e3a183ac1b3f" name="Engine Refit" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="390a5cf765d48c6d39ee3f9b8f0592a7" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="c3bc389088c662c7215cc0f0883f5b1e" name="Engine Refit" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="100.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
