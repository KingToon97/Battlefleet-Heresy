        <profile id="9014efba-cfd1-531d-80c4-90b9225dbf35" name="Defence Battery ×10" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
          <characteristics>
