hared="false" id="48da9c48-1aca-5257-8d0a-6ab9b9eccfa5" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="d09de1b1-2afe-560a-8f37-0444ad4aed8e" name="Triple Lance Battery Upgrade" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Her dorsal Lance Batteries each fire 3 shots rather than 2. The heavier feed is a hazard: whenever the ship suffers a Magazine Explosion it loses 1 additional Hull Point.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="75.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
