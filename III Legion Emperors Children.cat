        <selectionEntryGroup id="8d2e3be4d54e290a6fb0079c203ccf7b" name="Hull Upgrades" hidden="false"><selectionEntries><selectionEntry id="4dbe5da30f5aa13128ee0cbd5ba9783b" name="Side Armour Reinforcement" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="5e9fb40041b5cea86e8766bd6bc28b16" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="da53e3b4244074dcadf81fed663fcaa5" name="Side Armour Reinforcement" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="120.0" /></costs></selectionEntry><selectionEntry id="980ee0e77c07a1d36127fbca1aaca4e7" name="Engine Refit" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="41d8f517118ca6b7217495840cfc653c" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="56881bdc6c59ada21c5045c7791a7922" name="Engine Refit" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="100.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
