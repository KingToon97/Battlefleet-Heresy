            <characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Prow</characteristic>
            <characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">10</characteristic>
            <characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">1</characteristic>
            <characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">4</characteristic>
            <characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">48″</characteristic>
            <characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Twin-Linked, Reload (2), Devastating (2); re-roll failed hits a second time</characteristic>
          </characteristics>
