    <selectionEntryGroup id="487d34c9-8ddd-5d26-a0e4-9fea0ccefa1f" name="Hull Upgrades" hidden="false">
     <constraints>
      <constraint type="max" value="6.0" field="selections" scope="parent" shared="false" id="39133a76-3c35-5a7f-8bcb-f9a1c2417cf6" percentValue="false" includeChildSelections="false" includeChildForces="false" />
     </constraints>
     <selectionEntries>
      <selectionEntry id="c5eb6fd4-d2fa-54cb-8062-abc3d0935b3d" name="Adamantium Belt Armour" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="2ae05a79-8001-5749-a80f-6a2aa644d6bf" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="470c7603-29a4-51be-a1d6-e4aa8f2d5dbb" name="Adamantium Belt Armour" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="30.0" />
       </costs>
      </selectionEntry>
      <selectionEntry id="19a02999-7f60-5613-8f8b-1582acae1e93" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="51e10eeb-17cd-5965-a334-e7c38bd45ee0" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="6bf45796-70e0-580e-91ea-0bed5725fc19" name="Plasma Drive Overhaul" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="20.0" />
       </costs>
      </selectionEntry>
      <selectionEntry id="7be09032-5b30-5b30-ab84-a2e734dcfcfa" name="Phosphex Shell Magazines" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="f16fbc2f-e17b-5fe0-91c7-1b644c44442c" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="3832c5bf-b755-5d87-897d-85a711f0d378" name="Phosphex Shell Magazines" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Every Heavy Macro-Cannon Battery aboard fires phosphex: whenever one penetrates armour, the target takes 1 Critical Damage. Requires at least one Heavy Macro-Cannon Battery. Every Death Guard Capital Ship carries Phosphex Shell Magazines free of charge.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="15.0" />
       </costs>
      </selectionEntry>
      <selectionEntry id="15e1c3fe-cd11-515a-a7d0-9d11bace2c69" name="Blast-Shielded Magazines" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="2869dd28-2ac9-59dc-a89d-dd581bc3fec0" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="2ed73e4a-1468-50bd-9e9d-d5e212557768" name="Blast-Shielded Magazines" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Damage Control caused by a Magazine Explosion by 1, to a minimum of 0. A Twin Lance Turret that would suffer 1 Damage Control instead suffers 0 and ignores the effect; a Triple Lance Turret that would suffer 2 instead suffers 1. No other effect of a Magazine Explosion is prevented or reduced. Once per ship. Not available to Gloriana class or above.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="15.0" />
       </costs>
      </selectionEntry>
      <selectionEntry id="0f1b9601-1456-5e1d-b9f5-42838b69c09f" name="Emergency Shield Capacitors" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="1d4da04f-d691-582a-87b6-7170d9c2b727" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="d9e17de6-71b1-5fc4-b0d7-227e22301c09" name="Emergency Shield Capacitors" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 to Void Shield regeneration rolls. It confers no other benefit and can never raise a ship above its normal number of Void Shields; a shield burnt out despite the bonus stays burnt out for the rest of the battle. Once per ship.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="15.0" />
       </costs>
      </selectionEntry>
      <selectionEntry id="9853a82b-a3f9-5822-8249-8d6545f101a2" name="Servitor Autoloaders" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="25392e91-9472-548b-950d-72b0b394f2cc" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="959a07e6-6018-5293-9c3e-8853861ec940" name="Servitor Autoloaders" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose one weapon type aboard this ship when you buy this upgrade and note it on the roster. That weapon type reduces its Reload value by 1, to a minimum of Reload (0) — Reload (3) becomes Reload (2), Reload (2) becomes Reload (1). A weapon at Reload (1) already fires every battle round and gains nothing. Once per ship. Not available to Gloriana class or above.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="30.0" />
       </costs>
      </selectionEntry>
     </selectionEntries>
    </selectionEntryGroup>
   </selectionEntryGroups>
   <costs>
    <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="160.0" />
   </costs>
  </selectionEntry>
