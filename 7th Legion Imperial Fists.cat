    <profile id="8f1e2605-85a2-5102-920c-133d2e50c018" name="The Praetorian Line" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Requires Rogal Dorn or Sigismund as Fleet Commander. Bastion of the VII: enemy Damage Table rolls suffer −1. Praetorian Gunnery: if held station, Heavy Macro-Cannon Batteries fire at +1 BS. Launch Bays (3).</characteristic>
     </characteristics>
    </profile>
    <profile id="b649c07d-ee39-5820-b6a8-904629eef774" name="Vortex Torpedo ×6" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
     <characteristics>
      <characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Prow</characteristic>
      <characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">12</characteristic>
      <characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">D</characteristic>
      <characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1 each</characteristic>
      <characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">60″</characteristic>
      <characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">One Shot; Devastating (3); Volatile. Bypasses Void Shields entirely, resolving against the hull facing struck. Prow mount only</characteristic>
     </characteristics>
    </profile>
