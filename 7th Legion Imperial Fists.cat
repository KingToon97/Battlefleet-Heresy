     <selectionEntries>
      <selectionEntry id="3dd4da55-e699-5dc4-a762-d4ce94792bd7" name="Adamantium Belt Armour" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="313013a0-a48b-5770-a066-be753e4b106d" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="6867f384-16b1-5200-97e8-5b4c9719872d" name="Adamantium Belt Armour" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="60.0" />
       </costs>
      </selectionEntry>
      <selectionEntry id="26b4d56d-4b79-5190-ad25-3f5a347d5667" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="04f3de12-0031-511f-9cf5-6f0dc613a3e6" shared="false" includeChildSelections="false" />
