      <selectionEntry id="a20ffe1e-680f-5469-9b6a-7cbdf9c520b9" name="Huscarls" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="41b1d8f4-14d1-5298-baa1-2136fc794f5c" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="61548f79-f213-51ef-a354-6c20503a62ad" name="Huscarls" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">One Crew point; +2 to its boarding die. Maximum 1 per ship, and it does not count against the Terminator limit. While this unit is aboard, the ship's Crew may not be reduced below 1 by boarding.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <categoryLinks>
        <categoryLink id="78b23f43-7556-5d04-aa42-232d0f68f403" name="Boarding Force" hidden="false" targetId="4d94b920-d5bc-5fd7-a967-4ba346019f56" primary="true" />
