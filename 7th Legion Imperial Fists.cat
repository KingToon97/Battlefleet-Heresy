         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Character. Void Fortress: Once per battle round, this ship reduces the Hull Points lost from one enemy attack by 1, to a minimum of 1.</characteristic>
         </characteristics>
        </profile>
        <profile id="d353fb4f-9078-4014-b4a6-b935171a56bb" name="Primarch Retinue" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This character is embarked as the Primarch's additional named retinue. They do not add Fleet Orders or any command ability; only effects unrelated to the order economy apply.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <categoryLinks>
