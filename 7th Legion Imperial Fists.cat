      <selectionEntry id="edf3b6bc-88ae-50b7-812c-b1ef99bf1ce8" name="Huscarls" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="472a8c5a-0ec4-51ad-9240-82a059f8ece1" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="a06f6aea-a6c7-5e3f-9167-5f064d04120b" name="Huscarls" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">One Crew point; +2 to its boarding die. Maximum 1 per ship, and it does not count against the Terminator limit. While this unit is aboard, the ship's Crew may not be reduced below 1 by boarding.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <categoryLinks>
        <categoryLink id="168de1bc-c558-5dcf-8f69-11f33106299c" name="Boarding Force" hidden="false" targetId="4d94b920-d5bc-5fd7-a967-4ba346019f56" primary="true" />
       </categoryLinks>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="65.0" />
       </costs>
      </selectionEntry>
     </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="61784437-2345-549f-bf71-edacbf536f37" name="Hull Upgrades" hidden="false">
     <constraints>
      <constraint type="max" value="6.0" field="selections" scope="parent" shared="false" id="107c8fdb-8111-5e3a-8f81-edc6a76b9171" percentValue="false" includeChildSelections="false" includeChildForces="false" />
