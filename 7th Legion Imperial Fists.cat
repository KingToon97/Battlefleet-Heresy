      <selectionEntryGroup name="Hull Upgrades" id="d91eee50-5b9b-5341-b546-e7c503707de3" hidden="false" collective="false" import="true">
       <constraints>
        <constraint type="max" value="5.0" field="selections" scope="parent" shared="false" id="5fc28bc9-d40b-57da-88f8-0a9d2977f230" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <selectionEntries>
        <selectionEntry id="34481da4-4b8c-5982-93c8-6e04dec5476a" name="Blast-Shielded Magazines" hidden="false" collective="false" import="true" type="upgrade">
         <constraints>
          <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="12171dc6-3de8-5b2a-9532-41956a9de3eb" percentValue="false" includeChildSelections="false" includeChildForces="false" />
         </constraints>
         <profiles>
          <profile id="bd07be7e-601d-5874-9875-7ca9d34ddbe4" name="Blast-Shielded Magazines" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
           <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Damage Control caused by a Magazine Explosion by 1, to a minimum of 0. A Twin Lance Turret that would suffer 1 Damage Control instead suffers 0 and ignores the effect; a Triple Lance Turret that would suffer 2 instead suffers 1. No other effect of a Magazine Explosion is prevented or reduced. Once per ship. Not available to Gloriana class or above.</characteristic>
           </characteristics>
          </profile>
         </profiles>
         <costs>
          <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" />
         </costs>
        </selectionEntry>
        <selectionEntry id="01e46c07-9e8d-569f-9e7f-38aa2229bfc3" name="Emergency Shield Capacitors" hidden="false" collective="false" import="true" type="upgrade">
         <constraints>
          <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="f021918b-a89c-5975-a710-2cbac6a807b4" percentValue="false" includeChildSelections="false" includeChildForces="false" />
         </constraints>
         <profiles>
          <profile id="6109dbde-c344-59fe-b623-cf887ba02728" name="Emergency Shield Capacitors" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
           <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 to Void Shield regeneration rolls. It confers no other benefit and can never raise a ship above its normal number of Void Shields; a shield burnt out despite the bonus stays burnt out for the rest of the battle. Once per ship.</characteristic>
           </characteristics>
          </profile>
         </profiles>
         <costs>
          <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" />
         </costs>
        </selectionEntry>
        <selectionEntry id="7509c524-613e-5be4-b4f9-5a0b44110f65" name="Servitor Autoloaders" hidden="false" collective="false" import="true" type="upgrade">
         <constraints>
          <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="3d6c0ecc-7c3d-53ea-9a8b-ff4f773f708a" percentValue="false" includeChildSelections="false" includeChildForces="false" />
         </constraints>
         <profiles>
          <profile id="a34ea7a2-4db4-574b-aaf6-d70557dd5f66" name="Servitor Autoloaders" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
           <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose one weapon type aboard this ship when you buy this upgrade and note it on the roster. That weapon type reduces its Reload value by 1, to a minimum of Reload (0) — Reload (3) becomes Reload (2), Reload (2) becomes Reload (1). A weapon at Reload (1) already fires every battle round and gains nothing. Once per ship. Not available to Gloriana class or above.</characteristic>
           </characteristics>
          </profile>
         </profiles>
         <costs>
          <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" />
         </costs>
        </selectionEntry>
        <selectionEntry id="82430f0a-c7c1-537d-b6b2-ef91787c6bca" name="Adamantium Belt Armour" hidden="false" collective="false" import="true" type="upgrade">
         <constraints>
          <constraint field="selections" scope="parent" value="1.0" type="max" id="d8d4e463-0dc8-5a45-9837-3bb6f33b7f8c" shared="false" includeChildSelections="false" />
         </constraints>
         <profiles>
          <profile id="058e2d6b-adbe-5ffa-aebb-cbb1eb596d7b" name="Adamantium Belt Armour" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
           <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic>
           </characteristics>
          </profile>
         </profiles>
         <costs>
          <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" />
         </costs>
        </selectionEntry>
        <selectionEntry id="87f68aa1-07ca-5583-9416-d35f82d60c4d" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
         <constraints>
          <constraint field="selections" scope="parent" value="1.0" type="max" id="d3a3194b-e572-5bbc-9b9b-59fece0dd7f0" shared="false" includeChildSelections="false" />
         </constraints>
         <profiles>
          <profile id="40f918cd-8697-5ef3-b4b2-666cdc312b33" name="Plasma Drive Overhaul" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
           <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic>
           </characteristics>
          </profile>
         </profiles>
         <costs>
          <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" />
         </costs>
        </selectionEntry>
       </selectionEntries>
      </selectionEntryGroup>
