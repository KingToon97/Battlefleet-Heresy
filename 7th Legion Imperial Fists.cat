    <profile id="b70bf92a-934d-5891-9c14-dcd4b456cfdb" name="Launch Bays (6)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship carries 6 Launch Bays, sited on her broadsides. Each holds one aircraft squadron, bought separately. See Launch Bays &amp; Aircraft.</characteristic>
     </characteristics>
    </profile>
    <profile id="2378fad9-376a-5f1f-a5f6-a8264fce77f0" name="Bastion of Terra" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ship Type: Void Fortress. Imperial Fists only, and only at 3,000 points or more. This ship ignores the Crippled and Depleted −1 BS penalties, and every enemy attack against her suffers −1 on its Damage Table rolls. Rolling Barrage: only one broadside may fire each battle round, chosen as she shoots; that broadside may not fire in her next. Defence Batteries are exempt.</characteristic>
     </characteristics>
    </profile>
   </profiles>
   <infoLinks>
    <infoLink id="0a75b7db-9180-5fc6-b967-8612667365d8" name="Void Shields" hidden="false" type="rule" targetId="770afd1f-4a8d-537a-8e05-7698eb2f9ed2" />
   </infoLinks>
   <rules>
    <rule id="517e3e9b-04c2-5936-89d7-b9d41f0df5e9" name="Void Fortress" hidden="false">
     <description>Imperial Fists only; requires Rogal Dorn; games 3,000+ points. Four 90° broadside facings; Rolling Barrage: only one facing may fire each battle round, and a facing that fired may not fire in the Phalanx's next round. Defence Batteries may fire, Interceptor and Overwatch from any facing at any time. No Stern; cannot suffer Stern Strike. Enemy Damage Table rolls −1; never suffers Crippled −1 BS. Explodes on 5+, radius 3D6″. Launch Bays (6). Armament fixed.</description>
    </rule>
   </rules>
   <categoryLinks>
    <categoryLink id="8b2e9012-e664-5a77-b895-435543cf5d76" name="Capital" hidden="false" targetId="bd422ebf-10b3-5085-89cc-263568c40fe0" primary="false" />
    <categoryLink id="a9c6f799-ab68-5ca3-928f-ba93eacfdbd9" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" />
