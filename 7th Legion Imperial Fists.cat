     </constraints>
     <selectionEntries>
      <selectionEntry id="d71d8266-8a39-5ecd-b6ca-5ea4d4b2707f" name="Dreadclaw Drop Pod" hidden="false" collective="false" import="true" type="upgrade">
       <profiles>
        <profile id="6ae8bdca-b688-573d-9b98-971823c0d7b0" name="Dreadclaw Drop Pod" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding pod, Armour 8, Speed 30″/round. Takes 1 rail. Launched at a target within 18″, striking the same turn. One Shot. Counts as aircraft and may be intercepted; a surviving pod locks on 2+, and on a failure is destroyed with all aboard. Delivers 1 Crew of boarders (+1 in the first round). Removed from play after its run.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" />
       </costs>
      </selectionEntry>
      <selectionEntry id="aa6534df-26b7-5089-b694-50f98f6714b6" name="Kharybdis Assault Claw" hidden="false" collective="false" import="true" type="upgrade">
       <profiles>
        <profile id="f27f73df-a5ed-5066-a3ea-dcc4a63fc19d" name="Kharybdis Assault Claw" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding pod, Armour 9, Speed 30″/round. Takes 2 rails and locks automatically — melta cutters breach any hull — delivering 2 Crew of boarders (a Dreadnought filling both places). One Shot: removed from play after its run.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" />
       </costs>
      </selectionEntry>
     </selectionEntries>
    </selectionEntryGroup>
