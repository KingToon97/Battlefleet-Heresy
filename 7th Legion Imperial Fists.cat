     <selectionEntries>
      <selectionEntry id="bc658da4-5d01-5055-93ab-eed00c1840ac" name="Adamantium Belt Armour" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="3ffd571e-0a2f-5d45-8b9e-32e75cc2d6eb" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="f2ac942d-2348-5dab-95c3-967ba221f85b" name="Adamantium Belt Armour" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="85.0" />
       </costs>
      </selectionEntry>
      <selectionEntry id="0fef2eda-0bf1-5a9c-a3a5-2ec71128f3a6" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="12298e92-6ae6-56cb-8540-21f9f8446118" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="300f600e-fb5e-5782-8be0-03e585d005a5" name="Plasma Drive Overhaul" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="50.0" />
