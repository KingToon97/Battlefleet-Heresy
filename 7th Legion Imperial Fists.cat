       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="4e3bcb5c-18c9-57c0-83a8-06e44cc3b9d8" percentValue="false" includeChildSelections="false" includeChildForces="false" />
