      <selectionEntry id="e22d1b4b-d431-549e-9bff-bbcef56232e3" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="94563656-e82e-52c9-a5b2-feff009b706b" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="b0ad23a4-9b55-55b4-9a58-25040d8e14c9" name="Plasma Drive Overhaul" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="20.0" />
