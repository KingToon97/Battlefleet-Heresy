         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Character. Templar of the Fleet: This ship gains +1 to every boarding die in boarding actions it initiates, or +2 against an enemy Flagship.</characteristic>
         </characteristics>
        </profile>
        <profile id="fda97251-93cd-49a5-9551-e6a2609cc414" name="Primarch Retinue" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
