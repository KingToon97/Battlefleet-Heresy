       <categoryLinks>
        <categoryLink id="7aa385e6-1540-5c9f-b40a-f33d7039b4ea" name="Boarding Force" hidden="false" targetId="4d94b920-d5bc-5fd7-a967-4ba346019f56" primary="true" />
