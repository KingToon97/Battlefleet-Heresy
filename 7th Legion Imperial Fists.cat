        <profile id="16e23cf0-853c-578c-b61b-5bc4e105a2b9" name="Adamantium Belt Armour" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
