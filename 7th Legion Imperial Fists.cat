      <selectionEntry id="dfea4e25-9c74-5c35-b011-3897f9b3b55c" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="85928fcb-8b26-51f4-891f-f8d0d891db2f" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="2573fe08-cefb-5a6c-87e1-bc5789106cfd" name="Plasma Drive Overhaul" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="25.0" />
