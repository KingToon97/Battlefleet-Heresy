      <profile id="cfeb1a5e-03e5-4c95-affa-a15b4b7663d4" name="Primarch Retinue" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This character is embarked as the Primarch's additional named retinue. They do not add Fleet Orders, Command range or Leadership; only effects unrelated to the order economy apply.</characteristic></characteristics></profile></profiles>
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3bd7db78-1b16-4d98-8141-4ac1a12f6096" type="max" />
      </constraints>
    </selectionEntry>
    </selectionEntries><modifiers><modifier type="set" field="hidden" value="false"><conditions><condition field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="37dcaa18-b225-46c5-8ed2-f88ee7adf0d9" type="equalTo" /></conditions></modifier></modifiers></selectionEntryGroup></selectionEntryGroups>
    </selectionEntry>
    <selectionEntry id="a9698f94-9562-563b-a87e-53086b15ca76" name="Fleet Construction Rules" hidden="false" collective="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink id="f30fafc6-53e4-57a9-b920-6b5a7bf9263b" name="Upgrade" hidden="false" targetId="7610de76-9ef1-58ab-9c7b-f97ede66e61d" primary="true" />
      </categoryLinks>
      <profiles>
        <profile id="517ca2e4-30de-5f14-bb1e-3828dd9989a0" name="Fleet Construction Rules" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Capital Ships: minimum 1. Maximum by fleet size: 1 at 1,000; 2 at 1,500; 3 at 2,000; 4 at 2,500; 5 at 3,000. Minimum Line Ships: 4/5/6/7/8 respectively. No single ship may exceed 50% of fleet points including upgrades. Gloriana 2,000+; Abyss/Phalanx 3,000+. Escorts/Frigates squadrons 3–6; Assault Barges up to 4. This v0.2 catalogue displays these rules but automatic variable-points bracket validation is still in development.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry id="48c49901-5676-5e88-b361-d14cb76dcba5" name="X Legion - The Gorgon’s Creation" hidden="false" collective="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink id="ba93c37a-94c9-5f0e-9c4e-d966fb7eb146" name="Upgrade" hidden="false" targetId="7610de76-9ef1-58ab-9c7b-f97ede66e61d" primary="true" />
      </categoryLinks>
      <profiles>
        <profile id="651be658-af2c-52c0-a689-00fc9ebce153" name="X Legion - The Gorgon’s Creation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Repair rolls succeed on a 3+.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry id="e6e3ae6b-5d29-4b10-95c0-52ec99cad0ed" name="Battle Carrier" hidden="false" collective="false" import="true" type="unit">
      <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="150.0" />
      </costs>
      <categoryLinks>
        <categoryLink id="4df74164-f2d2-4ede-b801-f9fa45f056e8" name="Capital Ship" hidden="false" targetId="bd422ebf-10b3-5085-89cc-263568c40fe0" primary="true" />
      </categoryLinks>
      <profiles>
        <profile id="5347cabd-d164-41e1-9235-e0fd8d7cb6a1" name="Battle Carrier" hidden="false" typeId="806f9ff1-fd51-5ddb-b005-ce73a5d09d65" typeName="Ship">
          <characteristics>
            <characteristic name="BS" typeId="d130e705-611e-5a0a-bd7d-ea8e848fdb2e">3</characteristic>
            <characteristic name="Prow" typeId="84a55377-edbc-5825-a2bf-70c6155018f2">14</characteristic>
            <characteristic name="Broadside" typeId="5f595433-7397-5c4b-9d4a-8f35d83a2b29">13</characteristic>
            <characteristic name="Stern" typeId="cd9ec76e-f959-5560-8845-9ab242f16e71">12</characteristic>
            <characteristic name="HP" typeId="ef713781-2034-5fb4-83d1-e49d1d683694">13</characteristic>
            <characteristic name="VS" typeId="84309751-688d-50ef-8940-d8d042261a56">8</characteristic>
            <characteristic name="Speed" typeId="25d0e01e-8e74-55b3-8a2a-17773c881625">6″</characteristic>
            <characteristic name="Turn" typeId="899e9c58-70ef-5da5-8495-5bf6a8b7f8f0">45°</characteristic>
            <characteristic name="Crew" typeId="2f6312dd-493e-53c6-96e2-d901afca0e81">8</characteristic>
          </characteristics>
        </profile>
        <profile id="05f48609-25fa-48d6-a8af-42ebc01a4328" name="Hangar Bays (6)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">6 physical Hangar Bay mounts; each bay costs 10 pts and carries one aircraft squadron.</characteristic>
          </characteristics>
        </profile>
        <profile id="204ecc64-2025-4b46-a064-b3e49d6c063d" name="Bulwark of the Line" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Enemy Damage Table rolls against this ship suffer −1.</characteristic>
          </characteristics>
        </profile>
        <profile id="532377c7-cf3e-4a9a-a27c-73afadbfa56b" name="Hangar Loadout Validation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Maximum 8 aircraft squadrons.</characteristic>
          </characteristics>
        </profile>
        <profile id="6ea58df3-2d95-4687-a495-4b88977ca78f" name="Boarding Forces Validation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding forces are bought against the ship’s Crew. Terminator/Dreadnought class limits are enforced; remember a Contemptor occupies 2 Crew slots.</characteristic>
          </characteristics>
        </profile>
        <profile id="53b3a0ea-4191-4d4e-8a93-957fc159fcd1" name="Hardpoint Construction" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Bare chassis. Every mounted weapon is purchased separately. No upgrade-spend ceiling. Legal choices are controlled by hull class, hardpoint type and facing; each hardpoint must contain exactly one weapon.</characteristic>
          </characteristics>
        </profile>
      <profile id="b09761e0-cc9e-4777-8b36-f0644b095ab2" name="Mount Capacity" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Port Heavy: 1 · Starboard Heavy: 1 · Prow Ordnance: 6 · Dorsal: 4 · Defence: 10 · Hangar: 6</characteristic></characteristics></profile><profile id="acf22273-554c-40a7-b24f-bf58b3b2509a" name="Hardpoint Configuration" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Every physical weapon, defence and hangar hardpoint must be filled exactly once. There is no separate upgrade-spend cap; the hull's mount layout is the limit.</characteristic></characteristics></profile><profile id="bcf23b21-b224-47bb-afed-25862c683041" name="Carrier Flagship Priority" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">A Battle Carrier must be the fleet's Flagship unless a Gloriana is present. New Recruit enforces this through the Fleet Role selection.</characteristic></characteristics></profile><profile id="91f525f4-7ee4-4f05-9933-1730595b9ce8" name="Roster Builder Summary" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Crew 8 · Port Heavy 1 · Starboard Heavy 1 · Prow Ordnance 6 · Dorsal 4 · Defence 10 · Hangars 6. Fill every physical hardpoint exactly once; aircraft are purchased separately up to Hangar capacity.</characteristic></characteristics></profile></profiles>
      <selectionEntryGroups>
        <selectionEntryGroup id="13fecc5b-3e26-4b36-a31f-2e10da4699d2" name="Fleet Role" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="b6762bf9-6703-4ba7-80b2-a14fd04aa088" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="cb53f873-a360-47ac-9089-2ec47de11a96" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="9f2a94dd-a1d6-4bd8-a6ed-61b9b87118de" name="Designate as Flagship" hidden="false" collective="false" import="true" type="upgrade"><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" /></costs><categoryLinks><categoryLink id="25c8c84b-3ef0-4293-aff0-cb6dcbdb7613" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" /></categoryLinks><profiles><profile id="4566a882-9396-49f4-beb0-3bc5f0da9e64" name="Flagship" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Mandatory when the fleet contains no Gloriana. If a Gloriana is selected, this option is automatically hidden and the requirement is removed.</characteristic></characteristics></profile><profile id="509af58b-f1c1-4878-9eff-89aebf611bd6" name="Commander Embarkation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander here. The Commander is embarked on this Flagship.</characteristic></characteristics></profile></profiles><selectionEntryGroups><selectionEntryGroup id="21daaecd-9844-4607-a3d3-67c13908b8d0" name="Fleet Commander" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="6ff1602f-2101-4acf-b408-961ab4710b2d" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="cc6db6b4-3921-469a-83b3-9c6dd03431ae" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="51862b68-c9d3-493c-b9f8-7fde6ba179e3" name="Fleet Captain" hidden="false" collective="false" import="true" type="upgrade">
