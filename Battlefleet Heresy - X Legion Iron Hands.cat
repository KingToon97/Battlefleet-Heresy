        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="150.0" />
      </costs>
      <categoryLinks>
        <categoryLink id="f1992957-4b93-43b1-b818-ea8b8b24c9fa" name="Commander" hidden="false" targetId="6f3339ad-23a9-5687-b08f-3f11a43fe50b" primary="true" />
      </categoryLinks>
      <profiles>
        <profile id="57254701-c415-4a3a-a72a-2a20322725c1" name="Shadrak Meduson" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Once per turn, one friendly ship re-rolls failed penetration rolls against Capital Ships until end of turn.</characteristic>
          </characteristics>
        </profile>
