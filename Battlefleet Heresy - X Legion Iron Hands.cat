          <selectionEntries>
            <selectionEntry id="82078664-6c41-5ebe-a0fb-fac9ba72442e" name="Veteran Crew - Line Ship" hidden="false" collective="false" import="true" type="upgrade">
              <costs>
                <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="60.0" />
              </costs>
              <categoryLinks>
