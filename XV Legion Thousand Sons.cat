        <selectionEntryGroup id="5f7156ff6532e03b813f087fcd9f1591" name="Hull Upgrades" hidden="false"><selectionEntries><selectionEntry id="b96e7a1751fd6a15fd30aceef497f973" name="Side Armour Reinforcement" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="481e652b5907eff9c8cac4e20c758b7d" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="6a8e21f6f0cccc06585f5050fb209f61" name="Side Armour Reinforcement" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="120.0" /></costs></selectionEntry><selectionEntry id="b82d4c6c77babd505d598de014972302" name="Engine Refit" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="2e2ba4c55b6ff16ebcc25fc8e7deb03d" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="d6f5838befad94d22553c228eae8ea8a" name="Engine Refit" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="100.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
