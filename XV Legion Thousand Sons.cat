            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Once per turn force one enemy within 18″ to re-roll a successful Repair or Morale test.</characteristic>
          </characteristics>
        </profile>
      <profile id="f558f272-1f69-4d0f-895f-6008dfe34396" name="Primarch Retinue" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This character is embarked as the Primarch's additional named retinue. They do not add Fleet Orders, Command range or Leadership; only effects unrelated to the order economy apply.</characteristic></characteristics></profile></profiles>
      <categoryLinks>
        <categoryLink id="9be418b2-2b6f-40c4-8394-4b1433156b20" name="Retinue Character" hidden="false" targetId="194a7f31-dced-445a-b273-cca4996c8570" primary="false" /></categoryLinks>
