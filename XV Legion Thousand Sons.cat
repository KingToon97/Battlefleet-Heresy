        <selectionEntryGroup id="19eb930036856bed376ddb3b097ca82d" name="Hull Upgrades" hidden="false"><selectionEntries><selectionEntry id="92e28cde375dbce188cce57578a6430b" name="Side Armour Reinforcement" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="d70a242ee900fc6347e471f31b16d6e0" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="ffc125e02fea11d944a8c13cfca02867" name="Side Armour Reinforcement" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="120.0" /></costs></selectionEntry><selectionEntry id="6de799a8935ef780f3ceeed6f5d8300f" name="Engine Refit" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="3f51c4e1bdbbc154d9ed327b783ef816" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="b06ab17efa3dc15428d17567da75fdfd" name="Engine Refit" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="100.0" /></costs></selectionEntry><selectionEntry id="6b0fd11e-a127-5596-a1fc-a2697056c7b2" name="Triple Lance Battery Upgrade" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="f3267172-5b71-5d6a-81bc-a039aa2d1b88" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="6dbc6023-11e2-547f-919d-58a3e7a9722a" name="Triple Lance Battery Upgrade" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Her dorsal Lance Batteries each fire 3 shots rather than 2. The heavier feed is a hazard: whenever the ship suffers a Magazine Explosion it loses 1 additional Hull Point.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="75.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
