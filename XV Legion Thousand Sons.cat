      <selectionEntryGroups>
        <selectionEntryGroup id="05afc8fa-f34c-47e4-9773-5fdf164a2dfd" name="Fleet Role" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="47463bba-ccdb-45d0-9ae9-867cd612f857" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="36c4fc80-baed-4013-b786-e642b169ee22" name="Designate as Flagship" hidden="false" collective="false" import="true" type="upgrade"><profiles><profile id="aae59c5b-1d4b-4071-a1cc-d792ceafbfdb" name="Flagship" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship is the fleet's Flagship. Exactly one Flagship is required in a standard fleet.</characteristic></characteristics></profile><profile id="a332fc02-9e5e-48ed-b1b7-4d01eaa24ae8" name="Commander Embarkation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander here. The Commander is embarked on this Flagship.</characteristic></characteristics></profile></profiles><categoryLinks><categoryLink id="19d406fc-4644-47e3-85be-f115261b7952" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" /></categoryLinks><selectionEntryGroups><selectionEntryGroup id="bb430243-4d02-4376-babb-3388be63be0d" name="Fleet Commander" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="7802ae45-f7ec-42f6-99ee-e6408c51cda6" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="b80998bb-bc64-40c8-9a86-8bf