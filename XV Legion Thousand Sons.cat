      <selectionEntryGroups>
        <selectionEntryGroup id="71963c57-ddaa-42b7-8f21-8ca2de234b0b" name="Fleet Role" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="66070448-2333-4abe-acc7-effb095f32e2" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="204d3954-cb05-4f15-b102-46ab1f0bfc79" name="Designate as Flagship" hidden="false" collective="false" import="true" type="upgrade"><profiles><profile id="0c20d63e-3c2c-4c25-822f-e9b719d3c811" name="Flagship" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship is the fleet's Flagship. Exactly one Flagship is required in a standard fleet.</characteristic></characteristics></profile><profile id="043ecd74-14c0-4420-8d3d-624aef882aa8" name="Commander Embarkation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander here. The Commander is embarked on this Flagship.</characteristic></characteristics></profile></profiles><categoryLinks><categoryLink id="65e7b4e8-34a8-49e7-b188-655a96cb3131" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" /></categoryLinks><selectionEntryGroups><selectionEntryGroup id="ed9c4a99-fb93-4dc4-987c-7d884bdd5c33" name="Fleet Commander" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="80787ef5-47b3-4f1a-856b-a1238bc9f4a5" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="94dda824-05fe-40f8-94bf-5c7