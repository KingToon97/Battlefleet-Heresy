      <selectionEntryGroups>
        <selectionEntryGroup id="2e075f96-b5b2-45a2-8129-097907b8430f" name="Fleet Role" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="b1513c91-6934-4ad2-87ff-72b604b4f763" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="694f0aa2-aaba-480f-8704-104dee6bbee8" name="Designate as Flagship" hidden="false" collective="false" import="true" type="upgrade"><profiles><profile id="b6a9d4e2-4fcb-43ad-b516-da1ec21ff93b" name="Flagship" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship is the fleet's Flagship. Exactly one Flagship is required in a standard fleet.</characteristic></characteristics></profile><profile id="1365255e-9ff8-4643-9c6a-d0f55a37adee" name="Commander Embarkation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander here. The Commander is embarked on this Flagship.</characteristic></characteristics></profile></profiles><categoryLinks><categoryLink id="e700480c-a7fe-4fe0-84ce-1e14bce78f96" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" /></categoryLinks><selectionEntryGroups><selectionEntryGroup id="ef9598b8-87b2-4017-8925-7c77bf9fc6c9" name="Fleet Commander" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="ca34fdb4-1290-4171-ab49-aeb16b742c42" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="3f088144-4ac6-4950-b05e-440