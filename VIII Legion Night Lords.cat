    <profiles>
        <profile id="9c3b448e-5cb0-4107-b969-602fd8cd1087" name="Sevatar" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Enemies within 12″ suffer −1 Leadership; rounds in which his parties inflict a casualty inflict one more.</characteristic>
          </characteristics>
        </profile>
      <profile id="f14d91b9-891b-4709-aefa-c7244c140bae" name="Primarch Retinue" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This character is embarked as the Primarch's additional named retinue. They do not add Fleet Orders, Command range or Leadership; only effects unrelated to the order economy apply.</characteristic></characteristics></profile></profiles>
