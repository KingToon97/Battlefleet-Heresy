        <selectionEntryGroup id="f43f6b34-2783-4d9a-ac78-cf86b6b9d06f" name="Fleet Role" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="50bef898-8711-4650-b09e-ed0e6612aafe" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="e71f0cbf-da2f-4bc9-8d7c-8dc5b13a4863" name="Designate as Flagship" hidden="false" collective="false" import="true" type="upgrade"><profiles><profile id="970e99e5-dd69-4c83-af40-4ddce22186a4" name="Flagship" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship is the fleet's Flagship. Exactly one Flagship is required in a standard fleet.</characteristic></characteristics></profile><profile id="e49c86b0-2eed-4461-99bc-a6ef27f56479" name="Commander Embarkation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander here. The Commander is embarked on this Flagship.</characteristic></characteristics></profile></profiles><categoryLinks><categoryLink id="6b0c2f8b-a272-445b-ba9e-2d3ec50875f8" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" /></categoryLinks><selectionEntryGroups><selectionEntryGroup id="147b1ff8-7522-4877-bc1e-61346229c729" name="Fleet Commander" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="c3bb14d2-98d1-4c86-8a17-38aae89661dd" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="6158c03c-41a7-4ff6-b344-30a