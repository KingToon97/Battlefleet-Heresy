            </profile>
            <profile id="9fe87da1-6beb-529e-afab-8ca2a1fc4cbc" name="Mount Capacity" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
              <characteristics>
