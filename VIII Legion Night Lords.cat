        <profile id="d586782b-ae7f-5a97-bb1d-2e8912e5df35" name="Gloriana Common Rules" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">A Primarch’s Flagship: Leadership 10; never suffers the Crippled −1 BS penalty; must be the Flagship; one per battle; games of 2,000+ points. Gloriana Reactors: once per battle, when VS would reach 0 it remains at 1. Dorsal Lance Batteries fire into all arcs and never Gets Hot. Heavy Macrobatteries use Reload (1). Armament fixed: no Section 11b refits.</characteristic>
          </characteristics>
        </profile>
        <profile id="8f5474e1-5efd-5353-bff4-25b6b1ea2b73" name="The Dark Is Ours" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Enemies within 24″ suffer −2 Leadership (replaces trait −1) and do not auto-pass Morale. Hangar Bays (4).</characteristic>
          </characteristics>
        </profile>
        <profile id="97864021-719e-5808-917a-df558c74ceb6" name="Hangar Loadout Validation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Maximum 4 aircraft squadrons: one per Hangar Bay.</characteristic>
          </characteristics>
        </profile>
        <profile id="b95279fe-6243-5d4c-9068-b2d2ab204ce9" name="Boarding Forces Validation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding forces are bought against the ship’s Crew. Terminator/Dreadnought class limits are enforced; remember a Contemptor occupies 2 Crew slots.</characteristic>
          </characteristics>
        </profile>
        <profile id="6afc76ab-9d38-5548-ba37-e9b2cd221e03" name="Mount Capacity" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Port: 7 | Starboard: 7 | Dorsal: 6 | All-round: 9 | Hangar Bays: 4. Mounts, not arbitrary refit counts, are the limiting factor for weapon configuration.</characteristic>
          </characteristics>
        </profile>
      <profile id="e25ff023-174d-4b9a-a7e2-1343849da599" name="Commander Embarkation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander. This character is embarked aboard this Flagship.</characteristic></characteristics></profile><profile id="3b028034-dad4-4244-b56f-13993aa74dee" name="Retinue Eligibility" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">The Primarch Retinue slot may only be used when the Primarch is selected as this ship's Fleet Commander. Choose at most one named Character of the same Legion.</characteristic></characteristics></profile><profile id="26d1bc2c-604f-4ffd-98d3-edf983c8cce0" name="Roster Builder Summary" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Crew 10. Ships start unequipped. Fill only the weapon and Defence hardpoints you want to purchase; each may contain at most one component. Hangar Bay slots cost 0 pts. Aircraft are purchased separately up to Hangar capacity.</characteristic></characteristics></profile></profiles>
      <categoryLinks>
