      </constraints>
    <profiles>
        <profile id="684ca4b2-6700-4931-b5c2-6beec5133fad" name="Corswain" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Friendly boarding parties gain +1 in the first round of boarding.</characteristic>
          </characteristics>
