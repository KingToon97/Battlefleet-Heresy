      </constraints>
    <profiles>
        <profile id="920bf4cf-f591-46b8-b05e-8a7eb90b3f26" name="Holguin" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Once per turn, one friendly ship within 12″ may re-roll failed hits against the nearest target.</characteristic>
          </characteristics>
        </profile>
      <profile id="9d01ef19-d4a5-4d4f-9774-b30c2f677632" name="Primarch Retinue" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This character is embarked as the Primarch's additional named retinue. They do not add Fleet Orders, Command range or Leadership; only effects unrelated to the order economy apply.</characteristic></characteristics></profile></profiles>
      <categoryLinks>
        <categoryLink id="2a5c82c0-55d4-4cda-b1c5-b550e0aebe3a" name="Retinue Character" hidden="false" targetId="194a7f31-dced-445a-b273-cca4996c8570" primary="false" /></categoryLinks>
