        <profile id="03e4c0e1-ad19-56e2-b3cd-48fe6eadcc90" name="Excindio Pattern Lance Array" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
