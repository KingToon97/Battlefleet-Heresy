 <selectionEntry id="29d35439-674f-4f40-88f3-4b292e571674" name="Lion El’Jonson" hidden="false" collective="false" import="true" type="upgrade">
 <constraints>
 <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="25219573-abdb-4321-86e4-8bd9a2abbaae" type="max" />
 </constraints>
 <profiles>
 <profile id="988249af-7b76-4586-84fa-dc71a5f14d63" name="Lion El’Jonson" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Primarch. 3 Fleet Orders of each type each battle round. The Fleet Obeys: friendly ships within 12″ ignore the first Critical Damage they would suffer each battle round. Master Tactician: once per turn, one friendly ship within 12″ re-rolls all failed hit rolls until end of Shooting Phase. Demigod of War: own boarding die at +3.</characteristic>
 </characteristics>
 </profile>
 </profiles>
 <categoryLinks>
