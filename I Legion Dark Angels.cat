 <selectionEntryGroup id="ffda2190-255d-4209-b11a-f64acbc0ec11" name="Primarch Retinue" hidden="true" collective="false" import="true"><modifiers><modifier type="set" field="hidden" value="false"><conditions><condition field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="29d35439-674f-4f40-88f3-4b292e571674" type="equalTo" /></conditions></modifier></modifiers><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="b5b6717c-2dd8-4bd7-a97d-531e8ddff02d" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="8d329e1d-80e6-496c-b82c-144fec476809" name="Holguin" hidden="false" collective="false" import="true" type="upgrade">
 <constraints>
 <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ac52366e-6649-4dba-aed3-0bc36c754954" type="max" />
 </constraints>
 <profiles>
 <profile id="920bf4cf-f591-46b8-b05e-8a7eb90b3f26" name="Holguin" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Once per turn, one friendly ship within 12″ may re-roll failed hits against the nearest target.</characteristic>
 </characteristics>
 </profile>
 <profile id="9d01ef19-d4a5-4d4f-9774-b30c2f677632" name="Primarch Retinue" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This character is embarked as the Primarch's additional named retinue. They do not add Fleet Orders, Command range or any command ability; only effects unrelated to the order economy apply.</characteristic></characteristics></profile></profiles>
 <categoryLinks>
 <categoryLink id="2a5c82c0-55d4-4cda-b1c5-b550e0aebe3a" name="Retinue Character" hidden="false" targetId="194a7f31-dced-445a-b273-cca4996c8570" primary="false" /></categoryLinks>
