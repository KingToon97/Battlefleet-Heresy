 <selectionEntry id="1ea7c11f-d612-4e9f-9a20-87524d669f3a" name="Corswain" hidden="false" collective="false" import="true" type="upgrade">
 <constraints>
 <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="8f653e45-6eb9-4605-9a96-8f572ff98240" type="max" />
 </constraints>
 <profiles>
 <profile id="badf154c-c60a-4dd3-ae52-a7d8f4c371c7" name="Corswain" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Named Character. 2 Fleet Orders of each type each battle round. Practised Command: once per battle round, one friendly ship within Command range may re-roll a single failed Evade roll. Friendly boarding parties gain +1 in the first round of boarding.</characteristic>
 </characteristics>
 </profile>
 </profiles>
