          <selectionEntries>
            <selectionEntry id="2eb3565f-f3fe-4e4e-9c89-36cf9ee436f3" name="Heavy Macrobattery (Port)" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="52468214-d206-4aba-b3d1-d878e0bf88bc" percentValue="false" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <profiles>
                <profile id="57a4a8cf-f922-4ef3-9103-e651c5624f08" name="Heavy Macrobattery" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
                  <characteristics>
                    <characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Port</characteristic>
                    <characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">9</characteristic>
