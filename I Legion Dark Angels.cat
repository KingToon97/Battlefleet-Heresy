        <selectionEntryGroup id="23dc898e77cc3e6fc80161e6bcc5355e" name="Hull Upgrades" hidden="false"><selectionEntries><selectionEntry id="b981f2c389170bc1159c5764c7d623cf" name="Side Armour Reinforcement" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="39bc4e5ec838dfefe79cced0ebeb36db" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="d79ffd58f9b99d1a886a8336c08af1d0" name="Side Armour Reinforcement" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="120.0" /></costs></selectionEntry><selectionEntry id="7d2c33070a7120fdd5a0afed9552d2aa" name="Engine Refit" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="a1c9e99529188ff8a8840c17b27a3df6" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="33514df7d3fc254967cad3a32fb46ea1" name="Engine Refit" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="100.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
