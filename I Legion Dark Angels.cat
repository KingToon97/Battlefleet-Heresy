 <constraint type="max" value="7.0" field="selections" scope="parent" shared="false" id="1b3c6c68-f8c6-512b-b0f4-60990e84b21e" percentValue="false" includeChildSelections="false" includeChildForces="false" />
 </constraints>
 <profiles>
 <profile id="4504f161-e387-513d-9f8e-758f24be0be4" name="Boarding Force" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Counts as 2 Crew; fights as one warrior at +2 and gives −1 to the enemy die it faces. Limits as Terminators.</characteristic>
 </characteristics>
 </profile>
