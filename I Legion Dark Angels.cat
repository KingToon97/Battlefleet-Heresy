 </constraints>
 <profiles>
 <profile id="ab91f3d6-d4ae-4f26-a9cb-555c5cf90f86" name="Holguin" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Named Character. 2 Fleet Orders of each type each battle round. Practised Command: once per battle round, one friendly ship within Command range may re-roll a single failed Evade roll. Once per turn, one friendly ship within 12″ may re-roll failed hits against the nearest target.</characteristic>
 </characteristics>
 </profile>
 </profiles>
