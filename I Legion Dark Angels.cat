    <selectionEntryGroups><selectionEntryGroup id="7382db1deefc6cf2ffc387bda6cc717a" name="Hull Upgrades" hidden="false"><constraints><constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="f4b4b544-9257-598d-8915-e17344d18556" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="14d3406ff10dcabbfaca14686ac8fd6b" name="Side Armour Reinforcement" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="9866f9a892c33bdbced014bec514a20f" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="cb10bad0cd951048394e89eec3aa38b8" name="Side Armour Reinforcement" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="75.0" /></costs></selectionEntry><selectionEntry id="34c8e04e16092b173587a19f6373d58e" name="Engine Refit" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="5d50bfce9de03603754054ed8ceef0a6" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="899deb8a46786669ce46ed49dc68ec3c" name="Engine Refit" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="100.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry>
    <selectionEntry id="a26af397-0f6b-5f0c-a195-cfb72c83066a" name="Assault Barge" hidden="false" collective="false" import="true" type="unit">
      <constraints>
        <constraint field="selections" scope="roster" value="4.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="550c516f-e325-5cfd-b5e0-e1abdb2c35c4" type="max" />
      </constraints>
      <profiles>
        <profile id="fc61f0cb-aa34-57df-93fd-15fed9f43621" name="Assault Barge" hidden="false" typeId="806f9ff1-fd51-5ddb-b005-ce73a5d09d65" typeName="Ship">
          <characteristics>
            <characteristic name="BS" typeId="d130e705-611e-5a0a-bd7d-ea8e848fdb2e">3</characteristic>
            <characteristic name="Prow" typeId="84a55377-edbc-5825-a2bf-70c6155018f2">12</characteristic>
            <characteristic name="Broadside" typeId="5f595433-7397-5c4b-9d4a-8f35d83a2b29">11</characteristic>
            <characteristic name="Stern" typeId="cd9ec76e-f959-5560-8845-9ab242f16e71">10</characteristic>
            <characteristic name="HP" typeId="ef713781-2034-5fb4-83d1-e49d1d683694">4</characteristic>
            <characteristic name="VS" typeId="84309751-688d-50ef-8940-d8d042261a56">3</characteristic>
            <characteristic name="Speed" typeId="25d0e01e-8e74-55b3-8a2a-17773c881625">10″</characteristic>
            <characteristic name="Turn" typeId="899e9c58-70ef-5da5-8495-5bf6a8b7f8f0">90°</characteristic>
            <characteristic name="Crew" typeId="2f6312dd-493e-53c6-96e2-d901afca0e81">5</characteristic>
          </characteristics>
        </profile>
        <profile id="09dcfa8b-83b5-558b-9599-0d7fb96a3e11" name="Hangar Bays (1)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">1 physical Hangar Bay mount; each bay costs 10 pts and carries one aircraft squadron.</characteristic>
          </characteristics>
        </profile>
        <profile id="259cb497-5329-5608-b75f-b0b6164458da" name="Assault Ramp" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">In a Hull Assault may commit up to full current Crew, always keeping 1 aboard.</characteristic>
          </characteristics>
        </profile>
        <profile id="1aebe0ff-75da-5d57-8029-c50263d7ed04" name="Void Marines" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Every Crew point aboard counts as Legiones Astartes (+1), free; eligible for Astartes boarding upgrades.</characteristic>
          </characteristics>
        </profile>
        <profile id="99fc64d3-eb29-5bf8-813b-98c53904579c" name="Hangar Loadout Validation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Maximum 2 aircraft squadrons: one per Hangar Bay. Assault Barge bays may carry Thunderhawks only.</characteristic>
          </characteristics>
        </profile>
        <profile id="e32429c2-d9c3-5fd6-abf2-b8ecaea2ba0b" name="Boarding Forces Validation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding forces are bought against the ship’s Crew. Terminator/Dreadnought class limits are enforced; remember a Contemptor occupies 2 Crew slots.</characteristic>
          </characteristics>
        </profile>
        <profile id="fb9afb3c-ba8b-58ea-80b5-cc2b1efe821c" name="Hardpoint Construction" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Bare chassis. Every mounted weapon is purchased separately. No upgrade-spend ceiling. Legal choices are controlled by hull class, hardpoint type and facing; each hardpoint must contain exactly one weapon.</characteristic>
          </characteristics>
        </profile>
      <profile id="d0281cf9-8e7c-41f8-9cfd-48609ee4c5cf" name="Mount Capacity" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Port: 2 · Starboard: 2 · Prow Assault: 2 · Defence: 3 · Hangar: 1</characteristic></characteristics></profile><profile id="1ceed627-bb3b-4d61-8069-b193e19fb122" name="Hardpoint Configuration" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ships begin with no weapons or Defence Batteries selected. Hangar Bay slots represent built-in hull capacity and cost 0 pts. Each physical hardpoint may take at most one legal component. There is no separate upgrade-spend cap; the hull's mount layout is the limit.</characteristic></characteristics></profile><profile id="7856267a-d3cb-4436-bd60-52a5943108eb" name="Roster Builder Summary" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Crew 5 · Port 2 · Starboard 2 · Prow Assault 2 · Defence 3 · Hangars 1. Ships start unequipped. Fill only the weapon and Defence hardpoints you want to purchase; each may contain at most one component. Hangar Bay slots cost 0 pts. Aircraft are purchased separately up to Hangar capacity.</characteristic></characteristics></profile></profiles>
      <categoryLinks>
        <categoryLink id="afd208cf-89db-5b7a-b7da-c98a799fc4de" name="Line Ship" hidden="false" targetId="96572996-e9b1-54a7-a2a9-2108e1dfc993" primary="true" />
      </categoryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup name="Crew Upgrade" id="e0dcb783-33f8-5a52-ac4a-e78e25aa8cde" hidden="false" collective="false" import="true">
          <constraints>
            <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="91d77ff3-08f2-51fb-8904-951568f1f63b" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry id="8fbeb3e7-9876-5baa-9a4b-025e435d230e" name="Veteran Crew - Line Ship" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="17696b3f-0ec9-594c-8274-3456faf3a36b" percentValue="false" includeChildSelections="false" includeChildForces="false" />
              </constraints>
            <profiles>
