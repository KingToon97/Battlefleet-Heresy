 <categoryLink id="affafbac-5dd1-40ae-bca3-4e217481dfdf" name="Primarch" hidden="false" targetId="aa8f9cca-79d6-4483-b466-901fa59a2823" primary="false" /></categoryLinks>
 <costs>
 <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="300.0" />
 </costs>
