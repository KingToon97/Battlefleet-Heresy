 <profiles>
 <profile id="6bc27828-b1c7-5b46-84e1-0a98e39fe8a6" name="Heavy Macrobattery" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
 <characteristics>
