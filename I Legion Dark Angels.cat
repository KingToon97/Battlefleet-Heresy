 <constraints>
 <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6cb2c50c-f606-427e-baa2-4bd19c9c1bd5" type="max" />
 </constraints>
 <profiles>
 <profile id="684ca4b2-6700-4931-b5c2-6beec5133fad" name="Corswain" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Friendly boarding parties gain +1 in the first round of boarding.</characteristic>
 </characteristics>
 </profile>
 <profile id="99d9fa25-2a96-435a-935b-0180a764508c" name="Primarch Retinue" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This character is embarked as the Primarch's additional named retinue. They do not add Fleet Orders, Command range or any command ability; only effects unrelated to the order economy apply.</characteristic></characteristics></profile></profiles>
 <categoryLinks>
