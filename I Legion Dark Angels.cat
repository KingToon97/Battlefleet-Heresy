        <selectionEntryGroup id="4a6329040a88f8f4552fce7b1391da16" name="Hull Upgrades" hidden="false"><selectionEntries><selectionEntry id="5fda96be311b5c0d7be604f8f60fdb54" name="Side Armour Reinforcement" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="0483520f8996d45dee3c2a7e061e413e" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="db565091550948b331c6fcedeedafb8d" name="Side Armour Reinforcement" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="120.0" /></costs></selectionEntry><selectionEntry id="82f4011b6093aa221887fbd0d6c41e7e" name="Engine Refit" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="29c763a77275742a2967af44c5f36f7a" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="6447bd7da6b174a2ecf0f1ad5f989953" name="Engine Refit" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="100.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
