            <selectionEntry id="703c8625-679d-514f-9339-f4342603cc25" name="Astartes Breacher Squad" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint type="max" value="9.0" field="selections" scope="parent" shared="false" id="ec8c462a-3afd-5fdd-9414-671b6b8da206" percentValue="false" includeChildSelections="false" includeChildForces="false" />
              </constraints>
            <profiles>
                <profile id="b366426a-dcf4-5245-b206-88368447bb1b" name="Boarding Force" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
                  <characteristics>
                    <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">One Crew point; +1, and −1 to the enemy die it faces when defending its own ship.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink id="7837d138-833e-587d-8e6d-b0e2820896d4" name="Boarding Force" hidden="false" targetId="4d94b920-d5bc-5fd7-a967-4ba346019f56" primary="true" />
