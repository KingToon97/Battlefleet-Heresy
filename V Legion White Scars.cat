            <selectionEntry id="94fb1191-122c-51a6-aa52-b660fdf0bf23" name="Terminator Squad" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="d983c352-376f-5782-8732-de64ab75c7e1" percentValue="false" includeChildSelections="false" includeChildForces="false" />
                <constraint type="max" value="9.0" field="selections" scope="parent" shared="false" id="178cfb3e-564a-5bb4-ab56-4c307e344634" percentValue="false" includeChildSelections="false" includeChildForces="false" />
              </constraints>
            <profiles>
                <profile id="1455878e-53ce-50a0-bca4-7930b1e05b0a" name="Boarding Force" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
                  <characteristics>
                    <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">One Crew point; +2. Limits: Line 1, Capital 2, Gloriana/Phalanx 4.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink id="46fa2ca0-7aa6-5bf3-80d9-2973d14dc1db" name="Boarding Force" hidden="false" targetId="4d94b920-d5bc-5fd7-a967-4ba346019f56" primary="true" />
