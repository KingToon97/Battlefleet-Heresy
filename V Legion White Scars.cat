          <selectionEntries>
            <selectionEntry id="eec5b2e0-c7a2-4b6c-b034-cd9fa93ef2a7" name="Veteran Crew - Capital Ship" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="c5e93c42-5914-49fe-aa4f-967b6a84726d" percentValue="false" includeChildSelections="false" includeChildForces="false" />
              </constraints>
            <profiles>
                <profile id="a3583c84-bfd3-4ae0-8ef4-5dc6508d41a7" name="Veteran Crew" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
                  <characteristics>
                    <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Once per ship. +1 BS, to maximum BS 5.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink id="a63bab65-91b4-436d-a393-07e4902a1dfe" name="Upgrade" hidden="false" targetId="7610de76-9ef1-58ab-9c7b-f97ede66e61d" primary="true" />
