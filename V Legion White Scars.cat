            <selectionEntry id="21643f91-99ca-5699-9712-f18b0475904a" name="Contemptor Dreadnought" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="e73c22e8-6e18-5dd8-bed9-fa4da7e32df9" percentValue="false" includeChildSelections="false" includeChildForces="false" />
                <constraint type="max" value="9.0" field="selections" scope="parent" shared="false" id="4135778e-a04a-5a91-bcc0-c2d12e2cb545" percentValue="false" includeChildSelections="false" includeChildForces="false" />
              </constraints>
            <profiles>
                <profile id="eb107688-eb6e-5cdc-b7f9-50ad0bef8cee" name="Boarding Force" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
                  <characteristics>
                    <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Counts as 2 Crew; fights as one warrior at +2 and gives −1 to the enemy die it faces. Limits as Terminators.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink id="e4b5c3d4-2be2-5d92-938e-8d5686447f8d" name="Boarding Force" hidden="false" targetId="4d94b920-d5bc-5fd7-a967-4ba346019f56" primary="true" />
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="80.0" />
              </costs>
              </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup id="17cf7000791cd1416d6f6d30ac0d122d" name="Hull Upgrades" hidden="false"><constraints><constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="14a7b8c0-75f4-5b19-b184-972d973701a8" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="d1a83fe511a6e6f4a349960fefb5505e" name="Side Armour Reinforcement" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="8ac4088988567000c63cde7f5e3e50fe" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="96ee17df7bc0bbd9bc481f7e7d3df7d5" name="Side Armour Reinforcement" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="120.0" /></costs></selectionEntry><selectionEntry id="f34252a5c28959763197ec2ee28961ef" name="Engine Refit" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="a46d01e4d418b76fbdbf2bcc89b6d165" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="832c6bad34c8fefa55241a0ac48662ed" name="Engine Refit" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="100.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Drop Pod Loadout" id="4ce511d4-8657-5a85-83f1-1a71b3a6fd7c" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="4.0" field="selections" scope="parent" shared="false" id="5f9c6aff-3a6c-5b61-9189-6f5ce4e7e328" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="3afe514f-c9f7-5199-af6f-85eba3a9b5d8" name="Dreadclaw Drop Pod" hidden="false" collective="false" import="true" type="upgrade"><profiles><profile id="b8b7a3be-9740-550e-b9bf-cd5516cdbea3" name="Dreadclaw Drop Pod" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding pod, Armour 8, Speed 30″/round. Takes 1 rail. Launched at a target within 18″, striking the same turn. One Shot. Counts as aircraft and may be intercepted; a surviving pod locks on 2+, and on a failure is destroyed with all aboard. Delivers 1 Crew of boarders (+1 in the first round). Removed from play after its run.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" /></costs></selectionEntry><selectionEntry id="d4830a9e-15f1-59a6-a799-d5d3faa45c96" name="Kharybdis Assault Claw" hidden="false" collective="false" import="true" type="upgrade"><profiles><profile id="02a2bc44-9259-5199-8336-d82f2dc2ae06" name="Kharybdis Assault Claw" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding pod, Armour 9, Speed 30″/round. Takes 2 rails and locks automatically — melta cutters breach any hull — delivering 2 Crew of boarders (a Dreadnought filling both places). One Shot: removed from play after its run.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
    <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="176.0" />
      </costs>
      </selectionEntry>
    <selectionEntry id="81d44df7-c8bf-5864-afa5-3674282807ac" name="Battleship" hidden="false" collective="false" import="true" type="unit">
      <profiles>
        <profile id="0e9dbe0e-d611-5196-b185-4701b98f0717" name="Battleship" hidden="false" typeId="806f9ff1-fd51-5ddb-b005-ce73a5d09d65" typeName="Ship">
          <characteristics>
            <characteristic name="BS" typeId="d130e705-611e-5a0a-bd7d-ea8e848fdb2e">3</characteristic>
            <characteristic name="Prow" typeId="84a55377-edbc-5825-a2bf-70c6155018f2">14</characteristic>
            <characteristic name="Broadside" typeId="5f595433-7397-5c4b-9d4a-8f35d83a2b29">13</characteristic>
            <characteristic name="Stern" typeId="cd9ec76e-f959-5560-8845-9ab242f16e71">12</characteristic>
            <characteristic name="HP" typeId="ef713781-2034-5fb4-83d1-e49d1d683694">13</characteristic>
            <characteristic name="VS" typeId="84309751-688d-50ef-8940-d8d042261a56">8</characteristic>
            <characteristic name="Speed" typeId="25d0e01e-8e74-55b3-8a2a-17773c881625">8″</characteristic>
            <characteristic name="Turn" typeId="899e9c58-70ef-5da5-8495-5bf6a8b7f8f0">45°</characteristic>
            <characteristic name="Crew" typeId="2f6312dd-493e-53c6-96e2-d901afca0e81">8</characteristic>
          </characteristics>
        </profile>
        <profile id="63f43086-712e-5414-b673-1204009a96e8" name="Hangar Bays (2)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">2 physical Hangar Bay mounts; each bay must be purchased separately and carries one aircraft squadron.</characteristic>
          </characteristics>
        </profile>
        <profile id="21c4f8b0-cd3d-5fdd-895c-578f9305a826" name="Bulwark of the Line" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Enemy Damage Table rolls against this ship suffer −1.</characteristic>
          </characteristics>
        </profile>
        <profile id="20849c07-924c-5e18-9075-c02d971f7a77" name="Hangar Loadout Validation" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Maximum 2 aircraft squadrons: one per Hangar Bay.</characteristic>
          </characteristics>
        </profile>
        <profile id="2e1285b9-c145-5193-8c94-c998cbbf18b8" name="Boarding Forces Validation" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding forces are bought against the ship’s Crew. Terminator/Dreadnought class limits are enforced; remember a Contemptor occupies 2 Crew slots.</characteristic>
          </characteristics>
        </profile>
        <profile id="dafde299-339f-574c-b49b-f30852a640c4" name="Hardpoint Construction" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Bare chassis. Every mounted weapon is purchased separately. No upgrade-spend ceiling. Legal choices are controlled by hull class, hardpoint type and facing; each hardpoint must contain exactly one weapon.</characteristic>
          </characteristics>
        </profile>
      <profile id="99c3a033-e418-41e3-a6d9-c53f23b8eff4" name="Mount Capacity" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Port: 3 · Port Heavy: 2 · Starboard: 3 · Starboard Heavy: 2 · Prow Ordnance: 4 · Prow Super-Heavy: 1 · Dorsal: 4 · Defence: 8 · Hangar: 2</characteristic></characteristics></profile><profile id="89c1fc68-58bb-4a6e-949c-425094eeea17" name="Hardpoint Configuration" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ships begin with no weapons or Defence Batteries selected. Hangar Bay slots represent built-in hull capacity and cost 0 pts. Each physical hardpoint may take at most one legal component. There is no separate upgrade-spend cap; the hull's mount layout is the limit.</characteristic></characteristics></profile><profile id="c82e53da-0135-482c-ac10-862872c8ba39" name="Roster Builder Summary" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Crew 8 · Port 3 · Port Heavy 2 · Starboard 3 · Starboard Heavy 2 · Prow Ordnance 4 · Prow Super-Heavy 1 · Dorsal 4 · Defence 8 · Hangars 2. Ships start unequipped. Fill only the weapon and Defence hardpoints you want to purchase; each may contain at most one component. Hangar Bay slots cost 0 pts. Aircraft are purchased separately up to Hangar capacity.</characteristic></characteristics></profile></profiles>
      <rules><rule id="c6319357-0ccb-5bc5-b27a-d47f02e2b0e6" name="Gets Hot" hidden="false"><description>After a Lance Turret or Lance Battery resolves its attacks, roll a D6. On a 1 the firing ship loses 1 Hull Point. Each mount rolls separately.</description></rule><rule id="6a43d373-b871-5996-9b0f-ba6d0fda19b5" name="Twin-Linked" hidden="false"><description>Re-roll failed To Hit rolls.</description></rule><rule id="ed3d071c-40a3-5558-9e22-789da334baa6" name="Capital Ship" hidden="false"><description>Counts as a Capital Ship for every rule that names one, and fills a Capital slot.</description></rule><rule id="35f4e3cc-7cbc-5ee5-9cb3-efe146413e71" name="Reload (X)" hidden="false"><description>After firing, place X Reload tokens on the mount; flip one at the end of each battle round. The mount cannot fire while it bears a token.</description></rule><rule id="ab6c525e-1f7d-53cf-86c8-5a98d452a642" name="Devastating (X)" hidden="false"><description>Each hit costs X Hull Points, or 1 Void Shield Rating against live shields.</description></rule><rule id="4f0314bd-9aad-5109-8381-325ce3b4bf74" name="Armourbane" hidden="false"><description>Roll 2D6 + Strength to penetrate instead of 1D6, at 6″ or less, against shields or hull alike.</description></rule><rule id="d718e193-d42e-578f-b7cc-2ae1008f91fe" name="Point-Blank Broadsides" hidden="false"><description>At 6″ or less, Port, Starboard and Dorsal weapons improve AP by one step — or gain Armourbane instead if their printed AP is already 1. Prow weapons get neither.</description></rule><rule id="56da18cd-6464-5f09-ac08-9d9737f7232e" name="Crippled" hidden="false"><description>Below half starting Hull Points: −1 BS and half Speed.</description></rule><rule id="0d38bdd1-bea1-52a0-a672-5ef0cf7a61db" name="Depleted" hidden="false"><description>At half starting Crew or less: −1 BS. Stacks with Crippled.</description></rule><rule id="0f62b35a-9f0a-5d53-8262-2e195cbfb46c" name="Locked" hidden="false"><description>Joined by a ram. Neither ship may move; the rammer may not fire on its victim, who fires back at −1 BS. Break Away on 5+.</description></rule><rule id="68562142-4b2c-5d22-849c-9399726f1097" name="Snap Shots" hidden="false"><description>Firing at BS 1 — hits only on a 6.</description></rule><rule id="58a2b6d2-bf36-538f-818a-fa046fc7b094" name="Wreck" hidden="false"><description>0 Hull Points without exploding. Becomes impassable, obscuring terrain; never moves and never Evades.</description></rule><rule id="2646da35-b707-5917-a410-10d1e02f9cb2" name="Held station" hidden="false"><description>Moved 1″ or less under Burn Retros. Broadsides fire at +1 BS; −1 on Evade.</description></rule></rules><categoryLinks>
        <categoryLink id="78797cf8-6737-54b4-80ff-fd3f8e358728" name="Capital Ship" hidden="false" targetId="bd422ebf-10b3-5085-89cc-263568c40fe0" primary="true" />
      </categoryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup id="511eeda2-d3e5-40ff-ba91-723b02d6d343" name="Fleet Role" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="db3c827b-1eef-4dd8-8321-30b11100d08a" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="aba6352f-cf24-459a-b61c-8eec4c01e10f" name="Designate as Flagship" hidden="false" collective="false" import="true" type="upgrade"><profiles><profile id="055c36e8-facb-4d85-ab64-d96728eb8087" name="Commander Embarkation" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander here. The Commander is embarked on this Flagship.</characteristic></characteristics></profile></profiles><rules><rule id="997b7c63-7b7d-5f78-b56d-95a9dab2d254" name="Flagship" hidden="false"><description>This ship is the fleet's Flagship. Exactly one Flagship is required in a standard fleet.</description></rule></rules><categoryLinks><categoryLink id="e29dd374-5032-42cc-b945-d278b8d7b869" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" /></categoryLinks><selectionEntryGroups><selectionEntryGroup id="8cffbe58-796d-4435-8034-d942d3ce2bed" name="Fleet Commander" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="58969a56-98c6-43de-a9e8-7a847e0000e5" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="1db8c131-40ee-4e34-938a-88ce1711b8c1" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="091d70bf-e4ee-42db-aee3-05963e8669fc" name="Fleet Captain" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ec2c485a-ba5d-4e87-b951-1cd452212302" type="max" />
      </constraints>
    <profiles>
        <profile id="07ca85df-1e84-4a2c-97ae-4e6089a00be3" name="Fleet Captain" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Flagship issues 2 Fleet Orders each phase. Friendly ships within 6″ gain +1 Leadership.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <categoryLinks>
        <categoryLink id="f0eb5b17-5d50-4b00-a781-56d9549c31b9" name="Commander" hidden="false" targetId="6f3339ad-23a9-5687-b08f-3f11a43fe50b" primary="true" />
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" />
      </costs>
