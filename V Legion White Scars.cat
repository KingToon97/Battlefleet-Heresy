            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Friendly ships within 12″ gain +2″ Speed beyond the normal ceiling and may fire Prow weapons under All Ahead Full.</characteristic>
          </characteristics>
        </profile>
      <profile id="12c610d9-8d7c-416b-a54c-0dfb1fbce0a0" name="Primarch Retinue" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This character is embarked as the Primarch's additional named retinue. They do not add Fleet Orders, Command range or Leadership; only effects unrelated to the order economy apply.</characteristic></characteristics></profile></profiles>
      <categoryLinks>
        <categoryLink id="b5916907-7b8e-4bc5-8e7c-d507f307214d" name="Retinue Character" hidden="false" targetId="194a7f31-dced-445a-b273-cca4996c8570" primary="false" /></categoryLinks>
      <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="100.0" />
      </costs>
      </selectionEntry>
    <selectionEntry id="0db502d2-c9bd-4bef-b14c-a71e63cea421" name="Hibou Khan" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="4a21de27-115e-4f8b-9024-718ce29fe1da" type="max" />
      </constraints>
    <profiles>
        <profile id="cc26ce01-ff5c-4dda-beba-488d2d796518" name="Hibou Khan" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Escorts and Frigates within 12″ may turn an additional 45°.</characteristic>
          </characteristics>
        </profile>
      <profile id="46a90a0d-8e7b-40b0-89d0-43358160b4e6" name="Primarch Retinue" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This character is embarked as the Primarch's additional named retinue. They do not add Fleet Orders, Command range or Leadership; only effects unrelated to the order economy apply.</characteristic></characteristics></profile></profiles>
      <categoryLinks>
        <categoryLink id="e7bebe44-8b82-4f3a-83e6-6489392409d8" name="Retinue Character" hidden="false" targetId="194a7f31-dced-445a-b273-cca4996c8570" primary="false" /></categoryLinks>
