    <selectionEntryGroups><selectionEntryGroup id="70d183ffb1194f5816d1be0b13709b21" name="Hull Upgrades" hidden="false"><constraints><constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="5c36d147-45e3-5eb6-b9b4-962e2bc2ff5e" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="0215bf3267b84347490c7188b66c11d2" name="Side Armour Reinforcement" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="40b37df90063d3940e3a9de3cdcf0914" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="af6ef79fcf5d0af91f28ba37d5ae38f0" name="Side Armour Reinforcement" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="75.0" /></costs></selectionEntry><selectionEntry id="309fd48909acdb3599590b5c42780d39" name="Engine Refit" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="f09d24403db3e7ce664dee3f558899aa" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="3b640273040f0842fb449bf5621c3134" name="Engine Refit" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="100.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry>
    <selectionEntry id="f9d8d7f4-f920-5712-9d17-b245f036a627" name="Frigate Squadron" hidden="false" collective="false" import="true" type="unit">
      <profiles><profile id="289de48b-f358-4125-9832-adfcc5ea5ade" name="Mount Capacity" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Port: 1 · Starboard: 1 · Prow Ordnance: 2 · Dorsal: 1 · Defence: 2</characteristic></characteristics></profile><profile id="d1dd1efa-fe50-4bb2-907d-e07f932b3a09" name="Hardpoint Configuration" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ships begin with no weapons or Defence Batteries selected. Hangar Bay slots represent built-in hull capacity and cost 0 pts. Each physical hardpoint may take at most one legal component. There is no separate upgrade-spend cap; the hull's mount layout is the limit.</characteristic></characteristics></profile><profile id="8687f424-8f87-455e-a54e-3998bd9493bb" name="Roster Builder Summary" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Crew 3. Ships start unequipped. Fill only the weapon and Defence hardpoints you want to purchase; each may contain at most one component. Hangar Bay slots cost 0 pts. Aircraft are purchased separately up to Hangar capacity.</characteristic></characteristics></profile></profiles><categoryLinks>
        <categoryLink id="c7ba13aa9272bc43adc0374d86cd6a9f" name="Line Ship" hidden="false" targetId="96572996-e9b1-54a7-a2a9-2108e1dfc993" primary="true" /></categoryLinks>
      <selectionEntries>
        <selectionEntry id="0577f9d2-78eb-5dba-82ac-a407b96ab822" name="Frigate" hidden="false" collective="false" import="true" type="model">
          <constraints>
            <constraint field="selections" scope="parent" value="3.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="ac258f75-0ed7-5ad4-a3ed-5013c8c2d72b" type="min" />
            <constraint field="selections" scope="parent" value="6.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="45b3d5c3-8a78-551d-9206-4dfc1d0406c6" type="max" />
          </constraints>
          <profiles>
            <profile id="add74915-fb35-543e-9583-5263b1e03259" name="Frigate" hidden="false" typeId="806f9ff1-fd51-5ddb-b005-ce73a5d09d65" typeName="Ship">
              <characteristics>
                <characteristic name="BS" typeId="d130e705-611e-5a0a-bd7d-ea8e848fdb2e">3</characteristic>
                <characteristic name="Prow" typeId="84a55377-edbc-5825-a2bf-70c6155018f2">11</characteristic>
                <characteristic name="Broadside" typeId="5f595433-7397-5c4b-9d4a-8f35d83a2b29">10</characteristic>
                <characteristic name="Stern" typeId="cd9ec76e-f959-5560-8845-9ab242f16e71">9</characteristic>
                <characteristic name="HP" typeId="ef713781-2034-5fb4-83d1-e49d1d683694">4</characteristic>
                <characteristic name="VS" typeId="84309751-688d-50ef-8940-d8d042261a56">2</characteristic>
                <characteristic name="Speed" typeId="25d0e01e-8e74-55b3-8a2a-17773c881625">11″</characteristic>
                <characteristic name="Turn" typeId="899e9c58-70ef-5da5-8495-5bf6a8b7f8f0">90°</characteristic>
                <characteristic name="Crew" typeId="2f6312dd-493e-53c6-96e2-d901afca0e81">3</characteristic>
              </characteristics>
            </profile>
            <profile id="e80addbf-3fba-5db7-b529-fc2b51ef2b7d" name="Mount Capacity" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
              <characteristics>
                <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Port: 1 | Starboard: 1 | Prow torpedo: 2 | Dorsal: 1 | Defence: 2</characteristic>
              </characteristics>
            </profile>
            <profile id="564b2b53-c62a-53d6-9971-a4135ff514cb" name="Hardpoint Construction" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
              <characteristics>
                <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Bare chassis only. Every weapon on a physical hardpoint is paid separately. There is no upgrade-spend ceiling: facing and mount count are the limits. v0.7 component prices are balanced around sustained fire, armour penetration, shield interaction, firing arc, reload and one-shot restrictions.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules><rule id="8e7534f3-5965-559b-99cd-78d43b1fe4f3" name="Come About!" hidden="false"><description>Escorts and Frigates may turn at any point in their move, without first running a quarter of their Speed straight.</description></rule><rule id="27d3d6fa-a354-5f5a-9ff5-6ace255cdee4" name="Wolf Pack" hidden="false"><description>Torpedo Tubes fired by this ship add +1 to their Damage Table rolls.</description></rule><rule id="a4aa37e1-edb8-5a78-8136-556007e41ead" name="Intervention" hidden="false"><description>Costs no order. When a friendly ship within 3″ is attacked, rammed, or targeted by torpedoes, this ship may thrust into the firing line from up to 10″ of the attacker: it does not move, and the whole attack resolves against it instead. Once per battle round.</description></rule><rule id="5a1db1d0-9376-5a92-89d4-49778c0cfcd4" name="Gets Hot" hidden="false"><description>After a Lance Turret or Lance Battery resolves its attacks, roll a D6. On a 1 the firing ship loses 1 Hull Point. Each mount rolls separately.</description></rule><rule id="f15c4240-42fa-5510-84cd-f65f8d5b6ab2" name="Line Ship" hidden="false"><description>Counts as a Line Ship for every rule that names one, and toward the fleet's Line minimum.</description></rule><rule id="643f31b7-9cf1-5e3e-a5da-92bd3e04d99b" name="Reload (X)" hidden="false"><description>After firing, place X Reload tokens on the mount; flip one at the end of each battle round. The mount cannot fire while it bears a token.</description></rule><rule id="a56adc8b-ea93-5ed0-8948-e5e0f3058b31" name="Devastating (X)" hidden="false"><description>Each hit costs X Hull Points, or 1 Void Shield Rating against live shields.</description></rule><rule id="09f60056-a05f-50b4-95ad-0c2811e41b3e" name="Armourbane" hidden="false"><description>Roll 2D6 + Strength to penetrate instead of 1D6, at 6″ or less, against shields or hull alike.</description></rule><rule id="bbd5dd89-3018-5b89-a621-bb193826828a" name="Point-Blank Broadsides" hidden="false"><description>At 6″ or less, Port, Starboard and Dorsal weapons improve AP by one step — or gain Armourbane instead if their printed AP is already 1. Prow weapons get neither.</description></rule><rule id="91e16954-8f63-569a-a812-13df0b212ede" name="Crippled" hidden="false"><description>Below half starting Hull Points: −1 BS and half Speed.</description></rule><rule id="f23d6ba3-fe8d-56e3-825e-ffa62fa163d4" name="Depleted" hidden="false"><description>At half starting Crew or less: −1 BS. Stacks with Crippled.</description></rule><rule id="aa6458b9-9c64-5e92-9aea-f462a008cef0" name="Locked" hidden="false"><description>Joined by a ram. Neither ship may move; the rammer may not fire on its victim, who fires back at −1 BS. Break Away on 5+.</description></rule><rule id="b070583d-b256-5abc-b049-d78e932b9adc" name="Snap Shots" hidden="false"><description>Firing at BS 1 — hits only on a 6.</description></rule><rule id="d8fd048b-6ee3-5b27-97df-88fe15587f05" name="Wreck" hidden="false"><description>0 Hull Points without exploding. Becomes impassable, obscuring terrain; never moves and never Evades.</description></rule><rule id="bc21624f-b39a-5763-8fbc-e6e664368246" name="Held station" hidden="false"><description>Moved 1″ or less under Burn Retros. Broadsides fire at +1 BS; −1 on Evade.</description></rule></rules><categoryLinks>
            <categoryLink id="66c65ff0-4012-5f69-95c8-f7ac0db6496b" name="Line Ship" hidden="false" targetId="96572996-e9b1-54a7-a2a9-2108e1dfc993" primary="true" />
          </categoryLinks>
          <selectionEntryGroups>
            <selectionEntryGroup name="Crew Upgrade" id="1a33f129-f897-55b9-b39b-7bdc7274230d" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="85df62ee-cae9-59da-8f4c-dac009d83744" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="3987465b-2bd0-59db-a866-5748f99a4f96" name="Veteran Crew - Frigate" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="fd770440-f0bf-5ad6-ac8a-3bcfc1f91d78" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="ba0db1ef-b11b-5d9d-b283-3ea937115084" name="Veteran Crew" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Once per ship. +1 BS, to maximum BS 5.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="60.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Port Weapon Mounts" id="65449fa1-415c-5462-b72a-60947ae50c7e" hidden="false" collective="false" import="true">
