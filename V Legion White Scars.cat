    <selectionEntry id="ddf85d8e-ebba-43f8-9403-ada77377235d" name="Qin Xa" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="210b8c55-acab-4d9a-b7dd-65ca7f0dd345" type="max" />
      </constraints>
    <profiles>
        <profile id="3028af29-0217-4b73-95c4-30d51c904b06" name="Qin Xa" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Friendly ships within 12″ gain +2″ Speed beyond the normal ceiling and may fire Prow weapons under All Ahead Full.</characteristic>
          </characteristics>
