<?xml version='1.0' encoding='utf-8'?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="e6c74fa9-5dbb-58a5-9c77-511ebf7c16a6" name="V Legion White Scars" revision="7" battleScribeVersion="2.03" gameSystemId="86405571-5289-597b-b308-a9a2d68c00b9" gameSystemRevision="4" library="false">
  <selectionEntries>
    <selectionEntry id="cd897248-882f-5b2d-a889-d5b044bc5bcf" name="Escort Squadron" hidden="false" collective="false" import="true" type="unit">
      <profiles><profile id="76bc9f62-ce3c-4905-adde-f5b5c5b2cfa0" name="Mount Capacity" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Port: 1 · Starboard: 1 · Prow Ordnance: 1 · Defence: 1</characteristic></characteristics></profile><profile id="c45815a6-2a0c-4c81-8f70-dac3469fc2c2" name="Hardpoint Configuration" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ships begin with no weapons or Defence Batteries selected. Hangar Bay slots represent built-in hull capacity and cost 0 pts. Each physical hardpoint may take at most one legal component. There is no separate upgrade-spend cap; the hull's mount layout is the limit.</characteristic></characteristics></profile><profile id="0e0495ab-8f9f-4a9e-9725-2a38cb4c6fb3" name="Roster Builder Summary" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Crew 2. Ships start unequipped. Fill only the weapon and Defence hardpoints you want to purchase; each may contain at most one component. Hangar Bay slots cost 0 pts. Aircraft are purchased separately up to Hangar capacity.</characteristic></characteristics></profile></profiles><categoryLinks>
        <categoryLink id="8d224d2fe55c8f28c28e473bd74c3c3d" name="Line Ship" hidden="false" targetId="96572996-e9b1-54a7-a2a9-2108e1dfc993" primary="true" /></categoryLinks>
      <selectionEntries>
        <selectionEntry id="332b49e9-34a5-5770-bee6-823e9daa2365" name="Escort" hidden="false" collective="false" import="true" type="model">
          <constraints>
            <constraint field="selections" scope="parent" value="3.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="8d85bb5e-dfd4-562b-9907-494f99ba4a8e" type="min" />
            <constraint field="selections" scope="parent" value="6.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="ff987ffa-d10f-5264-a174-b7ac7d49f3e2" type="max" />
          </constraints>
          <profiles>
            <profile id="049f05fc-55f9-5290-9f09-f6df91c136a0" name="Escort" hidden="false" typeId="806f9ff1-fd51-5ddb-b005-ce73a5d09d65" typeName="Ship">
              <characteristics>
                <characteristic name="BS" typeId="d130e705-611e-5a0a-bd7d-ea8e848fdb2e">3</characteristic>
                <characteristic name="Prow" typeId="84a55377-edbc-5825-a2bf-70c6155018f2">11</characteristic>
                <characteristic name="Broadside" typeId="5f595433-7397-5c4b-9d4a-8f35d83a2b29">10</characteristic>
                <characteristic name="Stern" typeId="cd9ec76e-f959-5560-8845-9ab242f16e71">9</characteristic>
                <characteristic name="HP" typeId="ef713781-2034-5fb4-83d1-e49d1d683694">3</characteristic>
                <characteristic name="VS" typeId="84309751-688d-50ef-8940-d8d042261a56">1</characteristic>
                <characteristic name="Speed" typeId="25d0e01e-8e74-55b3-8a2a-17773c881625">12″</characteristic>
                <characteristic name="Turn" typeId="899e9c58-70ef-5da5-8495-5bf6a8b7f8f0">90°</characteristic>
                <characteristic name="Crew" typeId="2f6312dd-493e-53c6-96e2-d901afca0e81">2</characteristic>
              </characteristics>
            </profile>
            <profile id="f3eab5a4-7294-57c5-9a99-2ce2826c6bdf" name="Mount Capacity" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
              <characteristics>
                <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Port: 1 | Starboard: 1 | Prow torpedo: 1 | Defence: 1</characteristic>
              </characteristics>
            </profile>
            <profile id="716385b9-7c85-5808-acb5-7000df1c041b" name="Hardpoint Construction" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
              <characteristics>
                <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Bare chassis only. Every weapon on a physical hardpoint is paid separately. There is no upgrade-spend ceiling: facing and mount count are the limits. v0.7 component prices are balanced around sustained fire, armour penetration, shield interaction, firing arc, reload and one-shot restrictions.</characteristic>
              </characteristics>
            </profile>
          <profile id="eb72114c-ffc3-5038-ab29-8e51f9e9092a" name="Elusive Target" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Enemy ships targeting this vessel fire at −1 Ballistic Skill. No modifier may lower the required roll below 2+.</characteristic></characteristics></profile></profiles>
          <rules><rule id="9f52845b-b27f-5996-8c5d-1d1f289a8039" name="Come About!" hidden="false"><description>Escorts and Frigates may turn at any point in their move, without first running a quarter of their Speed straight.</description></rule><rule id="e6df2d36-ed35-52cf-bc00-edb66b477f08" name="Intervention" hidden="false"><description>Costs no order. When a friendly ship within 3″ is attacked, rammed, or targeted by torpedoes, this ship may thrust into the firing line from up to 10″ of the attacker: it does not move, and the whole attack resolves against it instead. Once per battle round.</description></rule><rule id="1b2ed339-2672-58e0-aa73-c2a9340e717b" name="Melta Mines" hidden="false"><description>Carries two. Laid in contact with the ship instead of shooting, never within 6″ of an enemy. Detonates when a non-Escort hull crosses it, hitting everything within 3″ at Str 9 AP 2 and bypassing Void Shields.</description></rule><rule id="a24b846c-60ec-5294-aba7-ed5107a1ee05" name="Line Ship" hidden="false"><description>Counts as a Line Ship for every rule that names one, and toward the fleet's Line minimum.</description></rule><rule id="a6e12722-a487-571b-af60-f4e91d30c801" name="Reload (X)" hidden="false"><description>After firing, place X Reload tokens on the mount; flip one at the end of each battle round. The mount cannot fire while it bears a token.</description></rule><rule id="e1482a32-1080-59fb-83c6-805f0c9dfae6" name="Devastating (X)" hidden="false"><description>Each hit costs X Hull Points, or 1 Void Shield Rating against live shields.</description></rule><rule id="4fae2ce2-4c77-5ddb-87be-244fb0ed5c7d" name="Armourbane" hidden="false"><description>Roll 2D6 + Strength to penetrate instead of 1D6, at 6″ or less, against shields or hull alike.</description></rule><rule id="636f3448-752a-51d8-82e8-c43cfbd06867" name="Point-Blank Broadsides" hidden="false"><description>At 6″ or less, Port, Starboard and Dorsal weapons improve AP by one step — or gain Armourbane instead if their printed AP is already 1. Prow weapons get neither.</description></rule><rule id="63c8f22e-5f7c-5678-923b-d2995c13c8f8" name="Crippled" hidden="false"><description>Below half starting Hull Points: −1 BS and half Speed.</description></rule><rule id="90f82232-e748-5a13-b7fe-a4dc0563976b" name="Depleted" hidden="false"><description>At half starting Crew or less: −1 BS. Stacks with Crippled.</description></rule><rule id="0188f756-be2d-57c2-81a7-4210440ede4d" name="Locked" hidden="false"><description>Joined by a ram. Neither ship may move; the rammer may not fire on its victim, who fires back at −1 BS. Break Away on 5+.</description></rule><rule id="7bae18fc-6560-51a9-926e-d3abe448447f" name="Snap Shots" hidden="false"><description>Firing at BS 1 — hits only on a 6.</description></rule><rule id="df22ade8-36d3-58e6-b091-1be4ac208089" name="Wreck" hidden="false"><description>0 Hull Points without exploding. Becomes impassable, obscuring terrain; never moves and never Evades.</description></rule><rule id="aa0acc0a-9a80-56e8-a602-11964c8ece0c" name="Held station" hidden="false"><description>Moved 1″ or less under Burn Retros. Broadsides fire at +1 BS; −1 on Evade.</description></rule></rules><categoryLinks>
            <categoryLink id="61d5169c-0706-593e-a82f-8cd1095b74d7" name="Line Ship" hidden="false" targetId="96572996-e9b1-54a7-a2a9-2108e1dfc993" primary="true" />
          </categoryLinks>
          <selectionEntryGroups>
            <selectionEntryGroup name="Crew Upgrade" id="aaecb261-8732-5ffd-a61f-3bd81e7c61f4" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="36af082d-b8a1-51ab-bb6b-c259b50a6bb1" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="b30eb081-8135-5fe9-949a-b71e7e139f82" name="Veteran Crew - Escort" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="992ad7a8-879f-50cd-ab14-5b856f3e12da" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="b2900aaa-255c-5694-a11c-c4815a9c7746" name="Veteran Crew" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Once per ship. +1 BS, to maximum BS 5.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="60.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Port Weapon Mounts" id="61c2ab41-459e-5681-bac7-3b8808b4a65f" hidden="false" collective="false" import="true">
