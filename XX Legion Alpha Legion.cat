          <selectionEntries>
            <selectionEntry id="90560490-afa8-4119-a571-43d329968156" name="Heavy Macrobattery (Port)" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="6f9998ec-e112-45ee-ba37-65ddea84a622" percentValue="false" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <profiles>
                <profile id="49455852-a363-46ae-a4d4-4c894326c30d" name="Heavy Macrobattery" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
                  <characteristics>
                    <characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Port</characteristic>
                    <characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">9</characteristic>
                    <characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">2</characteristic>
