      <selectionEntryGroup id="e5ef1a2d-17bf-4840-8eef-91a33e045321" name="Primarch Retinue" hidden="true" collective="false" import="true"><modifiers><modifier type="set" field="hidden" value="false"><conditions><condition field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="1ecc5909-7175-4e4b-b4a2-a384275b2178" type="equalTo" /></conditions></modifier></modifiers><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="48ea93cc-be44-45e3-bd59-2ba847545c10" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="7cd668e7-cffa-4c73-8a3c-5d106c63b383" name="Armillus Dynat" hidden="false" collective="false" import="true" type="upgrade">
