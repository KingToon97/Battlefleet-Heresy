 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Primarch. The Fleet Obeys: friendly ships within 12″ ignore the first Critical Damage they would suffer each battle round. Once per battle at start of Movement Phase, two friendly ships may exchange positions. Demigod of War +3.</characteristic>
 </characteristics>
 </profile>
