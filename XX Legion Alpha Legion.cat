        <selectionEntryGroup id="b655204ecba76c274a78cd8c01894dba" name="Hull Upgrades" hidden="false"><selectionEntries><selectionEntry id="365b6ef83a807cecd0232af9c7ee9c1a" name="Side Armour Reinforcement" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="743205f8611dd969651e26f8b655e9d4" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="0722ee42c8adc38208bc7c3f36376d4a" name="Side Armour Reinforcement" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="120.0" /></costs></selectionEntry><selectionEntry id="eb3a8ba1538b7d8cf45d0264db7b38b9" name="Engine Refit" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="a205defbcad30ee87029d4609f4d5673" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="9cb5d7515985bc0464a21b7155381737" name="Engine Refit" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="100.0" /></costs></selectionEntry><selectionEntry id="db34726e-d0aa-5477-8305-f6b7b1f0e2c8" name="Triple Lance Battery Upgrade" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="480a1102-dca2-5d9e-8aac-20d1312c30d6" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="5524323b-e9a0-5a68-80e7-7a562c8dc031" name="Triple Lance Battery Upgrade" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Her dorsal Lance Batteries each fire 3 shots rather than 2. The heavier feed is a hazard: whenever the ship suffers a Magazine Explosion it loses 1 additional Hull Point.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="75.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
    <costs>
