      </categoryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup id="7ff634c6-c506-4adb-8494-f2d36d85b3cd" name="Fleet Role" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="1a1e8988-7af6-4e34-acf0-daa0af07ab0f" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="e4b820e9-79ea-44de-ab72-74d99177984a" name="Designate as Flagship" hidden="false" collective="false" import="true" type="upgrade"><profiles><profile id="41b9ab7d-d724-495c-a21a-78a6957d6c8f" name="Flagship" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship is the fleet's Flagship. Exactly one Flagship is required in a standard fleet.</characteristic></characteristics></profile><profile id="84a7cbf0-9a3e-45ad-9e6b-ed310af1a75c" name="Commander Embarkation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander here. The Commander is embarked on this Flagship.</characteristic></characteristics></profile></profiles><categoryLinks><categoryLink id="b0446153-24f8-4d5c-a682-59ddbe0136a6" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" /></categoryLinks><selectionEntryGroups><selectionEntryGroup id="fb7be881-846f-4116-a765-8d0da399c942" name="Fleet Commander" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="e8cf70f9-2fef-43c1-b586-ad792a8239e5" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="997af3f7-472e-4059-9a06-2c5