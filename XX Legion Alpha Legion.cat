            <profile id="5f140a22-0708-50f8-b7d2-f8fe0bdea6da" name="Wolf Pack" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
              <characteristics>
                <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ships in the squadron within 6″ may combine gunnery fire on one target; penetration rolls gain +1. Never applies to Torpedo Tubes.</characteristic>
              </characteristics>
            </profile>
            <profile id="89c05762-c1f7-564e-bd4f-520ddebcf61b" name="Mount Capacity" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
              <characteristics>
                <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Port: 1 | Starboard: 1 | Prow torpedo: 1 | Defence: 1</characteristic>
              </characteristics>
            </profile>
            <profile id="ee78d628-1d08-5716-81d7-332a324e85de" name="Hardpoint Construction" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
              <characteristics>
                <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Bare chassis only. Every weapon on a physical hardpoint is paid separately. There is no upgrade-spend ceiling: facing and mount count are the limits. v0.7 component prices are balanced around sustained fire, armour penetration, shield interaction, firing arc, reload and one-shot restrictions.</characteristic>
              </characteristics>
            </profile>
          </profiles>
