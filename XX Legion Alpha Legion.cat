aa0" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="95eae2a7-80fa-5a59-949f-158932291ae3" name="Drop Pod Launcher" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Prow</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">—</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">—</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1 pod</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">18″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">One pod per launcher. Reload (2)</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Dorsal Mounts" id="0529ad41-0252-5255-ac92-6809f10db7e9" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="3.0" field="selections" scope="parent" shared="false" id="43f5cec9-2e5c-5ef8-b84c-90f22bf8423b" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="83393ea0-f7c8-5f7f-9bd1-89962b8c6ec9" name="Lance Turret" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="3.0" field="selections" scope="parent" shared="false" id="717481c9-d2c0-51f6-9469-1eb158e6be99" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="14765eb6-b836-511c-8125-b4271d387129" name="Lance Turret" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristi