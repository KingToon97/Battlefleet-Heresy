      </constraints>
    <profiles>
        <profile id="ff2d3440-3961-440c-8a5f-c8cdb50e5545" name="Armillus Dynat" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">After deployment redeploy up to three friendly ships.</characteristic>
          </characteristics>
        </profile>
      <profile id="11d6b708-77d2-4368-b74d-5cd7e9d62cd2" name="Primarch Retinue" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This character is embarked as the Primarch's additional named retinue. They do not add Fleet Orders, Command range or Leadership; only effects unrelated to the order economy apply.</characteristic></characteristics></profile></profiles>
      <categoryLinks>
        <categoryLink id="31db87ee-e45b-4711-acdd-351e302a2b9c" name="Retinue Character" hidden="false" targetId="194a7f31-dced-445a-b273-cca4996c8570" primary="false" /></categoryLinks>
