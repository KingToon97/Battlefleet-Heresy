ts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Starboard Mounts" id="e9001c3d-feba-5469-a93d-a84b259189f7" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="4.0" field="selections" scope="parent" shared="false" id="f966026e-9f90-59aa-9039-b823e4fdcf0d" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="b480c774-957a-56dc-96a1-4f75aaf92f4b" name="Macrobattery (Starboard)" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="4.0" field="selections" scope="parent" shared="false" id="b75efae5-1904-5ff0-b402-af2d5b7a2eaf" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="9dce4f34-fb53-5fa2-8e87-c15babba8804" name="Macrobattery (Starboard)" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Starboard</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">8</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">3</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">30″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">—</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" /></costs></selectionEntry><selectionEntry id="9ee8be73-8ce7-5b66-85be-6aa32a9ad3d8" name="Heavy Macrobattery (Starboard)" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="4.0" field="selections" scope="parent" shared="false" id="4c84e6e9-fef0-5579-be4b-a37c4e4e0a0a" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="8bc72391-6a12-50c7-88e4-74013d25f902" name="Heavy Macrobattery (Starboard)" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Starboard</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">9</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">2</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">30″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">—</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="15.0" /></costs></selectionEntry><selectionEntry id="086a591a-10f2-5853-8ae8-b3e3853376fe" name="Hangar Bay" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="56cacb08-733d-5a39-8c17-be865a21bcc9" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="51e6fe76-2419-53a9-a7c9-07549c97374c" name="Hangar Bay" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Holds one aircraft squadron, bought separately. Occupies one broadside mount that could otherwise carry a weapon, and may not be mounted on the Prow or Dorsally.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="bb15d241-245e-4bd9-bc81-50e7711124ec" name="Fleet Role" hidden="false" collective="false" import="true" defaultSelectionEntryId="93602e1d-e28f-40bf-8cc1-40b925d78cba"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="2e4d5b65-831a-4fc7-8016-08d801171b8f" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="93602e1d-e28f-40bf-8cc1-40b925d78cba" name="Designate as Flagship" hidden="false" collective="false" import="true" type="upgrade"><profiles /><rules><rule id="67376033-3217-51b5-81bf-118213510f53" name="Flagship" hidden="false"><description>This ship is the fleet's Flagship. Exactly one Flagship is required in a standard fleet.</description></rule></rules><categoryLinks><categoryLink id="fcedf879-66cf-4cc8-8d8a-c351e7130f4c" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" /></categoryLinks><selectionEntryGroups><selectionEntryGroup id="30a3ba10-1880-4a3e-909e-ca359cded861" name="Fleet Commander" hidden="false" collective="false" import="true" defaultSelectionEntryId="5b2e329e-5d98-4e62-b121-0112455ebca5"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="07d28f7f-1a0c-468e-b02a-22d36e7d8504" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="c99d0251-c90e-43fb-aae6-3827a0e0a6e8" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="5b2e329e-5d98-4e62-b121-0112455ebca5" name="Fleet Captain" hidden="false" collective="false" import="true" type="upgrade">
