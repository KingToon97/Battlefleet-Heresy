 <profiles>
 <profile id="c97ccc5c-b86e-46b7-935a-004b949e83f3" name="Fleet Captain" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Fleet Captain. 1 Fleet Order of each type each battle round. Ship’s Master: once per battle, the Flagship may re-roll a single failed Evade roll.</characteristic>
 </characteristics>
 </profile>
 </profiles>
 <categoryLinks>
 <categoryLink id="1a7ba781-3872-4bcc-8077-91733e9bd9bb" name="Commander" hidden="false" targetId="6f3339ad-23a9-5687-b08f-3f11a43fe50b" primary="true" />
