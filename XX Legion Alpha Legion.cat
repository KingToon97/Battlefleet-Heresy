      </constraints>
    <profiles>
        <profile id="4776a41b-0612-484c-b917-b2a483178bcf" name="Exodus" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Once per turn nominate one enemy ship; friendly ships re-roll hit rolls of 1 against it until end of turn.</characteristic>
          </characteristics>
        </profile>
      <profile id="0e7a291f-5184-46ab-bc7a-940e76b0c969" name="Primarch Retinue" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This character is embarked as the Primarch's additional named retinue. They do not add Fleet Orders, Command range or Leadership; only effects unrelated to the order economy apply.</characteristic></characteristics></profile></profiles>
