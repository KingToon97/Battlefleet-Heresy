  <selectionEntries>
    <selectionEntry id="cd897248-882f-5b2d-a889-d5b044bc5bcf" name="Escort Squadron" hidden="false" collective="false" import="true" type="unit">
      <profiles><profile id="1d150a1a-43ad-44c2-bb6b-a949e832f553" name="Mount Capacity" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Port: 1 · Starboard: 1 · Prow Ordnance: 1 · Defence: 1</characteristic></characteristics></profile><profile id="2a377db3-75b9-4a24-98b9-6c99a81a7b00" name="Hardpoint Configuration" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ships begin with no weapons or Defence Batteries selected. Hangar Bay slots represent built-in hull capacity and cost 0 pts. Each physical hardpoint may take at most one legal component. There is no separate upgrade-spend cap; the hull's mount layout is the limit.</characteristic></characteristics></profile><profile id="9e8ef586-8a72-4337-995f-3001b83aeec7" name="Roster Builder Summary" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Crew 2. Ships start unequipped. Fill only the weapon and Defence hardpoints you want to purchase; each may contain at most one component. Hangar Bay slots cost 0 pts. Aircraft are purchased separately up to Hangar capacity.</characteristic></characteristics></profile></profiles><categoryLinks>
        <categoryLink id="78a81e8979014a53a2e5788df2c5804d" name="Line Ship" hidden="false" targetId="96572996-e9b1-54a7-a2a9-2108e1dfc993" primary="true" /></categoryLinks>
