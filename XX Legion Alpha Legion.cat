            <characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">salvo (4)</characteristic>
            <characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">18″</characteristic>
            <characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Reload (2); no rails/boarders; each pod that reaches target inflicts D3 Crew loss and destroys one weapon system</characteristic>
          </characteristics>
        </profile>
        <profile id="435f79b8-51fd-5a4d-91aa-e3bb152160c6" name="Drop Pod Launchers ×3" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
