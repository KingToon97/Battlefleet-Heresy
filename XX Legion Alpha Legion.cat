 <constraint type="max" value="8.0" field="selections" scope="parent" shared="false" id="20a1acb8-6bde-5483-9574-902a997aed5c" percentValue="false" includeChildSelections="false" includeChildForces="false" />
 </constraints>
 <profiles>
 <profile id="759c9599-8f55-590e-9f5b-0a50e47a64a7" name="Boarding Force" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Counts as 2 Crew; fights as one warrior at +2 and gives −1 to the enemy die it faces. Limits as Terminators.</characteristic>
 </characteristics>
 </profile>
 </profiles>
