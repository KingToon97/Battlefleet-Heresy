    <selectionEntry id="9ffe29f6-25c7-49b8-9bd4-3b312fa6a470" name="Agapito Nev" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="01aa3a69-1865-4073-9ae4-b58bbde2cb98" type="max" />
      </constraints>
    <profiles>
        <profile id="daef85e3-50a1-41ed-b357-3fab79de264b" name="Agapito Nev" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Once per turn one friendly ship may make a free 45° turn before moving; Escorts/Frigates may Come About twice.</characteristic>
          </characteristics>
        </profile>
      <profile id="70c89b92-c9b3-4d76-a33d-68f289d54927" name="Primarch Retinue" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This character is embarked as the Primarch's additional named retinue. They do not add Fleet Orders, Command range or Leadership; only effects unrelated to the order economy apply.</characteristic></characteristics></profile></profiles>
