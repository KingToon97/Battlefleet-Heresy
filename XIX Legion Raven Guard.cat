        <selectionEntryGroup id="c1fd5c279e39ec5e2b2301123d2b9261" name="Hull Upgrades" hidden="false"><selectionEntries><selectionEntry id="c794c7dae52c289e93ae8ee1daba61e0" name="Side Armour Reinforcement" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="955e4a6714de8fede3aa51ae4567a9cb" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="1d4128d44ac54da59aaac65945077c3e" name="Side Armour Reinforcement" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="120.0" /></costs></selectionEntry><selectionEntry id="15c49284f19a39b18812bf4d595937b2" name="Engine Refit" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="c6039d46cd201f3f3534d2d0ecc72b47" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="4c5afc052cbebea5f13e4567005e19ca" name="Engine Refit" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="100.0" /></costs></selectionEntry><selectionEntry id="25765198-5fda-5f0e-8f45-7993dd2eac00" name="Triple Lance Battery Upgrade" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="c4b52f12-ea9a-57cb-94d6-7b55eaabaf34" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="fdf3e949-feee-5a82-9e18-c47dc024926b" name="Triple Lance Battery Upgrade" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Her dorsal Lance Batteries each fire 3 shots rather than 2. The heavier feed is a hazard: whenever the ship suffers a Magazine Explosion it loses 1 additional Hull Point.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="75.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
    <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="118.0" />
