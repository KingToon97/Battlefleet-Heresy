      <selectionEntryGroups>
        <selectionEntryGroup id="18ace1a9-f81a-43a5-974c-2ce9eb90aecd" name="Fleet Role" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="5e98cf5a-8a7c-421f-a6e4-8780be71eaef" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="0cdc56d8-a698-45e7-9b9f-d90294743536" name="Designate as Flagship" hidden="false" collective="false" import="true" type="upgrade"><profiles><profile id="6086d42d-3b5c-4f30-91f6-0123a7f661d2" name="Flagship" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship is the fleet's Flagship. Exactly one Flagship is required in a standard fleet.</characteristic></characteristics></profile><profile id="4585cab1-7f4c-4d32-a731-dc063314b09e" name="Commander Embarkation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander here. The Commander is embarked on this Flagship.</characteristic></characteristics></profile></profiles><categoryLinks><categoryLink id="e8d0f7e1-87a6-43f1-9982-2f49e3464685" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" /></categoryLinks><selectionEntryGroups><selectionEntryGroup id="4279b476-604b-4eea-93d1-ca3975b7526c" name="Fleet Commander" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="4e6679b6-f1ff-4e00-a7f5-03be5fb2d73d" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="b636c8c1-990e-4d4a-96d7-97e