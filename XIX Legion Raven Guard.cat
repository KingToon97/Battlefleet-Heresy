            <characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Reload (2), bypasses shields; prevents Return Fire in turns these strike</characteristic>
          </characteristics>
        </profile>
        <profile id="981373fc-c6dd-59f6-a73a-3e6def093c04" name="Drop Pod Launchers ×3" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
