        <profile id="395dd344-67f1-55df-8cb3-3750c5918917" name="Hangar Loadout Validation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Maximum 2 aircraft squadrons: one per Hangar Bay. Assault Barge bays may carry Thunderhawks only.</characteristic>
          </characteristics>
        </profile>
        <profile id="ee4b7d5e-66dc-59f9-baf2-f55c5ac5a3d6" name="Boarding Forces Validation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding forces are bought against the ship’s Crew. Terminator/Dreadnought class limits are enforced; remember a Contemptor occupies 2 Crew slots.</characteristic>
          </characteristics>
        </profile>
        <profile id="ec073e64-c445-512a-b64c-6f9d948937f5" name="Hardpoint Construction" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Bare chassis. Every mounted weapon is purchased separately. No upgrade-spend ceiling. Legal choices are controlled by hull class, hardpoint type and facing; each hardpoint must contain exactly one weapon.</characteristic>
          </characteristics>
        </profile>
      <profile id="211116ba-ce53-4a28-9fbc-a9a50a3ecebf" name="Mount Capacity" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Port: 2 · Starboard: 2 · Prow Assault: 2 · Defence: 3 · Hangar: 1</characteristic></characteristics></profile><profile id="bbf64e61-f925-45a1-9823-648dde2a28f5" name="Hardpoint Configuration" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ships begin with no weapons or Defence Batteries selected. Hangar Bay slots represent built-in hull capacity and cost 0 pts. Each physical hardpoint may take at most one legal component. There is no separate upgrade-spend cap; the hull's mount layout is the limit.</characteristic></characteristics></profile><profile id="590e3510-ae49-48ea-a986-9009263f13f5" name="Roster Builder Summary" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Crew 5 · Port 2 · Starboard 2 · Prow Assault 2 · Defence 3 · Hangars 1. Ships start unequipped. Fill only the weapon and Defence hardpoints you want to purchase; each may contain at most one component. Hangar Bay slots cost 0 pts. Aircraft are purchased separately up to Hangar capacity.</characteristic></characteristics></profile></profiles>
      <categoryLinks>
        <categoryLink id="afd208cf-89db-5b7a-b7da-c98a799fc4de" name="Line Ship" hidden="false" targetId="96572996-e9b1-54a7-a2a9-2108e1dfc993" primary="true" />
      </categoryLinks>
