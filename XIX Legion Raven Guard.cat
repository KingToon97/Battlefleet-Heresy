            <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="01a92a68-23f7-4a94-8747-b0e73ad3c39b" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry id="66a23356-42c0-4efe-a277-1ede6527d730" name="Heavy Macrobattery (Port)" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="a178e650-cf22-41e2-b17b-7df4e5ef2dc5" percentValue="false" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <profiles>
                <profile id="e5280db7-25e4-4846-a5ff-0e048ab23b6d" name="Heavy Macrobattery" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
                  <characteristics>
