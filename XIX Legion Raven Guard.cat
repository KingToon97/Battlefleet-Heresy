      <selectionEntryGroups>
        <selectionEntryGroup id="83d53ddd-7400-4e2a-a562-450a1bb11ca9" name="Fleet Role" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="6c4a5083-7576-435c-b6b2-2c95eccf4183" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="ce48af41-a85d-40b8-8e3d-32ce40b885bd" name="Designate as Flagship" hidden="false" collective="false" import="true" type="upgrade"><profiles><profile id="2c06c996-d365-465c-ade3-17387004c1da" name="Flagship" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship is the fleet's Flagship. Exactly one Flagship is required in a standard fleet.</characteristic></characteristics></profile><profile id="4f9e97c5-4cbf-4faa-b8f6-c3859a2b70f8" name="Commander Embarkation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander here. The Commander is embarked on this Flagship.</characteristic></characteristics></profile></profiles><categoryLinks><categoryLink id="d7a4f861-b58b-436a-9e49-5e412b3b587a" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" /></categoryLinks><selectionEntryGroups><selectionEntryGroup id="30579833-da5c-4339-b5b6-bb27f4384d78" name="Fleet Commander" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="6a638e70-53fc-4991-99a7-97ae3b2550b0" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="832bafb2-f804-49a8-8171-30a