      <selectionEntryGroup id="4bff165e-18b6-425d-ac0d-d7a65bce437f" name="Primarch Retinue" hidden="true" collective="false" import="true"><modifiers><modifier type="set" field="hidden" value="false"><conditions><condition field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="513095e1-f044-49cf-88a1-987ff09bb50b" type="equalTo" /></conditions></modifier></modifiers><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="ffb3624a-e262-46d4-bb16-e1954f4a8cdc" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="ff601b9d-bfb7-4ae4-86f7-b15056fd70e1" name="Branne Nev" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="45f176d7-8d4b-41a9-b5f0-963a95cb9d4e" type="max" />
      </constraints>
    <profiles>
        <profile id="e2e249bc-8e51-49d8-924b-659e567e9642" name="Branne Nev" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Escorts and Frigates gain +2″ Speed and +1 to Disengage rolls.</characteristic>
          </characteristics>
        </profile>
      <profile id="e3a63268-28fc-4a91-9bc9-bf6bad13ceba" name="Primarch Retinue" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This character is embarked as the Primarch's additional named retinue. They do not add Fleet Orders, Command range or Leadership; only effects unrelated to the order economy apply.</characteristic></characteristics></profile></profiles>
      <categoryLinks>
        <categoryLink id="4db20e4f-218e-4ce7-836f-4f1c1806e29c" name="Retinue Character" hidden="false" targetId="194a7f31-dced-445a-b273-cca4996c8570" primary="false" /></categoryLinks>
