        <selectionEntryGroup id="5bd8659580dd3c818d2938ca438ba3ac" name="Hull Upgrades" hidden="false"><selectionEntries><selectionEntry id="33bc4a156840e6412ba5eb18701fe35c" name="Side Armour Reinforcement" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="2fbf460ad4ec21c47f48bd63d6e17167" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="9629168477051f95b4790e1ea6e7b2b5" name="Side Armour Reinforcement" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="120.0" /></costs></selectionEntry><selectionEntry id="d228e3dcba81e2dbbfb8dbb263e5899e" name="Engine Refit" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="372f3f269522c8a3071685c7823b9927" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="10f755c568aecade6c59f878f665f2a5" name="Engine Refit" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="100.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
