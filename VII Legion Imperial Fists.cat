 </selectionEntryGroup>
 <selectionEntryGroup name="Hull Upgrades" id="8ea51351-3229-51dc-83ac-963b69fa7efa" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="5.0" field="selections" scope="parent" shared="false" id="ae9351b0-b8a1-540e-b1e4-5778f8ced483" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="691b7876-4a47-5da0-9697-0ad0af39718e" name="Reinforced Magazine Compartments" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="b7660401-dc37-5c69-8cd7-dbaafda7a86f" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="a6a7ad78-2128-5493-946d-5aaf0773eec4" name="Reinforced Magazine Compartments" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Damage Control caused by a Magazine Explosion by 1, to a minimum of 0. A Twin Lance Turret that would suffer 1 Damage Control instead suffers 0 and ignores the effect; a Triple Lance Turret that would suffer 2 instead suffers 1. No other effect of a Magazine Explosion is prevented or reduced. Once per ship. Not available to Gloriana class or above.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="30.0" /></costs></selectionEntry><selectionEntry id="5f625659-01c8-56d2-9113-52b7db7022f3" name="Enhanced Void Shield Array" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="f658bb02-0228-5105-a379-dce6c476644b" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="edb8a33b-3a56-5697-a632-fe62b163282f" name="Enhanced Void Shield Array" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">At the end of each battle round this ship regains 1 lost Void Shield, provided its Void Shields are currently active. It can never exceed its normal maximum. If its Void Shields have completely collapsed, been disabled, or are otherwise inactive, this upgrade cannot regenerate them; once at least one Void Shield is restored and the shields are active again, it resumes functioning normally. Once per ship. Not available to Gloriana class or above.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="45.0" /></costs></selectionEntry><selectionEntry id="318e3787-d9f0-55ff-9764-1fb43ff448f7" name="Autoloaders" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="62cda6c3-5d5b-5008-a9d1-9ddcae23dccb" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="e65b864d-ec79-5f4b-9f61-3417b3e78201" name="Autoloaders" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Reload value of every weapon and system aboard this ship by 1, to a minimum of Reload 0 — Reload (3) becomes Reload (2), Reload (2) becomes Reload (1), Reload (1) becomes Reload (0). A weapon reduced to Reload (0) has no cooldown and may fire every applicable battle round. Once per ship. Not available to Gloriana class or above.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="60.0" /></costs></selectionEntry><selectionEntry id="8b7e200d-506d-5a70-8505-c30225211233" name="Side Armour Reinforcement" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="f3ae3c33-cdf5-576a-91e9-3f474c51a697" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="3547fd95-74e5-5fa5-961a-5ab2b166833b" name="Side Armour Reinforcement" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="45.0" /></costs></selectionEntry><selectionEntry id="8a282909-9914-5d05-a1ef-27e383eb14e7" name="Engine Refit" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="08dcdde4-fb9e-5a5d-ab62-ec9a2367b635" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="781b6e2c-0856-5553-a4fa-ec1d5f642300" name="Engine Refit" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="60.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
 <costs>
