 <categoryLink id="50ba8caa-ff80-501a-b01d-c32f0a3dad73" name="Line" hidden="false" targetId="96572996-e9b1-54a7-a2a9-2108e1dfc993" primary="true" /></categoryLinks>
 <selectionEntries>
 <selectionEntry id="5e5962e1-0fba-5f52-bcb0-4a3985bfcff9" name="Destroyer" hidden="false" collective="false" import="true" type="model">
 <constraints>
 <constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="ea936b26-38ec-54d0-829a-a0c79745ebb5" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="3.0" field="selections" scope="parent" shared="false" id="a54cca35-1114-57c5-be8e-70823f7d6899" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints>
 <profiles>
 <profile id="89c9967c-0fc8-5cd3-8df2-3453f2918e41" name="Destroyer" hidden="false" typeId="806f9ff1-fd51-5ddb-b005-ce73a5d09d65" typeName="Ship">
 <characteristics>
 <characteristic name="BS" typeId="d130e705-611e-5a0a-bd7d-ea8e848fdb2e">3</characteristic>
 <characteristic name="Prow" typeId="84a55377-edbc-5825-a2bf-70c6155018f2">11</characteristic>
 <characteristic name="Side" typeId="5f595433-7397-5c4b-9d4a-8f35d83a2b29">10</characteristic>
 <characteristic name="Stern" typeId="cd9ec76e-f959-5560-8845-9ab242f16e71">9</characteristic>
 <characteristic name="HP" typeId="ef713781-2034-5fb4-83d1-e49d1d683694">2</characteristic>
 <characteristic name="VS" typeId="84309751-688d-50ef-8940-d8d042261a56">1</characteristic>
 <characteristic name="Speed" typeId="25d0e01e-8e74-55b3-8a2a-17773c881625">14″</characteristic>
 <characteristic name="Turn" typeId="899e9c58-70ef-5da5-8495-5bf6a8b7f8f0">360°</characteristic>
 <characteristic name="Crew" typeId="2f6312dd-493e-53c6-96e2-d901afca0e81">2</characteristic>
 </characteristics>
 </profile>
 </profiles>
 <rules><rule id="b63e12a4-4352-5d8c-991a-7f66987609d4" name="Intervention" hidden="false"><description>Costs no order. When a friendly ship within 3″ is attacked, rammed, or targeted by torpedoes, this ship may thrust into the firing line from up to 10″ of the attacker: it does not move, and the whole attack resolves against it instead. Once per battle round.</description></rule><rule id="bbe324b4-4719-55a0-8b36-9e02b86b9baa" name="Line" hidden="false"><description>Counts as a Line Ship for every rule that names one, and toward the fleet's Line minimum.</description></rule><rule id="efbd6798-96b4-5418-8e75-13aaacb20bbb" name="Reload (X)" hidden="false"><description>After firing, place X Reload tokens on the mount; flip one at the end of each battle round. The mount cannot fire while it bears a token.</description></rule><rule id="fbe8460f-2a1e-5b52-8f32-a23cd33b8703" name="Devastating (X)" hidden="false"><description>Each hit costs X Hull Points, or 1 Void Shield Rating against live shields.</description></rule><rule id="3eaa7ca4-2b66-5187-942b-9b53ec22977e" name="Armourbane" hidden="false"><description>Roll 2D6 + Strength to penetrate instead of 1D6, at 6″ or less, against shields or hull alike.</description></rule><rule id="470673d0-8e83-500b-ac71-1b5a542bc803" name="Point-Blank Broadsides" hidden="false"><description>At 6″ or less, Port, Starboard and Dorsal weapons improve AP by one step — or gain Armourbane instead if their printed AP is already 1. Prow weapons get neither.</description></rule><rule id="98a917df-2ff2-57c3-b501-73b2d9766f14" name="Crippled" hidden="false"><description>Below half starting Hull Points: −1 BS and half Speed.</description></rule><rule id="bbf68097-fc7b-5b3a-9715-9b02a6241192" name="Depleted" hidden="false"><description>At half starting Crew or less: −1 BS. Stacks with Crippled.</description></rule><rule id="ba3352a9-7c5c-5003-a67c-d0304a2f6fd5" name="Locked" hidden="false"><description>Joined by a ram. Neither ship may move; the rammer may not fire on its victim, who fires back at −1 BS. Break Away on 5+.</description></rule><rule id="1ef6de2c-4b2b-5e4b-80ea-2c63192fe20e" name="Snap Shots" hidden="false"><description>Firing at BS 1 — hits only on a 6.</description></rule><rule id="a179c2d7-8ec1-5147-8a27-00b1138cd781" name="Wreck" hidden="false"><description>0 Hull Points without exploding. Becomes impassable, obscuring terrain; never moves and never Evades.</description></rule><rule id="06706a68-11bf-5e21-98b1-28b100cfa1cd" name="Held station" hidden="false"><description>Moved 1″ or less under Burn Retros. Broadsides fire at +1 BS; −1 on Evade.</description></rule><rule id="84fd53d7-830f-5b8e-8451-e33ae90806d5" name="Wolf Pack" hidden="false"><description>Destroyers of one squadron within 6″ may combine fire on a single target, adding +1 to penetration. Gunnery only, never Torpedo Tubes.</description></rule><rule id="fcba3a85-cf65-5a9d-b1a7-c28d17ca44de" name="Scout" hidden="false"><description>A Destroyers may deploy up to 6″ ahead of its owner's deployment zone. Normal deployment restrictions and squadron coherency still apply.</description></rule><rule id="daee8fdb-2599-5f9b-a5bc-557a1cf6261d" name="Torpedo Specialist" hidden="false"><description>Torpedo Tubes fitted to a Destroyer have Reload (1) rather than Reload (2).</description></rule><rule id="54e5fdf9-814d-5445-a322-3afcd61cd9bb" name="Squadron" hidden="false"><description>Squadron: this vessel is taken singly, and up to 3 may be grouped into one squadron. A squadron moves and shoots as one unit and must keep coherency, each ship within 6″ of another in the squadron. It may split its fire, but every ship fires all of its own weapons at the one target it chooses.</description></rule></rules><categoryLinks>
 <categoryLink id="3e2a4fc9-ee12-55c5-8f3f-dcf53be29de7" name="Line" hidden="false" targetId="96572996-e9b1-54a7-a2a9-2108e1dfc993" primary="true" />
 </categoryLinks>
 <selectionEntryGroups>
 <selectionEntryGroup name="Prow Mounts" id="8483b655-c620-5d73-9b2d-eb0c2e44d2b2" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="ef234531-9378-5254-97d9-173f5649fc84" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="a67db80f-e329-5327-a998-e1be740f0f62" name="Torpedo Tube" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="051872d6-2192-5c30-be62-dff3419faefa" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="6f50cb43-9fc0-531e-808e-99a8541d553f" name="Torpedo Tube" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Prow</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">9</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">2</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">60″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">One torpedo per tube. Bypasses Void Shields; Armourbane within 6″; Reload (2)</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Port Mounts" id="3ba9155d-bd0e-52a8-a24a-62909201088a" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="4f83e61f-2a1d-5afb-92a2-edfb9c1263dc" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="8c7dbccc-b27b-530b-a2a6-28b14eb28b8f" name="Macrobattery (Port)" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="c7a0c03c-45b1-5e00-8d42-d9ed9ddfd96c" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="45af5eb1-af34-52e7-a4e7-7cd104676b39" name="Macrobattery (Port)" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Port</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">8</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">3</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">30″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">—</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Starboard Mounts" id="1c3930ab-394d-56d1-ab44-0e7d245da77c" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="c66dd545-da99-5e28-aba8-869ad423b1f0" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="944f9b4c-3d97-5ebb-bf0c-b8d9f4a01b50" name="Macrobattery (Starboard)" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="748b9e5b-0221-5723-b1b4-cc0b8dc4662d" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="26bd19cb-e1ce-5258-891f-ef628dd25ede" name="Macrobattery (Starboard)" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Starboard</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">8</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">3</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">30″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">—</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Crew Upgrade" id="94f2f368-6308-5fe5-9781-bca981308249" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="461ebb4f-464d-56c4-b09b-a179cc395aea" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="b8a7f7e5-f244-5993-aa29-fe43f36fd14f" name="Veteran Crew - Destroyer" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="588dfdef-3b81-5163-b5d9-d90bed0170ef" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="1addf182-c4b4-5658-b476-ab19d9601777" name="Veteran Crew" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Once per ship. +1 BS, to maximum BS 5.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="40.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Defence Mounts" id="ed39b297-ad04-5d24-bfd8-1c9354b3ea62" hidden="false" collective="false" import="true">
