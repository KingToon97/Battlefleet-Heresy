        <profile id="8d6b2e9a-5421-5e7c-a0ab-1e203763814a" name="Void Fortress" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Imperial Fists only; requires Rogal Dorn; games 3,000+ points. Four 90° broadside facings; one facing fires per Shooting Phase (Defence Batteries excepted). No Stern; cannot suffer Stern Strike. Enemy Damage Table rolls −1; never suffers Crippled −1 BS. Explodes on 5+, radius 3D6″. Hangar Bays (6). Armament fixed.</characteristic>
          </characteristics>
        </profile>
        <profile id="b96711a4-4170-594d-a1c7-f963e1d424f9" name="Hangar Loadout Validation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Maximum 6 aircraft squadrons: one per Hangar Bay.</characteristic>
          </characteristics>
        </profile>
        <profile id="5afd5fae-f994-5a78-91b2-fd2373d581a7" name="Boarding Forces Validation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding forces are bought against the ship’s Crew. Terminator/Dreadnought class limits are enforced; remember a Contemptor occupies 2 Crew slots.</characteristic>
          </characteristics>
        </profile>
        <profile id="0665425c-f15e-52af-a612-6b89c0e60c62" name="Mount Capacity" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Each facing: 13 | Hangar Bays: 6. Mounts, not arbitrary refit counts, are the limiting factor for weapon configuration.</characteristic>
