 <selectionEntryGroups><selectionEntryGroup name="Hull Upgrades" id="8c64c200-957f-5f53-91e0-8d6b9a7b23a0" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="3.0" field="selections" scope="parent" shared="false" id="68f8865a-b190-58bd-91a3-50b9ec0582b3" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="660aa7e5-fd0a-556b-9f44-adf2c5aa5926" name="Reinforced Magazine Compartments" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="787026e5-1181-5a01-8314-18977886401b" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="2a406fe4-02c5-5f11-8858-67812d10daf9" name="Reinforced Magazine Compartments" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Damage Control caused by a Magazine Explosion by 1, to a minimum of 0. A Twin Lance Turret that would suffer 1 Damage Control instead suffers 0 and ignores the effect; a Triple Lance Turret that would suffer 2 instead suffers 1. No other effect of a Magazine Explosion is prevented or reduced.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="50.0" /></costs></selectionEntry><selectionEntry id="b2944cd4-90e8-586c-9cec-8ed688d78085" name="Enhanced Void Shield Array" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="8f82b86d-fef5-5a60-a1f2-d976b2700189" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="ad162999-e926-59b3-a6b6-45da3bc5c52b" name="Enhanced Void Shield Array" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">At the end of each battle round this ship regains 1 lost Void Shield, provided its Void Shields are currently active. It can never exceed its normal maximum. If its Void Shields have completely collapsed, been disabled, or are otherwise inactive, this upgrade cannot regenerate them; once at least one shield has been restored by other means and the shields are active again, it resumes functioning normally.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="75.0" /></costs></selectionEntry><selectionEntry id="3f125263-4c9c-50a8-9e5a-d99ab7492380" name="Autoloaders" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="a27c7f28-94d5-5748-af5d-4650f8fda321" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="79b4bf03-c2e5-5d56-9553-a872be53965b" name="Autoloaders" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Reload value of all weapons and systems aboard this ship by 1, to a minimum of Reload 0. Reload (3) becomes Reload (2), Reload (2) becomes Reload (1), and Reload (1) becomes Reload (0). A weapon at Reload (0) has no cooldown and may fire every applicable battle round.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="100.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry>
 <selectionEntry id="78f3c439-a8c0-5eda-a4f9-67478002027c" name="Light Cruiser" hidden="false" collective="false" import="true" type="unit">
 <constraints><constraint type="max" value="5.0" field="selections" scope="roster" shared="false" id="16f66131-5d17-5b2a-94b8-386e705a8229" percentValue="false" includeChildSelections="false" includeChildForces="true" /></constraints><profiles>
 <profile id="096c4c20-7b11-587f-baca-64b0cf5a6454" name="Light Cruiser" hidden="false" typeId="806f9ff1-fd51-5ddb-b005-ce73a5d09d65" typeName="Ship">
 <characteristics>
 <characteristic name="BS" typeId="d130e705-611e-5a0a-bd7d-ea8e848fdb2e">3</characteristic>
 <characteristic name="Prow" typeId="84a55377-edbc-5825-a2bf-70c6155018f2">12</characteristic>
 <characteristic name="Side" typeId="5f595433-7397-5c4b-9d4a-8f35d83a2b29">10</characteristic>
 <characteristic name="Stern" typeId="cd9ec76e-f959-5560-8845-9ab242f16e71">10</characteristic>
 <characteristic name="HP" typeId="ef713781-2034-5fb4-83d1-e49d1d683694">5</characteristic>
 <characteristic name="VS" typeId="84309751-688d-50ef-8940-d8d042261a56">3</characteristic>
 <characteristic name="Speed" typeId="25d0e01e-8e74-55b3-8a2a-17773c881625">12″</characteristic>
 <characteristic name="Turn" typeId="899e9c58-70ef-5da5-8495-5bf6a8b7f8f0">90°</characteristic>
 <characteristic name="Crew" typeId="2f6312dd-493e-53c6-96e2-d901afca0e81">4</characteristic>
 </characteristics>
 </profile>
 </profiles>
 <rules><rule id="85f5b7fd-e672-5913-97b0-160e83c5e17c" name="Gets Hot" hidden="false"><description>After a Lance Turret or Twin Lance Turret resolves its attacks, roll a D6. On a 1 the firing ship loses 1 Hull Point. Each mount rolls separately.</description></rule><rule id="9b8e304c-2f84-5bea-9c1e-d89ea55e5481" name="Line" hidden="false"><description>Counts as a Line Ship for every rule that names one, and toward the fleet's Line minimum.</description></rule><rule id="c69523dd-d9be-5ed0-adba-d4a1a4d77491" name="Reload (X)" hidden="false"><description>After firing, place X Reload tokens on the mount; flip one at the end of each battle round. The mount cannot fire while it bears a token.</description></rule><rule id="8410a7e2-5bcc-5bfd-8f86-cdd46a44acca" name="Devastating (X)" hidden="false"><description>Each hit costs X Hull Points, or 1 Void Shield Rating against live shields.</description></rule><rule id="d2f435a7-7986-56dd-8136-fea052777be9" name="Armourbane" hidden="false"><description>Roll 2D6 + Strength to penetrate instead of 1D6, at 6″ or less, against shields or hull alike.</description></rule><rule id="c91fd289-c6ac-5b14-9172-99547cc5c47b" name="Point-Blank Broadsides" hidden="false"><description>At 6″ or less, Port, Starboard and Dorsal weapons improve AP by one step — or gain Armourbane instead if their printed AP is already 1. Prow weapons get neither.</description></rule><rule id="ee68a620-4395-5618-bdba-601b3d472981" name="Crippled" hidden="false"><description>Below half starting Hull Points: −1 BS and half Speed.</description></rule><rule id="ac0a48ad-c6b7-53fa-8424-0a384f9510ea" name="Depleted" hidden="false"><description>At half starting Crew or less: −1 BS. Stacks with Crippled.</description></rule><rule id="b8e58359-7e38-59f5-a2c5-c2923aa56309" name="Locked" hidden="false"><description>Joined by a ram. Neither ship may move; the rammer may not fire on its victim, who fires back at −1 BS. Break Away on 5+.</description></rule><rule id="510a6282-ec53-5043-9d99-a98060279188" name="Snap Shots" hidden="false"><description>Firing at BS 1 — hits only on a 6.</description></rule><rule id="1f7f79c2-c18b-521b-8317-611fd64912e9" name="Wreck" hidden="false"><description>0 Hull Points without exploding. Becomes impassable, obscuring terrain; never moves and never Evades.</description></rule><rule id="9a6a38a9-e426-568f-a79f-cb6336afcb5e" name="Held station" hidden="false"><description>Moved 1″ or less under Burn Retros. Broadsides fire at +1 BS; −1 on Evade.</description></rule><rule id="86c809e7-1180-5798-9030-b4dc012eea50" name="Independent Warship" hidden="false"><description>A Light Cruiser is taken singly and never forms a squadron. It is built to hunt, patrol and raid alone.</description></rule><rule id="4862c688-fdb0-5d10-81b0-f03838b57923" name="Light Hull" hidden="false"><description>A Light Cruiser may not mount Triple Lance Turrets; its dorsal mount takes a Lance Turret or a Twin Lance Turret only.</description></rule></rules><categoryLinks>
 <categoryLink id="7e6879e5-c5da-519b-ab62-0f8d8b41cb00" name="Line" hidden="false" targetId="96572996-e9b1-54a7-a2a9-2108e1dfc993" primary="true" />
 </categoryLinks>
 <selectionEntryGroups>
 <selectionEntryGroup name="Prow Mounts" id="7aac42f7-6362-5527-9183-b36f3785b2d0" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="5a2dad21-3a16-5aab-b77e-b85ceb8bd05b" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="f37d6030-adaf-5bf1-951c-9709584844bd" name="Torpedo Tube" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="2a978708-851f-5ef4-9b39-bc3183b8e15c" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="909a0431-36db-5d39-9237-050ac99a56df" name="Torpedo Tube" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Prow</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">9</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">2</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">60″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">One torpedo per tube. Bypasses Void Shields; Armourbane within 6″; Reload (2)</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Dorsal Mounts" id="86bd1985-7d41-5684-8c36-f31b06e2647b" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="11af5fb1-0d9e-570d-91de-d59505536c6f" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="5409a78e-9807-5d33-9ae1-262dbb3b9a03" name="Lance Turret" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="87df324b-2ae7-5541-b8e6-c6b2b665a731" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="b9405b0e-57a2-5b69-9e5a-86a15d33d130" name="Lance Turret" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Dorsal</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">10</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">1</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">46″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Gets Hot; Reload (1); Devastating (2)</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" /></costs></selectionEntry><selectionEntry id="b0b97770-985d-5388-a077-6fccb16c3b61" name="Twin Lance Turret" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="2b116bc9-30b6-59a8-bc9b-a64ef6608eeb" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="93e4d531-2931-5d48-b79e-e5713a843f99" name="Twin Lance Turret" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Dorsal</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">10</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">1</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">2</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">46″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Twin-Linked; Gets Hot; Reload (2); Devastating (2)</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="15.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Port Mounts" id="1d4e8a63-0f60-50a4-b97f-cfc20bbf8830" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="57997a02-5a0d-5e3f-af47-9df9bba46cc0" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="d54f0db9-b997-55a9-973d-12524cbc133e" name="Macrobattery (Port)" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="1e8d77b6-aeae-5449-b299-2aa3d529941b" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="56ea87f8-7dbc-5182-bceb-a552e95f38d3" name="Macrobattery (Port)" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Port</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">8</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">3</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">30″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">—</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" /></costs></selectionEntry><selectionEntry id="54fd2f9c-cd94-50ad-a44d-b54b5be78769" name="Heavy Macrobattery (Port)" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="54a3c13b-0835-5bd6-8fa5-49227f3d762b" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="bc57ab8d-cf31-5a7c-8c7e-07e1746226cb" name="Heavy Macrobattery (Port)" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Port</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">9</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">2</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">30″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">—</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="15.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Starboard Mounts" id="a6948ce0-35d6-57a4-a4b5-e6fa7e5695e5" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="04487324-77fb-5e21-ac1a-862ee988ab29" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="1079ae40-614b-5098-8b41-2c0b634c61e0" name="Macrobattery (Starboard)" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="7cccc678-295f-5c8e-9e06-eda780b2a02a" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="1fcf15a7-a3e0-5fe0-ae00-50b0ce785d9a" name="Macrobattery (Starboard)" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Starboard</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">8</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">3</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">30″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">—</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" /></costs></selectionEntry><selectionEntry id="bc3a08e8-2538-5f20-a7ef-72e51f97bbf3" name="Heavy Macrobattery (Starboard)" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="30dd9602-5cb6-5875-8392-9aa2cf685f52" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="012183f6-7cca-561c-b3d6-d3c539b8a9d2" name="Heavy Macrobattery (Starboard)" hidden="false" typeId="9e230bf6-0ca5-