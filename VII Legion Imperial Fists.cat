 <selectionEntryGroup name="Hull Upgrades" id="30aad8f6-0d4b-587c-8b0e-745bb1349f08" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="5.0" field="selections" scope="parent" shared="false" id="7cfaeb0c-9c07-5ebd-b61c-5d08467c5166" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="ea159dcf-61b4-585f-974a-fea0abd18aab" name="Reinforced Magazine Compartments" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="fec1864b-8a49-533b-a652-450ee8b3610e" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="131c9fd3-1356-5d92-b642-b626c4e1bf65" name="Reinforced Magazine Compartments" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Damage Control caused by a Magazine Explosion by 1, to a minimum of 0. A Twin Lance Turret that would suffer 1 Damage Control instead suffers 0 and ignores the effect; a Triple Lance Turret that would suffer 2 instead suffers 1. No other effect of a Magazine Explosion is prevented or reduced. Once per ship. Not available to Gloriana class or above.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="20.0" /></costs></selectionEntry><selectionEntry id="d99a27bc-38e3-5f54-add5-bbe642e6a4f2" name="Enhanced Void Shield Array" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="2d6c5e59-9cf3-56e1-84a4-5cd662b37f5b" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="3f7c6efb-84c9-5585-a20a-24fa2b83dc79" name="Enhanced Void Shield Array" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">At the end of each battle round this ship regains 1 lost Void Shield, provided its Void Shields are currently active. It can never exceed its normal maximum. If its Void Shields have completely collapsed, been disabled, or are otherwise inactive, this upgrade cannot regenerate them; once at least one Void Shield is restored and the shields are active again, it resumes functioning normally. Once per ship. Not available to Gloriana class or above.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="30.0" /></costs></selectionEntry><selectionEntry id="a3c91639-c3d8-5266-9f13-8d638629af43" name="Autoloaders" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="6a627d38-8d8f-525a-9b08-a41ee956125e" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="6e4f54cd-3e70-5d92-a690-51e8cbbf6da3" name="Autoloaders" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Reload value of every weapon and system aboard this ship by 1, to a minimum of Reload 0 — Reload (3) becomes Reload (2), Reload (2) becomes Reload (1), Reload (1) becomes Reload (0). A weapon reduced to Reload (0) has no cooldown and may fire every applicable battle round. Once per ship. Not available to Gloriana class or above.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="40.0" /></costs></selectionEntry><selectionEntry id="d12283b7-b0b2-5529-b5f2-ecafc3fd1927" name="Side Armour Reinforcement" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="f7c90cd5-3f5c-56c4-b65e-ba0b60553db4" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="29616e7b-218b-5d7e-8196-77a9057b5aaa" name="Side Armour Reinforcement" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="30.0" /></costs></selectionEntry><selectionEntry id="a8f39fb9-48e6-58bc-8cf5-e18155ae52c3" name="Engine Refit" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="fc5a598f-1b94-5fd2-9bea-26f9bab25a61" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="05e6f692-550e-5430-adad-6b65954154b5" name="Engine Refit" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="40.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
 <costs>
 <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" />
 </costs>
 </selectionEntry>
 </selectionEntries>
 <selectionEntryGroups><selectionEntryGroup name="Hull Upgrades" id="59bbd5f2-4491-5deb-b98e-7d42a2e3f69d" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="3.0" field="selections" scope="parent" shared="false" id="5092f873-20aa-5359-9ccd-f9d3aaa27565" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="fac48ac8-d478-5458-ac42-b2745703c764" name="Reinforced Magazine Compartments" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="11e819d6-8151-5cf6-8e7d-aa5821f22754" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="30cad8fc-3289-50b9-93c8-f87b95c986d7" name="Reinforced Magazine Compartments" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Damage Control caused by a Magazine Explosion by 1, to a minimum of 0. A Twin Lance Turret that would suffer 1 Damage Control instead suffers 0 and ignores the effect; a Triple Lance Turret that would suffer 2 instead suffers 1. No other effect of a Magazine Explosion is prevented or reduced.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="50.0" /></costs></selectionEntry><selectionEntry id="b3076b92-5a94-510c-b178-27e49affed4c" name="Enhanced Void Shield Array" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="43d7dae5-61e1-5ecc-b764-5633a2463f8f" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="f5a49ddb-26dd-534a-afc9-33e06c741548" name="Enhanced Void Shield Array" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">At the end of each battle round this ship regains 1 lost Void Shield, provided its Void Shields are currently active. It can never exceed its normal maximum. If its Void Shields have completely collapsed, been disabled, or are otherwise inactive, this upgrade cannot regenerate them; once at least one shield has been restored by other means and the shields are active again, it resumes functioning normally.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="75.0" /></costs></selectionEntry><selectionEntry id="e2603f12-1b91-55d5-a5ed-92927d8b6346" name="Autoloaders" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="0027d338-ece5-5507-84b8-f17ab379cb1a" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="1a606d09-83fa-5517-8ef5-6ea450f1fbd3" name="Autoloaders" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Reload value of all weapons and systems aboard this ship by 1, to a minimum of Reload 0. Reload (3) becomes Reload (2), Reload (2) becomes Reload (1), and Reload (1) becomes Reload (0). A weapon at Reload (0) has no cooldown and may fire every applicable battle round.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="100.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry>
 <selectionEntry id="e14ddbb4-2776-5882-bfcd-130b9832d209" name="Frigates" hidden="false" collective="false" import="true" type="unit">
 <constraints><constraint type="max" value="5.0" field="selections" scope="roster" shared="false" id="f39b5b93-a2d6-5abf-93c1-79379caf09c8" percentValue="false" includeChildSelections="false" includeChildForces="true" /></constraints><profiles /><categoryLinks>
 <categoryLink id="94811f93-ef90-520b-8352-659db261ab2c" name="Line" hidden="false" targetId="96572996-e9b1-54a7-a2a9-2108e1dfc993" primary="true" /></categoryLinks>
 <selectionEntries>
 <selectionEntry id="946cf774-05ce-5995-aa4f-036611750bab" name="Frigate" hidden="false" collective="false" import="true" type="model">
 <constraints>
 <constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="3e9fd33e-51c7-5c0b-9d36-3507db1c0771" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="3.0" field="selections" scope="parent" shared="false" id="733df866-2a10-5604-9ebf-4e85818797d0" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints>
 <profiles>
 <profile id="2452ae6d-6fcd-5a9c-bcbd-d62b9af324b2" name="Frigate" hidden="false" typeId="806f9ff1-fd51-5ddb-b005-ce73a5d09d65" typeName="Ship">
 <characteristics>
 <characteristic name="BS" typeId="d130e705-611e-5a0a-bd7d-ea8e848fdb2e">3</characteristic>
 <characteristic name="Prow" typeId="84a55377-edbc-5825-a2bf-70c6155018f2">11</characteristic>
 <characteristic name="Side" typeId="5f595433-7397-5c4b-9d4a-8f35d83a2b29">10</characteristic>
 <characteristic name="Stern" typeId="cd9ec76e-f959-5560-8845-9ab242f16e71">9</characteristic>
 <characteristic name="HP" typeId="ef713781-2034-5fb4-83d1-e49d1d683694">4</characteristic>
 <characteristic name="VS" typeId="84309751-688d-50ef-8940-d8d042261a56">2</characteristic>
 <characteristic name="Speed" typeId="25d0e01e-8e74-55b3-8a2a-17773c881625">12″</characteristic>
 <characteristic name="Turn" typeId="899e9c58-70ef-5da5-8495-5bf6a8b7f8f0">90°</characteristic>
 <characteristic name="Crew" typeId="2f6312dd-493e-53c6-96e2-d901afca0e81">3</characteristic>
 </characteristics>
 </profile>
 </profiles>
 <rules><rule id="9108c81d-4847-5e81-9471-f660bebd79d2" name="Intervention" hidden="false"><description>Costs no order. When a friendly ship within 3″ is attacked, rammed, or targeted by torpedoes, this ship may thrust into the firing line from up to 10″ of the attacker: it does not move, and the whole attack resolves against it instead. Once per battle round.</description></rule><rule id="2885ab07-5d1f-519c-b6d1-86bd115a6569" name="Gets Hot" hidden="false"><description>After a Lance Turret or Twin Lance Turret resolves its attacks, roll a D6. On a 1 the firing ship loses 1 Hull Point. Each mount rolls separately.</description></rule><rule id="cc5e218e-cab0-597e-84b9-937b2cc8de3d" name="Line" hidden="false"><description>Counts as a Line Ship for every rule that names one, and toward the fleet's Line minimum.</description></rule><rule id="829cf475-10b1-5f47-9e00-be78f3580607" name="Reload (X)" hidden="false"><description>After firing, place X Reload tokens on the mount; flip one at the end of each battle round. The mount cannot fire while it bears a token.</description></rule><rule id="c5019b42-3569-5e08-a025-767af023b996" name="Devastating (X)" hidden="false"><description>Each hit costs X Hull Points, or 1 Void Shield Rating against live shields.</description></rule><rule id="afe669c2-3d12-5d97-8765-e24d6e4d0adf" name="Armourbane" hidden="false"><description>Roll 2D6 + Strength to penetrate instead of 1D6, at 6″ or less, against shields or hull alike.</description></rule><rule id="ff8d16f6-29ef-5e91-855c-260b868e6210" name="Point-Blank Broadsides" hidden="false"><description>At 6″ or less, Port, Starboard and Dorsal weapons improve AP by one step — or gain Armourbane instead if their printed AP is already 1. Prow weapons get neither.</description></rule><rule id="280b4a0a-4728-56a9-aa1e-0123bd7b89b0" name="Crippled" hidden="false"><description>Below half starting Hull Points: −1 BS and half Speed.</description></rule><rule id="5a13065c-b26d-56da-b831-6a1704e49950" name="Depleted" hidden="false"><description>At half starting Crew or less: −1 BS. Stacks with Crippled.</description></rule><rule id="bb75fd54-8dab-56c2-9146-a81991197cff" name="Locked" hidden="false"><description>Joined by a ram. Neither ship may move; the rammer may not fire on its victim, who fires back at −1 BS. Break Away on 5+.</description></rule><rule id="9882edf9-1e9c-5d58-b1f6-5e61f04e4a22" name="Snap Shots" hidden="false"><description>Firing at BS 1 — hits only on a 6.</description></rule><rule id="bcefc7bb-07f4-5f12-a744-8899b9c1d699" name="Wreck" hidden="false"><description>0 Hull Points without exploding. Becomes impassable, obscuring terrain; never moves and never Evades.</description></rule><rule id="8d372a82-49f1-5ef2-a4db-229a3eb70e72" name="Held station" hidden="false"><description>Moved 1″ or less under Burn Retros. Broadsides fire at +1 BS; −1 on Evade.</description></rule><rule id="1fada64d-a4f0-52de-bed0-122cc2df6cb0" name="Screen" hidden="false"><description>A friendly Capital Ship within 3″ of one or more friendly Frigates is harder to pick out of the formation: enemy ships suffer −1 BS when targeting it. Screen protects only friendly Capital Ships, never the Frigate itself, and multiple Frigates do not stack — the modifier is never worse than −1.</description></rule><rule id="e15ff993-89d2-53c8-bb03-fba8ebbbaaaf" name="Squadron" hidden="false"><description>Squadron: this vessel is taken singly, and up to 3 may be grouped into one squadron. A squadron moves and shoots as one unit and must keep coherency, each ship within 6″ of another in the squadron. It may split its fire, but every ship fires all of its own weapons at the one target it chooses.</description></rule></rules><categoryLinks>
 <categoryLink id="54d21251-8c57-57bf-9f03-839d63f8dbe3" name="Line" hidden="false" targetId="96572996-e9b1-54a7-a2a9-2108e1dfc993" primary="true" />
 </categoryLinks>
 <selectionEntryGroups>
 <selectionEntryGroup name="Prow Mounts" id="aa476c4a-c66f-5c88-9af7-a8eb62878ede" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="e7af649e-0675-5210-a536-888386249374" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="8e200672-8da2-5ee9-b68e-daa88726a6e5" name="Torpedo Tube" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="cb1b53c6-6cbf-5110-888f-f578fb95995c" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="cafca8fc-94da-5cec-8c61-e45a72000b2b" name="Torpedo Tube" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Prow</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">9</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">2</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">60″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">One torpedo per tube. Bypasses Void Shields; Armourbane within 6″; Reload (2)</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Port Mounts" id="e29e3e06-2975-5090-b5e3-3930a34dda57" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="e0169dbd-0910-5427-9968-a042159565bd" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="7223af13-51c1-55bc-95dc-540fd225c1bc" name="Macrobattery (Port)" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="0c7627d4-612f-5380-9ac6-e24933429c58" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="78552db0-90e2-5fe4-90c8-9b4486940b53" name="Macrobattery (Port)" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Port</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">8</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">3</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">30″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">—</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Starboard Mounts" id="f885fa12-6aac-5854-9407-03d649dfdae1" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="7a108311-f1e0-5258-a734-f1d93b8f27ec" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="7dc83abc-c645-576a-9f5a-972375bc2139" name="Macrobattery (Starboard)" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="634130fe-f967-5bec-a553-c28fa62b761e" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="539ceaa2-069b-53ee-a99e-900e664d8c70" name="Macrobattery (Starboard)" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Starboard</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">8</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">3</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">30″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">—</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Crew Upgrade" id="943c1de8-01db-5dae-9780-53fbb9f185b5" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="0df9c6e5-eb11-5b98-8e8f-5d546ee6aa07" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="48cde18b-b43c-5a27-929e-6fc7728aa8ef" name="Veteran Crew - Frigate" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="eb65a4d7-c32c-5571-b2b7-1bee828c5a41" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="b344848f-cf9c-573c-a465-f58e0c3d1a5a" name="Veteran Crew" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Once per ship. +1 BS, to maximum BS 5.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="55.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Stern Mounts" id="cfbaff97-0137-58fe-8dc2-326cec99af55" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="0b16af27-a0eb-5c06-8ce1-fb8a704e4a03" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="7b099ca0-730a-593c-9e69-0b17b05e651d" name="Melta Mine Layer" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="27b96b59-b2b6-5f7c-a3d7-8bc0203ac054" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="4c3728fa-8dad-5942-a5dd-5f06b9d7e1d0" name="Melta Mine Layer" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Stern</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">9</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">2</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">3″ blast</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Armourbane. Carries 2 mines; Reload (2). Laid on a 32mm base instead of shooting. Triggers when any part of a non-Frigate ship passes over it: every ship within 3″ — including the ship that triggered it — suffers one hit resolved against its Armour. Aircraft pass over mines safely. Remove the mine once the attack is resolved.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="20.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Defence Mounts" id="5d85042b-9896-5297-a9e3-1262b47266a2" hidden="false" collective="false" import="true">
 <constraints>
 <constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="8708cc11-e46b-5356-b2c3-f0d158b9ffd4" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints>
 <selectionEntries>
 <selectionEntry id="f45a348f-8563-5853-9527-655a7a3ca8ed" name="Defence Battery" hidden="false" collective="false" import="true" type="upgrade">
 <constraints>
 <constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="b4d72482-b25f-5667-82ec-479308c0351d" percentValue="false" includeChildSelections="false" includeChildForces="false" />
 </constraints>
 <profiles>
 <profile id="64360217-fce5-5dee-84e0-7131e1e40af5" name="Defence Battery" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
 <characteristics>
 <characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">All-round</characteristic>
 <characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">6</characteristic>
 <characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">5</characteristic>
 <characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3</characteristic>
 <characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">12″</characteristic>
 <characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Skyfire; Interceptor. Aircraft to 12″; ships within 6″</characteristic>
 </characteristics>
 </profile>
 </profiles>
