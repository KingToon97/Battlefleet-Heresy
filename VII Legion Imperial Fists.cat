 </constraints>
 <profiles>
 <profile id="393181cf-3ef6-475a-91f8-82b3f978c4ae" name="Sigismund" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding parties gain +1 when attacking enemy flagships.</characteristic>
 </characteristics>
 </profile>
 <profile id="fda97251-93cd-49a5-9551-e6a2609cc414" name="Primarch Retinue" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This character is embarked as the Primarch's additional named retinue. They do not add Fleet Orders, Command range or any command ability; only effects unrelated to the order economy apply.</characteristic></characteristics></profile></profiles>
