 <constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="b65e9c0c-62eb-421f-b55e-c700dbb3944b" percentValue="false" includeChildSelections="false" includeChildForces="false" />
 <constraint type="max" value="8.0" field="selections" scope="parent" shared="false" id="ab8ca187-cd19-4067-a1f9-7e40b3b2a171" percentValue="false" includeChildSelections="false" includeChildForces="false" />
 </constraints>
 <profiles>
 <profile id="55ab3373-cc33-452d-a6eb-d03f6f063658" name="Boarding Force" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Counts as 2 Crew; fights as one warrior at +2 and gives −1 to the enemy die it faces. Limits as Terminators.</characteristic>
 </characteristics>
 </profile>
 </profiles>
 <categoryLinks>
 <categoryLink id="42261c60-9caf-4eab-9a52-3019aa451826" name="Boarding Force" hidden="false" targetId="4d94b920-d5bc-5fd7-a967-4ba346019f56" primary="true" />
 </categoryLinks>
 <costs>
 <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="80.0" />
 </costs>
