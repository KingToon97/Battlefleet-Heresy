 <constraint type="max" value="8.0" field="selections" scope="parent" shared="false" id="2f9c75c2-8153-5e18-aa01-bcb86c14c343" percentValue="false" includeChildSelections="false" includeChildForces="false" />
 </constraints>
 <profiles>
 <profile id="265ac883-6823-53cc-a46d-34fe08a9aef5" name="Boarding Force" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Counts as 2 Crew; fights as one warrior at +2 and gives −1 to the enemy die it faces. Limits as Terminators.</characteristic>
 </characteristics>
 </profile>
 </profiles>
