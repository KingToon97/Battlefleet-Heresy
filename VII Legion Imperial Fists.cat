<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="1bc59021-41d2-5a8f-8ca0-79a41227bcbf" name="VII Legion Imperial Fists" revision="8" battleScribeVersion="2.03" gameSystemId="86405571-5289-597b-b308-a9a2d68c00b9" gameSystemRevision="5" library="false">
