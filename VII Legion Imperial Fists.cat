      </constraints>
    <profiles>
        <profile id="571e5b31-b5f9-4aa3-a342-64d226cc6d4c" name="Rogal Dorn" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Primarch. Friendly ships within 12″ improve Prow Armour by +1 to max 14. Demigod of War +3.</characteristic>
          </characteristics>
        </profile>
      <profile id="5f39ed0b-8fda-4ce5-993e-0bc332ff797a" name="Primarch Embarkation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">May only be selected in a 2,000+ point fleet and must ride this Legion's Gloriana as Fleet Commander. Rogal Dorn may instead ride the Phalanx where permitted.</characteristic></characteristics></profile></profiles>
      <categoryLinks>
        <categoryLink id="0334aa77-5403-4b30-968e-1f3b2451859e" name="Commander" hidden="false" targetId="6f3339ad-23a9-5687-b08f-3f11a43fe50b" primary="true" />
      <categoryLink id="c14bb495-8816-4252-9bc0-d8ed20ffbcdc" name="Primarch" hidden="false" targetId="aa8f9cca-79d6-4483-b466-901fa59a2823" primary="false" /></categoryLinks>
      <costs>
