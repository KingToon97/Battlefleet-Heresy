 </selectionEntries>
 </selectionEntryGroup>
 <selectionEntryGroup id="71199a43e61183594e3dc6ebb38df76d" name="Hull Upgrades" hidden="false"><constraints><constraint type="max" value="6.0" field="selections" scope="parent" shared="false" id="1d55ccb2-60ed-5112-a83e-239332ea0d67" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="df3dcf49ed4a1aba49ea8bd6debe2aac" name="Side Armour Reinforcement" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="a4371c97334386ebb28b7dc5e13a1d46" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="ed84bf7fbfad9731f4ba03b15a45f14d" name="Side Armour Reinforcement" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="120.0" /></costs></selectionEntry><selectionEntry id="ca06c96620546e7370b976b4e5cf6298" name="Engine Refit" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="45668f77eb2dc0591aba1bb3561cc253" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="f4601d88a92a6b2e020aebd17cdf8df5" name="Engine Refit" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="160.0" /></costs></selectionEntry><selectionEntry id="3fdd11a2-ad88-5d31-a677-4e8da3f0175e" name="Phosphex Shells" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="177173cf-f603-5387-9141-ec070d57ff5b" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="d7181c32-abfa-5eeb-8a37-3ab21496ed5a" name="Phosphex Shells" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Every Heavy Macrobattery aboard fires phosphex: whenever one penetrates armour, the target takes 1 Critical Damage. Requires at least one Heavy Macrobattery.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="80.0" /></costs></selectionEntry><selectionEntry id="e7ee40f5-a4f8-5645-820f-c8c629679933" name="Reinforced Magazine Compartments" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="0005a05a-93ac-5664-a056-f98940bbf834" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="89fad4a7-fde8-5114-b01b-a3734cce9907" name="Reinforced Magazine Compartments" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Damage Control caused by a Magazine Explosion by 1, to a minimum of 0. A Twin Lance Turret that would suffer 1 Damage Control instead suffers 0 and ignores the effect; a Triple Lance Turret that would suffer 2 instead suffers 1. No other effect of a Magazine Explosion is prevented or reduced. Once per ship. Not available to Gloriana class or above.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="80.0" /></costs></selectionEntry><selectionEntry id="f62c47ce-08c8-5180-bf20-ff527bc64c5d" name="Enhanced Void Shield Array" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="c133d090-75a9-596c-b1ba-12233a2bba7b" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="d7af7754-ea4b-5313-8f5b-9e922f9bb35f" name="Enhanced Void Shield Array" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">At the end of each battle round this ship regains 1 lost Void Shield, provided its Void Shields are currently active. It can never exceed its normal maximum. If its Void Shields have completely collapsed, been disabled, or are otherwise inactive, this upgrade cannot regenerate them; once at least one Void Shield is restored and the shields are active again, it resumes functioning normally. Once per ship. Not available to Gloriana class or above.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="120.0" /></costs></selectionEntry><selectionEntry id="3634a890-61db-5114-a353-48e0d642975a" name="Autoloaders" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="a30cb00d-b30d-58ea-92fa-3b3822d9d9d5" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="2b5ddca0-7ee0-58d8-a5b7-e427b9d5a131" name="Autoloaders" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Reload value of every weapon and system aboard this ship by 1, to a minimum of Reload 0 — Reload (3) becomes Reload (2), Reload (2) becomes Reload (1), Reload (1) becomes Reload (0). A weapon reduced to Reload (0) has no cooldown and may fire every applicable battle round. Once per ship. Not available to Gloriana class or above.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="160.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
 <costs>
 <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="180.0" />
 </costs>
 </selectionEntry>
 <selectionEntry id="55da3a08-865f-55bc-abb5-3f7f25e010e1" name="Core Rules" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="force" shared="false" id="cc895f53-7b5e-52ab-99c5-1d6adbed1b65" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><rules><rule id="9df2d3e1-98d3-5ce9-b4a7-73d74d5485ce" name="The Battle Round" hidden="false"><description>1. Muster — flip Reload tokens and remove any reaching 0, refresh the fleet's Fleet Order allowance, declare Reactor Overloads. In the first battle round roll off for Initiative; in every later round it passes to whoever finished the previous round. The holder moves, shoots and rams first for the whole round. 2. Movement — alternate one ship each, then one aircraft squadron each. 3. Shooting — alternate one ship or squadron each. 4. Ramming &amp; Boarding — alternate one ship each. 5. End of round — resolve dogfights, then Critical Damage. A game lasts six rounds, and every duration runs to the end of the battle round unless it names something else.</description></rule><rule id="55d875c5-8e5f-5bb2-b559-f33e36045920" name="Movement" hidden="false"><description>A ship moves at least half its Speed and never more than 12″ (All Ahead Full excepted). It may make one turn per battle round, up to its Turn value, taken either at the start or at the end of its move — no straight run is required before turning. Ships may never overlap unless a Ram is declared; accidental contact stops the moving ship 1″ short.</description></rule><rule id="3f8e6e25-f919-50c1-9c9d-3cda516bc35a" name="Shooting" hidden="false"><description>A ship fires everything that bears at one enemy ship each round — it never divides its fire, though a squadron may. Roll a D6 per shot, hitting on 7 − BS. A natural 1 always misses and no modifier lowers the roll below 2+. Modifiers: target is a wreck +1 — a hulk cannot dodge. A ship that held station under Burn Retros fires its Port and Starboard broadsides at +1 BS.</description></rule><rule id="db055860-f3d2-5ef2-a6ee-475ecbd9e4de" name="Void Shields" hidden="false"><description>While Void Shield Rating is above 0 the shields are Armour Value 12 and every hit strikes them rather than the hull. Roll 1D6 + Strength against AV 12; equal or better collapses one layer and does nothing else — no Hull Points, no Damage Table. There is no save. At VS 0 the shields collapse permanently, with no restoration or repair, and AP applies in full. Torpedo Tubes, Melta Mines and the Abyss's Warp Lance Batteries bypass shields entirely. Nothing else does.</description></rule><rule id="5168186a-f2a6-5bf9-9c5f-7502784621c0" name="Penetration" hidden="false"><description>For each hit past the shields, roll 1D6 + Strength against the Armour Value of the facing struck. Equal = Glancing Hit: 1 Hull Point, no damage roll. Greater = Penetrating Hit: 1 Hull Point and a roll on the Damage Table. No Armour Value may exceed 14 by any means.</description></rule><rule id="f2d6270d-f251-598e-a9f4-f079c3f5c56c" name="Point-Blank Broadsides" hidden="false"><description>At 6″ or less, Port, Starboard and Dorsal weapons improve their AP by one step — a Macrobattery to AP 2, a Heavy Macrobattery to AP 1. A weapon whose printed AP is already 1 gains Armourbane instead. Never both, and Prow weapons get neither.</description></rule><rule id="2684fd63-9b98-55eb-8029-a6bf453278b2" name="Stern Strike" hidden="false"><description>When a Strength 9+ weapon rolls a natural 6 on its penetration die against a target's Stern and beats the Stern AV, the hit also inflicts Engines Crippled at once. With Armourbane at least one of the two dice must show a 6. It does not stack with an Engines Crippled already rolled, and while shields hold the hit must bring them down first.</description></rule><rule id="1474277b-fb53-5634-a777-489538692352" name="Ship Damage Table" hidden="false"><description>1 Held — nothing further happens. 2 Blaze — the ship gains 1 Critical Damage. 3 Hull Breach — the ship gains 1 Critical Damage. 4 Magazine Explosion — 1 Hull Point (2 if it mounts Triple Lance Turrets), 1 Critical Damage, and a random Port, Starboard or Dorsal weapon system destroyed. 5 Engines Crippled — immobile and Snap Shots only until repaired; a second leaves it Adrift. 6 Reactor Struck — a Line Ship suffers a Catastrophic Explosion at once; a Capital Ship takes D3 Hull Points then rolls a D6, detonating on a 6; a Gloriana or larger takes D3 and rolls 2D6, detonating if either die shows a 6. Modifiers: AP 2 +1 · AP 1 +2 · Destroyer +3, in place of any AP modifier (+2 against a Gloriana, the Abyss or the Phalanx) · Ramming +1 · Battleship target −1. A modified 7+ counts as Reactor Struck; below 1 counts as 1, and a 1 does nothing.</description></rule><rule id="3d1710e5-46d2-586c-9ba6-dccb0393ed1c" name="Destruction" hidden="false"><description>At 0 Hull Points roll a D6 once: on a 6 the ship is torn apart in a Catastrophic Explosion and every ship within the blast radius suffers one hit against its nearest facing — Str 8 AP 3 from a Line Ship, Str 9 AP 2 from a Capital Ship or Void Fortress. On any other result it becomes a wreck. Blast radius: Destroyer, Frigate or Assault Barge 3″ · Cruiser D6″ · Grand Cruiser or Battle Barge D6+3″ · Battleship or Gloriana 2D6″ · Abyss 3D6″.</description></rule><rule id="0b555cc6-7dc5-587f-af07-95da9846c77b" name="Ramming" hidden="false"><description>Free, needing no Fleet Order, against one enemy within 6″ of the rammer's prow. Roll a D6, −1 if the rammer mounts a prow Nova Cannon bought as an upgrade; the ram connects if it equals or beats the distance in inches. The target may Evade on 5+. On impact the target suffers one hit at Strength = the rammer's Prow AV, ignoring Void Shields, penetrating on 1D6 + Str with no Armourbane; a hit that glances or penetrates inflicts D6 Hull Points and a penetrating hit rolls on the Damage Table at +1. The rammer loses D3 Hull Points. Survivors remain Locked.</description></rule><rule id="71d9c2a7-008c-5c01-9ca0-a8cf999dee3c" name="Fleet Orders" hidden="false"><description>Only the Flagship issues orders, within 24″ Command range measured from the Flagship as it stands, itself included. No order needs a test. Three types — Command, Movement, Shooting — each issued up to the number set by the commander's rank per round: Captain 1, Named Character 2, Primarch 3. No ship takes two orders of the same type in a round, ranks never combine, and nothing adds to the allowance. Unspent orders do not carry over. Command: Damage Control, Focus Fire, Brace for Impact. Movement: All Ahead Full, Burn Retros, Evade. Shooting: Reload Ordnance, Return Fire, Overwatch.</description></rule><rule id="15e474e5-420a-5815-b161-249b92188edd" name="Reactions" hidden="false"><description>Brace for Impact, Return Fire and Overwatch are Fleet Orders with a trigger, issued the moment a friendly ship is attacked or targeted, whether or not that ship has already acted. They count against the round's allowance however many ships are under fire — an order spent defending is one you no longer have for your own turn.</description></rule><rule id="b7909ecd-0e91-5a89-b96c-59eb5a4a8415" name="Evade" hidden="false"><description>A Movement order, declared when the ship is shot at or rammed and before any dice are rolled. Roll a D6: on a 5+ the whole attack misses, or the ram fails and the rammer is moved 1″ past its intended victim. Modifiers: +1 Destroyer or Frigate · −1 held station · −1 Crippled, Adrift or Engines Crippled · −1 mounting no standard Macrobatteries. Never worse than −2. Once per battle round; wrecks and Speed 0 installations never Evade.</description></rule><rule id="ff70d1aa-8833-5f7d-a572-4b8ea307b833" name="Boarding Actions" hidden="false"><description>Crew are the hit points of boarding, and an action begins and ends in one Ramming &amp; Boarding step. Declare the Crew committed and the delivery method, then deduct them; a ship always keeps 1 aboard. Every fighter rolls his own D6 with his own bonus, and bonuses never combine into one roll. Starting with the boarders, players alternate nominating duels: the higher total fells its opponent, and ties re-roll until one is higher. Fight on until one side reaches 0 Crew or the boarders withdraw. Defenders reduced to 0 lose the ship — Capture or Scuttle. Modifiers to every die on that side: +1 boarders in the first round if delivered by craft, pod or teleport (never a Hull Assault) · +1 boarders if the enemy ship is Crippled · +1 boarders if it is Engines Crippled · −1 defenders if the ship carries any Critical Damage.</description></rule><rule id="530ccc41-3708-5c58-a3b7-2ed59da7d639" name="Hit-and-Run" hidden="false"><description>Instead of a full boarding, commit 1 Crew — so never a Dreadnought, which is two. Roll D6 plus the raider's own bonus. On 4+ choose one: destroy one weapon system or Hangar Bay; inflict 1 Critical Damage; cripple the enginarium (Engines Crippled); or sabotage the shields, reducing VS Rating by D3, or D6 against a Capital Ship, permanently. The raider returns. On a failure the raider is lost.</description></rule><rule id="9d5905db-0fbb-504e-88c0-09b175968076" name="Attrition" hidden="false"><description>There is no Morale. Ships do not flee and take no tests — they fight until wrecked, taken, or the battle ends, and they fight worse as they break down. Crippled and Depleted stack, so a ship can fire at −2. Broken Fleet: once three quarters of a fleet's starting points are lost it loses the battle at once. Count a lost ship at full cost, upgrades and any Fleet Commander aboard included; aircraft never count.</description></rule><rule id="8711f203-0e7a-5bdc-927d-b14769d0854f" name="Fleet Construction" hidden="false"><description>Capital Ship allowance is generated by Line Ships: for every 4 individual Line Ships in the fleet you may include 1 Capital Ship. 0–3 Line Ships permit no Capital Ship; 4–7 permit 1; 8–11 permit 2; 12–15 permit 3, and so on — maximum Capital Ships = Line Ships ÷ 4, rounded down. Individual vessels count, not roster entries: a squadron of four Destroyers is four Line Ships. Line Ships are the Destroyer, Frigate, Light Cruiser, Assault Barge and Cruiser. Capital Ships are the Grand Cruiser, Battle Barge, Battleship, Emperor Battleship, Gloriana and Abyss, and the Phalanx above them. No single ship may exceed 50% of the fleet's points, upgrades included. Destroyers and Frigates have the Squadron keyword: each is taken singly, and up to 3 may be grouped into one squadron. Minimum game size: Gloriana 2,000; Abyss and Phalanx 3,000.</description></rule><rule id="a8aa5a47-95b8-5be7-95b1-ff3bd4e99035" name="Veteran Crews &amp; Commanders" hidden="false"><description>Any ship may take a Veteran Crew once: +1 Ballistic Skill for the battle, 60 pts for a Line Ship and 150 pts for a Capital Ship. No ship exceeds BS 5, and a ship takes at most one +1 BS from position or command — Firing at anchor, Focus Fire and accuracy auras never stack with each other. A Veteran Crew's +1 is a paid upgrade and stacks on top. Every fleet has exactly one commander, the highest rank present, riding the Flagship and lost if that ship is destroyed, captured or wrecked. Each rank carries its own command ability: Ship’s Master, Practised Command, or The Fleet Obeys.</description></rule><rule id="c27a7442-7a78-5b95-8a35-a3b9aef3d256" name="Keyword: Armourbane" hidden="false"><description>Roll 2D6 + Strength to penetrate instead of 1D6, at 6″ or less, against shields or hull alike. Torpedo Tubes and the Starhawk's plasma bombs carry it outright; a broadside or dorsal weapon of printed AP 1 gains it inside 6″ in place of the AP step it cannot take. Macrobatteries never gain it, and neither do rams — the Conqueror's Ursus Claws excepted. Destroyer weapons never roll to penetrate, so it does nothing for them.</description></rule><rule id="d8bd8d44-eadf-5370-9b2e-fd3ce1cd9619" name="Keyword: Destroyer (D)" hidden="false"><description>Any weapon of Strength D or AP D. It penetrates automatically — no roll, whatever the Armour Value — and can never merely glance. Every Damage Table roll it causes is made at +3 in place of any AP modifier, or +2 against a Gloriana, the Abyss or the Phalanx. It is always at least Devastating (3). It does not pass Void Shields: while they hold it beats AV 12 automatically and collapses 3 layers, and does nothing else.</description></rule><rule id="c1fa8a15-38db-5304-ad17-ffe68942e7cc" name="Keyword: Devastating (X)" hidden="false"><description>Each unsaved hit costs the target X Hull Points instead of 1, whether it glances or penetrates. A penetrating Devastating hit still rolls once on the Damage Table, keeping its AP modifier. Against active shields a Devastating hit still costs only 1 Void Shield Rating, however large its X.</description></rule><rule id="323539a2-f572-59ec-a7d8-9866b9c6c9b4" name="Keyword: Gets Hot" hidden="false"><description>After a Lance Turret or Twin Lance Turret has resolved its attacks, roll a D6. On a 1 the firing ship suffers 1 Hull Point. Each mount rolls separately. Self-inflicted rolls have no attacker or facing: the owning player makes any choices, from any facing, but must choose a functioning system.</description></rule><rule id="51a4a797-a6ce-5238-9779-7e338dbe6b02" name="Keyword: One Shot" hidden="false"><description>Fired once per battle, then spent. It takes no Reload tokens.</description></rule><rule id="a3821ec7-b13d-569b-93e8-25de8e754a13" name="Keyword: Reload (X)" hidden="false"><description>After firing, place X Reload tokens on the mount. Flip the token at the end of each battle round — 2 becomes 1 — and remove it when it would reach 0. The mount cannot fire while it bears a token, so Reload (1) speaks every round and Reload (2) every second. The Reload Ordnance order removes one counter early.</description></rule><rule id="b54f1a5f-0d69-5568-ad47-9ea11ba36dab" name="Keyword: Skyfire" hidden="false"><description>Fires at full Ballistic Skill against aircraft.</description></rule><rule id="6b7c8444-668f-5f36-bacf-fbda32643691" name="Keyword: Twin-Linked" hidden="false"><description>Re-roll failed To Hit rolls.</description></rule><rule id="5405e394-9d52-5638-8485-08dd1e26b886" name="Keyword: Volatile" hidden="false"><description>An unmodified 1 To Hit resolves the attack against the firing ship instead, at the full profile — against the facing the launcher is mounted in. The launcher is spent either way.</description></rule><rule id="c2f69781-03f2-595e-b534-13fdd6f9fee5" name="Keyword: Critical Damage" hidden="false"><description>Fires, breaches and burning phosphex — one rule for all of them. A ship may carry up to 3 Critical Damage, marked with a single token. At the end of each battle round it loses 1 Crew for each Critical Damage it carries, always, with no roll. A successful Damage Control order clears the whole stack at once.</description></rule><rule id="d308ef1e-396c-5f40-ad1a-0322e023df40" name="Mounts &amp; Arcs" hidden="false"><description>Prow — the forward 90° arc. Port / Starboard — that side's 90° arc; these are the broadsides. Dorsal — every arc but the Stern; counts as a broadside for Point-Blank Broadsides, but gains no Firing at anchor bonus. All-round — every arc. Straight ahead — Torpedo Tubes only: a line drawn directly forward from the prow, and only a ship that line crosses may be targeted. The facing struck is whichever of the target's arcs the firer sits in. Broadsides are per side: each line of a datasheet is its own weapon system in that facing.</description></rule><rule id="56e6dc73-b052-5f9d-b91c-7641638eca8b" name="State: Adrift" hidden="false"><description>A second Engines Crippled. The ship moves 2D6″ straight ahead when it would move, cannot turn, and fires Snap Shots only.</description></rule><rule id="89e979a0-6623-5ad8-a656-9fb0b99e2587" name="State: Crippled" hidden="false"><description>Below half starting Hull Points: −1 BS and half Speed.</description></rule><rule id="c03e0eba-d683-5848-aacd-f841297766fe" name="State: Depleted" hidden="false"><description>At half starting Crew or less: −1 BS. Stacks with Crippled.</description></rule><rule id="ef3154fa-7690-52e5-99dc-de00b3d34a52" name="State: Engaged" hidden="false"><description>Two aircraft squadrons within 1″. Neither may act against ships, and no ship may fire on either — Defence Batteries, Interceptor and Overwatch included. Resolved at the end of the battle round.</description></rule><rule id="6dbf4b09-dcd8-5900-926b-f18d29d02c80" name="State: Engines Crippled" hidden="false"><description>Immobile and Snap Shots only until repaired. It may still be issued Fleet Orders. It gains no Firing at anchor bonus for standing still, though it still suffers −1 on Evade.</description></rule><rule id="aa7b9aa4-5a12-5999-9ee2-f2b2b71b90e3" name="State: Held station" hidden="false"><description>Moved 1″ or less under Burn Retros. Broadsides fire at +1 BS; −1 on Evade. A ship holding station may pivot freely on the spot.</description></rule><rule id="d4edc4c4-a5aa-5fa1-9523-dab8df022e4e" name="State: Locked" hidden="false"><description>Two ships joined by a ram. Neither may move; the rammer may not fire on its victim, who fires back at −1 BS against the rammer's Prow. Both fire at other enemies normally. Break Away on 5+, when the ship would move, once each per battle round: the rammer disengages 1″ away, a defender tears free 1″ away and suffers D3 Hull Points.</description></rule><rule id="b56595c0-b516-5a86-8d0b-cbaa0a346cb9" name="State: Snap Shots" hidden="false"><description>Firing at BS 1 — hits only on a 6.</description></rule><rule id="6f33b249-d1eb-59ab-a8ac-bfd92dcd0b28" name="State: Wreck" hidden="false"><description>0 Hull Points without exploding. It becomes obscuring terrain: impassable, blocks line of sight, and no straight-line weapon may fire across it. It never moves, never drifts and never Evades, and having no Crew it cannot be boarded or captured.</description></rule><rule id="812f8a77-1195-502d-8b47-b14dc14f4446" name="Keyword: Turning" hidden="false"><description>Turning is universal: any ship may turn at the start or the end of its move.</description></rule><rule id="3d6974dc-2390-57b8-882b-4713b42c7abe" name="Keyword: Interceptor" hidden="false"><description>A Defence Battery may fire the moment an enemy squadron comes within 12″ as the enemy moves, before it attacks — but then does nothing else that battle round, Overwatch included.</description></rule><rule id="86e26f72-4fd7-5e1d-9f99-c95167843c73" name="Keyword: Breachers" hidden="false"><description>+1 to all Boarding combat rolls, and enemy dice fighting them suffer −1. The −1 of a Dreadnought, or of an Astartes Breacher defending his own ship, falls on the one enemy die paired against him.</description></rule><rule id="bc1caee9-2821-54c2-851f-b105a2e760fe" name="Keyword: Intervention" hidden="false"><description>Destroyers and Frigates only, and it costs no order. When a friendly ship within 3″ is attacked, rammed, or targeted by torpedoes, a Destroyer or Frigate no more than 10″ from the attacker may thrust into the firing line: it does not move, and the whole attack resolves against it instead, striking whichever facing lies toward the attacker. Once per ship per battle round.</description></rule><rule id="adb1674c-1050-5a0f-9195-69e546a2db60" name="Keyword: Wolf Pack" hidden="false"><description>Destroyers of one squadron within 6″ may combine fire on a single target, adding +1 to penetration. Gunnery only, never Torpedo Tubes. Frigates do not have Wolf Pack.</description></rule><rule id="c598b94b-90da-5cca-a261-85e8d4af5d2e" name="Keyword: Melta Mines" hidden="false"><description>Each Frigate may carry two Melta Mines. No other class may take them. In the Movement step, after the Frigate has moved and instead of shooting, place a mine on a 32mm base in contact with the ship's base — one mine per round, Reload (2), and never within 6″ of an enemy ship. A mine detonates the moment any part of a non-Frigate ship's base passes over it. Every ship within 3″, friend or foe and including the ship that triggered it, immediately suffers one hit at Strength 9, AP 2 with Armourbane, resolved against the facing nearest the mine. Melta Mines bypass Void Shields entirely. Frigates of either fleet pass over mines safely, and aircraft ignore them. Remove the marker once the blast is resolved.</description></rule><rule id="1eb7b042-e989-5cd1-8ee5-c29b156c5ca7" name="Keyword: Broken Fleet" hidden="false"><description>Once three quarters of a fleet's starting points are lost, it loses the battle at once.</description></rule></rules><categoryLinks>
 <categoryLink id="7e62a3e2-0195-5856-a4c1-fbe2d309cf18" name="Rules" hidden="false" targetId="52616092-abd8-519e-a6fb-94b622114fa5" primary="true" /></categoryLinks>
 </selectionEntry><selectionEntry id="89068737-689d-5ca6-b271-85876daef744" name="Damage Table" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="force" shared="false" id="3014549c-418a-51ac-baf9-8d48a56b1b19" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><rules><rule id="3eba5280-d0e6-5ae2-a2fd-5672a7659c35" name="Ship Damage Table" hidden="false"><description>1 Held — nothing further happens. 2 Blaze — the ship gains 1 Critical Damage. 3 Hull Breach — the ship gains 1 Critical Damage. 4 Magazine Explosion — 1 Hull Point (2 if it mounts Triple Lance Turrets), 1 Critical Damage, and a random Port, Starboard or Dorsal weapon system destroyed. 5 Engines Crippled — immobile and Snap Shots only until repaired; a second leaves it Adrift. 6 Reactor Struck — a Line Ship suffers a Catastrophic Explosion at once; a Capital Ship takes D3 Hull Points then rolls a D6, detonating on a 6; a Gloriana or larger takes D3 and rolls 2D6, detonating if either die shows a 6. Modifiers: AP 2 +1 · AP 1 +2 · Destroyer +3, in place of any AP modifier (+2 against a Gloriana, the Abyss or the Phalanx) · Ramming +1 · Battleship target −1. A modified 7+ counts as Reactor Struck; below 1 counts as 1, and a 1 does nothing.</description></rule><rule id="11fc6466-d9ef-53b3-922c-9e8596bcfd94" name="Penetration" hidden="false"><description>For each hit past the shields, roll 1D6 + Strength against the Armour Value of the facing struck. Equal = Glancing Hit: 1 Hull Point, no damage roll. Greater = Penetrating Hit: 1 Hull Point and a roll on the Damage Table. No Armour Value may exceed 14 by any means.</description></rule><rule id="0be2d9a8-a6fa-515d-8304-eb4af1945e98" name="Stern Strike" hidden="false"><description>When a Strength 9+ weapon rolls a natural 6 on its penetration die against a target's Stern and beats the Stern AV, the hit also inflicts Engines Crippled at once. With Armourbane at least one of the two dice must show a 6. It does not stack with an Engines Crippled already rolled, and while shields hold the hit must bring them down first.</description></rule><rule id="cbcde607-f440-54d1-ae10-ede607451f95" name="Destruction" hidden="false"><description>At 0 Hull Points roll a D6 once: on a 6 the ship is torn apart in a Catastrophic Explosion and every ship within the blast radius suffers one hit against its nearest facing — Str 8 AP 3 from a Line Ship, Str 9 AP 2 from a Capital Ship or Void Fortress. On any other result it becomes a wreck. Blast radius: Destroyer, Frigate or Assault Barge 3″ · Cruiser D6″ · Grand Cruiser or Battle Barge D6+3″ · Battleship or Gloriana 2D6″ · Abyss 3D6″.</description></rule><rule id="9b69d8e3-e7e0-5f7c-a1b0-7dcf04acebbf" name="Keyword: Devastating (X)" hidden="false"><description>Each unsaved hit costs the target X Hull Points instead of 1, whether it glances or penetrates. A penetrating Devastating hit still rolls once on the Damage Table, keeping its AP modifier. Against active shields a Devastating hit still costs only 1 Void Shield Rating, however large its X.</description></rule><rule id="33497cdf-425b-5f22-a8db-aec13cd5c07a" name="Keyword: Critical Damage" hidden="false"><description>Fires, breaches and burning phosphex — one rule for all of them. A ship may carry up to 3 Critical Damage, marked with a single token. At the end of each battle round it loses 1 Crew for each Critical Damage it carries, always, with no roll. A successful Damage Control order clears the whole stack at once.</description></rule></rules><categoryLinks><categoryLink id="83cbbf86-71fa-55c9-b0ce-478cbb44ac9f" name="Rules" hidden="false" targetId="52616092-abd8-519e-a6fb-94b622114fa5" primary="true" /></categoryLinks></selectionEntry><selectionEntry id="8ca42a44-4c51-564c-b117-ba7ca93a39f4" name="Eternal Crusader" hidden="false" collective="false" import="true" type="unit">
 <constraints>
 <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1a566f70-70e8-5db0-9876-f5ae742e75fb" type="max" />
 </constraints>
 <profiles>
 <profile id="20d831f3-8c42-5896-a9f7-45750d0f9dc7" name="Eternal Crusader" hidden="false" typeId="806f9ff1-fd51-5ddb-b005-ce73a5d09d65" typeName="Ship">
 <characteristics>
 <characteristic name="BS" typeId="d130e705-611e-5a0a-bd7d-ea8e848fdb2e">4</characteristic>
 <characteristic name="Prow" typeId="84a55377-edbc-5825-a2bf-70c6155018f2">14</characteristic>
 <characteristic name="Side" typeId="5f595433-7397-5c4b-9d4a-8f35d83a2b29">14</characteristic>
 <characteristic name="Stern" typeId="cd9ec76e-f959-5560-8845-9ab242f16e71">13</characteristic>
 <characteristic name="HP" typeId="ef713781-2034-5fb4-83d1-e49d1d683694">16</characteristic>
 <characteristic name="VS" typeId="84309751-688d-50ef-8940-d8d042261a56">12</characteristic>
 <characteristic name="Speed" typeId="25d0e01e-8e74-55b3-8a2a-17773c881625">7″</characteristic>
 <characteristic name="Turn" typeId="899e9c58-70ef-5da5-8495-5bf6a8b7f8f0">45°</characteristic>
 <characteristic name="Crew" typeId="2f6312dd-493e-53c6-96e2-d901afca0e81">10</characteristic>
 </characteristics>
 </profile>
 <profile id="85916f2e-71de-5264-9315-499167e4db2d" name="Gloriana Common Rules" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">A Primarch’s Flagship: never suffers the Crippled −1 BS penalty; must be the Flagship; one per battle; games of 2,000+ points. Gloriana Reactors: once per battle, when VS would reach 0 it remains at 1. Dorsal Twin Lance Turrets fire into all arcs and never Gets Hot. Heavy Macrobatteries use Reload (1). Armament fixed: no Section 11b refits.</characteristic>
 </characteristics>
 </profile>
 <profile id="8f1e2605-85a2-5102-920c-133d2e50c018" name="The Praetorian Line" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Requires Rogal Dorn or Sigismund as Fleet Commander. Bastion of the VII: enemy Damage Table rolls suffer −1. Praetorian Gunnery: if held station, Heavy Macrobatteries fire at +1 BS. Hangar Bays (3).</characteristic>
 </characteristics>
 </profile>
 <profile id="fc5b70e2-3059-5a85-a361-edc538380124" name="Torpedo Tube ×4" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Prow</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">9</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">2</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1 each</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">60″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Bypasses Void Shields; Armourbane within 6″; Reload (2)</characteristic></characteristics></profile><profile id="b649c07d-ee39-5820-b6a8-904629eef774" name="Void Missile Launcher ×2" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Prow</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">12</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">D</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1 each</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">60″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">One Shot; Devastating (3); Volatile</characteristic></characteristics></profile><profile id="7ac10b3c-5607-58d8-8a44-92404875d3c6" name="Heavy Macrobattery ×5" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Port</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">9</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">2</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3 each</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">30″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">—</characteristic></characteristics></profile><profile id="e86939c1-5766-59a6-aa8d-da429821906e" name="Heavy Macrobattery ×5" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Starboard</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">9</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">2</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3 each</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">30″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">—</characteristic></characteristics></profile><profile id="29fb65a1-5e52-50f5-b063-b170a823e87c" name="Twin Lance Turret ×4" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Dorsal</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">10</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">1</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">2 each</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">46″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Twin-Linked; Reload (2); Devastating (2). All arcs, no Gets Hot</characteristic></characteristics></profile><profile id="f97654c8-82d0-5b2d-aebb-b8991f68883a" name="Triple Lance Turret ×2" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Dorsal</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">10</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">1</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3 each</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">46″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Twin-Linked; Reload (2); Devastating (2). All arcs, no Gets Hot</characteristic></characteristics></profile><profile id="02f62037-11da-5572-9986-dbd58314b69c" name="Defence Battery ×14" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">All-round</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">6</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">5</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">12″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Skyfire; Interceptor. Aircraft to 12″; ships within 6″</characteristic></characteristics></profile></profiles>
