 <selectionEntryGroup id="7d76a57d-43db-4041-86d3-b71b83dc6270" name="Primarch Retinue" hidden="true" collective="false" import="true"><modifiers><modifier type="set" field="hidden" value="false"><conditions><condition field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="421149c7-91d9-4cd3-bd1c-d63807e0015c" type="equalTo" /></conditions></modifier></modifiers><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="71f82538-5e0a-4e0d-bd46-5b02358b744c" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="dc14001b-3b7a-416a-b855-3c8cb00cea8a" name="Alexis Polux" hidden="false" collective="false" import="true" type="upgrade">
 <constraints>
 <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="d71e0ca6-63fe-4d8a-8d0f-d95fd015ac06" type="max" />
 </constraints>
 <profiles>
 <profile id="871f7fb5-8550-40a9-8cae-114d4a96f42a" name="Alexis Polux" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Named Character. Practised Command: once per battle round, one friendly ship within Command range may re-roll a single failed Evade roll. Friendly ships within 12″ gain +1 BS on Overwatch/Return Fire and may re-roll one failed Repair each turn. Flagship issues 3 Fleet Orders of each type each battle round.</characteristic>
 </characteristics>
 </profile>
 <profile id="f7a48d9c-5647-4a95-bf33-6d388e388ddb" name="Primarch Retinue" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Named Character. Practised Command: once per battle round, one friendly ship within Command range may re-roll a single failed Evade roll. This character is embarked as the Primarch's additional named retinue. They do not add Fleet Orders, Command range or any command ability; only effects unrelated to the order economy apply.</characteristic></characteristics></profile></profiles>
 <categoryLinks>
 <categoryLink id="acce7ee8-7e7e-45da-b90a-74664a5ddeca" name="Retinue Character" hidden="false" targetId="194a7f31-dced-445a-b273-cca4996c8570" primary="false" /></categoryLinks>
 <costs>
