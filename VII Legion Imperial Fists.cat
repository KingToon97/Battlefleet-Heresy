      <selectionEntryGroup id="75a396a0-d257-42d9-889c-6541a0c01fea" name="Primarch Retinue" hidden="true" collective="false" import="true"><modifiers><modifier type="set" field="hidden" value="false"><conditions><condition field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="23ee598f-8b22-4ae9-8611-7943be8997c1" type="equalTo" /></conditions></modifier></modifiers><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="cf178c32-46bd-41c3-b410-38bb791aea0d" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="c35cc0b2-678d-41da-b4ce-97e57d09488e" name="Alexis Polux" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="b7224b1a-a32b-4ded-b5ae-28af0e1dac5c" type="max" />
      </constraints>
    <profiles>
        <profile id="3ef7606c-bf17-4fcc-94cb-c413d61460ea" name="Alexis Polux" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Friendly ships within 12″ gain +1 BS on Overwatch/Return Fire and may re-roll one failed Repair each turn. Flagship issues 3 Fleet Orders each phase.</characteristic>
          </characteristics>
        </profile>
      <profile id="d353fb4f-9078-4014-b4a6-b935171a56bb" name="Primarch Retinue" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This character is embarked as the Primarch's additional named retinue. They do not add Fleet Orders, Command range or Leadership; only effects unrelated to the order economy apply.</characteristic></characteristics></profile></profiles>
      <categoryLinks>
        <categoryLink id="8b657630-8eb4-4dc9-9282-7b5eb033e407" name="Retinue Character" hidden="false" targetId="194a7f31-dced-445a-b273-cca4996c8570" primary="false" /></categoryLinks>
      <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="200.0" />
      </costs>
      </selectionEntry>
    <selectionEntry id="926eb065-f4c6-4d77-aa85-cdb57fb6460d" name="Sigismund" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0840ee70-9047-4569-8e63-2594cb832bd5" type="max" />
      </constraints>
    <profiles>
        <profile id="393181cf-3ef6-475a-91f8-82b3f978c4ae" name="Sigismund" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding parties gain +1 when attacking enemy flagships.</characteristic>
          </characteristics>
        </profile>
      <profile id="fda97251-93cd-49a5-9551-e6a2609cc414" name="Primarch Retinue" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This character is embarked as the Primarch's additional named retinue. They do not add Fleet Orders, Command range or Leadership; only effects unrelated to the order economy apply.</characteristic></characteristics></profile></profiles>
      <categoryLinks>
