    <selectionEntry id="a9698f94-9562-563b-a87e-53086b15ca76" name="Fleet Construction Rules" hidden="false" collective="false" import="true" type="upgrade">
      <profiles>
        <profile id="517ca2e4-30de-5f14-bb1e-3828dd9989a0" name="Fleet Construction Rules" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Capital Ships: minimum 1. Maximum by fleet size: 1 at 1,000; 2 at 1,500; 3 at 2,000; 4 at 2,500; 5 at 3,000. Minimum Line Ships: 4/5/6/7/8 respectively. No single ship may exceed 50% of fleet points including upgrades. Gloriana 2,000+; Abyss/Phalanx 3,000+. Escorts/Frigates squadrons 3–6; Assault Barges up to 4. This v0.2 catalogue displays these rules but automatic variable-points bracket validation is still in development.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    <categoryLinks>
        <categoryLink id="f30fafc6-53e4-57a9-b920-6b5a7bf9263b" name="Upgrade" hidden="false" targetId="7610de76-9ef1-58ab-9c7b-f97ede66e61d" primary="true" />
      </categoryLinks>
      </selectionEntry>
    <selectionEntry id="a3f6e96a-5440-5fe4-a5c3-243a9b453e38" name="VI Legion - The Wolf’s Claw" hidden="false" collective="false" import="true" type="upgrade">
      <rules><rule id="eeb63729-f664-5722-b0d8-c28f2fe0d7e7" name="VI Legion - The Wolf’s Claw" hidden="false"><description>In the first round of a boarding action, enemy dice suffer −1.</description></rule></rules><categoryLinks>
        <categoryLink id="046b2d5b-a82e-58ba-99c7-446e92e76c4c" name="Upgrade" hidden="false" targetId="7610de76-9ef1-58ab-9c7b-f97ede66e61d" primary="true" />
      </categoryLinks>
      </selectionEntry>
    <selectionEntry id="f83680f9-56a8-4c2c-90f0-9913c62ad81a" name="Battle Carrier" hidden="false" collective="false" import="true" type="unit">
      <profiles>
        <profile id="043fc03b-85fb-437f-9451-11d1ee072df5" name="Battle Carrier" hidden="false" typeId="806f9ff1-fd51-5ddb-b005-ce73a5d09d65" typeName="Ship">
          <characteristics>
            <characteristic name="BS" typeId="d130e705-611e-5a0a-bd7d-ea8e848fdb2e">3</characteristic>
            <characteristic name="Prow" typeId="84a55377-edbc-5825-a2bf-70c6155018f2">14</characteristic>
            <characteristic name="Broadside" typeId="5f595433-7397-5c4b-9d4a-8f35d83a2b29">13</characteristic>
            <characteristic name="Stern" typeId="cd9ec76e-f959-5560-8845-9ab242f16e71">12</characteristic>
            <characteristic name="HP" typeId="ef713781-2034-5fb4-83d1-e49d1d683694">13</characteristic>
            <characteristic name="VS" typeId="84309751-688d-50ef-8940-d8d042261a56">8</characteristic>
            <characteristic name="Speed" typeId="25d0e01e-8e74-55b3-8a2a-17773c881625">6″</characteristic>
            <characteristic name="Turn" typeId="899e9c58-70ef-5da5-8495-5bf6a8b7f8f0">45°</characteristic>
            <characteristic name="Crew" typeId="2f6312dd-493e-53c6-96e2-d901afca0e81">8</characteristic>
          </characteristics>
        </profile>
        <profile id="679833d6-7b70-4e44-914f-d2906ddde68d" name="Hangar Bays (6)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">6 physical Hangar Bay mounts; each bay costs 10 pts and carries one aircraft squadron.</characteristic>
          </characteristics>
        </profile>
        <profile id="3093704c-e675-4ac5-aa26-e0a8b1151b24" name="Bulwark of the Line" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Enemy Damage Table rolls against this ship suffer −1.</characteristic>
          </characteristics>
        </profile>
        <profile id="84b3f7ec-90d6-443e-bbcd-1c942eaf092c" name="Hangar Loadout Validation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Maximum 8 aircraft squadrons.</characteristic>
          </characteristics>
        </profile>
        <profile id="013b11a0-7369-43bb-a725-774ae1a0fa5b" name="Boarding Forces Validation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding forces are bought against the ship’s Crew. Terminator/Dreadnought class limits are enforced; remember a Contemptor occupies 2 Crew slots.</characteristic>
          </characteristics>
        </profile>
        <profile id="ce96d4f9-8b3b-483e-9297-5e9363694a0a" name="Hardpoint Construction" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Bare chassis. Every mounted weapon is purchased separately. No upgrade-spend ceiling. Legal choices are controlled by hull class, hardpoint type and facing; each hardpoint must contain exactly one weapon.</characteristic>
          </characteristics>
        </profile>
      <profile id="10f5156b-ce7d-4a82-af93-e5ecd8d6794b" name="Mount Capacity" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Port Heavy: 1 · Starboard Heavy: 1 · Prow Ordnance: 6 · Dorsal: 4 · Defence: 10 · Hangar: 6</characteristic></characteristics></profile><profile id="9ccd4825-58ef-44b0-b1b1-197f9c4f0e2f" name="Hardpoint Configuration" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ships begin with no weapons or Defence Batteries selected. Hangar Bay slots represent built-in hull capacity and cost 0 pts. Each physical hardpoint may take at most one legal component. There is no separate upgrade-spend cap; the hull's mount layout is the limit.</characteristic></characteristics></profile><profile id="38d2cff6-5a2d-4968-8a09-9e835732d15a" name="Carrier Flagship Priority" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">A Battle Carrier must be the fleet's Flagship unless a Gloriana is present. New Recruit enforces this through the Fleet Role selection.</characteristic></characteristics></profile><profile id="18c82d8d-92bd-4588-9991-0a7acbe26939" name="Roster Builder Summary" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Crew 8 · Port Heavy 1 · Starboard Heavy 1 · Prow Ordnance 6 · Dorsal 4 · Defence 10 · Hangars 6. Ships start unequipped. Fill only the weapon and Defence hardpoints you want to purchase; each may contain at most one component. Hangar Bay slots cost 0 pts. Aircraft are purchased separately up to Hangar capacity.</characteristic></characteristics></profile></profiles>
      <categoryLinks>
        <categoryLink id="33f5f231-b647-4ffb-93e3-d12a705188c1" name="Capital Ship" hidden="false" targetId="bd422ebf-10b3-5085-89cc-263568c40fe0" primary="true" />
      </categoryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup id="64f2c8d0-af79-48b3-80e4-8369f15b060d" name="Fleet Role" hidden="false" collective="false" import="true"><modifiers><modifier type="set" field="e0c2293c-3c99-4122-8fbb-5d5b11906f08" value="0.0"><conditions><condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="6e49ea9d-e24f-5916-8418-787496f3214a" type="atLeast" /></conditions></modifier></modifiers><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="30fd6bfe-8939-4e80-8ecc-b6776d08b615" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="e0c2293c-3c99-4122-8fbb-5d5b11906f08" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="3bb33b35-79f0-40ca-a06e-02590ba6c449" name="Designate as Flagship" hidden="false" collective="false" import="true" type="upgrade"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="6e49ea9d-e24f-5916-8418-787496f3214a" type="atLeast" /></conditions></modifier></modifiers><profiles><profile id="b4ca1e85-4e92-4e4a-94ea-c9741fadbe32" name="Flagship" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Mandatory when the fleet contains no Gloriana. If a Gloriana is selected, this option is automatically hidden and the requirement is removed.</characteristic></characteristics></profile><profile id="a98d04fe-e76a-42b4-aa6c-e9df132e9a9b" name="Commander Embarkation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander here. The Commander is embarked on this Flagship.</characteristic></characteristics></profile></profiles><categoryLinks><categoryLink id="2c66cfea-0350-44b3-a660-dfe3bae5bf84" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" /></categoryLinks><selectionEntryGroups><selectionEntryGroup id="ae499dfb-f917-4b4e-bf91-91680d914ba8" name="Fleet Commander" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="24e47067-9411-4a48-9a8b-2667fa9c546c" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="96b1b980-45bd-4f09-91fa-42dc78bf8121" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="5b899e76-9277-43c6-94f9-008a6b962543" name="Fleet Captain" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
