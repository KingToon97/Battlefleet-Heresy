        <selectionEntryGroup id="12009bf0281d9e7d8255ab5da76ec27b" name="Hull Upgrades" hidden="false"><selectionEntries><selectionEntry id="f918eed68d8585d72cccb8a782d74515" name="Side Armour Reinforcement" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="aee286706c2f01c0aa5f311b0992ffec" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="8b3f507fccc192cc765c3cc395cb5824" name="Side Armour Reinforcement" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="120.0" /></costs></selectionEntry><selectionEntry id="cc5aff2eabe108feceea305fa4d6d4e5" name="Engine Refit" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="31ee67e7c888f759803f42e96ccbb518" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="9aa2db4dec13cff7b9d4deee2c4c9821" name="Engine Refit" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="100.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
