      <selectionEntryGroups>
        <selectionEntryGroup id="ae1daa02-31e0-4c8e-a904-257ae3ead925" name="Fleet Role" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="d54736c8-1869-492f-ba9c-926e830fc688" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="1adf537d-2681-4248-9258-fd9efac889bb" name="Designate as Flagship" hidden="false" collective="false" import="true" type="upgrade"><profiles><profile id="c6fd3121-c028-4757-9153-883e2bdce1d7" name="Flagship" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship is the fleet's Flagship. Exactly one Flagship is required in a standard fleet.</characteristic></characteristics></profile><profile id="8c15a60e-9ee3-4cd9-9186-0c478b471c1b" name="Commander Embarkation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander here. The Commander is embarked on this Flagship.</characteristic></characteristics></profile></profiles><categoryLinks><categoryLink id="0c663a35-526a-41da-a05c-b53634199c8a" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" /></categoryLinks><selectionEntryGroups><selectionEntryGroup id="b56016e7-aa06-4c41-8a8e-971fbca0e9dc" name="Fleet Commander" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="14279203-bfd3-41f9-a1eb-3658bc4de936" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="bb10a3ac-684f-4e36-81c1-776