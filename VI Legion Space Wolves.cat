      </constraints>
    <profiles>
        <profile id="b298fffe-a8e5-4ff0-958b-0e36932c0b8f" name="Bjorn Stormwolf" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">The Fell-Handed: once per boarding action, the first round in which friendly parties inflict a casualty, inflict one more.</characteristic>
          </characteristics>
        </profile>
      <profile id="8f793efc-4f91-41ca-9772-f1b564da3a1a" name="Primarch Retinue" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This character is embarked as the Primarch's additional named retinue. They do not add Fleet Orders, Command range or Leadership; only effects unrelated to the order economy apply.</characteristic></characteristics></profile></profiles>
      <categoryLinks>
        <categoryLink id="97929278-c98f-4ad9-877e-4b0a7c57acdf" name="Retinue Character" hidden="false" targetId="194a7f31-dced-445a-b273-cca4996c8570" primary="false" /></categoryLinks>
