          <selectionEntries>
            <selectionEntry id="bc691801-d5a1-4dfd-a03d-e9e57c0dddeb" name="Heavy Macrobattery (Port)" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="7a56d022-1519-4e2e-9d0e-808347d68ccc" percentValue="false" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <profiles>
                <profile id="2d40af17-e696-4587-a434-4a89e1984f53" name="Heavy Macrobattery" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
                  <characteristics>
                    <characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Port</characteristic>
