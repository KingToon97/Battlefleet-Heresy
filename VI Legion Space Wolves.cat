      <selectionEntryGroups>
        <selectionEntryGroup id="6b38bbb8-17f7-49f5-8353-6a1c60d5eefb" name="Fleet Role" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="9940ed5a-bb8e-471b-a26d-f9d2bef80ec7" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="659044b3-9674-4eef-b1ab-eb088160952b" name="Designate as Flagship" hidden="false" collective="false" import="true" type="upgrade"><profiles><profile id="b27452fc-d410-4ee7-9ae5-87fdb799dde4" name="Flagship" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship is the fleet's Flagship. Exactly one Flagship is required in a standard fleet.</characteristic></characteristics></profile><profile id="1d77710f-32f7-42de-b8a3-a4bbffa456bb" name="Commander Embarkation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander here. The Commander is embarked on this Flagship.</characteristic></characteristics></profile></profiles><categoryLinks><categoryLink id="b18bae5b-3424-4146-8e33-1968927ba7a9" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" /></categoryLinks><selectionEntryGroups><selectionEntryGroup id="3b8f4651-4dd3-4188-a1b7-9d073c4cf3ba" name="Fleet Commander" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="d906da33-40cc-438b-9bd5-af3322f50bda" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="fb1385b7-14dc-4a6b-80d0-289