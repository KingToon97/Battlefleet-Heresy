      </constraints>
    <profiles>
        <profile id="68662104-1877-458a-a3e4-0d4ef7179bbd" name="Jorin Bloodhowl" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Friendly boarding parties gain +1 while their ship is within 6″ of an enemy ship.</characteristic>
          </characteristics>
