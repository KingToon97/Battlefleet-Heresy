                <categoryLink id="6b574705-c7c5-5635-8711-d1d6b66ad079" name="Boarding Force" hidden="false" targetId="4d94b920-d5bc-5fd7-a967-4ba346019f56" primary="true" />
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="60.0" />
              </costs>
              </selectionEntry>
            <selectionEntry id="a4661d82-c593-5a2e-aa33-af321b340b4e" name="Contemptor Dreadnought" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint type="max" value="3.0" field="selections" scope="parent" shared="false" id="ca2f2073-dc11-5394-9881-0cb6cd623e51" percentValue="false" includeChildSelections="false" includeChildForces="false" />
                <constraint type="max" value="12.0" field="selections" scope="parent" shared="false" id="fce307ca-09cc-50be-892a-8848dbc8d226" percentValue="false" includeChildSelections="false" includeChildForces="false" />
              </constraints>
            <profiles>
                <profile id="4fce99cc-b13b-502f-b3d8-7a41869f4922" name="Boarding Force" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
                  <characteristics>
                    <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Counts as 2 Crew; fights as one warrior at +2 and gives −1 to the enemy die it faces. Limits as Terminators.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink id="92de394c-71a5-5a03-b89e-b3cc04f8505c" name="Boarding Force" hidden="false" targetId="4d94b920-d5bc-5fd7-a967-4ba346019f56" primary="true" />
              </categoryLinks>
