            <characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">4 rails</characteristic>
            <characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">18″</characteristic>
