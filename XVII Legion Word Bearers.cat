        <selectionEntryGroup id="60d9d101031484838947105be2d29cc4" name="Hull Upgrades" hidden="false"><selectionEntries><selectionEntry id="ef915dccbb4bd3dfdf63e61e3af4a750" name="Side Armour Reinforcement" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="e5456b8364d0e8909af9c1d224aaa487" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="3d184acb3b4598c2d81cd65399aa3b2a" name="Side Armour Reinforcement" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="120.0" /></costs></selectionEntry><selectionEntry id="b80168b1ebd6f6f3ac60bf444ca770fa" name="Engine Refit" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="c1a927f2223cb325fc91cf98360ab088" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="378bb4146b4d96be1e65411b49deafa7" name="Engine Refit" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="100.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
