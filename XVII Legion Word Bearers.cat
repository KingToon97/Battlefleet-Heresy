        <selectionEntryGroup id="7931e9d0-dac5-4f8d-8491-737f18008fbe" name="Fleet Role" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="c090b3b8-20ec-4b8f-bdce-a1ed082738e9" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="4166541d-3f81-475e-8bae-7e6b1320aaf0" name="Designate as Flagship" hidden="false" collective="false" import="true" type="upgrade"><profiles><profile id="88fa7f73-73e5-4063-85cf-016bb78913ee" name="Flagship" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship is the fleet's Flagship. Exactly one Flagship is required in a standard fleet.</characteristic></characteristics></profile><profile id="d6f83c37-36bc-4709-a7cd-085183bed47f" name="Commander Embarkation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander here. The Commander is embarked on this Flagship.</characteristic></characteristics></profile></profiles><categoryLinks><categoryLink id="bfde8c84-4b6d-49ce-a96f-73678d845284" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" /></categoryLinks><selectionEntryGroups><selectionEntryGroup id="1478e59d-993a-44c3-b4e8-5d55422bbf6d" name="Fleet Commander" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="da4297f8-6ccc-4965-9cfd-7e228dff9b5a" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="3b3b2e06-486b-4658-965a-80a