    <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="1400.0" />
      </costs>
      </selectionEntry>
    <selectionEntry id="a9698f94-9562-563b-a87e-53086b15ca76" name="Fleet Construction Rules" hidden="false" collective="false" import="true" type="upgrade">
      <profiles>
        <profile id="517ca2e4-30de-5f14-bb1e-3828dd9989a0" name="Fleet Construction Rules" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Capital Ships: minimum 1. Maximum by fleet size: 1 at 1,000; 2 at 1,500; 3 at 2,000; 4 at 2,500; 5 at 3,000. Minimum Line Ships: 4/5/6/7/8 respectively. No single ship may exceed 50% of fleet points including upgrades. Gloriana 2,000+; Abyss/Phalanx 3,000+. Escorts/Frigates squadrons 3–6; Assault Barges up to 4. This v0.2 catalogue displays these rules but automatic variable-points bracket validation is still in development.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    <categoryLinks>
        <categoryLink id="f30fafc6-53e4-57a9-b920-6b5a7bf9263b" name="Upgrade" hidden="false" targetId="7610de76-9ef1-58ab-9c7b-f97ede66e61d" primary="true" />
      </categoryLinks>
      </selectionEntry>
    <selectionEntry id="4ebf6a6b-8813-56ed-a477-701a2e8ebe06" name="XVII Legion - The Dark Brethren" hidden="false" collective="false" import="true" type="upgrade">
      <rules><rule id="4977c42a-29cc-5893-929a-77b5daf93884" name="XVII Legion - The Dark Brethren" hidden="false"><description>Each End Phase, enemy ships within 12″ of a Word Bearers ship take Morale; only Word Bearers may field the Abyss.</description></rule></rules><categoryLinks>
        <categoryLink id="972f950f-6813-5f09-a4ed-bbdd5e83cdd3" name="Upgrade" hidden="false" targetId="7610de76-9ef1-58ab-9c7b-f97ede66e61d" primary="true" />
      </categoryLinks>
      </selectionEntry>
    <selectionEntry id="a91a64f9-6b45-4b99-8a84-48bfe7e441af" name="Battle Carrier" hidden="false" collective="false" import="true" type="unit">
      <profiles>
        <profile id="5d1f7171-0ebd-4f1f-bfd8-2bedea3927bb" name="Battle Carrier" hidden="false" typeId="806f9ff1-fd51-5ddb-b005-ce73a5d09d65" typeName="Ship">
          <characteristics>
            <characteristic name="BS" typeId="d130e705-611e-5a0a-bd7d-ea8e848fdb2e">3</characteristic>
            <characteristic name="Prow" typeId="84a55377-edbc-5825-a2bf-70c6155018f2">14</characteristic>
            <characteristic name="Broadside" typeId="5f595433-7397-5c4b-9d4a-8f35d83a2b29">13</characteristic>
            <characteristic name="Stern" typeId="cd9ec76e-f959-5560-8845-9ab242f16e71">12</characteristic>
            <characteristic name="HP" typeId="ef713781-2034-5fb4-83d1-e49d1d683694">13</characteristic>
            <characteristic name="VS" typeId="84309751-688d-50ef-8940-d8d042261a56">8</characteristic>
            <characteristic name="Speed" typeId="25d0e01e-8e74-55b3-8a2a-17773c881625">6″</characteristic>
            <characteristic name="Turn" typeId="899e9c58-70ef-5da5-8495-5bf6a8b7f8f0">45°</characteristic>
            <characteristic name="Crew" typeId="2f6312dd-493e-53c6-96e2-d901afca0e81">8</characteristic>
          </characteristics>
        </profile>
        <profile id="9f245e5e-b290-4eef-b97d-b02903113c21" name="Hangar Bays (6)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">6 physical Hangar Bay mounts; each bay costs 10 pts and carries one aircraft squadron.</characteristic>
          </characteristics>
        </profile>
        <profile id="28b6cb15-2845-4dab-9fb3-7d711ecff624" name="Bulwark of the Line" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Enemy Damage Table rolls against this ship suffer −1.</characteristic>
          </characteristics>
        </profile>
        <profile id="12214a21-9d5b-4d73-b0c8-672b0d600038" name="Hangar Loadout Validation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Maximum 8 aircraft squadrons.</characteristic>
          </characteristics>
        </profile>
        <profile id="9b60ed16-4226-4979-801d-a650b987b6c9" name="Boarding Forces Validation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding forces are bought against the ship’s Crew. Terminator/Dreadnought class limits are enforced; remember a Contemptor occupies 2 Crew slots.</characteristic>
          </characteristics>
        </profile>
        <profile id="f7d28b36-3148-4b1c-8220-9d4f44498605" name="Hardpoint Construction" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Bare chassis. Every mounted weapon is purchased separately. No upgrade-spend ceiling. Legal choices are controlled by hull class, hardpoint type and facing; each hardpoint must contain exactly one weapon.</characteristic>
          </characteristics>
        </profile>
      <profile id="395e1c5a-2dc1-4763-a7c4-97b1ef9d6e35" name="Mount Capacity" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Port Heavy: 1 · Starboard Heavy: 1 · Prow Ordnance: 6 · Dorsal: 4 · Defence: 10 · Hangar: 6</characteristic></characteristics></profile><profile id="5d9a5060-733f-4517-b844-371f50d7b069" name="Hardpoint Configuration" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ships begin with no weapons or Defence Batteries selected. Hangar Bay slots represent built-in hull capacity and cost 0 pts. Each physical hardpoint may take at most one legal component. There is no separate upgrade-spend cap; the hull's mount layout is the limit.</characteristic></characteristics></profile><profile id="22652977-e61e-4d79-b155-eca1e1213f07" name="Carrier Flagship Priority" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">A Battle Carrier must be the fleet's Flagship unless a Gloriana is present. New Recruit enforces this through the Fleet Role selection.</characteristic></characteristics></profile><profile id="e2f406c8-061e-4dac-8e43-6f4b33082b0c" name="Roster Builder Summary" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Crew 8 · Port Heavy 1 · Starboard Heavy 1 · Prow Ordnance 6 · Dorsal 4 · Defence 10 · Hangars 6. Ships start unequipped. Fill only the weapon and Defence hardpoints you want to purchase; each may contain at most one component. Hangar Bay slots cost 0 pts. Aircraft are purchased separately up to Hangar capacity.</characteristic></characteristics></profile></profiles>
      <categoryLinks>
        <categoryLink id="f6ed8682-ae36-4913-9aae-6efd83446f17" name="Capital Ship" hidden="false" targetId="bd422ebf-10b3-5085-89cc-263568c40fe0" primary="true" />
      </categoryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup id="bfb6555d-8157-4df3-9f21-b5cd88c5eba4" name="Fleet Role" hidden="false" collective="false" import="true"><modifiers><modifier type="set" field="fd9675cf-4108-4db9-a9d2-0a171acdb0b9" value="0.0"><conditions><condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="6e49ea9d-e24f-5916-8418-787496f3214a" type="atLeast" /></conditions></modifier></modifiers><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="67867944-ace4-41bd-b2ce-89cd9ed0dbb4" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="fd9675cf-4108-4db9-a9d2-0a171acdb0b9" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="7799245f-a729-42c4-a7e9-ce077f2e8802" name="Designate as Flagship" hidden="false" collective="false" import="true" type="upgrade"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="6e49ea9d-e24f-5916-8418-787496f3214a" type="atLeast" /></conditions></modifier></modifiers><profiles><profile id="e9df1dd8-2c86-4437-ad06-10b3ce05e4e6" name="Flagship" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Mandatory when the fleet contains no Gloriana. If a Gloriana is selected, this option is automatically hidden and the requirement is removed.</characteristic></characteristics></profile><profile id="336ee29e-7493-4836-9e72-2d1533da1524" name="Commander Embarkation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander here. The Commander is embarked on this Flagship.</characteristic></characteristics></profile></profiles><categoryLinks><categoryLink id="ae5db55d-825c-410a-a614-71b63e98c1b2" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" /></categoryLinks><selectionEntryGroups><selectionEntryGroup id="df480113-d189-49fc-b462-82b7ff42a8bb" name="Fleet Commander" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="e35f6833-a554-4279-a9e6-cfbd53b5ebcb" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="2f18d1d9-dce1-4300-8f60-d8e47f69c701" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="ac1c282e-2995-40bb-995e-daf795516a4f" name="Fleet Captain" hidden="false" collective="false" import="true" type="upgrade">
