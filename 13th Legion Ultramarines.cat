       <profiles>
        <profile id="14e9d8ed-7e67-5487-adfa-688e14d14bee" name="Victrix Guard" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">One Crew point; +2 to its boarding die. Maximum 1 per ship, and it does not count against the Terminator limit. Friendly boarding parties aboard the same ship gain +1 to their dice while this unit remains alive.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <categoryLinks>
        <categoryLink id="0bcc0e95-0c33-5c23-a7da-e2929b1be72b" name="Boarding Force" hidden="false" targetId="4d94b920-d5bc-5fd7-a967-4ba346019f56" primary="true" />
