     <selectionEntries>
      <selectionEntry id="634e0f5c-1251-503f-b92d-aa0d8ac4fb74" name="Blast-Shielded Magazines" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="42128429-bbf1-596e-8ebb-184dc3b45174" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="bd106bb8-9b7a-5bff-8b7f-2db6e31cc3b6" name="Blast-Shielded Magazines" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Damage Control caused by a Magazine Explosion by 1, to a minimum of 0. A Twin Lance Turret that would suffer 1 Damage Control instead suffers 0 and ignores the effect; a Triple Lance Turret that would suffer 2 instead suffers 1. No other effect of a Magazine Explosion is prevented or reduced. Once per ship. Not available to Gloriana class or above.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="50.0" />
       </costs>
      </selectionEntry>
      <selectionEntry id="18cdcb78-b140-5d1f-9b45-367cdb982175" name="Emergency Shield Capacitors" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="ba553b51-4903-5463-b93f-58e8ae6c326e" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="3b68ba57-6ab0-55b9-844b-4bd2c0c88a58" name="Emergency Shield Capacitors" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 to Void Shield regeneration rolls. It confers no other benefit and can never raise a ship above its normal number of Void Shields; a shield burnt out despite the bonus stays burnt out for the rest of the battle. Once per ship.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="75.0" />
       </costs>
      </selectionEntry>
      <selectionEntry id="8f62f8d6-4a3c-516d-ad61-db823ab46969" name="Servitor Autoloaders" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="6e2f4ccb-2a0e-518c-b8aa-cff0740072af" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="757a562f-42ad-5f9c-85d2-10db17a23d21" name="Servitor Autoloaders" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Reduce the Reload value of every weapon and system aboard this ship by 1, to a minimum of Reload 0 — Reload (3) becomes Reload (2), Reload (2) becomes Reload (1), Reload (1) becomes Reload (0). A weapon reduced to Reload (0) has no cooldown and may fire every applicable battle round. Once per ship. Not available to Gloriana class or above.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="100.0" />
       </costs>
      </selectionEntry>
     </selectionEntries>
    </selectionEntryGroup>
