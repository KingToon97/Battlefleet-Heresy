       <profiles>
        <profile id="0c5778b7-2127-5d1d-ae7d-4bf0c5ae273f" name="Boarding Force" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
