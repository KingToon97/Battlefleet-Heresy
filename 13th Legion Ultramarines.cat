    <profile id="7ede473a-2b2a-505f-91dd-4d13b89e4ea2" name="Pattern" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">The most numerous cruiser in the Imperium, and the most balanced: torpedoes, lances and a full broadside.</characteristic>
     </characteristics>
    </profile>
    <profile id="3ae9e004-6b4c-577d-bf7a-1ca291e4bc05" name="Enduring Hull" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
