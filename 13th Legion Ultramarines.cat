        <selectionEntry id="38100f92-c227-55be-b493-c7f4c95ee415" name="Veteran Crew" hidden="false" collective="false" import="true" type="upgrade">
         <constraints>
          <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="60f91337-dec8-5329-8627-126ddf7efd55" percentValue="false" includeChildSelections="false" includeChildForces="false" />
