      <selectionEntry id="014b6bed-1eb7-5534-b067-ac8dab786c87" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="5ea90a68-02ba-5660-bae3-776110dff522" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="44bb92a2-9540-5b23-bd2c-fa57a83a457f" name="Plasma Drive Overhaul" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic>
         </characteristics>
        </profile>
       </profiles>
