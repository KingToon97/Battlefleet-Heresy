    <profile id="506d74eb-a9f6-5e4c-a4cc-d4a138b55dd4" name="Twin Lance Turret ×3" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
