           </constraints>
           <profiles>
            <profile id="02e703af-16a4-5443-b169-9289a23a3a3d" name="Marius Gage" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
             <characteristics>
              <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Character. Fleet Coordination: Once per battle round, one friendly ship may take the benefit of the selected Fleet Order a second time — a second Damage Control attempt, a second Evade, or the same order applied twice where its effect allows. It may not be used to exceed a limit the order itself states.</characteristic>
             </characteristics>
            </profile>
           </profiles>
           <categoryLinks>
            <categoryLink id="747ebe26-1d92-50e9-816c-a2b28703b774" name="Commander" hidden="false" targetId="6f3339ad-23a9-5687-b08f-3f11a43fe50b" primary="true" />
           </categoryLinks>
           <costs>
            <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="125.0" />
           </costs>
