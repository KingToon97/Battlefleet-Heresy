     <selectionEntries>
      <selectionEntry id="ec407875-8fc9-5573-93f4-2f55a9f7423a" name="Veteran Crew" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="e9b49709-c332-5b04-983f-53a4ca453f74" percentValue="false" includeChildSelections="false" includeChildForces="false" />
