      <characteristic name="VS" typeId="84309751-688d-50ef-8940-d8d042261a56">1 × AV 12, regen 4+</characteristic>
      <characteristic name="Speed" typeId="25d0e01e-8e74-55b3-8a2a-17773c881625">12″</characteristic>
