      <characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Skyfire; Interceptor. Aircraft to 12″; ships within 6″</characteristic>
     </characteristics>
    </profile>
    <profile id="5b9003c0-01eb-58f7-a174-29b614be2e9d" name="Pattern" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">The Navy's battleship of the line: a nova cannon forward, triple lance turrets aloft, a heavy broadside and six bays amidships.</characteristic>
     </characteristics>
    </profile>
    <profile id="8ecaa412-7258-5a11-8c47-db891a780873" name="Launch Bays (6)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship carries 6 Launch Bays, sited on her broadsides. Each holds one aircraft squadron, bought separately. See Launch Bays &amp; Aircraft.</characteristic>
     </characteristics>
    </profile>
    <profile id="b8078321-c9b2-5ee2-8205-315d1de8c0a1" name="Bulwark of the Line" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ship Type: Battleship. Apply −1 to Damage Table rolls made against this ship.</characteristic>
     </characteristics>
    </profile>
   </profiles>
