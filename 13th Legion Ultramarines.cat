      <selectionEntry id="d414018a-9917-59e1-a420-570405e597a1" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="5e37ee3a-f2da-506d-bb93-24ba98378483" shared="false" includeChildSelections="false" />
