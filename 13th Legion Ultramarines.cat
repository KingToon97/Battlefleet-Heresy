     <selectionEntries>
      <selectionEntry id="b13f31f1-7709-552c-aa39-01548b353ba6" name="Adamantium Belt Armour" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="b2411605-a31e-5b1f-af4e-12390138535a" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="94b61732-e97c-595b-a6b3-928a6a000082" name="Adamantium Belt Armour" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="45.0" />
       </costs>
      </selectionEntry>
      <selectionEntry id="ccb68bdf-e5f8-5c3b-bbc0-5405659f53a5" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="bde284a7-a222-5f84-872a-d3d411f349fa" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="aeab4d2c-5405-50e7-9634-b7a11ea6faec" name="Plasma Drive Overhaul" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
