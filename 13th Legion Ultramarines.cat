       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="b61337f5-229e-59cf-8267-3512d72b7f90" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="23a12d20-230f-51e7-aa95-103f2a0e8ccb" name="Victrix Guard" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">One Crew point; +2 to its boarding die. Maximum 1 per ship, and it does not count against the Terminator limit. Friendly boarding parties aboard the same ship gain +1 to their dice while this unit remains alive.</characteristic>
