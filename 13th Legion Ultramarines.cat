      </selectionEntry>
      <selectionEntry id="fc9598de-a330-57e0-be2e-a3a684c7a977" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="2b196da1-f186-588d-8f03-f8f796a9660c" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="761b2dd9-da50-57d1-97fa-81d417e52d99" name="Plasma Drive Overhaul" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <costs>
        <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="25.0" />
