      <selectionEntry id="dc6dce2e-b4ba-5b70-abba-6b4e0fa32f61" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="5e2b7db1-aaf1-53b3-8a0f-a4034f403a3a" shared="false" includeChildSelections="false" />
