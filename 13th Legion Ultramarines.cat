   <profiles>
    <profile id="f79898ec-2e2d-5392-820d-9116d50a1553" name="Battle Barge - Invasion pattern" hidden="false" typeId="806f9ff1-fd51-5ddb-b005-ce73a5d09d65" typeName="Ship">
