      <selectionEntry id="1ef194be-a74a-56d1-83e3-7889caa09f49" name="Adamantium Belt Armour" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="558ad0a0-eebb-568c-9a3b-6a62c90f0b05" shared="false" includeChildSelections="false" />
