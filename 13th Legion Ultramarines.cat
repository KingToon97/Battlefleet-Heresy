          <selectionEntry id="944db7e9-c32a-56c0-8f96-5ae5af9898c7" name="Remus Ventanus" hidden="false" collective="false" import="true" type="upgrade">
           <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="721a7601-8257-5514-93a0-e8b4e27ae138" type="max" />
