    <profile id="817578b0-1a39-5e13-b18d-3287613f7b8b" name="Pattern" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">A grand cruiser rebuilt around her launch bays.</characteristic>
     </characteristics>
    </profile>
    <profile id="e6e0c273-2c6b-52ca-80ae-6b367d021aa5" name="Launch Bays (4)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship carries 4 Launch Bays, sited on her broadsides. Each holds one aircraft squadron, bought separately. See Launch Bays &amp; Aircraft.</characteristic>
     </characteristics>
    </profile>
    <profile id="52505a28-3760-5b15-b5d4-29f4996bf06c" name="Fire Control Coordination" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ship Type: Grand Cruiser. This ship may split its fire without suffering the −1 BS penalty for doing so. All other restrictions on Splitting Fire still apply.</characteristic>
     </characteristics>
    </profile>
