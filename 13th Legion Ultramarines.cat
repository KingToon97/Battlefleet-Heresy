           <categoryLinks>
            <categoryLink id="7b121be4-e0cf-565f-9a4a-82e3c26e8a9d" name="Commander" hidden="false" targetId="6f3339ad-23a9-5687-b08f-3f11a43fe50b" primary="true" />
