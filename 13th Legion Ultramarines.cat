 <sharedRules>
  <rule id="29413e9e-fa3e-582d-8d7d-9706d16ea1bd" name="13th Legion - Scions of Macragge" hidden="false">
   <description>The fleet may select one additional Fleet Order each battle round. This is an express exception to the rule that nothing adds to the order allowance.</description>
  </rule>
