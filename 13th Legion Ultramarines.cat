     <selectionEntries>
      <selectionEntry id="df3c3166-394d-5604-967a-28fff48f3ace" name="Adamantium Belt Armour" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="02ded5d6-514c-596f-aa3c-0cc55f467c1f" shared="false" includeChildSelections="false" />
       </constraints>
       <profiles>
        <profile id="20f40249-da92-543b-b270-d847bc0896d7" name="Adamantium Belt Armour" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic>
         </characteristics>
