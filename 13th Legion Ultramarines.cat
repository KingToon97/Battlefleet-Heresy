    <profile id="8898912d-adea-5b4c-b943-1cc3782aefa6" name="Pattern" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">A heavy-gun refit, trading torpedoes for weight of shot.</characteristic>
     </characteristics>
    </profile>
    <profile id="cfed5964-6a97-5eec-8f5c-9634fc1e7179" name="Enduring Hull" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ship Type: Cruiser. This ship succeeds on Damage Control rolls on a 3+ rather than 4+.</characteristic>
     </characteristics>
    </profile>
   </profiles>
