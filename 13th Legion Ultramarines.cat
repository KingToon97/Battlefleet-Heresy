     </characteristics>
    </profile>
    <profile id="710fa55b-c853-596e-accd-7f0895a1a774" name="Lance Turret ×2" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
     <characteristics>
