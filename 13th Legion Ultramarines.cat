      <characteristic name="Speed" typeId="25d0e01e-8e74-55b3-8a2a-17773c881625">7″</characteristic>
      <characteristic name="Turn" typeId="899e9c58-70ef-5da5-8495-5bf6a8b7f8f0">45°</characteristic>
      <characteristic name="Crew" typeId="2f6312dd-493e-53c6-96e2-d901afca0e81">10</characteristic>
     </characteristics>
    </profile>
    <profile id="947cac8f-f271-5fce-81a3-fd34c028d8f1" name="Perfect Coordination" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
     <characteristics>
      <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">The fleet may issue two additional Reactions each battle round, over and above its commander's allowance — the one exception to the rule that nothing adds to a fleet's orders. Launch Bays (4).</characteristic>
     </characteristics>
    </profile>
    <profile id="7c28a8d5-41e8-5db6-8f34-23047222f959" name="Victrix Lance Array" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
     <characteristics>
      <characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Prow</characteristic>
      <characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">10</characteristic>
      <characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">1</characteristic>
      <characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3</characteristic>
      <characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">45″</characteristic>
      <characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Reload (2); Devastating (2). Friendly ships targeting the same enemy this round may each re-roll one failed To Hit roll</characteristic>
     </characteristics>
    </profile>
    <profile id="1ca273c7-ed88-5b5c-91c8-6c5680da874a" name="Nova Cannon" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
