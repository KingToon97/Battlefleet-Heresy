          <selectionEntry id="c15d531f-9462-5e54-923a-42f0c3331a99" name="Remus Ventanus" hidden="false" collective="false" import="true" type="upgrade">
           <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="4f376b15-3e42-5dbf-90e3-db0179ae3c5c" type="max" />
