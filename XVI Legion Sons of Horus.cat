      <profile id="b8f08369-86c8-4e9d-bc1e-85247c426942" name="Primarch Embarkation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">May only be selected in a 2,000+ point fleet and must ride this Legion's Gloriana as Fleet Commander. Rogal Dorn may instead ride the Phalanx where permitted.</characteristic></characteristics></profile></profiles>
