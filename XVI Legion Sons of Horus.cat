            <characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">60″</characteristic>
            <characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">One Shot, Devastating (3), Volatile</characteristic>
          </characteristics>
        </profile>
        <profile id="db12cae0-37c2-54bf-b70e-cd165a98775b" name="Defence Battery ×10" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
          <characteristics>
            <characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">All-round</characteristic>
            <characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">6</characteristic>
            <characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">5</characteristic>
            <characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3</characteristic>
            <characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">12″</characteristic>
            <characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Aircraft to 12″; ships within 6″</characteristic>
          </characteristics>
        </profile>
        <profile id="d0a690f4-21e2-5028-96f9-9f4f6d4c4b5d" name="Gloriana Common Rules" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">A Primarch’s Flagship: Leadership 10; never suffers the Crippled −1 BS penalty; must be the Flagship; one per battle; games of 2,000+ points. Gloriana Reactors: once per battle, when VS would reach 0 it remains at 1. Dorsal Lance Batteries fire into all arcs and never Gets Hot. Heavy Macrobatteries use Reload (1). Armament fixed: no Section 11b refits.</characteristic>
          </characteristics>
        </profile>
        <profile id="44f59994-87b7-5ced-b4ef-2030e80c3085" name="Absolute Command" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Friendly ships within 18″ gain +1 BS, subject to accuracy stacking limits. Hangar Bays (5).</characteristic>
          </characteristics>
        </profile>
        <profile id="404c3b04-7d0e-5d9f-b5cd-2bf0d2c95841" name="Hangar Loadout Validation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Maximum 5 aircraft squadrons: one per Hangar Bay.</characteristic>
          </characteristics>
        </profile>
        <profile id="2fddd5d1-62f1-5c32-ba11-991d096e491b" name="Boarding Forces Validation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding forces are bought against the ship’s Crew. Terminator/Dreadnought class limits are enforced; remember a Contemptor occupies 2 Crew slots.</characteristic>
          </characteristics>
        </profile>
        <profile id="9430b0a0-67ca-51b0-ba6a-da67dd86205d" name="Mount Capacity" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Port: 7 | Starboard: 7 | Prow: 7 | Dorsal: 8 | All-round: 10 | Hangar Bays: 5. Mounts, not arbitrary refit counts, are the limiting factor for weapon configuration.</characteristic>
          </characteristics>
        </profile>
      <profile id="a5f2f5ec-fa0a-40f3-8ca0-df76076639ca" name="Commander Embarkation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander. This character is embarked aboard this Flagship.</characteristic></characteristics></profile><profile id="d1bed3c1-48f8-4247-b4ec-b97c70aaa49f" name="Retinue Eligibility" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">The Primarch Retinue slot may only be used when the Primarch is selected as this ship's Fleet Commander. Choose at most one named Character of the same Legion.</characteristic></characteristics></profile><profile id="733c51d1-1a53-46e0-a2e3-73a24045504d" name="Roster Builder Summary" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Crew 10. Ships start unequipped. Fill only the weapon and Defence hardpoints you want to purchase; each may contain at most one component. Hangar Bay slots cost 0 pts. Aircraft are purchased separately up to Hangar capacity.</characteristic></characteristics></profile></profiles>
      <categoryLinks>
        <categoryLink id="2b7a2682-dc6f-50e6-96e9-dbb75826b34c" name="Capital Ship" hidden="false" targetId="bd422ebf-10b3-5085-89cc-263568c40fe0" primary="true" />
        <categoryLink id="449f3507-7e55-5901-8917-7745a86b5b78" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" />
