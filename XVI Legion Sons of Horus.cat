              <selectionEntry id="e5707494-f5d9-4484-b043-8ce960bc7fcf" name="Heavy Macrobattery (Port)" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="269c9a1a-4889-4b74-9986-d7dc975e3e03" percentValue="false" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <profiles>
                <profile id="f0420734-4b60-4b74-a726-738e7d801997" name="Heavy Macrobattery" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
                  <characteristics>
