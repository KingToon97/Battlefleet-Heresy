        <selectionEntryGroup id="3ab96da9-fce3-420f-9a36-f1f4e83ae5e8" name="Fleet Commander" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="6ecd4c46-fce3-4af4-8577-68dc265192f1" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="d57827a2-6e8a-4cdc-8c57-b50df704aa03" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="940b1c33-0592-48bf-8049-6ddf9cf3971f" name="Fleet Captain" hidden="false" collective="false" import="true" type="upgrade">
