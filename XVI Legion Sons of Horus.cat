            <characteristic name="VS" typeId="84309751-688d-50ef-8940-d8d042261a56">6</characteristic>
            <characteristic name="Speed" typeId="25d0e01e-8e74-55b3-8a2a-17773c881625">8″</characteristic>
            <characteristic name="Turn" typeId="899e9c58-70ef-5da5-8495-5bf6a8b7f8f0">45°</characteristic>
            <characteristic name="Crew" typeId="2f6312dd-493e-53c6-96e2-d901afca0e81">7</characteristic>
          </characteristics>
        </profile>
        <profile id="0a087154-27a6-5190-a0d3-8db27367ba8b" name="Hardpoint Construction" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Bare chassis. Every mounted weapon is purchased separately. No upgrade-spend ceiling. Legal choices are controlled by hull class, hardpoint type and facing; each hardpoint must contain exactly one weapon.</characteristic>
          </characteristics>
        </profile>
      <profile id="d12abe5f-05bb-41bd-82c4-105fcbfb47b6" name="Hangar Bays (1)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">1 physical Hangar Bay mount; each bay costs 10 pts and carries one aircraft squadron.</characteristic></characteristics></profile><profile id="13599edd-00d0-4aec-9f16-503db2fd6375" name="Mount Capacity" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Port: 3 · Starboard: 3 · Prow Ordnance: 3 · Dorsal: 3 · Defence: 6 · Hangar: 1</characteristic></characteristics></profile><profile id="b79bb625-7bcc-44d9-9753-eca4274a44f7" name="Hardpoint Configuration" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ships begin with no weapons or Defence Batteries selected. Hangar Bay slots represent built-in hull capacity and cost 0 pts. Each physical hardpoint may take at most one legal component. There is no separate upgrade-spend cap; the hull's mount layout is the limit.</characteristic></characteristics></profile><profile id="afa1e544-7489-452d-a1e3-43c1d2f0f739" name="Roster Builder Summary" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Crew 7 · Port 3 · Starboard 3 · Prow Ordnance 3 · Dorsal 3 · Defence 6 · Hangars 1. Ships start unequipped. Fill only the weapon and Defence hardpoints you want to purchase; each may contain at most one component. Hangar Bay slots cost 0 pts. Aircraft are purchased separately up to Hangar capacity.</characteristic></characteristics></profile></profiles>
      <categoryLinks>
        <categoryLink id="37435d2f-53f4-5d13-94bc-4a16d155ff92" name="Capital Ship" hidden="false" targetId="bd422ebf-10b3-5085-89cc-263568c40fe0" primary="true" />
      </categoryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup id="144a3a3e-2748-42ff-869f-2a9a3f496d02" name="Fleet Role" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="a253723d-0515-4674-bdf6-24c9e556c3f7" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="e49fca83-5aba-4af8-9ee1-751582c751e8" name="Designate as Flagship" hidden="false" collective="false" import="true" type="upgrade"><profiles><profile id="a6985717-b192-4605-a2d8-d30589b4bb2d" name="Flagship" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship is the fleet's Flagship. Exactly one Flagship is required in a standard fleet.</characteristic></characteristics></profile><profile id="7ad3bebd-315c-4935-99eb-5788befd4764" name="Commander Embarkation" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander here. The Commander is embarked on this Flagship.</characteristic></characteristics></profile></profiles><categoryLinks><categoryLink id="8969e93d-0735-40ec-a735-a127dea15a6a" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" /></categoryLinks><selectionEntryGroups><selectionEntryGroup id="5ebc4759-bb99-450c-8755-938921efe607" name="Fleet Commander" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="6d59d202-4399-4e8c-9653-2dcdb9834be1" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="c9685001-da68-434c-9c67-d07