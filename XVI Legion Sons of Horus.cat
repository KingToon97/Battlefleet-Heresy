        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="283b8733-f9d6-4eb6-a5ad-75bacd37a868" type="max" />
      </constraints>
    <profiles>
        <profile id="f27b7d4a-47b0-4e1a-ab8e-b45c21b9c26d" name="Horus Aximand" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Friendly ships within 6″ may re-roll one failed hit each turn.</characteristic>
          </characteristics>
        </profile>
      <profile id="a4a10e93-3a6e-4879-a583-fde6f6db3407" name="Primarch Retinue" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This character is embarked as the Primarch's additional named retinue. They do not add Fleet Orders, Command range or Leadership; only effects unrelated to the order economy apply.</characteristic></characteristics></profile></profiles>
