<?xml version='1.0' encoding='utf-8'?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="a1c4f0e2-5d37-5b90-8f21-6cb3d9a41e70" name="Open Play" revision="1" battleScribeVersion="2.03" gameSystemId="86405571-5289-597b-b308-a9a2d68c00b9" gameSystemRevision="4" authorName="Battlefleet Heresy" library="true"><readme>Shared library for Open Play. Holds the common line of battle and the rules cards used by every Legion in this system. Not selectable on its own — each Legion catalogue imports it.</readme><selectionEntries><selectionEntry id="cd897248-882f-5b2d-a889-d5b044bc5bcf" name="Escorts" hidden="false" collective="false" import="true" type="unit">
 <constraints><constraint type="max" value="5.0" field="selections" scope="roster" shared="false" id="cad6dc60-c5f7-50c9-8a1f-89976c4599dc" percentValue="false" includeChildSelections="false" includeChildForces="true" /></constraints><profiles><profile id="89ca4fcc-d771-4ec4-94f6-175b2a50e3c7" name="Mount Capacity" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Port: 1 · Starboard: 1 · Prow Ordnance: 1 · Defence: 1</characteristic></characteristics></profile><profile id="eda4417f-d689-4d3a-be1b-485e3db72544" name="Hardpoint Configuration" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ships begin with no weapons or Defence Batteries selected. Hangar Bay slots represent built-in hull capacity and cost 0 pts. Each physical hardpoint may take at most one legal component. There is no separate upgrade-spend cap; the hull's mount layout is the limit.</characteristic></characteristics></profile><profile id="27f7d447-51cb-4b7c-b9e6-53ec7eac06a4" name="Roster Builder Summary" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Crew 2. Ships start unequipped. Fill only the weapon and Defence hardpoints you want to purchase; each may contain at most one component. Hangar Bay slots cost 0 pts. Aircraft are purchased separately up to Hangar capacity.</characteristic></characteristics></profile></profiles><categoryLinks>
 <categoryLink id="efeaf9f4baba319c17fabd76002142fa" name="Line" hidden="false" targetId="96572996-e9b1-54a7-a2a9-2108e1dfc993" primary="true" /></categoryLinks>
 <selectionEntries>
 <selectionEntry id="332b49e9-34a5-5770-bee6-823e9daa2365" name="Escort" hidden="false" collective="false" import="true" type="model">
 <constraints>
 <constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="2934a158-a369-5b02-a554-d03a5e10bd3b" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="3.0" field="selections" scope="parent" shared="false" id="f600a92d-9df3-5e93-9ee5-5bb803a6bedd" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints>
 <profiles>
 <profile id="049f05fc-55f9-5290-9f09-f6df91c136a0" name="Escort" hidden="false" typeId="806f9ff1-fd51-5ddb-b005-ce73a5d09d65" typeName="Ship">
 <characteristics>
 <characteristic name="BS" typeId="d130e705-611e-5a0a-bd7d-ea8e848fdb2e">3</characteristic>
 <characteristic name="Prow" typeId="84a55377-edbc-5825-a2bf-70c6155018f2">11</characteristic>
 <characteristic name="Side" typeId="5f595433-7397-5c4b-9d4a-8f35d83a2b29">10</characteristic>
 <characteristic name="Stern" typeId="cd9ec76e-f959-5560-8845-9ab242f16e71">9</characteristic>
 <characteristic name="HP" typeId="ef713781-2034-5fb4-83d1-e49d1d683694">3</characteristic>
 <characteristic name="VS" typeId="84309751-688d-50ef-8940-d8d042261a56">1</characteristic>
 <characteristic name="Speed" typeId="25d0e01e-8e74-55b3-8a2a-17773c881625">12″</characteristic>
 <characteristic name="Turn" typeId="899e9c58-70ef-5da5-8495-5bf6a8b7f8f0">90°</characteristic>
 <characteristic name="Crew" typeId="2f6312dd-493e-53c6-96e2-d901afca0e81">2</characteristic>
 </characteristics>
 </profile>
 <profile id="f2fbdbd1-f703-5622-b1a1-30cc093ac093" name="Mount Capacity" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Port: 1 | Starboard: 1 | Prow torpedo: 1 | Defence: 1</characteristic>
 </characteristics>
 </profile>
 <profile id="e12a8518-6962-5d17-a7d7-c3b8932f812e" name="Hardpoint Construction" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Bare chassis only. Every weapon on a physical hardpoint is paid separately. There is no upgrade-spend ceiling: facing and mount count are the limits. v0.7 component prices are balanced around sustained fire, armour penetration, shield interaction, firing arc, reload and one-shot restrictions.</characteristic>
 </characteristics>
 </profile>
 <profile id="f1ed3a68-6f07-5fd1-9848-5d56fb62a182" name="Elusive Target" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Enemy ships targeting this vessel fire at −1 Ballistic Skill. No modifier may lower the required roll below 2+.</characteristic></characteristics></profile></profiles>
 <rules><rule id="6f00e64c-785b-588b-acb0-a1facd3198cc" name="Intervention" hidden="false"><description>Costs no order. When a friendly ship within 3″ is attacked, rammed, or targeted by torpedoes, this ship may thrust into the firing line from up to 10″ of the attacker: it does not move, and the whole attack resolves against it instead. Once per battle round.</description></rule><rule id="46f04780-f0a3-5658-9b29-50eb090e0bcc" name="Melta Mines" hidden="false"><description>Carries two. Laid in contact with the ship instead of shooting, never within 6″ of an enemy. Detonates when a non-Escort hull crosses it, hitting everything within 3″ at Str 9 AP 2 and bypassing Void Shields.</description></rule><rule id="82ab5fe0-7df5-5491-865e-7427245bd1d3" name="Line" hidden="false"><description>Counts as a Line Ship for every rule that names one, and toward the fleet's Line minimum.</description></rule><rule id="d79cc0b9-6830-5b0b-8b71-905e670e775d" name="Reload (X)" hidden="false"><description>After firing, place X Reload tokens on the mount; flip one at the end of each battle round. The mount cannot fire while it bears a token.</description></rule><rule id="ba24f6c1-8ed0-52ec-bde8-2e4af43a3142" name="Devastating (X)" hidden="false"><description>Each hit costs X Hull Points, or 1 Void Shield Rating against live shields.</description></rule><rule id="10d895e3-b5ea-5b46-b347-4922c9842d66" name="Armourbane" hidden="false"><description>Roll 2D6 + Strength to penetrate instead of 1D6, at 6″ or less, against shields or hull alike.</description></rule><rule id="66d605fa-0469-5d4d-93c3-206822124cc7" name="Point-Blank Broadsides" hidden="false"><description>At 6″ or less, Port, Starboard and Dorsal weapons improve AP by one step — or gain Armourbane instead if their printed AP is already 1. Prow weapons get neither.</description></rule><rule id="e7f89d88-d253-5998-9165-e8fb28a5dff4" name="Crippled" hidden="false"><description>Below half starting Hull Points: −1 BS and half Speed.</description></rule><rule id="a7b79fb1-83cf-58ed-b781-8debb2ecbc29" name="Depleted" hidden="false"><description>At half starting Crew or less: −1 BS. Stacks with Crippled.</description></rule><rule id="f38a2ebd-3abb-597e-b81b-27a0df5ad3fe" name="Locked" hidden="false"><description>Joined by a ram. Neither ship may move; the rammer may not fire on its victim, who fires back at −1 BS. Break Away on 5+.</description></rule><rule id="f389993b-55cd-5e61-abc6-01ce82759150" name="Snap Shots" hidden="false"><description>Firing at BS 1 — hits only on a 6.</description></rule><rule id="a1c72e93-28d9-540a-a2dd-ac1c283eb509" name="Wreck" hidden="false"><description>0 Hull Points without exploding. Becomes impassable, obscuring terrain; never moves and never Evades.</description></rule><rule id="0ed9ec6e-c0d5-5179-bdc2-65c8794e0eb0" name="Held station" hidden="false"><description>Moved 1″ or less under Burn Retros. Broadsides fire at +1 BS; −1 on Evade.</description></rule><rule id="32d02e86-3c33-538c-8184-fe04652ccb27" name="Squadron" hidden="false"><description>Squadron: this vessel is taken singly, and up to 3 may be grouped into one squadron. A squadron moves and shoots as one unit and must keep coherency, each ship within 6″ of another in the squadron. It may split its fire, but every ship fires all of its own weapons at the one target it chooses.</description></rule></rules><categoryLinks>
 <categoryLink id="b4bbcc23-094c-51f9-91ad-c28e7f5b6941" name="Line" hidden="false" targetId="96572996-e9b1-54a7-a2a9-2108e1dfc993" primary="true" />
 </categoryLinks>
 <selectionEntryGroups>
 <selectionEntryGroup name="Port Mounts" id="1c806c10-3052-58eb-b345-82907fdeaf6b" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="a9748d1f-c58a-5245-b89c-dd821d2e0c84" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="a5660a69-758b-5b18-bfaf-997038b1cb8f" name="Macrobattery (Port)" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="d36325ce-2811-5ea3-a763-7b80bc0607b0" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="f098c22f-4c5c-5f6d-b800-0761fcdc3861" name="Macrobattery (Port)" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Port</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">8</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">3</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">30″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">—</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Starboard Mounts" id="643886d9-6620-55c6-a6fb-b81405af1772" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="d1077cf5-e045-5a92-ba2c-016e2a8ce759" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="4a25a0ae-7147-5570-aa0b-1b2b2c3514ea" name="Macrobattery (Starboard)" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="b9351b5b-26b2-5022-b545-605ef75d8355" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="173403a7-8f41-599f-8b16-433b56d97dd8" name="Macrobattery (Starboard)" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Starboard</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">8</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">3</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">30″</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">—</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="10.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Stern Mounts" id="591374bd-431a-5307-80bc-c3e0c78dfc7f" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="69495acb-ecdf-54fb-84b8-bbe8c5c341cf" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="62cd6400-a210-5727-af0f-c84018d0b0c2" name="Melta Mine Layer" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="d0955d73-43b6-5e40-8e6d-cc3e659ba8e6" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="51c3b98b-b780-5518-8fbe-d7bf2252445e" name="Melta Mine Layer" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon"><characteristics><characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">Stern</characteristic><characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">9</characteristic><characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">2</characteristic><characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">1</characteristic><characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">3″ burst</characteristic><characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Carries 2 mines. Laid instead of shooting, never within 6″ of an enemy. Detonates when a non-Escort hull crosses it, hitting everything within 3″. Bypasses Void Shields</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="20.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Crew Upgrade" id="335f6b34-dc53-5f82-93dc-a7406f29bc03" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="dffe5539-d17b-553a-954b-8684ba319e6b" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="3fb91c1c-c4da-5fd5-8975-f45c494cb82f" name="Veteran Crew - Escort" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="58e32513-5fb6-5182-8e48-d6156219be83" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="832d1dde-74a9-5c2b-82e5-aa6ea6c6749d" name="Veteran Crew" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Once per ship. +1 BS, to maximum BS 5.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="60.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Defence Mounts" id="ec00980f-1af6-5178-92e6-b63bfce29119" hidden="false" collective="false" import="true">
