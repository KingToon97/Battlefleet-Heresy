 <selectionEntryGroup id="ebc1510f7582ab3b96816bed140f92f8" name="Hull Upgrades" hidden="false"><constraints><constraint type="max" value="3.0" field="selections" scope="parent" shared="false" id="7db1e7ec-44f7-5411-9520-171ce6bcb346" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="8eb421f94ed40aceb13886ed2cc05e0c" name="Side Armour Reinforcement" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="e162d703de33bb181b51624ccb9b0268" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="2d75d343b2e3f1a4252e1b35bbb23dff" name="Side Armour Reinforcement" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="75.0" /></costs></selectionEntry><selectionEntry id="4e828681139435cd7282e75025efb4a1" name="Engine Refit" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="9b3291c1df600fdaeb8b23aa5ddbb52b" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="7951383344eee79198f75042155bef7d" name="Engine Refit" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="100.0" /></costs></selectionEntry><selectionEntry id="08651a47-d7c0-5ff5-a3a7-b90cd3e42861" name="Phosphex Shells" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="d2cff0f0-5558-51bd-bf10-1b99cc2759b2" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="b61720ec-63c3-5d06-a712-b70b5f86ae59" name="Phosphex Shells" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Every Heavy Macrobattery aboard fires phosphex: whenever one penetrates armour, the target takes 1 Critical Damage. Requires at least one Heavy Macrobattery.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="50.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
 <costs>
 <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="80.0" />
