selectionEntry><selectionEntry id="7fdbfa34-d966-57a9-b1f4-a552ce859167" name="Phosphex Shells" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="4504779d-8500-53ab-9188-7e262e12837f" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="0d5e5913-eaba-5845-8bc9-81770f07313b" name="Phosphex Shells" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Every Heavy Macrobattery aboard fires phosphex: whenever one penetrates armour, the target takes 1 Critical Damage. Requires at least one Heavy Macrobattery.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="50.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Campaign Record" id="73eed83a-154c-5827-9334-b056fd15f2bf" hidden="false" collective="false" import="true"><selectionEntryGroups><selectionEntryGroup name="Veteran Level" id="10767df8-979c-5738-86ad-0b2660993dab" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="dbc4b788-6fed-5769-b126-97c9594e70ae" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><entryLinks><entryLink id="add5fdb8-e2f6-524d-91e4-78b5d182257d" name="Level I — Blooded" hidden="false" collective="false" import="true" type="selectionEntry" targetId="0422d53a-c5ff-5433-b26c-6d37a29871ef" /><entryLink id="5a0c41ce-f738-58e7-8520-f75e581466b4" name="Level II — Proven" hidden="false" collective="false" import="true" type="selectionEntry" targetId="4177d3ff-5254-57ce-9712-bdc58565a6da" /><entryLink id="c51eea12-2c2f-5014-b677-ec9e76d2aebb