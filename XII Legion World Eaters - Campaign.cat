car: Thinned Complement (5)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="911dcabc-c515-557f-b3a1-5abc66d5eebd" /><entryLink id="af9afdab-8ec1-5435-b2d3-471081295299" name="Scar: Haunted Decks (6)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="ee23f0bd-8e60-554b-afea-2b96200cbc53" /></entryLinks></selectionEntryGroup></selectionEntryGroups></selectionEntryGroup></selectionEntryGroups>
 <costs>
 <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="100.0" />
 </costs>
 </selectionEntry>
 <selectionEntry id="e9c20dc5-d0fa-586f-a729-d85ca509ba61" name="Battle Barge" hidden="false" collective="false" import="true" type="unit">
 <constraints><constraint type="max" value="3.0" field="selections" scope="roster" shared="false" id="156aba1d-9870-5e12-b658-f83a760885aa" percentValue="false" includeChildSelections="false" includeChildForces="true" /></constraints><profiles>
 <profile id="6b5ea49c-7823-5edf-9af0-0c8dd7bc5d5e" name="Battle Barge" hidden="false" typeId="806f9ff1-fd51-5ddb-b005-ce73a5d09d65" typeName="Ship">
 <characteristics>
 <characteristic name="BS" typeId="d130e705-611e-5a0a-bd7d-ea8e848fdb2e">3</characteristic>
 <characteristic name="Prow" typeId="84a55377-edbc-5825-a2bf-70c6155018f2">13</characteristic>
 <characteristic name="Side" typeId="5f595433-7397-5c4b-9d4a-8f35d83a2b29">12</characteristic>
 <characteristic name="Stern" typeId="cd9ec76e-f959-5560-8845-9ab242f16e71">11</characteristic>
 <characteristic name="HP" typeId="ef713781-2034-5fb4-83d1-e49d1d683694">10</characteristic>
 <characteristic name="VS" typeId="84309751-688d-50ef-8940-d8d042261a56">7</characteristic>
 <characteristic name="Speed" typeId="25d0e01e-8e74-55b3-8a2a-17773c881625">9″</characteristic>
 <characteristic name="Turn" typeId="899e9c58-70ef-5da5-8495-5bf6a8b7f8f0">45°</characteristic>
 <characteristic name="Crew" typeId="2f6312dd-493e-53c6-96e2-d901afca0e81">9</characteristic>
 </characteristics>
 </profile>
 <profile id="4c4d1e7d-d6fd-57ee-9ab5-82565727d907" name="Astartes Crew" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">All Crew count as Legiones Astartes (+1), free; may commit up to full current Crew in a Hull Assault, keeping 1 aboard.</characteristic>
 </characteristics>
 </profile>
 <profile id="153a821c-6ba7-5258-8ee2-e605f565019a" name="Boarding Forces Validation" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding forces are bought against the ship’s Crew. Terminator/Dreadnought class limits are enforced; remember a Contemptor occupies 2 Crew slots.</characteristic>
 </characteristics>
 </profile>
 <profile id="ca24dd79-7f23-5ae9-af10-30166dae9adc" name="Hardpoint Construction" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Bare chassis. Every mounted weapon is purchased separately. No upgrade-spend ceiling. Legal choices are controlled by hull class, hardpoint type and facing; each hardpoint must contain exactly one weapon.</characteristic>
 </characteristics>
 </profile>
 <profile id="bbef20bb-989d-5133-a99c-29f5d5f44e13" name="Mount Capacity" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Port: 3 · Starboard: 3 · Prow Weapon: 1 · Prow Assault: 4 · Defence: 6 · Hangar: 2</characteristic></characteristics></profile><profile id="69ef384f-dfee-5647-899b-8f178c1d6769" name="Hardpoint Configuration" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ships begin with no weapons or Defence Batteries selected. Hangar Bay slots represent built-in hull capacity and cost 0 pts. Each physical hardpoint may take at most one legal component. There is no separate upgrade-spend cap; the hull's mount layout is the limit.</characteristic></characteristics></profile><profile id="3d5895cf-d0fd-5f3e-92e4-bea0bd400f07" name="Roster Builder Summary" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Crew 9 · Port 3 · Starboard 3 · Prow 1 · Prow Assault 4 · Defence 6 · Hangars 2. Ships start unequipped. Fill only the weapon and Defence hardpoints you want to purchase; each may contain at most one component. Hangar Bay slots cost 0 pts. Aircraft are purchased separately up to Hangar capacity.</characteristic></characteristics></profile></profiles>
 <rules><rule id="4b7ba4b6-94ab-56a0-be1c-54854b390962" name="Gets Hot" hidden="false"><description>After a Lance Turret or Lance Battery resolves its attacks, roll a D6. On a 1 the firing ship loses 1 Hull Point. Each mount rolls separately.</description></rule><rule id="cbde9e86-df9f-5536-b57d-bc75e3d5a513" name="Capital Ship" hidden="false"><description>Counts as a Capital Ship for every rule that names one, and fills a Capital slot.</description></rule><rule id="40e49f04-4db8-5b99-85be-9d745b867b57" name="Reload (X)" hidden="false"><description>After firing, place X Reload tokens on the mount; flip one at the end of each battle round. The mount cannot fire while it bears a token.</description></rule><rule id="2c3e275a-c31b-5a45-bc2f-a2f7d816185f" name="Devastating (X)" hidden="false"><description>Each hit costs X Hull Points, or 1 Void Shield Rating against live shields.</description></rule><rule id="90508fe4-3edc-5b91-aac3-9d0b2da319a8" name="Armourbane" hidden="false"><description>Roll 2D6 + Strength to penetrate instead of 1D6, at 6″ or less, against shields or hull alike.</description></rule><rule id="be1c3f46-1374-5f47-a908-5adae3e36b05" name="Point-Blank Broadsides" hidden="false"><description>At 6″ or less, Port, Starboard and Dorsal weapons improve AP by one step — or gain Armourbane instead if their printed AP is already 1. Prow weapons get neither.</description></rule><rule id="ecdea403-83da-5d87-9660-738bc999ac4d" name="Crippled" hidden="false"><description>Below half starting Hull Points: −1 BS and half Speed.</description></rule><rule id="8ac9d811-0758-55ea-81a0-dc093326ba69" name="Depleted" hidden="false"><description>At half starting Crew or less: −1 BS. Stacks with Crippled.</description></rule><rule id="2c586766-99cb-5b04-87ea-ae4c788f6550" name="Locked" hidden="false"><description>Joined by a ram. Neither ship may move; the rammer may not fire on its victim, who fires back at −1 BS. Break Away on 5+.</description></rule><rule id="3f19f1d4-0491-59b5-8c15-c07398a18b41" name="Snap Shots" hidden="false"><description>Firing at BS 1 — hits only on a 6.</description></rule><rule id="61b436e5-389f-51ff-8d6e-80e965cec97e" name="Wreck" hidden="false"><description>0 Hull Points without exploding. Becomes impassable, obscuring terrain; never moves and never Evades.</description></rule><rule id="c5d0ab9f-f214-55f0-b3b4-e1508a1495cb" name="Held station" hidden="false"><description>Moved 1″ or less under Burn Retros. Broadsides fire at +1 BS; −1 on Evade.</description></rule></rules><categoryLinks>
 <categoryLink id="fee282d9-e50c-5a51-a00f-bb6c04253823" name="Capital Ship" hidden="false" targetId="bd422ebf-10b3-5085-89cc-263568c40fe0" primary="false" />
 <categoryLink id="28c49558-9e23-542f-b7d0-8dd58c8f458a" name="Open Play Fleet" hidden="false" targetId="f4a1bdc9-d680-5abd-a007-4b0b71797ecd" primary="false" /><categoryLink id="b1148a3e-2d50-549f-9514-13a84a332d34" name="Campaign Fleet" hidden="false" targetId="69270169-f826-5f6c-8c3d-26f416055ec0" primary="true" /></categoryLinks>
 <selectionEntryGroups>
 <selectionEntryGroup id="465b1221-a163-5267-9708-d688f87b50e1" name="Fleet Role" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="2eb450dc-6e39-5db7-bd7d-2b2fe3d4b8d8" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="6d6c6d7c-e890-58e3-95fc-7037207158e0" name="Designate as Flagship" hidden="false" collective="false" import="true" type="upgrade"><profiles><profile id="8c02aa93-7c9e-55a3-8b2a-7172e09147ee" name="Commander Embarkation" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander here. The Commander is embarked on this Flagship.</characteristic></characteristics></profile></profiles><rules><rule id="b9e1d5bd-0947-516b-8322-8b98fc96066b" name="Flagship" hidden="false"><description>This ship is the fleet's Flagship. Exactly one Flagship is required in a standard fleet.</description></rule></rules><categoryLinks><categoryLink id="98c8ec42-064a-5355-8223-26d25f84319d" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" /></categoryLinks><selectionEntryGroups><selectionEntryGroup id="ae20a643-87bf-5ae8-852e-1fc7760588bd" name="Fleet Commander" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="5449381a-4a16-5e0d-a10b-50d54f0dcf6b" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="b144c20d-090d-55e2-bf79-680d41c281f1" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="2d184a6f-8f4b-5eae-8810-345b22864456" name="Fleet Captain" hidden="false" collective="false" import="true" type="upgrade">
 <constraints>
 <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6a3022e0-0a22-5f38-8ec9-7cfca00d6914" type="max" />
 </constraints>
 <profiles>
 <profile id="d4fe588b-089d-59e9-b070-0c602d9cc152" name="Fleet Captain" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Fleet Captain. 1 Fleet Order of each type each battle round. Ship’s Master: once per battle, the Flagship may re-roll a single failed Evade roll.</characteristic>
 </characteristics>
 </profile>
 </profiles>
 <categoryLinks>
 <categoryLink id="5773e6fb-483f-5bc3-8e3b-39951abd690e" name="Commander" hidden="false" targetId="6f3339ad-23a9-5687-b08f-3f11a43fe50b" primary="true" />
