 <selectionEntry id="752046dd-d93b-5483-a8bc-0b132686fe57" name="Lotara Sarrin" hidden="false" collective="false" import="true" type="upgrade">
 <constraints>
 <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="cd8f9688-446a-5442-a261-8ec657b53615" type="max" />
 </constraints>
 <profiles>
 <profile id="a4acef43-81b4-5388-9e2c-0b538c6cb046" name="Lotara Sarrin" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
