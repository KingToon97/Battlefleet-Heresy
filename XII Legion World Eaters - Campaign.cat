k id="083e69f3-2ed0-5c59-9464-a5538d4f2d65" name="Corridor Fighters" hidden="false" collective="false" import="true" type="selectionEntry" targetId="86901424-0ee6-5da6-99b2-80e129c9cedf" /><entryLink id="0bbc5de9-f97a-5499-8f15-f14b4aa1f14f" name="Ready at the Ramp (restricted: does not already have Assault Ramp)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="0e6ab312-75ff-5bf2-a05e-bc4308889fbe" /><entryLink id="a43c23e6-825f-5aba-a8af-da252d4ab515" name="Butcher's Bill" hidden="false" collective="false" import="true" type="selectionEntry" targetId="f7b53e1a-7b5b-5ad6-86a7-5b86fb562ebe" /><entryLink id="54056055-771c-504b-803a-03d4ac0eaa67" name="Prize Crew" hidden="false" collective="false" import="true" type="selectionEntry" targetId="51c9b35b-fccc-5192-a7a8-fdd050cb3ce3" /><entryLink id="4165fe30-e51e-55fc-a226-8c8a33a983e8" name="Terror of the Void" hidden="false" collective="false" import="true" type="selectionEntry" targetId="d42808c6-bb45-578d-af04-63a7b5956a1c" /><entryLink id="c14ef54b-199d-5c56-be43-459a7f5eb0f3" name="The Unsinkable" hidden="false" collective="false" import="true" type="selectionEntry" targetId="6a9a0ce7-24fa-505f-a17c-6f0f5e6dbcb6" /><entryLink id="e4181aa3-c46a-5ae8-97e9-155cc7f93e33" name="Legend of the Line" hidden="false" collective="false" import="true" type="selectionEntry" targetId="725932d8-0fc7-5e63-a2e3-ca3546e9b3b4" /><entryLink id="8fc8d43b-a2fc-5e6e-9ace-939cc80c3f4b" name="She Remembers" hidden="false" collective="false" import="true" type="selectionEntry" targetId="3a675403-7c09-50b5-a664-0f5f7c29fcc2" /><entryLink id="bfe84926-9d37-537b-85ff-c25fc55e5f7b" name="The Emperor's Own" hidden="false" collective="false" import="true" type="selectionEntry" targetId="2c5b9df3-9987-5238-9a1e-1fd0a7c35bff" /></entryLinks></selectionEntryGroup><selectionEntryGroup name="Battle Scars" id="29cbf2e7-9aec-59f2-856a-3a1b05b1a2bb" hidden="false" collective="false" import="true"><entryLinks><entryLink id="00624374-7031-5153-bd89-7f26a6c5e52f" name="Scar: Warped Keel (1)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="e8b0d2ac-3e0f-58cb-9149-d56a67c1365d" /><entryLink id="0b2c86ab-8c12-593f-ba4b-7b562a880201" name="Scar: Scarred Plate (2)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="6992c5f7-fe97-53cf-be82-b823fa3c974c" /><entryLink id="2a6f9c72-ccee-5dac-abbe-f9a544bb7827" name="Scar: Ruined Gun Deck (3)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="32d19964-15d2-59d8-aade-bc173b4b2132" /><entryLink id="e5ccef52-4b3d-5eae-8c56-b66d0378e3e7" name="Scar: Cracked Reactor (4)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="339aa58b-4758-57a7-a146-4aefcad66ce0" /><entryLink id="622744ca-8e6a-5f30-9751-674e1bbee23b" name="Scar: Thinned Complement (5)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="911dcabc-c515-557f-b3a1-5abc66d5eebd" /><entryLink id="ef2279ec-a4f1-50fc-a601-d5ffb1920006" name="Scar: Haunted Decks (6)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="ee23f0bd-8e60-554b-afea-2b96200cbc53" /></entryLinks></selectionEntryGroup></selectionEntryGroups></selectionEntryGroup></selectionEntryGroups>
 <costs>
 <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="870.0" />
 </costs>
 </selectionEntry>
 <selectionEntry id="ef335acf-a03e-50ec-b482-bce1d65bc65d" name="XII Legion - Violence Incarnate" hidden="false" collective="false" import="true" type="upgrade">
 <rules><rule id="c2b8b675-e3af-597f-b807-4c731d551268" name="XII Legion - Violence Incarnate" hidden="false"><description>One ship per turn gains +3 on its Ram roll.</description></rule></rules><categoryLinks>
 <categoryLink id="fdfa2ed9-6baa-5724-8329-53d23c700759" name="Open Play Fleet" hidden="false" targetId="f4a1bdc9-d680-5abd-a007-4b0b71797ecd" primary="false" /><categoryLink id="3aec5743-a648-50a8-9291-3366252a1879" name="Rules" hidden="false" targetId="52616092-abd8-519e-a6fb-94b622114fa5" primary="false" /><categoryLink id="d68e836e-4e1a-50db-9639-12b3b0b22b0f" name="Campaign Fleet" hidden="false" targetId="69270169-f826-5f6c-8c3d-26f416055ec0" primary="true" /></categoryLinks>
 </selectionEntry>
 <selectionEntry id="85316a1c-d1a7-57c5-a8c5-5846a7e3e0cd" name="Battle Carrier" hidden="false" collective="false" import="true" type="unit">
 <constraints><constraint type="max" value="3.0" field="selections" scope="roster" shared="false" id="82c81104-3f73-5b52-9a19-851596608bf9" percentValue="false" includeChildSelections="false" includeChildForces="true" /></constraints><profiles>
 <profile id="2c8709e9-ec86-5bd5-80fc-29e1c514d735" name="Battle Carrier" hidden="false" typeId="806f9ff1-fd51-5ddb-b005-ce73a5d09d65" typeName="Ship">
 <characteristics>
 <characteristic name="BS" typeId="d130e705-611e-5a0a-bd7d-ea8e848fdb2e">3</characteristic>
 <characteristic name="Prow" typeId="84a55377-edbc-5825-a2bf-70c6155018f2">14</characteristic>
 <characteristic name="Side" typeId="5f595433-7397-5c4b-9d4a-8f35d83a2b29">13</characteristic>
 <characteristic name="Stern" typeId="cd9ec76e-f959-5560-8845-9ab242f16e71">12</characteristic>
 <characteristic name="HP" typeId="ef713781-2034-5fb4-83d1-e49d1d683694">13</characteristic>
 <characteristic name="VS" typeId="84309751-688d-50ef-8940-d8d042261a56">8</characteristic>
 <characteristic name="Speed" typeId="25d0e01e-8e74-55b3-8a2a-17773c881625">6″</characteristic>
 <characteristic name="Turn" typeId="899e9c58-70ef-5da5-8495-5bf6a8b7f8f0">45°</characteristic>
 <characteristic name="Crew" typeId="2f6312dd-493e-53c6-96e2-d901afca0e81">8</characteristic>
 </characteristics>
 </profile>
 <profile id="5bf5ac43-90f1-51a3-8feb-e1ca57aaf193" name="Bulwark of the Line" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Enemy Damage Table rolls against this ship suffer −1.</characteristic>
 </characteristics>
 </profile>
 <profile id="efb89031-e337-554e-bbcf-3209e734fb1e" name="Boarding Forces Validation" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding forces are bought against the ship’s Crew. Terminator/Dreadnought class limits are enforced; remember a Contemptor occupies 2 Crew slots.</characteristic>
 </characteristics>
 </profile>
 <profile id="948e0af5-2886-5c13-b7df-d871944224bf" name="Hardpoint Construction" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Bare chassis. Every mounted weapon is purchased separately. No upgrade-spend ceiling. Legal choices are controlled by hull class, hardpoint type and facing; each hardpoint must contain exactly one weapon.</characteristic>
 </characteristics>
 </profile>
 <profile id="24b33f85-0fba-52e9-b3c0-7dfad72fec1e" name="Mount Capacity" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Port Heavy: 1 · Starboard Heavy: 1 · Prow Ordnance: 6 · Dorsal: 4 · Defence: 10 · Hangar: 6</characteristic></characteristics></profile><profile id="c368988a-f667-5d99-9801-2600fe799529" name="Hardpoint Configuration" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ships begin with no weapons or Defence Batteries selected. Hangar Bay slots represent built-in hull capacity and cost 0 pts. Each physical hardpoint may take at most one legal component. There is no separate upgrade-spend cap; the hull's mount layout is the limit.</characteristic></characteristics></profile><profile id="c872694f-b926-5d90-8996-346f7001285f" name="Carrier Flagship Priority" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">A Battle Carrier must be the fleet's Flagship unless a Gloriana is present. New Recruit enforces this through the Fleet Role selection.</characteristic></characteristics></profile><profile id="9f5eb774-6558-5eca-ae19-d571cf015cba" name="Roster Builder Summary" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Crew 8 · Port Heavy 1 · Starboard Heavy 1 · Prow Ordnance 6 · Dorsal 4 · Defence 10 · Hangars 6. Ships start unequipped. Fill only the weapon and Defence hardpoints you want to purchase; each may contain at most one component. Hangar Bay slots cost 0 pts. Aircraft are purchased separately up to Hangar capacity.</characteristic></characteristics></profile></profiles>
 <rules><rule id="dc8bbeb6-c136-5b23-a633-6ab663d6a999" name="Gets Hot" hidden="false"><description>After a Lance Turret or Lance Battery resolves its attacks, roll a D6. On a 1 the firing ship loses 1 Hull Point. Each mount rolls separately.</description></rule><rule id="750e8e63-5659-5a8d-9207-66d0bc64999a" name="Twin-Linked" hidden="false"><description>Re-roll failed To Hit rolls.</description></rule><rule id="f55cf9b8-a868-5e40-a2a1-d9abbfa8cf8e" name="Air Group" hidden="false"><description>Carries six aircraft squadrons free of charge, chosen when the fleet is built. Further squadrons may be bought, but she has nowhere to put them.</description></rule><rule id="3caec2c0-31f6-52a1-b1da-11785e7ff525" name="Capital Ship" hidden="false"><description>Counts as a Capital Ship for every rule that names one, and fills a Capital slot.</description></rule><rule id="2053bf75-a965-5809-b340-51bf6eb420e6" name="Reload (X)" hidden="false"><description>After firing, place X Reload tokens on the mount; flip one at the end of each battle round. The mount cannot fire while it bears a token.</description></rule><rule id="f6fb5a66-4f6d-511a-b439-a0ccff73c08f" name="Devastating (X)" hidden="false"><description>Each hit costs X Hull Points, or 1 Void Shield Rating against live shields.</description></rule><rule id="0d0da551-f55c-50bb-8449-c093019cc870" name="Armourbane" hidden="false"><description>Roll 2D6 + Strength to penetrate instead of 1D6, at 6″ or less, against shields or hull alike.</description></rule><rule id="d472a1d1-9c67-5efb-8281-08eff96a09a5" name="Point-Blank Broadsides" hidden="false"><description>At 6″ or less, Port, Starboard and Dorsal weapons improve AP by one step — or gain Armourbane instead if their printed AP is already 1. Prow weapons get neither.</description></rule><rule id="7bf24297-0c46-5cdc-9569-4089daa80172" name="Crippled" hidden="false"><description>Below half starting Hull Points: −1 BS and half Speed.</description></rule><rule id="09f12187-c0de-55a6-9a2f-8cde7bfa39d3" name="Depleted" hidden="false"><description>At half starting Crew or less: −1 BS. Stacks with Crippled.</description></rule><rule id="c0557593-edd6-585a-bcff-d822f52904da" name="Locked" hidden="false"><description>Joined by a ram. Neither ship may move; the rammer may not fire on its victim, who fires back at −1 BS. Break Away on 5+.</description></rule><rule id="91be8bde-dda5-5b66-8896-3ce8eb2556cb" name="Snap Shots" hidden="false"><description>Firing at BS 1 — hits only on a 6.</description></rule><rule id="a07e1d39-bdfb-550e-8d62-17bdc1685540" name="Wreck" hidden="false"><description>0 Hull Points without exploding. Becomes impassable, obscuring terrain; never moves and never Evades.</description></rule><rule id="83ac84a7-ce5f-5498-a164-06d5fe7d55a7" name="Held station" hidden="false"><description>Moved 1″ or less under Burn Retros. Broadsides fire at +1 BS; −1 on Evade.</description></rule></rules><categoryLinks>
 <categoryLink id="faf4929c-bb09-5aff-9937-597d3813953b" name="Capital Ship" hidden="false" targetId="bd422ebf-10b3-5085-89cc-263568c40fe0" primary="false" />
 <categoryLink id="2f86d99b-35ca-568a-ad42-87b828fe7652" name="Open Play Fleet" hidden="false" targetId="f4a1bdc9-d680-5abd-a007-4b0b71797ecd" primary="false" /><categoryLink id="375d0206-bca4-5bc9-8e49-e65c408804c2" name="Campaign Fleet" hidden="false" targetId="69270169-f826-5f6c-8c3d-26f416055ec0" primary="true" /></categoryLinks>
 <selectionEntryGroups>
 <selectionEntryGroup id="ee57c10d-3355-5839-96eb-599a12ce61a6" name="Fleet Role" hidden="false" collective="false" import="true"><modifiers><modifier type="set" field="74761eec-ce7b-427c-8f29-cb71b5f04429" value="0.0"><conditions><condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="6e49ea9d-e24f-5916-8418-787496f3214a" type="atLeast" /></conditions></modifier></modifiers><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="edac3b83-021b-5b01-93ec-12504878d731" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="d71bd9de-de7b-5f23-81ab-9669ebcb3eba" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="15730a6e-6014-5cb4-a7d4-6d4c1f5493d2" name="Designate as Flagship" hidden="false" collective="false" import="true" type="upgrade"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="6e49ea9d-e24f-5916-8418-787496f3214a" type="atLeast" /></conditions></modifier></modifiers><profiles><profile id="078e1f75-61c9-5f43-8389-dfc2097c666b" name="Commander Embarkation" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander here. The Commander is embarked on this Flagship.</characteristic></characteristics></profile></profiles><rules><rule id="b3a14cf8-454d-5579-b6bd-7df14b20dcb6" name="Flagship" hidden="false"><description>Mandatory when the fleet contains no Gloriana. If a Gloriana is selected, this option is automatically hidden and the requirement is removed.</description></rule></rules><categoryLinks><categoryLink id="c3e6500c-0e41-5207-8f5e-051c5b81ec4e" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" /></categoryLinks><selectionEntryGroups><selectionEntryGroup id="b78a250e-f4a2-5bac-a44c-77d8758f4d3a" name="Fleet Commander" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="0ca2f4e9-5731-58e6-8d78-05c3ff82c547" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="7756bfd5-10e1-51a8-a6a5-5d0dfc81eebc" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="0d343cdd-4545-554a-917b-d7e63479c018" name="Fleet Captain" hidden="false" collective="false" import="true" type="upgrade">
 <constraints>
 <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="5e7dbbf9-9ea0-52b1-b49b-f44152529390" type="max" />
 </constraints>
 <profiles>
 <profile id="08b3617d-02ce-5bd1-9e1f-d4cd3f63aff7" name="Fleet Captain" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Fleet Captain. 1 Fleet Order of each type each battle round. Ship’s Master: once per battle, the Flagship may re-roll a single failed Evade roll.</characteristic>
 </characteristics>
 </profile>
 </profiles>
