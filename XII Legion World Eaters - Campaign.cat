 <characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">4 rails</characteristic>
 <characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">18″</characteristic>
 <characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">One pod per rail, each rail once per battle</characteristic>
 </characteristics>
 </profile>
 <profile id="bca6fd4a-a774-5c3d-b310-940f8a203562" name="Defence Battery ×8" hidden="false" typeId="9e230bf6-0ca5-5105-b10d-a29e26b36da4" typeName="Weapon">
 <characteristics>
 <characteristic name="Mount" typeId="a7d4d3c1-fadb-52b5-b9c2-4ca7010a2a7f">All-round</characteristic>
 <characteristic name="Str" typeId="909e3bc8-34f7-50eb-8079-4e717af82c39">6</characteristic>
 <characteristic name="AP" typeId="1086c466-d9ef-5b28-afb0-8d806ff0f9c2">5</characteristic>
 <characteristic name="Shots" typeId="f85124c6-e75b-574a-befd-08cd1968bedf">3</characteristic>
 <characteristic name="Range" typeId="f06bbe8e-b4ee-55fe-a54c-c6fda727a7fd">12″</characteristic>
 <characteristic name="Special" typeId="59853d0d-663c-56dc-9957-cd236b62b380">Aircraft to 12″; ships within 6″</characteristic>
 </characteristics>
 </profile>
 <profile id="85bb97ea-4eea-54fe-ab15-a8f779aac1f4" name="Gloriana Common Rules" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">A Primarch’s Flagship: never suffers the Crippled −1 BS penalty; must be the Flagship; one per battle; games of 2,000+ points. Gloriana Reactors: once per battle, when VS would reach 0 it remains at 1. Dorsal Lance Batteries fire into all arcs and never Gets Hot. Heavy Macrobatteries use Reload (1). Armament fixed: no Section 11b refits.</characteristic>
 </characteristics>
 </profile>
 <profile id="67198e37-526f-512b-8934-2051bc46c9ee" name="Butcher’s Nails" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">May declare a Ram against any enemy within 12″ of prow rather than 6″. Hangar Bays (4).</characteristic>
 </characteristics>
 </profile>
 <profile id="6999e400-c557-5488-9324-697b0d23b886" name="Boarding Forces Validation" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding forces are bought against the ship’s Crew. Terminator/Dreadnought class limits are enforced; remember a Contemptor occupies 2 Crew slots.</characteristic>
 </characteristics>
 </profile>
 <profile id="ee324356-d03d-50d2-87a0-2af523b57ee4" name="Mount Capacity" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Port: 7 | Starboard: 7 | Prow: 1 | Dorsal: 6 | All-round: 8 | Hangar Bays: 4. Mounts, not arbitrary refit counts, are the limiting factor for weapon configuration.</characteristic>
 </characteristics>
 </profile>
 <profile id="142541a0-e68c-5f39-be2b-7cb31e769244" name="Commander Embarkation" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander. This character is embarked aboard this Flagship.</characteristic></characteristics></profile><profile id="1e65524e-1a1c-536c-8fc6-36090866b0cc" name="Retinue Eligibility" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">The Primarch Retinue slot may only be used when the Primarch is selected as this ship's Fleet Commander. Choose at most one named Character of the same Legion.</characteristic></characteristics></profile><profile id="cf614d72-3865-5f3d-9cc7-67cfd43819b2" name="Roster Builder Summary" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Crew 14. Ships start unequipped. Fill only the weapon and Defence hardpoints you want to purchase; each may contain at most one component. Hangar Bay slots cost 0 pts. Aircraft are purchased separately up to Hangar capacity.</characteristic></characteristics></profile></profiles>
 <categoryLinks>
