 <sharedSelectionEntries><selectionEntry id="a7702998-5962-5b4c-96e7-5df501554eba" name="Master Gunners" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="3c19cf64-8bc6-5101-babc-6e787bcb09da" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="7ef38821-eb72-503b-ab20-cbd55b9dba9f" name="Master Gunners" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Once per battle round, one weapon system aboard may re-roll a single failed To Hit roll.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" /></costs></selectionEntry><selectionEntry id="6a23924b-02f5-51d1-82ea-7a9293c58a52" name="Void Marksmen" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="5443b5f5-bce3-5195-94b2-e9539c2eb9c8" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="03f57156-58bf-5d74-bb12-75e305c78d71" name="Void Marksmen" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship's shots add +1 to penetration rolls against Void Shields. Against a bare hull it does nothing — these crews are practised at finding the seams in an envelope.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" /></costs></selectionEntry><selectionEntry id="6c28eaad-ee9d-5e39-a869-fc79422f40cb" name="Ordnance Veterans" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="8d3e6c50-1914-5849-b752-a3b0da5d781d" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="1ea3a584-dd05-5322-bec8-238216a810d4" name="Ordnance Veterans" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Once per battle, remove one Reload token from a weapon system aboard. This costs no Fleet Order.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" /></costs></selectionEntry><selectionEntry id="3da029ff-4b9d-5e2b-80cf-cd55b2257a39" name="Executioners" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="ea455fe3-6a9c-5d70-acc2-8dd0f6819162" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="c0f9f3cc-f324-5304-8c3c-91c7c9b476a5" name="Executioners" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 on Damage Table rolls against any ship already carrying Critical Damage.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" /></costs></selectionEntry><selectionEntry id="146a06bc-0244-593c-a5c4-9578800f723e" name="Cold Gunnery (restricted: must mount a Lance Turret or Lance Battery)" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="99ede1ad-5d71-5a6d-bef8-03236c7926e9" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="f4763070-9144-50da-a920-bbd3178a3b28" name="Cold Gunnery (restricted: must mount a Lance Turret or Lance Battery)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">The first Gets Hot roll of 1 this ship suffers each battle inflicts no Hull Point.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" /></costs></selectionEntry><selectionEntry id="94f1ff56-4e3c-55da-a6dd-e13797ad37e4" name="Practised Broadside" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="3d1a7c37-a35c-5418-bc1a-515e50a723d8" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="984d5a28-a3ef-53b0-9ccc-ed17ae9b9b60" name="Practised Broadside" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">When this ship has held station under Burn Retros, its broadsides re-roll To Hit rolls of 1.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" /></costs></selectionEntry><selectionEntry id="e72095c0-6645-58e7-acc5-5c2fd16ca2f4" name="Iron Discipline" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="f01ce44f-1f31-5fcf-9860-d221d4f020da" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="b6278b8c-da3d-53af-aba6-7d01ae46efba" name="Iron Discipline" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship ignores the Depleted −1 BS penalty.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" /></costs></selectionEntry><selectionEntry id="0ea322ae-b0ac-596d-bc9e-f48a5788376d" name="Damage Control Veterans" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="1e5c9df9-2f5e-5fe6-a3bb-ab4410c0f85d" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="6e751c52-4ef0-5f12-abbd-cd9a0fa7eed1" name="Damage Control Veterans" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Damage Control succeeds on a 3+ rather than 4+.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" /></costs></selectionEntry><selectionEntry id="0c577c43-e46e-553e-823e-6a7760f15242" name="Old Warhorse" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="322c199c-6495-59a9-b148-04737d1ce689" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="576be5aa-eebc-5686-b6bd-59e3a13b3a8f" name="Old Warhorse" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Counts as Crippled only below a third of its starting Hull Points, rather than half.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" /></costs></selectionEntry><selectionEntry id="0d045628-dc97-56b0-b526-1a8b9c7b83fa" name="Never Abandon Ship" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="f2235fe3-60c0-5ac1-98e6-df2b1afe98ee" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="f7c5df18-77c6-5554-bb7a-366577703976" name="Never Abandon Ship" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Re-roll the D6 taken at 0 Hull Points. The owning player chooses which result stands — sometimes a crew would rather take the enemy with them.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" /></costs></selectionEntry><selectionEntry id="bcfadde2-57b3-5cf3-9784-06c345fd72bc" name="Steady Bridge" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="e137e505-c91b-54c0-b565-314c1a831a77" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="96e96971-2d82-5884-8ff7-a7afbd2ca07e" name="Steady Bridge" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Once per battle round this ship may be issued a Fleet Order while outside Command range.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" /></costs></selectionEntry><selectionEntry id="e4a652cb-cd83-5e26-bed2-d4175aa3ed3b" name="Grim Resolve" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="32eb8eb4-4d37-5995-b8c5-60ac9ab2bb97" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="8f5280a4-013f-555b-8b87-cd4d556f14d3" name="Grim Resolve" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Enemy boarding parties suffer −1 on every die in the first round of any boarding action fought aboard this ship.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" /></costs></selectionEntry><selectionEntry id="db051a5e-b07d-56ef-9552-a1d3488a7789" name="Master Helmsman" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="8d6085f8-517e-51b0-b196-e624a942a7a6" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="8b2745c6-8789-52f2-8604-66f12691d48a" name="Master Helmsman" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Once per battle, re-roll a failed Evade roll.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" /></costs></selectionEntry><selectionEntry id="d965b3fe-330c-5c91-94a1-9653cd03ad51" name="Flank Speed" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="f1d88af3-7f89-522b-a898-5f41fac6acfc" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="b11f6f79-77fd-5fa4-9226-275aef7d12c9" name="Flank Speed" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1″ Speed, to the 12″ ceiling, and this ship needs only move a fifth of its Speed straight before turning rather than a quarter.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" /></costs></selectionEntry><selectionEntry id="9c5a5c4f-0ff1-5b16-bd78-32cadd6a0db8" name="Veteran Navigator" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="55815b81-79a2-507f-8256-23862607c4e2" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="0f78e908-e31a-514c-9b68-4cf5b199d0b5" name="Veteran Navigator" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ignores the −1 BS for firing into, out of, or within an Asteroid Field, and passes Dangerous Terrain tests automatically.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" /></costs></selectionEntry><selectionEntry id="ebdc1447-ddbe-5911-9e27-f860226fdb52" name="Ramming Veteran" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="a183d9e7-e49f-56be-8b6e-cf36f4f7b553" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="087043cd-7bb0-573b-87f4-3f4ddd784007" name="Ramming Veteran" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 on this ship's ram Connect rolls, and it loses D3−1 Hull Points from its own ram rather than D3.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" /></costs></selectionEntry><selectionEntry id="8b39f1c9-9548-57f4-b92f-2c095988eb45" name="Come About Drill (restricted: Cruiser or larger)" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="b3f5bc40-c700-5030-a7d9-179c5dd2a241" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="291d3658-af68-5aa3-9a9a-0f928d80cfc9" name="Come About Drill (restricted: Cruiser or larger)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship gains Come About!, turning at any point in its move.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" /></costs></selectionEntry><selectionEntry id="8fc82ad0-7164-5812-bc1f-718f97b150c1" name="Silent Running" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="a8ea2f51-8c89-581c-9aa7-9c1401826d6b" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="57d8c87a-6be5-5f73-9a77-95c2cdfb5c2b" name="Silent Running" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship cannot be targeted at ranges beyond 36″ during the first battle round, unless it has fired.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" /></costs></selectionEntry><selectionEntry id="615698cb-2552-5f9d-83d9-e64cdde9b129" name="Storm Parties" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="135564d2-d353-54f0-af0e-d017f02debae" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="d0f5c675-01e4-54d1-9aef-9406f97b55ac" name="Storm Parties" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 to every boarding die in the first round of any action this ship's parties begin.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" /></costs></selectionEntry><selectionEntry id="75f7cb2a-d811-5253-a886-19f1ee1895db" name="Breach Veterans" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="8a8a871d-47ff-56d5-9cb2-36bea2614b98" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="f6bfa936-3def-541a-a6da-901c4c5e6e24" name="Breach Veterans" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship's Hit-and-Run raids succeed on a 3+ rather than 4+.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" /></costs></selectionEntry><selectionEntry id="86901424-0ee6-5da6-99b2-80e129c9cedf" name="Corridor Fighters" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="dc2b7003-24a9-56d8-99d7-ea85d81e82de" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="44c19e01-45b1-5286-8ff8-83eb19dbd176" name="Corridor Fighters" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">When defending against boarders, one enemy die each round suffers −1.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" /></costs></selectionEntry><selectionEntry id="0e6ab312-75ff-5bf2-a05e-bc4308889fbe" name="Ready at the Ramp (restricted: does not already have Assault Ramp)" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="20409b14-8631-55c9-9129-010e09741a47" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="9dd9cf25-eede-5276-afb3-48eabb8fcb6e" name="Ready at the Ramp (restricted: does not already have Assault Ramp)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">In a Hull Assault this ship may commit up to its full current Crew rather than half, always keeping 1 aboard.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" /></costs></selectionEntry><selectionEntry id="f7b53e1a-7b5b-5ad6-86a7-5b86fb562ebe" name="Butcher's Bill" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="70e6dbcb-16bb-51cc-a921-8c78f6b6ab6c" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="831bd950-55d1-545e-b82f-398c06de3c26" name="Butcher's Bill" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Once per boarding action, in a round where this ship's parties inflict a casualty, they inflict one more.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" /></costs></selectionEntry><selectionEntry id="51c9b35b-fccc-5192-a7a8-fdd050cb3ce3" name="Prize Crew" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="0a96685d-7041-5280-84c4-8f5a4b020ab6" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="ea89d276-5c2b-5d59-9fee-fa497864a081" name="Prize Crew" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">When this ship captures an enemy vessel, it need transfer only 1 Crew regardless of the prize's size, and that Crew returns at the end of the battle.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" /></costs></selectionEntry><selectionEntry id="617cd28b-1810-5b76-9cf3-f74a6c476f49" name="Practised Deck Crews" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="2a2c6433-51ee-5f8b-9318-6deda07e6b32" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="b71f3953-5ba1-5a18-8ba2-b3b3d56fcd00" name="Practised Deck Crews" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship may launch and recover squadrons in the same battle round.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" /></costs></selectionEntry><selectionEntry id="0b121b12-22cf-514c-986a-3e8c74deeb2a" name="Rearming Drill" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="7ade2a96-5c4a-5d1a-828b-95fda03c92d8" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="87ba71a1-2cd3-5bc9-bff0-ab3922d203cd" name="Rearming Drill" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">A bomber squadron that docks with this ship may launch again in the same round it docked.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" /></costs></selectionEntry><selectionEntry id="2fbc33f8-c687-5388-b06a-d9bd822c0bc3" name="Combat Air Patrol" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="2b384b11-5eaa-5bae-815c-91f8c896960d" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="3c514c24-d24c-53ec-9866-f3797b6c4e3e" name="Combat Air Patrol" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Fighters launched from this ship destroy enemy craft on a 2+ in the first round of each dogfight.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" /></costs></selectionEntry><selectionEntry id="97d9aa73-9806-5898-bb12-10cc4542ddff" name="Strike Coordinators" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="b9134836-1c7f-549a-b921-b63fb23ea7d8" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="70a0c715-4098-5c21-90a9-76cc26a8c8da" name="Strike Coordinators" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Bomber squadrons launched from this ship re-roll one failed To Hit roll per attack run.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" /></costs></selectionEntry><selectionEntry id="ab5dbffe-496e-5eaf-b937-377ac996ea66" name="Ace Wing" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="a885715c-8e80-559d-b2bb-80e33bbe78fc" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="3817b1d9-7eb4-5f2b-85a4-bddfed2d911b" name="Ace Wing" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Nominate one squadron aboard at the start of each battle. The first craft it would lose is not removed.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" /></costs></selectionEntry><selectionEntry id="770d15e9-76f3-59fb-bebb-c4c9f111d763" name="Deep Magazines" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="3d166af7-0c0a-550e-878f-64362fb525d2" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="6a1aeaf1-44bd-5a5e-a475-69bca0e8e359" name="Deep Magazines" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Once per battle, a spent bomber squadron re-arms without returning to a Hangar Bay.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" /></costs></selectionEntry><selectionEntry id="d42808c6-bb45-578d-af04-63a7b5956a1c" name="Terror of the Void" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="dc0df781-4d44-5431-87c1-241a8a4b250f" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="2067b461-0761-5a35-bd1d-f92ca5958553" name="Terror of the Void" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Enemy ships within 12″ may not be issued Brace for Impact.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" /></costs></selectionEntry><selectionEntry id="6a9a0ce7-24fa-505f-a17c-6f0f5e6dbcb6" name="The Unsinkable" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="e437f562-fbe9-51f5-9a39-2462b9ae2aaa" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="acb57a87-e479-55fc-bf13-9e52c276b907" name="The Unsinkable" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Once per battle, when this ship would be reduced to 0 Hull Points, it is instead reduced to 1 and takes 1 Critical Damage.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" /></costs></selectionEntry><selectionEntry id="725932d8-0fc7-5e63-a2e3-ca3546e9b3b4" name="Legend of the Line" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="eaf2c7b7-174f-5846-9b1b-4f91e39b84e5" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="bb09c186-e24d-5670-820e-2ae0708c99e7" name="Legend of the Line" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Friendly ships within 12″ ignore the Crippled −1 BS penalty.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" /></costs></selectionEntry><selectionEntry id="3a675403-7c09-50b5-a664-0f5f7c29fcc2" name="She Remembers" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="e5efb415-69da-51d4-86bb-582a314e5518" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="03caed06-6450-5b8a-b6b3-1d37eff3fad3" name="She Remembers" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Once per battle, this ship may re-roll every failed To Hit roll for one weapon system, against a ship of a class that has previously destroyed her.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" /></costs></selectionEntry><selectionEntry id="2c5b9df3-9987-5238-9a1e-1fd0a7c35bff" name="The Emperor's Own" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="ebdd91b6-301b-5cb3-b5e8-2b65d3201d94" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="dd3b56b4-ff09-5a6e-ac18-24eff74ecbb0" name="The Emperor's Own" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship counts as the Flagship for the purpose of receiving Fleet Orders even when she is not, and may be issued one order of any type each round regardless of the fleet's allowance.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="5.0" /></costs></selectionEntry><selectionEntry id="e8b0d2ac-3e0f-58cb-9149-d56a67c1365d" name="Scar: Warped Keel (1)" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="5e35f477-0992-58b9-9453-8453211cdf52" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="3d7bf958-bf29-5588-b767-7e7bb25853cb" name="Scar: Warped Keel (1)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">−1″ Speed, to a minimum of 4″.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="-5.0" /></costs></selectionEntry><selectionEntry id="6992c5f7-fe97-53cf-be82-b823fa3c974c" name="Scar: Scarred Plate (2)" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="78edd44a-6837-5f3e-877b-d683fe6884d1" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="49ae8ea0-aed9-5e5e-a4b2-8dcff433aa03" name="Scar: Scarred Plate (2)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">−1 to one facing's Armour Value (roll: 1–2 Prow, 3–4 Side, 5–6 Stern).</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="-5.0" /></costs></selectionEntry><selectionEntry id="32d19964-15d2-59d8-aade-bc173b4b2132" name="Scar: Ruined Gun Deck (3)" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="a604068b-3694-5a70-b027-e29fbafb23eb" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="109796ae-5f09-5a61-9fe1-f2945f06f955" name="Scar: Ruined Gun Deck (3)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">One weapon system, chosen by the owner, begins each battle bearing a Reload token.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="-5.0" /></costs></selectionEntry><selectionEntry id="339aa58b-4758-57a7-a146-4aefcad66ce0" name="Scar: Cracked Reactor (4)" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="2f54a9a3-5c6b-5dd4-afd5-68f084431993" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="2e6dc519-4cac-5e6a-a462-7215faeec834" name="Scar: Cracked Reactor (4)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">This ship explodes on a 5+ rather than a 6, and its Void Shield Rating is reduced by 1 permanently.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="-5.0" /></costs></selectionEntry><selectionEntry id="911dcabc-c515-557f-b3a1-5abc66d5eebd" name="Scar: Thinned Complement (5)" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="3e759752-693c-5fcf-a17e-c61b3ef9f67c" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="528c92bd-3e2b-5139-8e00-acab7b6b4174" name="Scar: Thinned Complement (5)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">−1 Crew, to a minimum of 1.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="-5.0" /></costs></selectionEntry><selectionEntry id="ee23f0bd-8e60-554b-afea-2b96200cbc53" name="Scar: Haunted Decks (6)" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="bfd7156f-6700-5426-80e6-1ec2d26af939" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="9341f808-703e-5959-be7e-2078942d2959" name="Scar: Haunted Decks (6)" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding parties fighting aboard this ship, defending or attacking from her, suffer −1 in the first round of every action.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="-5.0" /></costs></selectionEntry><selectionEntry id="0422d53a-c5ff-5433-b26c-6d37a29871ef" name="Level I — Blooded" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="df9bc5ea-aac2-5fc4-8e94-2ac860491501" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="2fc9679d-1944-5f59-8358-73d3cd0d30b7" name="Level I — Blooded" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">0–4 XP. No Battle Honours.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" /></costs></selectionEntry><selectionEntry id="4177d3ff-5254-57ce-9712-bdc58565a6da" name="Level II — Proven" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="18b392fe-fb70-5d26-b481-1f212e8dba29" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="99f6b363-a736-5cc7-b1d6-ec6ef9d57a6d" name="Level II — Proven" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">5–9 XP. One Battle Honour.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" /></costs></selectionEntry><selectionEntry id="eed3481b-e34a-54da-be7e-ef379df0b20a" name="Level III — Veteran" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="2ad416b2-b565-56ad-894c-39fc6aa89b2e" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="b6f3df1e-da98-5dca-a3dd-0702a775f9c6" name="Level III — Veteran" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">10–16 XP. Two Battle Honours.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" /></costs></selectionEntry><selectionEntry id="2207da58-a40a-5379-97ce-1550a6f5a228" name="Level IV — Honoured" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="0234497e-e9b7-513e-83a1-088c1aae58fc" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="f1317e7d-3a8c-5564-8e4c-63f81fa37359" name="Level IV — Honoured" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">17–24 XP. Three Battle Honours.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" /></costs></selectionEntry><selectionEntry id="154132b0-6e8c-52fe-a505-b85d62f2d9d3" name="Level V — Legendary" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="95448561-90ed-5e9d-ac03-1b5e4059e085" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="0ea1fccd-5deb-5536-a414-73a381fa2f95" name="Level V — Legendary" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">25+ XP. Four Battle Honours, one of which may be Legendary.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" /></costs></selectionEntry></sharedSelectionEntries>
<sharedSelectionEntryGroups /><sharedRules><rule id="4577692d-70ff-50d2-bf48-36fcacbaa1b3" name="XII Legion - Violence Incarnate" hidden="false"><description>One ship per turn gains +3 on its Ram roll.</description></rule><rule id="28264461-ae72-5202-8d4d-2bfa027e7727" name="Ship Construction" hidden="false"><description>Ships are bought as a bare chassis and armed hardpoint by hardpoint. Every weapon and Defence Battery on a mount is paid for separately; Hangar Bay slots are built-in hull capacity and cost 0 pts. Each mount group shows its capacity — Defence Mounts 0/8, for instance — and you choose how many of that mount to fill. A hull filled with its standard armament costs exactly its rulebook price. There is no separate upgrade-spend ceiling: mount count and facing are the limits.</description></rule><rule id="4d8a73c3-fced-5f60-9ad7-62a316aa2d57" name="Fleet Construction" hidden="false"><description>Capital Ships: minimum 1, maximum 1 at 1,000 pts, 2 at 1,500, 3 at 2,000, 4 at 2,500, 5 at 3,000. Minimum Line Ships: 4, 5, 6, 7, 8 respectively. No single ship may exceed 50% of the fleet's points, upgrades included. Gloriana 2,000+; Abyss and Phalanx 3,000+. Escorts and Frigates form squadrons of 3–6; Assault Barges fight alone or in up to 4.</description></rule><rule id="ac932593-e30e-5018-a499-f2956351b2e0" name="Fleet Commanders" hidden="false"><description>Every fleet has exactly one commander, the highest rank present, riding the Flagship and lost if that ship is destroyed, captured or wrecked. Orders of each type per battle round: Fleet Captain 1, Named Character 2, Primarch 3 — unless that commander's own entry states otherwise. Ranks never combine, and no ship, ability or upgrade adds to the allowance: where a datasheet grants a different number, that number replaces the rank's rather than adding to it. Each rank carries its own command ability: Ship’s Master, Practised Command, or The Fleet Obeys.</description></rule><rule id="d8152574-5315-55d6-bd2d-7af00d97d408" name="The Battle Round" hidden="false"><description>1. Muster — flip Reload tokens and remove any reaching 0, refresh the fleet's Fleet Order allowance, declare Reactor Overloads. In the first battle round roll off for Initiative; in every later round it passes to whoever finished the previous round. The holder moves, shoots and rams first for the whole round. 2. Movement — alternate one ship each, then one aircraft squadron each. 3. Shooting — alternate one ship or squadron each. 4. Ramming &amp; Boarding — alternate one ship each. 5. End of round — resolve dogfights, then Critical Damage. A game lasts six rounds, and every duration runs to the end of the battle round unless it names something else.</description></rule><rule id="4ce6e002-114c-5a2c-8908-4c50871d176f" name="Movement" hidden="false"><description>A ship moves at least half its Speed and never more than 12″ (All Ahead Full excepted). One turn per round of 90°, 180°, 270° or 360° up to its Turn value, and only after first moving a quarter of its Speed in a straight line. Ships may never overlap unless a Ram is declared; accidental contact stops the moving ship 1″ short.</description></rule><rule id="6fe2e059-2dc2-5dc0-9826-cae680a73855" name="Shooting" hidden="false"><description>A ship fires everything that bears at one enemy ship each round — it never divides its fire, though a squadron may. Roll a D6 per shot, hitting on 7 − BS. A natural 1 always misses and no modifier lowers the roll below 2+. Modifiers: target is an Escort or Frigate that moved its full Speed −1; target is a wreck +1. A ship that held station under Burn Retros fires its Port and Starboard broadsides at +1 BS.</description></rule><rule id="1ca6fe86-1dcc-56ce-8c4b-9ee3a5bda856" name="Void Shields" hidden="false"><description>While Void Shield Rating is above 0 the shields are Armour Value 12 and every hit strikes them rather than the hull. Roll 1D6 + Strength against AV 12; equal or better collapses one layer and does nothing else — no Hull Points, no Damage Table. There is no save. At VS 0 the shields collapse permanently, with no restoration or repair, and AP applies in full. Torpedo Tubes, Melta Mines and the Abyss's Warp Lance Batteries bypass shields entirely. Nothing else does.</description></rule><rule id="874ad505-7b56-5e4f-94cc-71d2d5449922" name="Penetration" hidden="false"><description>For each hit past the shields, roll 1D6 + Strength against the Armour Value of the facing struck. Equal = Glancing Hit: 1 Hull Point, no damage roll. Greater = Penetrating Hit: 1 Hull Point and a roll on the Damage Table. No Armour Value may exceed 14 by any means.</description></rule><rule id="163590d5-6e1a-5533-a2fa-9fc4b7c6d7ee" name="Point-Blank Broadsides" hidden="false"><description>At 6″ or less, Port, Starboard and Dorsal weapons improve their AP by one step — a Macrobattery to AP 2, a Heavy Macrobattery to AP 1. A weapon whose printed AP is already 1 gains Armourbane instead. Never both, and Prow weapons get neither.</description></rule><rule id="42711389-7093-57d0-a7db-cb9899a28019" name="Stern Strike" hidden="false"><description>When a Strength 9+ weapon rolls a natural 6 on its penetration die against a target's Stern and beats the Stern AV, the hit also inflicts Engines Crippled at once. With Armourbane at least one of the two dice must show a 6. It does not stack with an Engines Crippled already rolled, and while shields hold the hit must bring them down first.</description></rule><rule id="2b566256-52cf-50d1-8b5d-305ecaae6388" name="Ship Damage Table" hidden="false"><description>1 Held — nothing further happens. 2 Blaze — the ship gains 1 Critical Damage. 3 Hull Breach — the ship gains 1 Critical Damage. 4 Magazine Explosion — 1 Hull Point (2 if it mounts Triple Lance Batteries), 1 Critical Damage, and a random Port, Starboard or Dorsal weapon system destroyed. 5 Engines Crippled — immobile and Snap Shots only until repaired; a second leaves it Adrift. 6 Reactor Struck — a Line Ship suffers a Catastrophic Explosion at once; a Capital Ship takes D3 Hull Points then rolls a D6, detonating on a 6; a Gloriana or larger takes D3 and rolls 2D6, detonating if either die shows a 6. Modifiers: AP 2 +1 · AP 1 +2 · Destroyer +3, in place of any AP modifier (+2 against a Gloriana, the Abyss or the Phalanx) · Ramming +1 · Battleship target −1. A modified 7+ counts as Reactor Struck; below 1 counts as 1, and a 1 does nothing.</description></rule><rule id="d75c2e08-4d07-55c0-a082-ea5124029faf" name="Destruction" hidden="false"><description>At 0 Hull Points roll a D6 once: on a 6 the ship is torn apart in a Catastrophic Explosion and every ship within the blast radius suffers one hit against its nearest facing — Str 8 AP 3 from a Line Ship, Str 9 AP 2 from a Capital Ship or Void Fortress. On any other result it becomes a wreck. Blast radius: Escort, Frigate or Assault Barge 3″ · Cruiser D6″ · Grand Cruiser or Battle Barge D6+3″ · Battleship or Gloriana 2D6″ · Abyss 3D6″.</description></rule><rule id="1663311b-3988-507f-8a58-a19fff2003d8" name="Ramming" hidden="false"><description>Free, needing no Fleet Order, against one enemy within 6″ of the rammer's prow. Roll a D6, −1 if the rammer mounts a prow Nova Cannon bought as an upgrade; the ram connects if it equals or beats the distance in inches. The target may Evade on 5+. On impact the target suffers one hit at Strength = the rammer's Prow AV, ignoring Void Shields, penetrating on 1D6 + Str with no Armourbane; a hit that glances or penetrates inflicts D6 Hull Points and a penetrating hit rolls on the Damage Table at +1. The rammer loses D3 Hull Points. Survivors remain Locked.</description></rule><rule id="3c75ab36-7d87-59d4-8d5d-c926c67a0c1f" name="Fleet Orders" hidden="false"><description>Only the Flagship issues orders, within 24″ Command range measured from the Flagship as it stands, itself included. No order needs a test. Three types — Command, Movement, Shooting — each issued up to the number set by the commander's rank per round: Captain 1, Named Character 2, Primarch 3. No ship takes two orders of the same type in a round, ranks never combine, and nothing adds to the allowance. Unspent orders do not carry over. Command: Damage Control, Focus Fire, Brace for Impact. Movement: All Ahead Full, Burn Retros, Evade. Shooting: Reload Ordnance, Return Fire, Overwatch.</description></rule><rule id="ffcb2ccf-c490-5d35-a762-39e5bc0755ec" name="Orders Need No Test" hidden="false"><description>No Fleet Order needs a test — the word is given and obeyed. There is no Morale, no Leadership and no test of a crew's nerve anywhere in the game; a damaged ship is measured by the Crippled and Depleted penalties alone. Command ranks instead carry their own abilities: Ship's Master, Practised Command, and the Primarch's own.</description></rule><rule id="a81d937b-37bd-592c-bbd3-4da114f13486" name="Reactions" hidden="false"><description>Brace for Impact, Return Fire and Overwatch are Fleet Orders with a trigger, issued the moment a friendly ship is attacked or targeted, whether or not that ship has already acted. They count against the round's allowance however many ships are under fire — an order spent defending is one you no longer have for your own turn.</description></rule><rule id="191afbb3-9ce6-5755-a0fa-50ef6b1e58a1" name="Evade" hidden="false"><description>A Movement order, declared when the ship is shot at or rammed and before any dice are rolled. Roll a D6: on a 5+ the whole attack misses, or the ram fails and the rammer is moved 1″ past its intended victim. Modifiers: +1 Escort or Frigate · −1 held station · −1 Crippled, Adrift or Engines Crippled · −1 mounting no standard Macrobatteries. Never worse than −2. Once per battle round; wrecks and Speed 0 installations never Evade.</description></rule><rule id="826b57c1-ed24-5ce9-b78c-398e76d2d414" name="Boarding Actions" hidden="false"><description>Crew are the hit points of boarding, and an action begins and ends in one Ramming &amp; Boarding step. Declare the Crew committed and the delivery method, then deduct them; a ship always keeps 1 aboard. Every fighter rolls his own D6 with his own bonus, and bonuses never combine into one roll. Starting with the boarders, players alternate nominating duels: the higher total fells its opponent, and ties re-roll until one is higher. Fight on until one side reaches 0 Crew or the boarders withdraw. Defenders reduced to 0 lose the ship — Capture or Scuttle. Modifiers to every die on that side: +1 boarders in the first round if delivered by craft, pod or teleport (never a Hull Assault) · +1 boarders if the enemy ship is Crippled · +1 boarders if it is Engines Crippled · −1 defenders if the ship carries any Critical Damage.</description></rule><rule id="137d6a0e-24c9-502d-adcd-02cfd6125e75" name="Hit-and-Run" hidden="false"><description>Instead of a full boarding, commit 1 Crew — so never a Dreadnought, which is two. Roll D6 plus the raider's own bonus. On 4+ choose one: destroy one weapon system or Hangar Bay; inflict 1 Critical Damage; cripple the enginarium (Engines Crippled); or sabotage the shields, reducing VS Rating by D3, or D6 against a Capital Ship, permanently. The raider returns. On a failure the raider is lost.</description></rule><rule id="b72dfafd-04ef-5f5f-b520-650e406b95b8" name="Attrition" hidden="false"><description>There is no Morale. Ships do not flee and take no tests — they fight until wrecked, taken, or the battle ends, and they fight worse as they break down. Crippled and Depleted stack, so a ship can fire at −2. Broken Fleet: once three quarters of a fleet's starting points are lost it loses the battle at once. Count a lost ship at full cost, upgrades and any Fleet Commander aboard included; aircraft never count.</description></rule><rule id="3618206e-463b-5b6e-aa5c-de4c0c23818f" name="Fleet Construction" hidden="false"><description>Capital figures are a maximum and Line figures a minimum, by game size: 1,000 pts — 1 Capital, 4 Line · 1,500 — 2 Capital, 5 Line · 2,000 — 3 Capital, 6 Line · 2,500 — 4 Capital, 7 Line · 3,000 — 5 Capital, 8 Line. Sizes between the rows build to the next row down. The roster builder enforces the outer bounds only — at least 4 Line Ships and no more than 5 Capital Ships — so apply your game size's row yourself. No single ship may exceed 50% of the fleet's points, upgrades included. Per-roster hull limits: 5 of any Line Ship; 3 of any Capital Ship; 1 of any Gloriana, the Abyss or the Phalanx. Escorts and Frigates form squadrons of 3–6; Assault Barges fight alone or in up to 4. Minimum game size: Gloriana 2,000; Abyss and Phalanx 3,000. A hull may spend no more than half its base cost on refits, the Lance Turret Upgrade and Side Armour Reinforcement excepted.</description></rule><rule id="5e9ac9a9-5835-5468-9c75-50bd5818f978" name="Veteran Crews &amp; Commanders" hidden="false"><description>Any ship may take a Veteran Crew once: +1 Ballistic Skill for the battle, 60 pts for a Line Ship and 150 pts for a Capital Ship. No ship exceeds BS 5, and a ship takes at most one +1 BS from position or command — Firing at anchor, Focus Fire and accuracy auras never stack with each other. A Veteran Crew's +1 is a paid upgrade and stacks on top. Every fleet has exactly one commander, the highest rank present, riding the Flagship and lost if that ship is destroyed, captured or wrecked. Each rank carries its own command ability: Ship’s Master, Practised Command, or The Fleet Obeys.</description></rule><rule id="61e1f45c-de5e-5973-b0e1-91428056d9b0" name="Keyword: Armourbane" hidden="false"><description>Roll 2D6 + Strength to penetrate instead of 1D6, at 6″ or less, against shields or hull alike. Torpedo Tubes and the Starhawk's plasma bombs carry it outright; a broadside or dorsal weapon of printed AP 1 gains it inside 6″ in place of the AP step it cannot take. Macrobatteries never gain it, and neither do rams — the Conqueror's Ursus Claws excepted. Destroyer weapons never roll to penetrate, so it does nothing for them.</description></rule><rule id="85b5cc25-86c3-506c-9ab2-0cdc866deffd" name="Keyword: Destroyer (D)" hidden="false"><description>Any weapon of Strength D or AP D. It penetrates automatically — no roll, whatever the Armour Value — and can never merely glance. Every Damage Table roll it causes is made at +3 in place of any AP modifier, or +2 against a Gloriana, the Abyss or the Phalanx. It is always at least Devastating (3). It does not pass Void Shields: while they hold it beats AV 12 automatically and collapses 3 layers, and does nothing else.</description></rule><rule id="abf8a19a-6229-5273-a3bc-9103739c5848" name="Keyword: Devastating (X)" hidden="false"><description>Each unsaved hit costs the target X Hull Points instead of 1, whether it glances or penetrates. A penetrating Devastating hit still rolls once on the Damage Table, keeping its AP modifier. Against active shields a Devastating hit still costs only 1 Void Shield Rating, however large its X.</description></rule><rule id="14ca3acf-a794-59fc-a01b-d4040bc10367" name="Keyword: Gets Hot" hidden="false"><description>After a Lance Turret or Lance Battery has resolved its attacks, roll a D6. On a 1 the firing ship suffers 1 Hull Point. Each mount rolls separately. Self-inflicted rolls have no attacker or facing: the owning player makes any choices, from any facing, but must choose a functioning system.</description></rule><rule id="599745a0-9d2d-51c0-94ce-98af606e72bb" name="Keyword: One Shot" hidden="false"><description>Fired once per battle, then spent. It takes no Reload tokens.</description></rule><rule id="b285c77f-b1c8-5b35-9bf5-093d11d1ea27" name="Keyword: Reload (X)" hidden="false"><description>After firing, place X Reload tokens on the mount. Flip the token at the end of each battle round — 2 becomes 1 — and remove it when it would reach 0. The mount cannot fire while it bears a token, so Reload (1) speaks every round and Reload (2) every second. The Reload Ordnance order removes one counter early.</description></rule><rule id="2deec800-a4cf-5aec-9e42-eb01d8af93fc" name="Keyword: Skyfire" hidden="false"><description>Fires at full Ballistic Skill against aircraft.</description></rule><rule id="6b60be4b-3ed3-5983-acaf-a4dbe348f28e" name="Keyword: Twin-Linked" hidden="false"><description>Re-roll failed To Hit rolls.</description></rule><rule id="392c0223-1c3c-546e-9a01-bb79e2303ad8" name="Keyword: Volatile" hidden="false"><description>An unmodified 1 To Hit resolves the attack against the firing ship instead, at the full profile — against the facing the launcher is mounted in. The launcher is spent either way.</description></rule><rule id="7527437d-abb3-51f7-b16c-71c3225119cb" name="Keyword: Critical Damage" hidden="false"><description>Fires, breaches and burning phosphex — one rule for all of them. A ship may carry up to 3 Critical Damage, marked with a single token. At the end of each battle round it loses 1 Crew for each Critical Damage it carries, always, with no roll. A successful Damage Control order clears the whole stack at once.</description></rule><rule id="0d322e28-9d4f-50f5-911b-178d388b33e8" name="Mounts &amp; Arcs" hidden="false"><description>Prow — the forward 90° arc. Port / Starboard — that side's 90° arc; these are the broadsides. Dorsal — every arc but the Stern; counts as a broadside for Point-Blank Broadsides, but gains no Firing at anchor bonus. All-round — every arc. Straight ahead — Torpedo Tubes only: a line drawn directly forward from the prow, and only a ship that line crosses may be targeted. The facing struck is whichever of the target's arcs the firer sits in. Broadsides are per side: each line of a datasheet is its own weapon system in that facing.</description></rule><rule id="e372acab-01f6-5ecf-957e-175a4396cce0" name="State: Adrift" hidden="false"><description>A second Engines Crippled. The ship moves 2D6″ straight ahead when it would move, cannot turn, and fires Snap Shots only.</description></rule><rule id="7a61f2a1-db24-5a8d-be2e-8edd8790d7e1" name="State: Crippled" hidden="false"><description>Below half starting Hull Points: −1 BS and half Speed.</description></rule><rule id="a3e9565f-a2fa-577e-b4a1-292e76bd08bc" name="State: Depleted" hidden="false"><description>At half starting Crew or less: −1 BS. Stacks with Crippled.</description></rule><rule id="6353e6ea-a9a3-5ea6-8060-3ab34a8054e7" name="State: Engaged" hidden="false"><description>Two aircraft squadrons within 1″. Neither may act against ships, and no ship may fire on either — Defence Batteries, Interceptor and Overwatch included. Resolved at the end of the battle round.</description></rule><rule id="208aaf4b-d458-5676-bf47-5f352142ec5f" name="State: Engines Crippled" hidden="false"><description>Immobile and Snap Shots only until repaired. It may still be issued Fleet Orders. It gains no Firing at anchor bonus for standing still, though it still suffers −1 on Evade.</description></rule><rule id="6246106f-cf3f-540e-8203-f97376e8340e" name="State: Held station" hidden="false"><description>Moved 1″ or less under Burn Retros. Broadsides fire at +1 BS; −1 on Evade. A ship holding station may pivot freely on the spot.</description></rule><rule id="811b247b-6ddf-5006-b352-c5ca60db458b" name="State: Locked" hidden="false"><description>Two ships joined by a ram. Neither may move; the rammer may not fire on its victim, who fires back at −1 BS against the rammer's Prow. Both fire at other enemies normally. Break Away on 5+, when the ship would move, once each per battle round: the rammer disengages 1″ away, a defender tears free 1″ away and suffers D3 Hull Points.</description></rule><rule id="b56528e6-7174-5a54-ade6-9a451b910d60" name="State: Snap Shots" hidden="false"><description>Firing at BS 1 — hits only on a 6.</description></rule><rule id="2d611b74-4bfd-5767-b16a-8e63be1292e3" name="State: Wreck" hidden="false"><description>0 Hull Points without exploding. It becomes obscuring terrain: impassable, blocks line of sight, and no straight-line weapon may fire across it. It never moves, never drifts and never Evades, and having no Crew it cannot be boarded or captured.</description></rule><rule id="39d4a7a4-32f1-514d-9424-b4b9a11aa91f" name="Keyword: Come About!" hidden="false"><description>Escorts and Frigates may turn at any point in their move, without first running a quarter of their Speed straight.</description></rule><rule id="61692e0f-2dce-591b-89da-df712587b43f" name="Keyword: Interceptor" hidden="false"><description>A Defence Battery may fire the moment an enemy squadron comes within 12″ as the enemy moves, before it attacks — but then does nothing else that battle round, Overwatch included.</description></rule><rule id="f7f5bf05-711b-5ce4-b379-affad862a67b" name="Keyword: Breachers" hidden="false"><description>+1 to all Boarding combat rolls, and enemy dice fighting them suffer −1. The −1 of a Dreadnought, or of an Astartes Breacher defending his own ship, falls on the one enemy die paired against him.</description></rule><rule id="b447814e-d20e-5b62-ae62-89e541df1cd2" name="Keyword: Intervention" hidden="false"><description>Escorts and Frigates only, and it costs no order. When a friendly ship within 3″ is attacked, rammed, or targeted by torpedoes, an Escort or Frigate no more than 10″ from the attacker may thrust into the firing line: it does not move, and the whole attack resolves against it instead, striking whichever facing lies toward the attacker. Once per ship per battle round.</description></rule><rule id="d4519c0c-067b-50f2-b436-cb5550b94487" name="Keyword: Wolf Pack" hidden="false"><description>Escorts and Frigates of one squadron within 6″ may combine fire on a single target, adding +1 to penetration. Gunnery only, never Torpedo Tubes.</description></rule><rule id="d7199c56-7dfa-57bb-ad12-7940c67d321e" name="Keyword: Melta Mines" hidden="false"><description>Each Escort carries two. Laid in contact with the ship instead of shooting, one per round, and never within 6″ of an enemy ship. A mine detonates the moment any part of a non-Escort ship's base passes over it, hitting every ship within 3″, friend or foe, at Strength 9 AP 2 against the facing nearest the mine. Melta Mines bypass Void Shields entirely. Escorts of either fleet pass over them safely and aircraft ignore them.</description></rule><rule id="2deb29ff-4c4a-5f16-8cfc-dd34165835ad" name="Keyword: Broken Fleet" hidden="false"><description>Once three quarters of a fleet's starting points are lost, it loses the battle at once.</description></rule></sharedRules><catalogueLinks><catalogueLink id="b4ca9295-b49d-5346-b14a-8d384c6846e7" name="Campaigns of the Void" hidden="false" type="catalogue" targetId="b7e2d4a8-9c15-5f46-a3b8-2ed7c0951f34" importRootEntries="true" /></catalogueLinks></catalogue>