 <profiles>
 <profile id="8f52cb0c-94e1-595c-a52a-83de42db3790" name="Khârn" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Named Character. 2 Fleet Orders of each type each battle round. Practised Command: once per battle round, one friendly ship within Command range may re-roll a single failed Evade roll. Friendly boarding parties gain +1 and may re-roll one failed boarding die.</characteristic>
 </characteristics>
 </profile>
 </profiles>
