 <selectionEntryGroup id="ee95d534-68db-5570-b1f7-ff1b937066bf" name="Hull Upgrades" hidden="false"><constraints><constraint type="max" value="3.0" field="selections" scope="parent" shared="false" id="1cf33d5e-6641-57f2-a194-615cfd9b6519" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="2f044ed4-9301-5c72-904e-cad2210d3458" name="Side Armour Reinforcement" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="75aeffc0-e37e-57e1-89d1-071e7ffbcd3c" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="1fb9c173-1d3c-5b33-9576-bc177193fd39" name="Side Armour Reinforcement" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+1 Port and Starboard Armour, to a maximum of AV 14. Reduce Speed by 2", to a minimum of 4".</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="120.0" /></costs></selectionEntry><selectionEntry id="f5ac7418-c699-5de6-9770-6cb71d9b61e1" name="Engine Refit" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint field="selections" scope="parent" value="1.0" type="max" id="04e463ee-5566-5adb-9eee-586e58ae226f" shared="false" includeChildSelections="false" /></constraints><profiles><profile id="4b60b91d-bcf8-5cef-820f-9159034c1c27" name="Engine Refit" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">+2" to the ship's Speed characteristic.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="100.0" /></costs></selectionEntry><selectionEntry id="24c9fcd2-0014-54ea-b276-fe9634525f57" name="Phosphex Shells" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="8b328118-b01f-51a0-b41e-5f494c6e7d2d" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><profiles><profile id="49103707-9319-5723-b268-c581710a25a3" name="Phosphex Shells" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Every Heavy Macrobattery aboard fires phosphex: whenever one penetrates armour, the target takes 1 Critical Damage. Requires at least one Heavy Macrobattery.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="50.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Drop Pod Loadout" id="7ece8afd-ea1f-580f-8ae9-7087544a4e91" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="4.0" field="selections" scope="parent" shared="false" id="4d182c1f-1351-5d56-9c16-b2751b46dbf2" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="54404c84-fe9e-5078-bae7-546a088874ed" name="Dreadclaw Drop Pod" hidden="false" collective="false" import="true" type="upgrade"><profiles><profile id="95058c1a-e77a-545c-9f48-5ca768b475c0" name="Dreadclaw Drop Pod" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding pod, Armour 8, Speed 30″/round. Takes 1 rail. Launched at a target within 18″, striking the same turn. One Shot. Counts as aircraft and may be intercepted; a surviving pod locks on 2+, and on a failure is destroyed with all aboard. Delivers 1 Crew of boarders (+1 in the first round). Removed from play after its run.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" /></costs></selectionEntry><selectionEntry id="ee09d66f-822e-54fb-b092-5896a59f39cc" name="Kharybdis Assault Claw" hidden="false" collective="false" import="true" type="upgrade"><profiles><profile id="e0f5c16c-0781-5abc-8777-ab5e24517fb8" name="Kharybdis Assault Claw" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding pod, Armour 9, Speed 30″/round. Takes 2 rails and locks automatically — melta cutters breach any hull — delivering 2 Crew of boarders (a Dreadnought filling both places). One Shot: removed from play after its run.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup name="Campaign Record" id="e43e3ef1-b0b4-5fba-8d72-b9efb3dc74c9" hidden="false" collective="false" import="true"><selectionEntryGroups><selectionEntryGroup name="Veteran Level" id="63f63f5e-54ed-571d-bcd3-b1611bf8adcb" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="74bec8b4-cef4-5fbc-90e4-685fa7e29dc6" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><entryLinks><entryLink id="b9e50ebd-58ae-5e91-bc54-e0855572242b" name="Level I — Blooded" hidden="false" collective="false" import="true" type="selectionEntry" targetId="0422d53a-c5ff-5433-b26c-6d37a29871ef" /><entryLink id="51ccc2ef-fab2-5ff4-b0a5-1db91772d6b7" name="Level II — Proven" hidden="false" collective="false" import="true" type="selectionEntry" targetId="4177d3ff-5254-57ce-9712-bdc58565a6da" /><entryLink id="76b08ef5-ea0f-566c-9660-1254099359d2" name="Level III — Veteran" hidden="false" collective="false" import="true" type="selectionEntry" targetId="eed3481b-e34a-54da-be7e-ef379df0b20a" /><entryLink id="d9dccdd5-cb89-51a3-8a7b-535ace5f7713" name="Level IV — Honoured" hidden="false" collective="false" import="true" type="selectionEntry" targetId="2207da58-a40a-5379-97ce-1550a6f5a228" /><entryLink id="1141a743-3c47-5bc9-8e0c-81eb8138c533" name="Level V — Legendary" hidden="false" collective="false" import="true" type="selectionEntry" targetId="154132b0-6e8c-52fe-a505-b85d62f2d9d3" /></entryLinks></selectionEntryGroup><selectionEntryGroup name="Battle Honours" id="11b63180-f9fa-57c3-9092-03d06f0f7d60" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="4.0" field="selections" scope="parent" shared="false" id="a544f2a9-62ba-56f4-8094-e3b687e86f9b" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><entryLinks><entryLink id="6799d85b-fc41-534c-a966-3981ae251755" name="Master Gunners" hidden="false" collective="false" import="true" type="selectionEntry" targetId="a7702998-5962-5b4c-96e7-5df501554eba" /><entryLink id="df80a9e6-370c-5334-bf3d-5209c4a29c3f" name="Void Marksmen" hidden="false" collective="false" import="true" type="selectionEntry" targetId="6a23924b-02f5-51d1-82ea-7a9293c58a52" /><entryLink id="af46461e-07ca-5814-b97a-38073415c965" name="Ordnance Veterans" hidden="false" collective="false" import="true" type="selectionEntry" targetId="6c28eaad-ee9d-5e39-a869-fc79422f40cb" /><entryLink id="50560cc0-1bf7-5a6f-882b-1a32ef7b8a11" name="Executioners" hidden="false" collective="false" import="true" type="selectionEntry" targetId="3da029ff-4b9d-5e2b-80cf-cd55b2257a39" /><entryLink id="6297ff76-05f8-5a54-9e7f-52433a230d7d" name="Cold Gunnery (restricted: must mount a Lance Turret or Lance Battery)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="146a06bc-0244-593c-a5c4-9578800f723e" /><entryLink id="39642b1f-3519-5b76-933e-0c5484092551" name="Practised Broadside" hidden="false" collective="false" import="true" type="selectionEntry" targetId="94f1ff56-4e3c-55da-a6dd-e13797ad37e4" /><entryLink id="e4067a9d-10b6-5613-9889-804c5a2a1f23" name="Iron Discipline" hidden="false" collective="false" import="true" type="selectionEntry" targetId="e72095c0-6645-58e7-acc5-5c2fd16ca2f4" /><entryLink id="3a71a389-23eb-53fc-899d-50e8b490f8b3" name="Damage Control Veterans" hidden="false" collective="false" import="true" type="selectionEntry" targetId="0ea322ae-b0ac-596d-bc9e-f48a5788376d" /><entryLink id="49d7c3ee-ca6e-5ea7-8956-dc0ec554441b" name="Old Warhorse" hidden="false" collective="false" import="true" type="selectionEntry" targetId="0c577c43-e46e-553e-823e-6a7760f15242" /><entryLink id="3460ea88-8af3-507d-a195-9aa6b802c509" name="Never Abandon Ship" hidden="false" collective="false" import="true" type="selectionEntry" targetId="0d045628-dc97-56b0-b526-1a8b9c7b83fa" /><entryLink id="02326110-f57a-57cc-b759-466cee4e38c4" name="Steady Bridge" hidden="false" collective="false" import="true" type="selectionEntry" targetId="bcfadde2-57b3-5cf3-9784-06c345fd72bc" /><entryLink id="f4f2e532-b85e-579c-924d-7ceb3edac823" name="Grim Resolve" hidden="false" collective="false" import="true" type="selectionEntry" targetId="e4a652cb-cd83-5e26-bed2-d4175aa3ed3b" /><entryLink id="76895bcb-ed28-53d7-ac9a-ca24e2990b30" name="Master Helmsman" hidden="false" collective="false" import="true" type="selectionEntry" targetId="db051a5e-b07d-56ef-9552-a1d3488a7789" /><entryLink id="f7226dc5-e336-51ce-89d5-d731391e8363" name="Flank Speed" hidden="false" collective="false" import="true" type="selectionEntry" targetId="d965b3fe-330c-5c91-94a1-9653cd03ad51" /><entryLink id="d8c5e61b-f080-548a-a1bb-7efb44728963" name="Veteran Navigator" hidden="false" collective="false" import="true" type="selectionEntry" targetId="9c5a5c4f-0ff1-5b16-bd78-32cadd6a0db8" /><entryLink id="b194a9c1-4e5f-5688-a55f-06fc49cb9349" name="Ramming Veteran" hidden="false" collective="false" import="true" type="selectionEntry" targetId="ebdc1447-ddbe-5911-9e27-f860226fdb52" /><entryLink id="c2528641-e6dd-524c-9f24-8990deaa83c7" name="Come About Drill (restricted: Cruiser or larger)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="8b39f1c9-9548-57f4-b92f-2c095988eb45" /><entryLink id="18c31233-0a51-5591-a09f-f417b158cbaa" name="Silent Running" hidden="false" collective="false" import="true" type="selectionEntry" targetId="8fc82ad0-7164-5812-bc1f-718f97b150c1" /><entryLink id="ce1ba6bf-d3d9-55e6-a6f3-636e30194267" name="Storm Parties" hidden="false" collective="false" import="true" type="selectionEntry" targetId="615698cb-2552-5f9d-83d9-e64cdde9b129" /><entryLink id="7857f99e-2014-5f9a-b25a-777c1c9ff2f6" name="Breach Veterans" hidden="false" collective="false" import="true" type="selectionEntry" targetId="75f7cb2a-d811-5253-a886-19f1ee1895db" /><entryLink id="458ee2f5-62b3-5f1c-973a-a7784621743f" name="Corridor Fighters" hidden="false" collective="false" import="true" type="selectionEntry" targetId="86901424-0ee6-5da6-99b2-80e129c9cedf" /><entryLink id="46c9fe31-b7e2-5195-9ea0-f095659aea71" name="Ready at the Ramp (restricted: does not already have Assault Ramp)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="0e6ab312-75ff-5bf2-a05e-bc4308889fbe" /><entryLink id="696be460-537c-55dc-b1e5-5bda978fa49f" name="Butcher's Bill" hidden="false" collective="false" import="true" type="selectionEntry" targetId="f7b53e1a-7b5b-5ad6-86a7-5b86fb562ebe" /><entryLink id="a2f156ec-d8d0-5bdd-b03f-26a29efd56b4" name="Prize Crew" hidden="false" collective="false" import="true" type="selectionEntry" targetId="51c9b35b-fccc-5192-a7a8-fdd050cb3ce3" /><entryLink id="6e093701-33ea-5341-b415-39bf1b059530" name="Practised Deck Crews" hidden="false" collective="false" import="true" type="selectionEntry" targetId="617cd28b-1810-5b76-9cf3-f74a6c476f49" /><entryLink id="8c669c2b-1492-533a-8241-e4f95b88008e" name="Rearming Drill" hidden="false" collective="false" import="true" type="selectionEntry" targetId="0b121b12-22cf-514c-986a-3e8c74deeb2a" /><entryLink id="448831b6-34c1-53df-92bb-55260bfe2991" name="Combat Air Patrol" hidden="false" collective="false" import="true" type="selectionEntry" targetId="2fbc33f8-c687-5388-b06a-d9bd822c0bc3" /><entryLink id="ff2df008-70f4-5b28-ada7-e884f1aed8cf" name="Strike Coordinators" hidden="false" collective="false" import="true" type="selectionEntry" targetId="97d9aa73-9806-5898-bb12-10cc4542ddff" /><entryLink id="8ad4b4a9-8622-5073-8311-3aad3be0623d" name="Ace Wing" hidden="false" collective="false" import="true" type="selectionEntry" targetId="ab5dbffe-496e-5eaf-b937-377ac996ea66" /><entryLink id="e8ee1b4b-4d3b-5c96-882c-d3775e6a3765" name="Deep Magazines" hidden="false" collective="false" import="true" type="selectionEntry" targetId="770d15e9-76f3-59fb-bebb-c4c9f111d763" /><entryLink id="6a63541e-4308-5d14-aad9-fc0083816aa4" name="Terror of the Void" hidden="false" collective="false" import="true" type="selectionEntry" targetId="d42808c6-bb45-578d-af04-63a7b5956a1c" /><entryLink id="88d27400-f1ce-5900-9d0e-afdb11c55748" name="The Unsinkable" hidden="false" collective="false" import="true" type="selectionEntry" targetId="6a9a0ce7-24fa-505f-a17c-6f0f5e6dbcb6" /><entryLink id="02b18a95-cc48-54cf-be7c-61bfc71ad8cd" name="Legend of the Line" hidden="false" collective="false" import="true" type="selectionEntry" targetId="725932d8-0fc7-5e63-a2e3-ca3546e9b3b4" /><entryLink id="11c09db0-1c0d-5afc-b3da-e8e50b2d8047" name="She Remembers" hidden="false" collective="false" import="true" type="selectionEntry" targetId="3a675403-7c09-50b5-a664-0f5f7c29fcc2" /><entryLink id="8924224c-c4fc-536a-b29f-a53c9aed86b2" name="The Emperor's Own" hidden="false" collective="false" import="true" type="selectionEntry" targetId="2c5b9df3-9987-5238-9a1e-1fd0a7c35bff" /></entryLinks></selectionEntryGroup><selectionEntryGroup name="Battle Scars" id="e39c977f-8d5c-540d-818c-e29dd57379a8" hidden="false" collective="false" import="true"><entryLinks><entryLink id="44edd634-000c-5724-928a-70d30bc19ecb" name="Scar: Warped Keel (1)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="e8b0d2ac-3e0f-58cb-9149-d56a67c1365d" /><entryLink id="fe3a3029-6999-584a-bfe0-7c1ab01485b9" name="Scar: Scarred Plate (2)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="6992c5f7-fe97-53cf-be82-b823fa3c974c" /><entryLink id="2117bd63-d050-52cc-8740-0dae8d3e5c22" name="Scar: Ruined Gun Deck (3)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="32d19964-15d2-59d8-aade-bc173b4b2132" /><entryLink id="73c18d19-5ebe-54b7-af79-14c267473185" name="Scar: Cracked Reactor (4)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="339aa58b-4758-57a7-a146-4aefcad66ce0" /><entryLink id="1ae2c2b1-1c94-56d4-9a2a-821bd6935f67" name="Scar: Thinned Complement (5)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="911dcabc-c515-557f-b3a1-5abc66d5eebd" /><entryLink id="0a3a8556-9719-56a2-a642-4eb7294151fc" name="Scar: Haunted Decks (6)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="ee23f0bd-8e60-554b-afea-2b96200cbc53" /></entryLinks></selectionEntryGroup></selectionEntryGroups></selectionEntryGroup></selectionEntryGroups>
 <costs>
 <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="140.0" />
 </costs>
 </selectionEntry>
 <selectionEntry id="336ead29-6f73-545d-bdd0-063ed90f5850" name="Battleship" hidden="false" collective="false" import="true" type="unit">
 <constraints><constraint type="max" value="3.0" field="selections" scope="roster" shared="false" id="10ee95ec-b5b3-5a99-a539-97ee7ed1a70c" percentValue="false" includeChildSelections="false" includeChildForces="true" /></constraints><profiles>
 <profile id="34660a2c-e2d5-5bd2-88af-470c25627b1d" name="Battleship" hidden="false" typeId="806f9ff1-fd51-5ddb-b005-ce73a5d09d65" typeName="Ship">
 <characteristics>
 <characteristic name="BS" typeId="d130e705-611e-5a0a-bd7d-ea8e848fdb2e">3</characteristic>
 <characteristic name="Prow" typeId="84a55377-edbc-5825-a2bf-70c6155018f2">14</characteristic>
 <characteristic name="Side" typeId="5f595433-7397-5c4b-9d4a-8f35d83a2b29">13</characteristic>
 <characteristic name="Stern" typeId="cd9ec76e-f959-5560-8845-9ab242f16e71">12</characteristic>
 <characteristic name="HP" typeId="ef713781-2034-5fb4-83d1-e49d1d683694">13</characteristic>
 <characteristic name="VS" typeId="84309751-688d-50ef-8940-d8d042261a56">8</characteristic>
 <characteristic name="Speed" typeId="25d0e01e-8e74-55b3-8a2a-17773c881625">8″</characteristic>
 <characteristic name="Turn" typeId="899e9c58-70ef-5da5-8495-5bf6a8b7f8f0">45°</characteristic>
 <characteristic name="Crew" typeId="2f6312dd-493e-53c6-96e2-d901afca0e81">8</characteristic>
 </characteristics>
 </profile>
 <profile id="d4e7ed23-50ac-5882-84a6-4994b2eee74a" name="Bulwark of the Line" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Enemy Damage Table rolls against this ship suffer −1.</characteristic>
 </characteristics>
 </profile>
 <profile id="dc77ed57-5fc8-50a0-ba26-6620f7ab65e7" name="Boarding Forces Validation" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Boarding forces are bought against the ship’s Crew. Terminator/Dreadnought class limits are enforced; remember a Contemptor occupies 2 Crew slots.</characteristic>
 </characteristics>
 </profile>
 <profile id="83220861-b223-5111-99af-2a8599533346" name="Hardpoint Construction" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Bare chassis. Every mounted weapon is purchased separately. No upgrade-spend ceiling. Legal choices are controlled by hull class, hardpoint type and facing; each hardpoint must contain exactly one weapon.</characteristic>
 </characteristics>
 </profile>
 <profile id="99cabed7-df22-529b-83c6-cd0c968a6d92" name="Mount Capacity" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Port: 3 · Port Heavy: 2 · Starboard: 3 · Starboard Heavy: 2 · Prow Ordnance: 4 · Prow Super-Heavy: 1 · Dorsal: 4 · Defence: 8 · Hangar: 2</characteristic></characteristics></profile><profile id="89f1bdfa-2e5f-5e44-ac41-93c6cea79960" name="Hardpoint Configuration" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Ships begin with no weapons or Defence Batteries selected. Hangar Bay slots represent built-in hull capacity and cost 0 pts. Each physical hardpoint may take at most one legal component. There is no separate upgrade-spend cap; the hull's mount layout is the limit.</characteristic></characteristics></profile><profile id="fba9c86b-0e4e-50e7-8e4e-75c4f9948894" name="Roster Builder Summary" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Crew 8 · Port 3 · Port Heavy 2 · Starboard 3 · Starboard Heavy 2 · Prow Ordnance 4 · Prow Super-Heavy 1 · Dorsal 4 · Defence 8 · Hangars 2. Ships start unequipped. Fill only the weapon and Defence hardpoints you want to purchase; each may contain at most one component. Hangar Bay slots cost 0 pts. Aircraft are purchased separately up to Hangar capacity.</characteristic></characteristics></profile></profiles>
 <rules><rule id="5bfbc2eb-e540-5cfe-a6b8-ab85c4f3c43e" name="Gets Hot" hidden="false"><description>After a Lance Turret or Lance Battery resolves its attacks, roll a D6. On a 1 the firing ship loses 1 Hull Point. Each mount rolls separately.</description></rule><rule id="12a26584-5c22-5219-8be0-a33a5063c480" name="Twin-Linked" hidden="false"><description>Re-roll failed To Hit rolls.</description></rule><rule id="4f5feb59-353a-53f8-ae63-ccb8902d11fa" name="Capital Ship" hidden="false"><description>Counts as a Capital Ship for every rule that names one, and fills a Capital slot.</description></rule><rule id="e99394e4-998d-5d58-bd0c-4b42ec9b8bb1" name="Reload (X)" hidden="false"><description>After firing, place X Reload tokens on the mount; flip one at the end of each battle round. The mount cannot fire while it bears a token.</description></rule><rule id="d15724dc-b3ed-56b4-88a3-27bcb64f21e0" name="Devastating (X)" hidden="false"><description>Each hit costs X Hull Points, or 1 Void Shield Rating against live shields.</description></rule><rule id="b089575b-405c-5440-802f-5367c7962c75" name="Armourbane" hidden="false"><description>Roll 2D6 + Strength to penetrate instead of 1D6, at 6″ or less, against shields or hull alike.</description></rule><rule id="eed9deb8-1ba1-5b97-b6a6-915d69c8d788" name="Point-Blank Broadsides" hidden="false"><description>At 6″ or less, Port, Starboard and Dorsal weapons improve AP by one step — or gain Armourbane instead if their printed AP is already 1. Prow weapons get neither.</description></rule><rule id="42867756-c58b-5229-9870-24a5248a1aed" name="Crippled" hidden="false"><description>Below half starting Hull Points: −1 BS and half Speed.</description></rule><rule id="384029bd-010c-5212-ba4a-b97a5b022324" name="Depleted" hidden="false"><description>At half starting Crew or less: −1 BS. Stacks with Crippled.</description></rule><rule id="6ff4dcc2-8b18-58cb-8267-0754b50a22df" name="Locked" hidden="false"><description>Joined by a ram. Neither ship may move; the rammer may not fire on its victim, who fires back at −1 BS. Break Away on 5+.</description></rule><rule id="187f7178-762c-56d6-b591-471296d90809" name="Snap Shots" hidden="false"><description>Firing at BS 1 — hits only on a 6.</description></rule><rule id="1514b814-f874-56aa-ba7c-f941db6eef7b" name="Wreck" hidden="false"><description>0 Hull Points without exploding. Becomes impassable, obscuring terrain; never moves and never Evades.</description></rule><rule id="cba211f7-8c96-59f7-96cc-074fdd56796d" name="Held station" hidden="false"><description>Moved 1″ or less under Burn Retros. Broadsides fire at +1 BS; −1 on Evade.</description></rule></rules><categoryLinks>
 <categoryLink id="aa8556d3-ffc6-54ef-b02c-a3a148e9af2e" name="Capital Ship" hidden="false" targetId="bd422ebf-10b3-5085-89cc-263568c40fe0" primary="false" />
 <categoryLink id="7a661b21-6549-5de3-95a8-099c109076e4" name="Open Play Fleet" hidden="false" targetId="f4a1bdc9-d680-5abd-a007-4b0b71797ecd" primary="false" /><categoryLink id="6b80c6a6-9a1b-515a-8fe8-0387a17db209" name="Campaign Fleet" hidden="false" targetId="69270169-f826-5f6c-8c3d-26f416055ec0" primary="true" /></categoryLinks>
 <selectionEntryGroups>
 <selectionEntryGroup id="e62cd17b-69d1-5b9e-b593-f25d2ac1bd06" name="Fleet Role" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="b3c09af2-1587-5838-8082-9b8c80b394e1" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="ad1f052c-07aa-558b-a833-2ebee28edc3f" name="Designate as Flagship" hidden="false" collective="false" import="true" type="upgrade"><profiles><profile id="f6a48cd0-68dd-5a64-bfe1-adcbcf7c3c68" name="Commander Embarkation" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander here. The Commander is embarked on this Flagship.</characteristic></characteristics></profile></profiles><rules><rule id="39c41587-cd42-5f88-8bfb-cf09a1bced7f" name="Flagship" hidden="false"><description>This ship is the fleet's Flagship. Exactly one Flagship is required in a standard fleet.</description></rule></rules><categoryLinks><categoryLink id="fe78dc8f-32f2-5ce9-b1c4-a113f4e3a994" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" /></categoryLinks><selectionEntryGroups><selectionEntryGroup id="1eef99d6-a87e-5e99-a1fd-c66946682801" name="Fleet Commander" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="7904b3dd-a397-5b76-9714-8cc4ceaef99b" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="55647d2f-40b2-5dc3-9e87-9bf923f50e8f" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="74b20f49-ae3e-573b-81b5-f0458f8a7424" name="Fleet Captain" hidden="false" collective="false" import="true" type="upgrade">
 <constraints>
 <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3aa0a364-c295-529f-a3c3-eca9e42137a5" type="max" />
 </constraints>
 <profiles>
 <profile id="b03df5d5-bd50-5596-97d7-e70b72edc3dc" name="Fleet Captain" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
 <characteristics>
 <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Fleet Captain. 1 Fleet Order of each type each battle round. Ship’s Master: once per battle, the Flagship may re-roll a single failed Evade roll.</characteristic>
 </characteristics>
 </profile>
 </profiles>
 <categoryLinks>
 <categoryLink id="4a907a99-2868-5946-9b1c-1d702aa6031f" name="Commander" hidden="false" targetId="6f3339ad-23a9-5687-b08f-3f11a43fe50b" primary="true" />
 </categoryLinks>
 <costs>
 <cost name="pts" typeId="570b7f63-4fc7-515c-9c96-5b5c25501f85" value="0.0" />
 </costs>
 </selectionEntry>
 <selectionEntry id="89672452-fc0b-51b8-8f6f-09f3586b4224" name="Lotara Sarrin" hidden="false" collective="false" import="true" type="upgrade">
 <constraints>
 <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7d8d6cfd-21a7-5521-84cb-72138eaa14d5" type="max" />
