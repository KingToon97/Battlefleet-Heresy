 <selectionEntryGroup id="c3853f75-1061-53d3-b11a-0a5b4f588381" name="Fleet Role" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="945a4e30-24de-52d1-b161-c0ece95a6cb6" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="d474e16f-a908-5b4a-ad21-d2d904baf8b4" name="Designate as Flagship" hidden="false" collective="false" import="true" type="upgrade"><profiles><profile id="ffdd4f1c-17cc-5355-b65b-b3c37444cdf9" name="Commander Embarkation" hidden="true" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability"><characteristics><characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Choose exactly one Fleet Commander here. The Commander is embarked on this Flagship.</characteristic></characteristics></profile></profiles><rules><rule id="22d463c4-078b-593a-9e43-872914731e3e" name="Flagship" hidden="false"><description>This ship is the fleet's Flagship. Exactly one Flagship is required in a standard fleet.</description></rule></rules><categoryLinks><categoryLink id="e7f0ef7b-026b-514d-9335-d2bb18bd5da5" name="Flagship" hidden="false" targetId="9a05d1db-3fb3-5329-a5a0-257d3cb53d11" primary="false" /></categoryLinks><selectionEntryGroups><selectionEntryGroup id="80293f68-b29b-5ab3-b8e0-b8d7ac4c5f69" name="Fleet Commander" hidden="false" collective="false" import="true"><constraints><constraint type="min" value="1.0" field="selections" scope="parent" shared="false" id="3a4a18b3-3f36-5055-b6e3-bece5a4453ec" percentValue="false" includeChildSelections="false" includeChildForces="false" /><constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="d2e5f7bb-9325-5995-89c5-cc7f22a94fbd" percentValue="false" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="d18d43be-d97f-5077-86da-fbcab94fb86e" name="Fleet Captain" hidden="false" collective="false" import="true" type="upgrade">
 <constraints>
