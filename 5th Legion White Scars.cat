      <selectionEntry id="42eb2c41-cec3-55e2-a7c1-1c6d9b875ae5" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="dbe7136b-a8c1-598c-8780-ae8158eb04cd" shared="false" includeChildSelections="false" />
