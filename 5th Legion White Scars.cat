      <selectionEntry id="faefd7c7-17d7-51fd-8987-0fa41c7a7b74" name="Ebon Keshig" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="f004ae12-23fa-5ee1-b4e9-72e40d59dcbf" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="5f610101-b39b-53a8-82cd-f62bb0b6746e" name="Ebon Keshig" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">One Crew point; +2 to its boarding die. Maximum 1 per ship, and it does not count against the Terminator limit. This unit may be committed to a boarding action after the enemy has declared his own boarders, rather than before.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <categoryLinks>
