   <profiles>
    <profile id="4c0b28c8-55c5-5204-9aa3-c6179a532880" name="Cruiser - Gothic-class" hidden="false" typeId="806f9ff1-fd51-5ddb-b005-ce73a5d09d65" typeName="Ship">
