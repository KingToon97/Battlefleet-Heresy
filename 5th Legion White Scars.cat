     <selectionEntries>
      <selectionEntry id="17291589-6d38-5a44-9a7d-c4d1645cd19e" name="Adamantium Belt Armour" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="e555775c-dd24-5fd8-a33d-6cc3f2d13fcb" shared="false" includeChildSelections="false" />
