       <profiles>
        <profile id="565a13c7-e95b-5565-8a2d-d5105a7dcff0" name="Boarding Force" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">One Crew point; +1 boarding modifier. Eligible Astartes hulls only.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <categoryLinks>
        <categoryLink id="a13acc84-6e7d-5d87-824b-b9ed6cb35d62" name="Boarding Force" hidden="false" targetId="4d94b920-d5bc-5fd7-a967-4ba346019f56" primary="true" />
