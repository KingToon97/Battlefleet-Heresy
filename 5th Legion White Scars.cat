      <selectionEntry id="846fb8c0-2126-5152-805f-8d9939492727" name="Contemptor Dreadnought" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="2.0" field="selections" scope="parent" shared="false" id="6fa1fc4c-b5ae-516c-b5d5-2ea82385260e" percentValue="false" includeChildSelections="false" includeChildForces="false" />
        <constraint type="max" value="8.0" field="selections" scope="parent" shared="false" id="2fcda7aa-5c68-52bf-a2fb-fcb7bdfb0c32" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="64d1bffa-ea41-5aa8-a7a5-c5b9d5589f95" name="Boarding Force" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">Counts as 2 Crew; fights as one warrior at +2 and gives −1 to the enemy die it faces. Limits as Terminators.</characteristic>
