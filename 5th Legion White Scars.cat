       </constraints>
       <profiles>
        <profile id="774050da-6a36-5df5-96cf-6398b6b1c2d7" name="Ebon Keshig" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">One Crew point; +2 to its boarding die. Maximum 1 per ship, and it does not count against the Terminator limit. This unit may be committed to a boarding action after the enemy has declared his own boarders, rather than before.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <categoryLinks>
        <categoryLink id="94a7f2f7-b7d2-5567-af51-0c4fb10ef9e6" name="Boarding Force" hidden="false" targetId="4d94b920-d5bc-5fd7-a967-4ba346019f56" primary="true" />
