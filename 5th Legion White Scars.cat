      <selectionEntry id="8db6098a-1fdc-547e-88e3-9e55b397bac9" name="Veteran Crew" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="7d59d816-b808-5c8b-ae69-1e96ed7b40d6" percentValue="false" includeChildSelections="false" includeChildForces="false" />
