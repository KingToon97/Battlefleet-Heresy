       <profiles>
        <profile id="58630098-dc33-5cc6-952f-8ed03564c19d" name="Ebon Keshig" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">One Crew point; +2 to its boarding die. Maximum 1 per ship, and it does not count against the Terminator limit. This unit may be committed to a boarding action after the enemy has declared his own boarders, rather than before.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <categoryLinks>
        <categoryLink id="696fea6c-f4be-5ed0-ab95-f50bcfec5a35" name="Boarding Force" hidden="false" targetId="4d94b920-d5bc-5fd7-a967-4ba346019f56" primary="true" />
