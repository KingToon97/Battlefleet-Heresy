      </selectionEntry>
      <selectionEntry id="1fe77983-80b6-56e7-a979-49e58b246050" name="Plasma Drive Overhaul" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint field="selections" scope="parent" value="1.0" type="max" id="c174a221-476a-5f1e-9383-b6dec3429d16" shared="false" includeChildSelections="false" />
