      <selectionEntry id="589c0767-7c82-5490-91a2-0733e8d35bed" name="Ebon Keshig" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="459762b6-9281-5cfc-8ce5-f68252f999e9" percentValue="false" includeChildSelections="false" includeChildForces="false" />
       </constraints>
       <profiles>
        <profile id="f22241a1-7722-50c0-bdf6-ba0d6adc2c46" name="Ebon Keshig" hidden="false" typeId="3ec9b61c-f3d1-5fe4-adb4-6104872812e1" typeName="Ability">
         <characteristics>
          <characteristic name="Description" typeId="5e1f6242-764b-516f-9c81-5659b132c092">One Crew point; +2 to its boarding die. Maximum 1 per ship, and it does not count against the Terminator limit. This unit may be committed to a boarding action after the enemy has declared his own boarders, rather than before.</characteristic>
         </characteristics>
        </profile>
       </profiles>
       <categoryLinks>
