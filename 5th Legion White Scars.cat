     <selectionEntries>
      <selectionEntry id="41cda9b1-d1c5-57de-b3bc-fa7b3fbc53ad" name="Veteran Crew" hidden="false" collective="false" import="true" type="upgrade">
       <constraints>
        <constraint type="max" value="1.0" field="selections" scope="parent" shared="false" id="516594d6-e743-5c49-9d74-fdd40798e4b5" percentValue="false" includeChildSelections="false" includeChildForces="false" />
